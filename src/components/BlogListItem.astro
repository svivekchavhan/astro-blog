---
interface Props {
  title: string;
  href: string;
  date?: string;
  number?: number;
  category?: string;
}

const { title, href, date = "2026", number, category } = Astro.props;
---

<div class="group py-3 sm:py-3.5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2.5 sm:gap-6 border-b border-border-card/60 dark:border-border-card/30 last:border-0 hover:bg-primary/5 px-3 sm:px-4 rounded-xl transition-all duration-200 cursor-pointer" onclick={`window.location.href='${href}'`}>
  <div class="flex-1 min-w-0 flex items-center gap-3 sm:gap-4">
    {number !== undefined && (
      <span class="text-xs sm:text-sm font-black text-primary bg-primary/10 border border-primary/20 w-7 h-7 sm:w-8 sm:h-8 rounded-lg shrink-0 flex items-center justify-center tabular-nums">
        {number < 10 ? `0${number}` : number}
      </span>
    )}
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 mb-0.5 flex-wrap">
        {category && (
          <span class="text-[0.65rem] font-extrabold uppercase tracking-wider bg-primary/10 text-primary px-2 py-0.5 rounded border border-primary/20">
            {category}
          </span>
        )}
        {date && <span class="text-text-muted text-[0.725rem] font-medium">{date}</span>}
      </div>
      <a href={href} class="no-underline text-inherit block">
        <h3 class="text-sm sm:text-base font-bold text-text-main leading-snug m-0 transition-colors duration-200 group-hover:text-primary truncate">{title}</h3>
      </a>
    </div>
  </div>
  <div class="flex items-center gap-1.5 font-bold text-xs text-primary no-underline whitespace-nowrap shrink-0 sm:self-center">
    <span class="hidden sm:inline">वाचा (Read)</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
  </div>
</div>
