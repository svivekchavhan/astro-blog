---
interface Props {
	title: string;
	href: string;
  date?: string;
  number?: number;
}

const { title, href, date = "2026", number } = Astro.props;
---

<div class="group py-4 sm:py-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-12 border-b border-border-card dark:border-border-card/30 last:border-0 hover:pl-1 sm:hover:pl-2 transition-all duration-300 cursor-pointer" onclick={`window.location.href='${href}'`}>
	<div class="flex-1 min-w-0 flex items-start gap-6">
    {number && (
      <span class="text-3xl md:text-4xl font-black text-text-muted/20 group-hover:text-primary/40 transition-colors duration-300 shrink-0 leading-none tabular-nums">
        {number < 10 ? `0${number}` : number}
      </span>
    )}
    <div class="min-w-0">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-text-muted text-[0.8rem] font-medium whitespace-nowrap">{date}</span>
      </div>
      <a href={href} class="no-underline text-inherit block">
        <h3 class="text-[1.15rem] md:text-xl font-semibold text-text-main leading-tight m-0 transition-colors duration-200 group-hover:text-primary truncate">{title}</h3>
      </a>
    </div>
	</div>
	<div class="flex items-center gap-2 font-bold text-[0.9rem] text-primary no-underline whitespace-nowrap shrink-0">
		<span class="hidden sm:inline">Read Article</span>
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
	</div>
</div>
