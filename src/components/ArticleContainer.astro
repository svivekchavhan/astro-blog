---
import Layout from "../layouts/Layout.astro";
import { articlesRegistry } from "../constants/articles";
import { HiOutlineCalendarDays } from "react-icons/hi2";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  date: string;
  category: string;
  image?: string;
  customBreadcrumbs?: { name: string; url?: string }[];
}

const {
  title,
  description,
  canonicalURL,
  date,
  category,
  image,
  customBreadcrumbs,
} = Astro.props;

// Determine current pathname
const currentPath = canonicalURL 
  ? new URL(canonicalURL).pathname 
  : Astro.url.pathname;

// Calculate relevance score and find top 3 related articles
const relatedArticles = articlesRegistry
  .filter(art => {
    // Remove trailing slashes to accurately match paths
    const cleanArtSlug = art.slug.replace(/\/$/, "");
    const cleanCurrentPath = currentPath.replace(/\/$/, "");
    return cleanArtSlug !== cleanCurrentPath;
  })
  .map(art => {
    let score = 0;
    // Boost score if category matches
    if (art.category.toLowerCase() === category.toLowerCase()) {
      score += 5;
    }
    // Boost score if both are admit-cards or jobs
    const isArtAdmit = art.slug.includes("/admit-card/");
    const isCurrAdmit = currentPath.includes("/admit-card/");
    if (isArtAdmit === isCurrAdmit) {
      score += 3;
    }
    return { ...art, score };
  })
  // Sort by relevance score descending, then by date descending
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return new Date(b.date).getTime() - new Date(a.date).getTime();
  })
  .slice(0, 6);
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image={image}
  article={true}
  customBreadcrumbs={customBreadcrumbs}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20">
          {category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]">
        {title}
      </h1>
      <p class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic">
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <slot />
    </div>

    <!-- ================= LANGUAGE SEPARATOR & ENGLISH VERSION ================= -->
    {Astro.slots.has('english') && (
      <div class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative">
        <span class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md">
          English Version
        </span>
      </div>
      
      <div id="english-version" class="opacity-95">
        <slot name="english" />
      </div>
    )}

    <!-- ================= DYNAMIC RELATED ARTICLES SECTION ================= -->
    {relatedArticles.length > 0 && (
      <div class="mt-20 pt-10 border-t border-border-card dark:border-border-card/30 not-prose">
        <div class="flex items-center gap-2 mb-8">
          <span class="w-2.5 h-6 bg-primary rounded-full"></span>
          <h3 class="text-xl md:text-2xl font-black text-text-main m-0 uppercase tracking-tight">
            संबंधित महत्वाचे लेख / Related Articles
          </h3>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedArticles.map(art => (
            <a 
              href={art.slug} 
              class="group flex flex-col bg-bg-surface border border-border-card hover:border-primary rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-sm hover:shadow-md no-underline"
            >
              <!-- Card Image -->
              <div class="relative aspect-video w-full overflow-hidden bg-black/10 img-skeleton">
                <img 
                  src={art.image} 
                  alt={art.titleEn} 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 article-img"
                  loading="lazy"
                  onload="this.classList.add('img-loaded'); this.parentElement?.classList.remove('img-skeleton');"
                />
                <div class="absolute top-3 left-3">
                  <span class="bg-primary/95 backdrop-blur-xs text-white px-2 py-0.5 rounded text-[0.6rem] font-bold uppercase tracking-wider">
                    {art.category}
                  </span>
                </div>
              </div>

              <!-- Card Content -->
              <div class="p-4 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <!-- Title Marathi -->
                  <h4 class="text-sm font-extrabold text-text-main line-clamp-2 leading-snug group-hover:text-primary transition-colors m-0">
                    {art.titleMr}
                  </h4>
                  <!-- Title English -->
                  <p class="text-[0.7rem] text-text-muted line-clamp-1 m-0 font-medium">
                    {art.titleEn}
                  </p>
                </div>
                
                <!-- Card Footer Date -->
                <div class="flex items-center gap-1.5 text-[0.65rem] text-text-muted/80 font-bold pt-3 mt-3 border-t border-border-card/50">
                  <HiOutlineCalendarDays className="text-primary text-xs shrink-0" />
                  <span>{art.date}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>
