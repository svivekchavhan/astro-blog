---
import {
  HiOutlineHome,
  HiOutlineNewspaper,
  HiOutlineEnvelope,
  HiOutlineBell,
  HiOutlineMagnifyingGlass,
  HiOutlineQueueList,
  HiOutlineSun,
  HiOutlineMoon,
  HiOutlineClock,
  HiOutlineCalendarDays,
  HiOutlineShieldCheck,
  HiOutlineDocumentText,
  HiOutlineExclamationTriangle,
  HiOutlineMap,
  HiOutlineIdentification,
  HiOutlineBriefcase,
  HiOutlineKey,
  HiOutlineAcademicCap,
  HiOutlineCalculator,
  HiOutlineUserGroup,
} from "react-icons/hi2";
import { articlesRegistry } from "../constants/articles";
import { MAHARASHTRA_DISTRICTS } from "../constants/districts";
import { naukriUpdates } from "../constants/naukriUpdates";
import Marquee from "./Marquee.astro";

// 1. Core Pages & Tools
const mainPages = [
  {
    title: "Home - Sarkari Naukri Updates",
    href: "/",
    category: "Page",
    keywords: "home sarkari naukri mahasandhi",
  },
  {
    title: "Current Recruitment 2026 (नवीन भरती जाहिराती)",
    href: "/current-recruitment",
    category: "Jobs",
    keywords: "recruitment jobs vacancies naukri bharti",
  },
  {
    title: "10th Pass Govt Jobs 2026 (१०वी पास सरकारी नोकऱ्या)",
    href: "/10th-pass-government-jobs-maharashtra",
    category: "Jobs",
    keywords: "10th pass ssc police bharti railway navy jobs",
  },
  {
    title: "Exam Syllabus 2026 (परीक्षा अभ्यासक्रम)",
    href: "/syllabus",
    category: "Syllabus",
    keywords: "syllabus abhyaskram exam pattern pdf mpsc upsc bank ssc",
  },
  {
    title: "Walk-In Jobs & Interviews 2026 (वॉक-इन मुलाखत)",
    href: "/walk-in-jobs",
    category: "Walk-In",
    keywords: "walkin interview direct recruitment",
  },
  {
    title: "Bank Recruitment 2026 (बँक भरती)",
    href: "/bank-recruitment",
    category: "Jobs",
    keywords: "bank ibps sbi po clerk",
  },
  {
    title: "Naukri Updates & Alerts (नोकरी अपडेट्स)",
    href: "/naukri-updates",
    category: "Updates",
    keywords: "naukri alerts news",
  },
  {
    title: "Mega Recruitment 2026 (मेगा भरती)",
    href: "/mega-recruitment",
    category: "Jobs",
    keywords: "mega bharti govt jobs",
  },
  {
    title: "Result Page 2026 (निकाल)",
    href: "/result",
    category: "Result",
    keywords: "result cutoff merit list",
  },
  {
    title: "Admit Card Download (प्रवेश पत्र / हॉलतिकीट)",
    href: "/admit-card",
    category: "Admit Card",
    keywords: "admit card hall ticket call letter",
  },
  {
    title: "Answer Key 2026 (उत्तरतालिका)",
    href: "/answer-key",
    category: "Answer Key",
    keywords: "answer key response sheet",
  },
  {
    title: "Admission 2026 (प्रवेश प्रक्रिया)",
    href: "/admission",
    category: "Admission",
    keywords: "admission mht cet iti counselling",
  },
  {
    title: "MPSC Study Material & Exam Details (एमपीएससी)",
    href: "/mpsc",
    category: "MPSC",
    keywords: "mpsc polity syllabus prelims mains",
  },
  {
    title: "MPSC Age Calculator (मराठी वय कॅल्क्युलेटर)",
    href: "/mpsc-age-calculator-marathi",
    category: "Calculator",
    keywords: "age calculator vaya ganak mpsc",
  },
  {
    title: "SGPA & CGPA Percentage Calculator (टक्केवारी कॅल्क्युलेटर)",
    href: "/sgpa-cgpa-calculator",
    category: "Calculator",
    keywords: "sgpa cgpa percentage conversion marksheet",
  },
  {
    title: "Calculators & Tools Hub",
    href: "/calculator",
    category: "Tool",
    keywords: "calculators tools",
  },
  {
    title: "About Us",
    href: "/about-us",
    category: "Page",
    keywords: "about mission team",
  },
  {
    title: "Contact Us",
    href: "/contact-us",
    category: "Page",
    keywords: "contact email feedback support",
  },
  {
    title: "Sitemap Index",
    href: "/sitemap",
    category: "Page",
    keywords: "sitemap index pages",
  },
];

// 2. All Registered Articles (Marathi + English)
const articleSearchItems = articlesRegistry.map((art) => ({
  title: `${art.titleMr} (${art.titleEn})`,
  href: art.slug,
  category: art.category || "Article",
  keywords: `${art.titleMr} ${art.titleEn} ${art.category}`.toLowerCase(),
}));

// 3. All 35+ District Pages (Marathi + English)
const districtSearchItems = MAHARASHTRA_DISTRICTS.map((dist) => ({
  title: `${dist.nameMr} जिल्हा भरती (${dist.nameEn} District Jobs)`,
  href: `/district/${dist.slug}`,
  category: "District",
  keywords:
    `${dist.nameMr} ${dist.nameEn} district bharti jobs ${dist.division}`.toLowerCase(),
}));

// 4. Daily Naukri Updates
const naukriUpdateSearchItems = naukriUpdates.map((u) => ({
  title: `${u.titleHi} (${u.titleEn})`,
  href: u.link,
  category: "Alert",
  keywords: `${u.titleHi} ${u.titleEn}`.toLowerCase(),
}));

// Combined Search Index
const searchData = [
  ...mainPages,
  ...articleSearchItems,
  ...districtSearchItems,
  ...naukriUpdateSearchItems,
];
