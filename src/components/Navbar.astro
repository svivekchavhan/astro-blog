<script define:vars={{ searchData }}>
  function initNavbar() {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileOverlay = document.getElementById("mobile-overlay");
    
    // Desktop Search Elements
    const searchInput = document.getElementById("search-input");
    const searchBoxContainer = document.getElementById("search-box-container");
    const searchClearBtn = document.getElementById("search-clear-btn");
    const suggestionsContainer = document.getElementById("search-suggestions");
    const suggestionsList = document.getElementById("suggestions-list");
    const searchResultsCount = document.getElementById("search-results-count");
    const desktopCategoryChips = document.getElementById("desktop-category-chips");

    // Mobile Search Elements
    const mobileSearchModal = document.getElementById("mobile-search-modal");
    const mobileSearchInput = document.getElementById("mobile-search-input");
    const mobileSearchClearBtn = document.getElementById("mobile-search-clear-btn");
    const closeMobileSearchBtn = document.getElementById("close-mobile-search");
    const mobileSearchResults = document.getElementById("mobile-search-results");
    const mobileCategoryChips = document.getElementById("mobile-category-chips");

    let activeIndex = -1;
    let desktopActiveCategory = "all";
    let mobileActiveCategory = "all";

    function getCategoryBadgeClass(category) {
      const cat = (category || "").toLowerCase();
      if (cat.includes("result")) return "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30";
      if (cat.includes("admit") || cat.includes("ticket")) return "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/30";
      if (cat.includes("bank") || cat.includes("sbi")) return "bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/30";
      if (cat.includes("mpsc")) return "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30";
      if (cat.includes("district")) return "bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/30";
      if (cat.includes("alert") || cat.includes("update") || cat.includes("notice")) return "bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/30";
      if (cat.includes("syllabus") || cat.includes("calculator") || cat.includes("tool")) return "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30";
      return "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/30";
    }

    function highlightMatch(text, query) {
      if (!query) return text;
      const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, "gi");
      return text.replace(
        regex,
        '<u class="text-primary no-underline font-bold bg-primary/10 px-0.5 rounded">$1</u>',
      );
    }

    function renderEmptyState(query) {
      return `
        <div class="text-center py-8 px-4">
          <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto mb-2.5 text-lg">
            🔍
          </div>
          <p class="text-xs sm:text-sm font-bold text-text-main mb-1">No results found ${query ? `for "${query}"` : ''}</p>
          <p class="text-[0.72rem] text-text-muted mb-4">Try checking spelling or tap a popular topic below:</p>
          <div class="flex flex-wrap justify-center gap-1.5 max-w-xs mx-auto">
            <button type="button" class="quick-suggest-btn text-[0.7rem] font-semibold px-2.5 py-1 rounded-full bg-bg-base hover:bg-primary/10 text-primary border border-primary/20 transition-all cursor-pointer" data-suggest="SBI Clerk">SBI Clerk</button>
            <button type="button" class="quick-suggest-btn text-[0.7rem] font-semibold px-2.5 py-1 rounded-full bg-bg-base hover:bg-primary/10 text-primary border border-primary/20 transition-all cursor-pointer" data-suggest="MPSC">MPSC</button>
            <button type="button" class="quick-suggest-btn text-[0.7rem] font-semibold px-2.5 py-1 rounded-full bg-bg-base hover:bg-primary/10 text-primary border border-primary/20 transition-all cursor-pointer" data-suggest="Admit Card">Admit Card</button>
            <button type="button" class="quick-suggest-btn text-[0.7rem] font-semibold px-2.5 py-1 rounded-full bg-bg-base hover:bg-primary/10 text-primary border border-primary/20 transition-all cursor-pointer" data-suggest="Police Bharti">Police Bharti</button>
            <button type="button" class="quick-suggest-btn text-[0.7rem] font-semibold px-2.5 py-1 rounded-full bg-bg-base hover:bg-primary/10 text-primary border border-primary/20 transition-all cursor-pointer" data-suggest="10th Pass">10th Pass</button>
          </div>
        </div>
      `;
    }

    function renderItemHTML(post, query) {
      const badgeClass = getCategoryBadgeClass(post.category);
      const highlightedTitle = highlightMatch(post.title, query);
      const metaInfo = post.vacancies
        ? `<span class="text-[0.62rem] font-semibold text-primary bg-primary/10 px-1.5 py-0.5 rounded shrink-0">${post.vacancies} Posts</span>`
        : post.date
        ? `<span class="text-[0.62rem] text-text-muted shrink-0">${post.date}</span>`
        : "";

      return `
        <a href="${post.href}" class="search-item-link flex items-center justify-between gap-3 px-3.5 py-2.5 hover:bg-primary/5 rounded-xl transition-colors group no-underline border-b border-border-card/20 last:border-b-0">
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all shrink-0 text-xs sm:text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            </div>
            <div class="flex flex-col min-w-0 flex-1">
              <span class="text-xs sm:text-sm text-text-main font-medium truncate group-hover:text-primary transition-colors">${highlightedTitle}</span>
              ${metaInfo ? `<div class="mt-0.5 flex items-center gap-2">${metaInfo}</div>` : ""}
            </div>
          </div>
          <span class="text-[0.55rem] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shrink-0 border ${badgeClass}">
            ${post.category || "Page"}
          </span>
        </a>
      `;
    }

    function filterPosts(query, activeCategory) {
      return searchData.filter((post) => {
        const matchesCategory =
          activeCategory === "all" ||
          (post.category && post.category.toLowerCase().includes(activeCategory.toLowerCase()));

        if (!matchesCategory) return false;

        if (!query) return true;

        const titleMatch = post.title.toLowerCase().includes(query);
        const kwMatch = post.keywords
          ? post.keywords.toLowerCase().includes(query)
          : false;
        return titleMatch || kwMatch;
      });
    }

    // DESKTOP SEARCH LOGIC
    if (searchInput && suggestionsContainer && suggestionsList) {
      function getSuggestionItems() {
        return suggestionsList.querySelectorAll("a.search-item-link");
      }

      function updateActiveItem() {
        const items = getSuggestionItems();
        items.forEach((item, idx) => {
          if (idx === activeIndex) {
            item.classList.add("bg-primary/10", "ring-1", "ring-primary/30");
            item.scrollIntoView({ block: "nearest" });
          } else {
            item.classList.remove("bg-primary/10", "ring-1", "ring-primary/30");
          }
        });
      }

      function updateDesktopResults() {
        const query = searchInput.value.toLowerCase().trim();
        activeIndex = -1;

        if (searchClearBtn) {
          searchClearBtn.classList.toggle("hidden", query.length === 0);
        }

        const filtered = filterPosts(query, desktopActiveCategory).slice(0, 10);

        if (filtered.length > 0) {
          suggestionsList.innerHTML = filtered.map((post) => renderItemHTML(post, query)).join("");
          if (searchResultsCount) {
            searchResultsCount.textContent = `Found ${filtered.length} results${query ? ` for "${query}"` : ''}`;
          }
          suggestionsContainer.classList.remove("hidden");
          setTimeout(() => {
            suggestionsContainer.classList.remove("opacity-0", "translate-y-2");
          }, 10);
        } else {
          suggestionsList.innerHTML = renderEmptyState(query);
          if (searchResultsCount) {
            searchResultsCount.textContent = `No matches found`;
          }
          suggestionsContainer.classList.remove("hidden");
          setTimeout(() => {
            suggestionsContainer.classList.remove("opacity-0", "translate-y-2");
          }, 10);
        }
      }

      searchInput.addEventListener("input", updateDesktopResults);
      searchInput.addEventListener("focus", updateDesktopResults);

      if (searchClearBtn) {
        searchClearBtn.addEventListener("click", () => {
          searchInput.value = "";
          searchInput.focus();
          updateDesktopResults();
        });
      }

      // Desktop Category Chips Click
      if (desktopCategoryChips) {
        const chips = desktopCategoryChips.querySelectorAll("button[data-chip]");
        chips.forEach((chip) => {
          chip.addEventListener("click", () => {
            chips.forEach((c) => {
              c.classList.remove("active", "bg-primary", "text-white");
              c.classList.add("bg-bg-base", "border-border-card/60", "text-text-main");
            });
            chip.classList.add("active", "bg-primary", "text-white");
            chip.classList.remove("bg-bg-base", "border-border-card/60", "text-text-main");
            desktopActiveCategory = chip.getAttribute("data-chip") || "all";
            updateDesktopResults();
          });
        });
      }

      // Quick suggestions delegated click inside desktop dropdown
      suggestionsList.addEventListener("click", (e) => {
        const suggestBtn = e.target.closest(".quick-suggest-btn");
        if (suggestBtn) {
          const text = suggestBtn.getAttribute("data-suggest");
          if (text) {
            searchInput.value = text;
            updateDesktopResults();
          }
        }
      });

      // Keyboard navigation for desktop search input
      searchInput.addEventListener("keydown", (e) => {
        const isOpen = !suggestionsContainer.classList.contains("hidden");
        if (!isOpen) return;

        const items = getSuggestionItems();

        if (e.key === "ArrowDown") {
          e.preventDefault();
          if (items.length > 0) {
            activeIndex = (activeIndex + 1) % items.length;
            updateActiveItem();
          }
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (items.length > 0) {
            activeIndex = (activeIndex - 1 + items.length) % items.length;
            updateActiveItem();
          }
        } else if (e.key === "Enter") {
          if (activeIndex >= 0 && activeIndex < items.length) {
            e.preventDefault();
            items[activeIndex].click();
          }
        } else if (e.key === "Escape") {
          suggestionsContainer.classList.add("hidden", "opacity-0", "translate-y-2");
          searchInput.blur();
        }
      });

      // Close suggestions when clicking outside
      document.addEventListener("click", (e) => {
        if (
          !searchBoxContainer?.contains(e.target) &&
          !suggestionsContainer.contains(e.target)
        ) {
          suggestionsContainer.classList.add("hidden", "opacity-0", "translate-y-2");
        }
      });
    }

    // MOBILE SEARCH MODAL OVERLAY LOGIC
    function openMobileSearchModal(initialQuery = "") {
      if (!mobileSearchModal) return;
      mobileSearchModal.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
      setTimeout(() => {
        mobileSearchModal.classList.remove("opacity-0");
        if (mobileSearchInput) {
          if (initialQuery) mobileSearchInput.value = initialQuery;
          mobileSearchInput.focus();
          updateMobileResults();
        }
      }, 10);
    }

    function closeMobileSearchModal() {
      if (!mobileSearchModal) return;
      mobileSearchModal.classList.add("opacity-0");
      setTimeout(() => {
        mobileSearchModal.classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
      }, 300);
    }

    function updateMobileResults() {
      if (!mobileSearchInput || !mobileSearchResults) return;
      const query = mobileSearchInput.value.toLowerCase().trim();

      if (mobileSearchClearBtn) {
        mobileSearchClearBtn.classList.toggle("hidden", query.length === 0);
      }

      const filtered = filterPosts(query, mobileActiveCategory).slice(0, 15);

      if (filtered.length > 0) {
        mobileSearchResults.innerHTML = filtered.map((post) => renderItemHTML(post, query)).join("");
      } else {
        mobileSearchResults.innerHTML = renderEmptyState(query);
      }
    }

    // Open Mobile Search Modal when tapping search box on small screens (< 768px)
    if (searchBoxContainer) {
      searchBoxContainer.addEventListener("click", (e) => {
        if (window.innerWidth < 768) {
          e.preventDefault();
          const currentVal = searchInput ? searchInput.value : "";
          openMobileSearchModal(currentVal);
        }
      });
    }

    if (mobileSearchInput) {
      mobileSearchInput.addEventListener("input", updateMobileResults);
    }

    if (mobileSearchClearBtn) {
      mobileSearchClearBtn.addEventListener("click", () => {
        if (mobileSearchInput) {
          mobileSearchInput.value = "";
          mobileSearchInput.focus();
          updateMobileResults();
        }
      });
    }

    if (closeMobileSearchBtn) {
      closeMobileSearchBtn.addEventListener("click", closeMobileSearchModal);
    }

    // Mobile Category Chips Click
    if (mobileCategoryChips) {
      const chips = mobileCategoryChips.querySelectorAll("button[data-chip]");
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          chips.forEach((c) => {
            c.classList.remove("active", "bg-primary", "text-white");
            c.classList.add("bg-bg-base", "border-border-card/60", "text-text-main");
          });
          chip.classList.add("active", "bg-primary", "text-white");
          chip.classList.remove("bg-bg-base", "border-border-card/60", "text-text-main");
          mobileActiveCategory = chip.getAttribute("data-chip") || "all";
          updateMobileResults();
        });
      });
    }

    // Quick suggestions click listener in mobile search modal
    if (mobileSearchResults) {
      mobileSearchResults.addEventListener("click", (e) => {
        const suggestBtn = e.target.closest(".quick-suggest-btn");
        if (suggestBtn && mobileSearchInput) {
          const text = suggestBtn.getAttribute("data-suggest");
          if (text) {
            mobileSearchInput.value = text;
            updateMobileResults();
          }
        }
      });
    }

    // Global Keyboard Listeners (Ctrl+K, Cmd+K, '/')
    document.addEventListener("keydown", (e) => {
      // Ignore shortcut when typing in input/textarea unless it's Escape
      const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : "";
      const isInputActive = activeTag === "input" || activeTag === "textarea";

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (window.innerWidth < 768) {
          openMobileSearchModal();
        } else {
          searchInput?.focus();
        }
      } else if (e.key === "/" && !isInputActive) {
        e.preventDefault();
        if (window.innerWidth < 768) {
          openMobileSearchModal();
        } else {
          searchInput?.focus();
        }
      } else if (e.key === "Escape") {
        if (mobileSearchModal && !mobileSearchModal.classList.contains("hidden")) {
          closeMobileSearchModal();
        }
      }
    });

    function closeMenu() {
      if (menuToggle?.classList.contains("active")) {
        menuToggle.classList.remove("active");
        mobileMenu?.classList.add("translate-x-full");
        mobileMenu?.classList.remove("translate-x-0");
        mobileOverlay?.classList.remove("!opacity-100", "!visible");
        document.body.classList.remove("overflow-hidden");

        // Reset hamburger animation
        const spans = menuToggle?.querySelectorAll("span");
        if (spans && spans.length === 3) {
          spans[0].style.transform = "none";
          spans[1].style.opacity = "1";
          spans[2].style.transform = "none";
        }
      }
    }

    function toggleMenu() {
      const isActive = menuToggle?.classList.contains("active");

      if (isActive) {
        closeMenu();
      } else {
        // Open menu
        menuToggle?.classList.add("active");
        mobileMenu?.classList.remove("translate-x-full");
        mobileMenu?.classList.add("translate-x-0");
        mobileOverlay?.classList.add("!opacity-100", "!visible");
        document.body.classList.add("overflow-hidden");

        // Animate hamburger to X
        const spans = menuToggle?.querySelectorAll("span");
        if (spans && spans.length === 3) {
          spans[0].style.transform = "translateY(8px) rotate(45deg)";
          spans[1].style.opacity = "0";
          spans[2].style.transform = "translateY(-8px) rotate(-45deg)";
        }
      }
    }

    // Always ensure menu is reset to closed state
    closeMenu();

    if (menuToggle && !menuToggle.hasAttribute("data-initialized")) {
      menuToggle.addEventListener("click", toggleMenu);
      mobileOverlay?.addEventListener("click", toggleMenu);
      menuToggle.setAttribute("data-initialized", "true");

      // Auto-close menu when any page link inside mobile menu is clicked
      if (mobileMenu) {
        const mobileLinks = mobileMenu.querySelectorAll("a");
        mobileLinks.forEach((link) => {
          link.addEventListener("click", closeMenu);
        });
      }
    }
  }

  function initDateTime() {
    const dateEl = document.getElementById("current-date");
    const timeEl = document.getElementById("current-time");

    function update() {
      const now = new Date();
      if (dateEl) {
        dateEl.textContent = now.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
      }
      if (timeEl) {
        timeEl.textContent = now.toLocaleTimeString("en-US", {
          hour12: true,
          hour: "2-digit",
          minute: "2-digit",
        });
      }
    }

    update();
    setInterval(update, 1000);
  }

  function updateNavbarHeight() {
    requestAnimationFrame(() => {
      const navbar = document.querySelector(".sticky.top-0");
      if (navbar) {
        const height = navbar.getBoundingClientRect().height;
        document.documentElement.style.setProperty(
          "--navbar-height",
          `${height}px`,
        );
      }
    });
  }

  function initNavBadges() {
    const rawPath = window.location.pathname;
    const currentPath = rawPath.replace(/\/$/, "") || "/";
    const badgeLinks = document.querySelectorAll("[data-nav-badge]");

    badgeLinks.forEach((link) => {
      const categoryKey = link.getAttribute("data-nav-badge"); // 'result', 'admit-card', 'naukri-updates'
      const latestTs = parseInt(link.getAttribute("data-latest-ts") || "0", 10);
      const badgeEl = link.querySelector(".nav-new-badge");

      if (!categoryKey || !badgeEl) return;

      const visitedKey = "nav_visited_" + categoryKey;

      // If user is currently on this page, update visited timestamp
      if (currentPath === "/" + categoryKey) {
        localStorage.setItem(visitedKey, Date.now().toString());
      }

      const lastVisited = parseInt(localStorage.getItem(visitedKey) || "0", 10);

      // Show NEW badge if there is a recent update timestamp (latestTs > 0)
      // AND user has NOT visited the page since the latest update (lastVisited < latestTs)
      if (latestTs > 0 && lastVisited < latestTs) {
        badgeEl.classList.remove("hidden");
      } else {
        badgeEl.classList.add("hidden");
      }

      // Add click handler to immediately remove badge when user clicks link
      link.addEventListener("click", () => {
        localStorage.setItem(visitedKey, Date.now().toString());
        if (badgeEl) badgeEl.classList.add("hidden");
      });
    });
  }

  // Initialize on page load and after view transitions
  document.addEventListener("astro:page-load", () => {
    initNavbar();
    initDateTime();
    initNavBadges();
    updateNavbarHeight();

    // Add event listener to recalculate height on window resize
    window.removeEventListener("resize", updateNavbarHeight);
    window.addEventListener("resize", updateNavbarHeight);
  });
</script>
