<div
  class="fixed inset-0 bg-black/60 backdrop-blur-[4px] z-[999] opacity-0 invisible transition-all duration-300"
  id="mobile-overlay"
>
</div>

<script define:vars={{ searchData }}>
  function initNavbar() {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileOverlay = document.getElementById("mobile-overlay");
    const searchInput = document.getElementById("search-input");
    const suggestionsContainer = document.getElementById("search-suggestions");
    const suggestionsList = document.getElementById("suggestions-list");

    // Live Search Suggestions
    if (searchInput && suggestionsContainer && suggestionsList) {
      let activeIndex = -1;

      function getSuggestionItems() {
        return suggestionsList.querySelectorAll("a");
      }

      function updateActiveItem() {
        const items = getSuggestionItems();
        items.forEach((item, idx) => {
          const iconContainer = item.querySelector("div");
          if (idx === activeIndex) {
            item.classList.add("bg-primary/5");
            if (iconContainer) {
              iconContainer.classList.add("!bg-primary", "!text-white");
            }
            item.scrollIntoView({ block: "nearest" });
          } else {
            item.classList.remove("bg-primary/5");
            if (iconContainer) {
              iconContainer.classList.remove("!bg-primary", "!text-white");
            }
          }
        });
      }

      function highlightMatch(text, query) {
        if (!query) return text;
        const regex = new RegExp(`(${query})`, "gi");
        return text.replace(
          regex,
          '<u class="text-primary no-underline font-bold">$1</u>',
        );
      }

      searchInput.addEventListener("input", (e) => {
        const query = e.target.value.toLowerCase().trim();
        activeIndex = -1; // Reset selection index on input change

        if (query.length < 2) {
          suggestionsContainer.classList.add(
            "hidden",
            "opacity-0",
            "translate-y-2",
          );
          return;
        }

        const filtered = searchData
          .filter((post) => {
            const titleMatch = post.title.toLowerCase().includes(query);
            const kwMatch = post.keywords
              ? post.keywords.toLowerCase().includes(query)
              : false;
            return titleMatch || kwMatch;
          })
          .slice(0, 8);

        if (filtered.length > 0) {
          suggestionsList.innerHTML = filtered
            .map(
              (post) => `
            <a href="${post.href}" class="flex items-center justify-between gap-3 px-3.5 py-2.5 hover:bg-primary/5 rounded-xl transition-colors group no-underline border-b border-border-card/20 last:border-b-0">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all shrink-0 text-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                </div>
                <span class="text-xs md:text-sm text-text-main font-medium truncate">${highlightMatch(
                  post.title,
                  query,
                )}</span>
              </div>
              <span class="text-[0.55rem] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shrink-0 bg-primary/10 text-primary border border-primary/20">
                ${post.category || "Page"}
              </span>
            </a>
          `,
            )
            .join("");

          suggestionsContainer.classList.remove("hidden");
          setTimeout(() => {
            suggestionsContainer.classList.remove("opacity-0", "translate-y-2");
          }, 10);
        } else {
          suggestionsContainer.classList.add(
            "hidden",
            "opacity-0",
            "translate-y-2",
          );
        }
      });

      // Keyboard navigation
      searchInput.addEventListener("keydown", (e) => {
        const isOpen = !suggestionsContainer.classList.contains("hidden");
        if (!isOpen) return;

        const items = getSuggestionItems();
        if (items.length === 0) return;

        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % items.length;
          updateActiveItem();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + items.length) % items.length;
          updateActiveItem();
        } else if (e.key === "Enter") {
          if (activeIndex >= 0 && activeIndex < items.length) {
            e.preventDefault();
            items[activeIndex].click();
          }
        } else if (e.key === "Escape") {
          suggestionsContainer.classList.add(
            "hidden",
            "opacity-0",
            "translate-y-2",
          );
        }
      });

      // Close suggestions when clicking outside
      document.addEventListener("click", (e) => {
        if (
          !searchInput.contains(e.target) &&
          !suggestionsContainer.contains(e.target)
        ) {
          suggestionsContainer.classList.add(
            "hidden",
            "opacity-0",
            "translate-y-2",
          );
        }
      });
    }

    function closeMenu() {
      if (menuToggle?.classList.contains("active")) {
        menuToggle.classList.remove("active");
        mobileMenu?.classList.add("translate-x-full");
        mobileMenu?.classList.remove("translate-x-0");
        mobileOverlay?.classList.remove("!opacity-100", "!visible");
        document.body.classList.remove("overflow-hidden");

        // Reset hamburger animation
        const spans = menuToggle?.querySelectorAll("span");
        if (spans && spans.length === 3) {
          spans[0].style.transform = "none";
          spans[1].style.opacity = "1";
          spans[2].style.transform = "none";
        }
      }
    }

    function toggleMenu() {
      const isActive = menuToggle?.classList.contains("active");

      if (isActive) {
        closeMenu();
      } else {
        // Open menu
        menuToggle?.classList.add("active");
        mobileMenu?.classList.remove("translate-x-full");
        mobileMenu?.classList.add("translate-x-0");
        mobileOverlay?.classList.add("!opacity-100", "!visible");
        document.body.classList.add("overflow-hidden");

        // Animate hamburger to X
        const spans = menuToggle?.querySelectorAll("span");
        if (spans && spans.length === 3) {
          spans[0].style.transform = "translateY(8px) rotate(45deg)";
          spans[1].style.opacity = "0";
          spans[2].style.transform = "translateY(-8px) rotate(-45deg)";
        }
      }
    }

    // Always ensure menu is reset to closed state
    closeMenu();

    if (menuToggle && !menuToggle.hasAttribute("data-initialized")) {
      menuToggle.addEventListener("click", toggleMenu);
      mobileOverlay?.addEventListener("click", toggleMenu);
      menuToggle.setAttribute("data-initialized", "true");

      // Auto-close menu when any page link inside mobile menu is clicked
      if (mobileMenu) {
        const mobileLinks = mobileMenu.querySelectorAll("a");
        mobileLinks.forEach((link) => {
          link.addEventListener("click", closeMenu);
        });
      }
    }
  }

  function initDateTime() {
    const dateEl = document.getElementById("current-date");
    const timeEl = document.getElementById("current-time");

    function update() {
      const now = new Date();
      if (dateEl) {
        dateEl.textContent = now.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
      }
      if (timeEl) {
        timeEl.textContent = now.toLocaleTimeString("en-US", {
          hour12: true,
          hour: "2-digit",
          minute: "2-digit",
        });
      }
    }

    update();
    setInterval(update, 1000);
  }

  function updateNavbarHeight() {
    requestAnimationFrame(() => {
      const navbar = document.querySelector(".sticky.top-0");
      if (navbar) {
        const height = navbar.getBoundingClientRect().height;
        document.documentElement.style.setProperty(
          "--navbar-height",
          `${height}px`,
        );
      }
    });
  }

  // Initialize on page load and after view transitions
  document.addEventListener("astro:page-load", () => {
    initNavbar();
    initDateTime();
    updateNavbarHeight();

    // Add event listener to recalculate height on window resize
    window.removeEventListener("resize", updateNavbarHeight);
    window.addEventListener("resize", updateNavbarHeight);
  });
</script>
