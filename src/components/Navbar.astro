          <span id="current-date">May 15, 2026</span>
        </span>
        <span class="text-border-card opacity-60">|</span>
        <span class="flex items-center gap-1.5 font-bold text-primary"
          ><HiOutlineClock className="text-primary text-xs shrink-0 animate-pulse" />
