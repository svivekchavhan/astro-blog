---
import { 
  HiOutlineCalculator, 
  HiOutlineAcademicCap, 
  HiOutlineArrowRight,
  HiOutlineWrenchScrewdriver
} from "react-icons/hi2";

const toolsList = [
  {
    titleMr: "मराठी वय कॅल्क्युलेटर (MPSC Age Calculator)",
    titleEn: "MPSC Age Calculator",
    descMr: "MPSC व सरकारी भरतीसाठी तुमचे अचूक वय (वर्षे, महिने, दिवस) व वयोमर्यादा पात्रता लगेच तपासा.",
    link: "/tools/mpsc-age-calculator",
    icon: "🧮",
    color: "from-amber-500/10 to-orange-500/10 border-amber-500/25 text-amber-600 dark:text-amber-400",
    badge: "Popular Tool"
  },
  {
    titleMr: "SGPA व CGPA टक्केवारी कॅल्क्युलेटर",
    titleEn: "SGPA & CGPA Calculator",
    descMr: "विद्यापीठ निकालाचे SGPA/CGPA ग्रेड पॉईंट्स थेट गुणपत्रक टक्केवारी (Percentage %) मध्ये रूपांतरित करा.",
    link: "/tools/sgpa-cgpa-calculator",
    icon: "📊",
    color: "from-emerald-500/10 to-teal-500/10 border-emerald-500/25 text-emerald-600 dark:text-emerald-400",
    badge: "Student Tool"
  }
];
---

<section class="py-8 my-6 not-prose border-t border-border-card/50">
  <div class="max-w-[1200px] mx-auto px-2 md:px-0">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-extrabold uppercase tracking-wider mb-2">
          <HiOutlineWrenchScrewdriver className="text-sm" /> Tools & Utilities Hub
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-text-main tracking-tight m-0">
          उपयुक्त साधने व <span class="gradient-text">कॅल्क्युलेटर टूल</span>
        </h2>
      </div>

      <a
        href="/tools"
        class="inline-flex items-center gap-1.5 px-4 py-2 bg-bg-surface hover:bg-bg-base text-text-main border border-border-card rounded-xl text-xs font-bold uppercase tracking-wider no-underline transition-all shrink-0 self-start sm:self-auto"
      >
        <span>All Tools Hub</span>
        <HiOutlineArrowRight className="text-xs" />
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-[900px] mx-auto">
      {toolsList.map((tool) => (
        <a
          href={tool.link}
          class="group bg-bg-surface border border-border-card hover:border-primary rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:-translate-y-1 shadow-2xs hover:shadow-md no-underline flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-2xl">{tool.icon}</span>
              <span class="text-[0.62rem] font-extrabold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 rounded-full">
                {tool.badge}
              </span>
            </div>

            <h3 class="text-base font-extrabold text-text-main group-hover:text-primary transition-colors m-0 mb-2 leading-snug">
              {tool.titleMr}
            </h3>

            <p class="text-xs text-text-muted leading-relaxed m-0 font-medium">
              {tool.descMr}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-border-card/40 flex items-center justify-between text-xs font-bold text-primary">
            <span>Use Tool Now</span>
            <HiOutlineArrowRight className="text-sm group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

