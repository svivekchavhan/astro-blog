---
import { HiOutlineSparkles } from "react-icons/hi2";
---

<div class="flex items-center gap-3 py-2 select-none">
  <div
    class="h-[1px] flex-1 bg-gradient-to-r from-transparent to-border-card dark:to-border-card/30"
  >
  </div>
  <div
    class="flex items-center gap-1.5 text-[0.62rem] font-extrabold text-text-muted uppercase tracking-widest bg-bg-surface px-3 py-1 rounded-full border border-border-card/80 shadow-xs"
  >
    <HiOutlineSparkles class="text-rose-500 animate-pulse text-[0.8rem]" />
    <span>Important Updates</span>
  </div>
  <div
    class="h-[1px] flex-1 bg-gradient-to-l from-transparent to-border-card dark:to-border-card/30"
  >
  </div>
</div>
