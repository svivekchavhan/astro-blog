---
import {
  HiOutlineMegaphone,
  HiOutlineChevronRight,
  HiOutlineChevronLeft,
  HiOutlineCalendarDays,
  HiOutlineArrowRight,
} from "react-icons/hi2";
import { importantUpdates } from "../constants/importantUpdates";
import { isWithin7Days, isNotExpired } from "../utils/dateUtils";
import { getAllPosts } from "../utils/postUtils";

interface Props {
  pageSize?: number;
}

const { pageSize = 5 } = Astro.props;

// Strictly filter only Answer Key, Admit Card, or Cutoff posts that are explicitly marked with show: true
const activeUpdates = importantUpdates.filter((update) => {
  if (update.show !== true) return false;
  if (!isNotExpired(update.expiry)) return false;

  const badgeType = (update.badgeType || "").toLowerCase();
  const category = (update.category || "").toLowerCase();
  const badge = (update.badge || "").toLowerCase();
  const title = (update.title || "").toLowerCase();

  const isAnswerKey =
    badgeType === "answer-key" ||
    category === "answer-key" ||
    badge.includes("answer key") ||
    badge.includes("उत्तरतालिका") ||
    title.includes("answer key") ||
    title.includes("उत्तरतालिका");

  const isAdmitCard =
    badgeType === "admit" ||
    badgeType === "admit-card" ||
    category === "admit" ||
    category === "admit-card" ||
    badge.includes("admit") ||
    badge.includes("hall ticket") ||
    badge.includes("प्रवेशपत्र") ||
    badge.includes("हॉल तिकीट") ||
    title.includes("admit card") ||
    title.includes("hall ticket") ||
    title.includes("प्रवेशपत्र") ||
    title.includes("हॉल तिकीट");

  const isCutoffOrResult =
    badgeType === "cutoff" ||
    badgeType === "cut-off" ||
    badgeType === "result" ||
    category === "cutoff" ||
    category === "cut-off" ||
    category === "result" ||
    badge.includes("cutoff") ||
    badge.includes("cut-off") ||
    badge.includes("कट-ऑफ") ||
    badge.includes("निकाल") ||
    badge.includes("result") ||
    title.includes("cutoff") ||
    title.includes("cut-off") ||
    title.includes("कट-ऑफ") ||
    title.includes("निकाल") ||
    title.includes("result");

  return isAnswerKey || isAdmitCard || isCutoffOrResult;
});

const totalItems = activeUpdates.length;
const totalPages = Math.ceil(totalItems / pageSize);

const latestPosts = getAllPosts().slice(0, 3);
---

{activeUpdates.length > 0 && (
<div class="flex flex-col important-updates-widget">
  <!-- Heading Container for Important Updates -->
  <div
    class="bg-rose-500 text-white px-5 py-3 rounded-t-2xl font-bold flex items-center justify-between gap-2 border border-rose-500 border-b-0 shadow-xs mt-0"
  >
    <div class="flex items-center gap-2">
      <HiOutlineMegaphone className="text-white text-[1.1rem] shrink-0" />
      <span class="text-xs font-extrabold uppercase tracking-wider"
        >Important Updates</span
      >
    </div>
    <span class="text-[0.65rem] bg-white/20 text-white font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider shrink-0">
      Urgent
    </span>
  </div>

  <!-- Content Container for Important Updates -->
  <div
    class="bg-bg-surface border border-rose-500/20 hover:border-rose-500 border-t-0 p-5 rounded-b-2xl transition-all duration-300 shadow-sm mt-0 relative overflow-hidden"
  >
    <div class="flex flex-col">
      {
        activeUpdates.length === 0 ? (
          <p class="text-xs text-text-muted text-center py-2 m-0">
            No active updates.
          </p>
        ) : (
          activeUpdates.map((update, index) => {
            const pageIndex = Math.floor(index / pageSize);
            return (
              <div
                class={`update-item py-3 border-b border-border-card dark:border-border-card/30 last:border-b-0 last:pb-0 ${pageIndex !== 0 ? "hidden" : ""}`}
                data-page={pageIndex}
              >
                <a
                  href={update.link}
                  class="flex flex-col gap-1 text-text-muted hover:text-rose-500 transition-colors duration-300 no-underline group/link"
                >
                  <!-- Title Row (Full Width) -->
                  <div class="flex items-start">
                    <span class="flex items-start gap-1.5 text-xs font-bold text-text-main group-hover/link:text-rose-500 transition-colors min-w-0 flex-1 leading-snug">
                      <HiOutlineChevronRight className="text-rose-500 text-[0.8rem] shrink-0 mt-0.5 transform group-hover/link:translate-x-0.5 transition-transform" />
                      <span class="line-clamp-2">{update.title}</span>
                    </span>
                  </div>

                  <!-- Horizontal Badge & Date Row Below Title -->
                  <div class="flex items-center justify-between text-[0.65rem] pl-5 pt-1">
                    {update.badge ? (
                      <span
                        class={`shrink-0 text-[0.55rem] px-1.5 py-0.5 rounded font-extrabold uppercase tracking-widest ${
                          update.badgeType === "cutoff" || update.badgeType === "cut-off" || update.badgeType === "result"
                            ? "bg-rose-600 text-white"
                            : update.badgeType === "admit" || update.badgeType === "admit-card"
                              ? "bg-indigo-600 text-white"
                              : update.badgeType === "answer-key"
                                ? "bg-amber-600 text-white"
                                : "bg-purple-600 text-white"
                        }`}
                      >
                        {update.badge}
                      </span>
                    ) : isWithin7Days(update.date) ? (
                      <span
                        class="shrink-0 text-[0.55rem] bg-rose-500 text-white px-1.5 py-0.5 rounded font-bold uppercase tracking-wider animate-pulse"
                      >
                        NEW
                      </span>
                    ) : (
                      <span />
                    )}

                    <span class="text-rose-600 dark:text-rose-400 font-extrabold flex items-center gap-1 shrink-0">
                      <HiOutlineCalendarDays className="text-xs text-rose-500 shrink-0" />
                      {update.date}
                    </span>
                  </div>
                </a>
              </div>
            );
          })
        )
      }
    </div>

    <!-- Pagination Controls (Shown if totalItems > pageSize) -->
    {
      totalPages > 1 && (
        <div class="pt-3 border-t border-border-card/30 dark:border-border-card/10 mt-3 flex items-center justify-between gap-2 text-xs select-none">
          <button
            type="button"
            class="prev-btn px-2.5 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/20 rounded-lg font-bold disabled:opacity-40 disabled:cursor-not-allowed transition-all flex items-center gap-1 cursor-pointer"
            disabled
          >
            <HiOutlineChevronLeft className="text-xs" />
            <span>Prev</span>
          </button>

          <span class="page-indicator text-[0.7rem] font-bold text-text-muted">
            Page{" "}
            <strong class="current-page text-rose-500 font-extrabold">1</strong>{" "}
            of <strong>{totalPages}</strong>
          </span>

          <button
            type="button"
            class="next-btn px-2.5 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/20 rounded-lg font-bold disabled:opacity-40 disabled:cursor-not-allowed transition-all flex items-center gap-1 cursor-pointer"
          >
            <span>Next</span>
            <HiOutlineChevronRight className="text-xs" />
          </button>
        </div>
      )
    }
  </div>
</div>
)}

<!-- Latest 3 Posts -->
{latestPosts.length > 0 && (
  <div class="mt-3 bg-bg-surface border border-border-card rounded-2xl overflow-hidden shadow-sm">
    <div class="px-4 py-2.5 border-b border-border-card bg-primary/5 flex items-center gap-2">
      <HiOutlineArrowRight className="text-primary text-sm shrink-0" />
      <span class="text-[0.7rem] font-extrabold uppercase tracking-wider text-primary">Latest Posts</span>
    </div>
    <div class="flex flex-col divide-y divide-border-card/40">
      {latestPosts.map((post) => (
        <a
          href={post.slug}
          class="group flex items-start gap-2 px-4 py-2.5 hover:bg-primary/5 no-underline transition-colors"
        >
          <HiOutlineChevronRight className="text-primary text-[0.75rem] shrink-0 mt-0.5 group-hover:translate-x-0.5 transition-transform" />
          <span class="text-xs font-semibold text-text-main group-hover:text-primary transition-colors line-clamp-2 leading-snug">
            {post.titleMr || post.titleEn}
          </span>
        </a>
      ))}
    </div>
  </div>
)}


<script>
  function initWidgetPagination() {
    const widgets = document.querySelectorAll(".important-updates-widget");
    widgets.forEach((widget) => {
      const items = widget.querySelectorAll<HTMLElement>(".update-item");
      const prevBtn = widget.querySelector<HTMLButtonElement>(".prev-btn");
      const nextBtn = widget.querySelector<HTMLButtonElement>(".next-btn");
      const currentPageEl = widget.querySelector<HTMLElement>(".current-page");

      if (!items.length || !prevBtn || !nextBtn) return;

      let currentPage = 0;
      const totalPages = Math.ceil(items.length / 5);

      function updatePage(page: number) {
        currentPage = page;
        items.forEach((item) => {
          const itemPage = parseInt(item.dataset.page || "0", 10);
          if (itemPage === currentPage) {
            item.classList.remove("hidden");
          } else {
            item.classList.add("hidden");
          }
        });

        if (currentPageEl) {
          currentPageEl.textContent = (currentPage + 1).toString();
        }

        prevBtn.disabled = currentPage === 0;
        nextBtn.disabled = currentPage >= totalPages - 1;
      }

      prevBtn.addEventListener("click", () => {
        if (currentPage > 0) updatePage(currentPage - 1);
      });

      nextBtn.addEventListener("click", () => {
        if (currentPage < totalPages - 1) updatePage(currentPage + 1);
      });
    });
  }

  // Initialize immediately and on Astro client-side navigation
  initWidgetPagination();
  document.addEventListener("astro:page-load", initWidgetPagination);
</script>
