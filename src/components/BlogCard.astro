---
interface Props {
	title: string;
	href: string;
  date?: string;
  image?: string;
}

const { title, href, date = "2026", image = "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80" } = Astro.props;
---

<div class="group bg-bg-surface border border-border-card rounded-3xl transition-all duration-300 hover:border-primary hover:shadow-2xl hover:shadow-primary/10 cursor-pointer flex flex-col h-full overflow-hidden" onclick={`window.location.href='${href}'`}>
  <div class="relative aspect-video overflow-hidden">
    <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
      <span class="text-white font-bold text-sm">Read Article →</span>
    </div>
  </div>
	<div class="p-6 flex-1 flex flex-col">
    <div class="mb-3">
      <span class="text-text-muted text-[0.8rem] font-medium tracking-wide">{date}</span>
    </div>
		<a href={href} class="no-underline text-inherit block flex-1">
			<h3 class="text-base md:text-lg font-bold text-text-main leading-relaxed m-0 transition-colors duration-200 group-hover:text-primary">{title}</h3>
		</a>
	</div>
</div>
