---
interface Props {
	title: string;
	href: string;
  category?: string;
  date?: string;
}

const { title, href, date = "2026" } = Astro.props;
---

<div class="group bg-bg-surface border border-border-card rounded-3xl p-8 transition-all duration-300 hover:border-primary hover:shadow-2xl hover:shadow-primary/10 cursor-pointer flex flex-col h-full" onclick={`window.location.href='${href}'`}>
	<div class="flex-1">
    <div class="mb-4">
      <span class="text-text-muted text-[0.8rem] font-medium tracking-wide">{date}</span>
    </div>
		<a href={href} class="no-underline text-inherit block">
			<h3 class="text-base md:text-lg font-bold text-text-main leading-relaxed m-0 transition-colors duration-200 group-hover:text-primary">{title}</h3>
		</a>
	</div>
	<div class="mt-8 flex items-center gap-2 font-bold text-[0.85rem] text-primary no-underline whitespace-nowrap opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
		<span>Read Story</span>
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
	</div>
</div>
