---
import {
  FaWhatsapp,
  FaTelegram,
  FaXTwitter,
  FaFacebookF,
  FaLink,
  FaShareNodes,
} from "react-icons/fa6";

interface Props {
  title: string;
  url?: string;
}

const { title, url } = Astro.props;
const currentUrl = url || Astro.url.href;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(currentUrl);

const shareLinks = [
  {
    name: "WhatsApp",
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    bg: "bg-[#25D366] hover:bg-[#20ba5a] text-white shadow-xs shadow-[#25D366]/30",
    icon: FaWhatsapp,
  },
  {
    name: "Telegram",
    href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
    bg: "bg-[#0088cc] hover:bg-[#0077b3] text-white shadow-xs shadow-[#0088cc]/30",
    icon: FaTelegram,
  },
  {
    name: "X (Twitter)",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    bg: "bg-[#14171A] dark:bg-white dark:text-black hover:bg-black text-white shadow-xs",
    icon: FaXTwitter,
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    bg: "bg-[#1877F2] hover:bg-[#166fe5] text-white shadow-xs shadow-[#1877F2]/30",
    icon: FaFacebookF,
  },
];
---

<div class="flex items-center justify-between sm:justify-start gap-2 shrink-0 w-full sm:w-auto">
  <span
    class="text-xs font-black text-text-muted uppercase tracking-wider hidden md:inline-block mr-0.5 shrink-0"
  >
    शेअर:
  </span>
  <div class="flex items-center justify-between sm:justify-start gap-1.5 sm:gap-2.5 w-full sm:w-auto">
    {
      shareLinks.map((item) => {
        const Icon = item.icon;
        return (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`flex items-center justify-center w-9.5 h-9.5 sm:w-9 sm:h-9 rounded-xl transition-transform duration-200 ease-out will-change-transform hover:-translate-y-0.5 hover:scale-105 active:scale-95 shrink-0 shadow-2xs ${item.bg}`}
            title={`${item.name} वर शेअर करा`}
            aria-label={`Share on ${item.name}`}
          >
            <Icon className="text-base sm:text-base shrink-0" />
          </a>
        );
      })
    }

    <!-- Copy Direct Link Button (Icon Only - Rounded Square) -->
    <button
      data-url={currentUrl}
      class="copy-link-btn flex items-center justify-center w-9.5 h-9.5 sm:w-9 sm:h-9 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 text-purple-600 dark:text-purple-400 border border-purple-500/30 transition-transform duration-200 ease-out will-change-transform hover:-translate-y-0.5 hover:scale-105 active:scale-95 cursor-pointer shrink-0 shadow-2xs"
      title="Copy Direct Link"
      aria-label="Copy Direct Link"
    >
      <FaLink className="text-base sm:text-base shrink-0" />
    </button>

    <!-- Native Share Button (Icon + Name - Rounded Square) -->
    <button
      data-title={title}
      data-url={currentUrl}
      class="native-share-btn inline-flex items-center justify-center gap-1.5 px-3 sm:px-3.5 h-9.5 sm:h-9 rounded-xl bg-primary hover:bg-primary/90 text-white font-extrabold text-xs sm:text-xs transition-transform duration-200 ease-out will-change-transform hover:-translate-y-0.5 hover:scale-105 active:scale-95 cursor-pointer shrink-0 shadow-2xs"
      title="More Share Options"
      aria-label="Share page"
    >
      <FaShareNodes className="text-xs sm:text-sm shrink-0" />
      <span class="tracking-wide">Share</span>
    </button>
  </div>
</div>

<script>
  // Robust clipboard copy function with execCommand fallback for all browsers/environments
  async function copyTextToClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch (err) {
        // Fallback to execCommand if writeText fails
      }
    }
    try {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.left = "-999999px";
      textarea.style.top = "-999999px";
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const successful = document.execCommand("copy");
      document.body.removeChild(textarea);
      return successful;
    } catch (err) {
      return false;
    }
  }

  function setupShareButtons() {
    // Copy Link Button handler for all copy-link-btn elements
    const copyBtns = document.querySelectorAll(".copy-link-btn");

    copyBtns.forEach((btn) => {
      const copyBtn = btn as HTMLElement;
      if (copyBtn.hasAttribute("data-initialized")) return;
      copyBtn.setAttribute("data-initialized", "true");

      copyBtn.addEventListener("click", async (e) => {
        e.preventDefault();
        const url = copyBtn.getAttribute("data-url") || window.location.href;
        const success = await copyTextToClipboard(url);

        if (success) {
          // Dynamically change color to bright success emerald green
          copyBtn.classList.add(
            "!bg-emerald-500",
            "!text-white",
            "!border-emerald-500",
            "!scale-110",
            "!shadow-md",
            "!shadow-emerald-500/30",
          );
          setTimeout(() => {
            copyBtn.classList.remove(
              "!bg-emerald-500",
              "!text-white",
              "!border-emerald-500",
              "!scale-110",
              "!shadow-md",
              "!shadow-emerald-500/30",
            );
          }, 2000);
        }
      });
    });

    // Native Share Button handler for all native-share-btn elements
    const shareBtns = document.querySelectorAll(".native-share-btn");
    shareBtns.forEach((btn) => {
      const shareBtn = btn as HTMLElement;
      if (shareBtn.hasAttribute("data-initialized")) return;
      shareBtn.setAttribute("data-initialized", "true");

      shareBtn.addEventListener("click", async (e) => {
        e.preventDefault();
        const title = shareBtn.getAttribute("data-title") || document.title;
        const url = shareBtn.getAttribute("data-url") || window.location.href;

        if (navigator.share) {
          try {
            await navigator.share({ title, url });
          } catch (err) {
            // User cancelled share dialog
          }
        } else {
          const success = await copyTextToClipboard(url);
          if (success) {
            shareBtn.classList.add("!bg-emerald-500", "!text-white");
            setTimeout(() => {
              shareBtn.classList.remove("!bg-emerald-500", "!text-white");
            }, 2000);
          }
        }
      });
    });
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupShareButtons);
  } else {
    setupShareButtons();
  }
  document.addEventListener("astro:page-load", setupShareButtons);
</script>
