---
import { FaWhatsapp, FaTelegram, FaXTwitter, FaFacebookF, FaShareNodes } from "react-icons/fa6";

interface Props {
  title: string;
  url?: string;
}

const { title, url } = Astro.props;
const currentUrl = url || Astro.url.href;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(currentUrl);

const shareLinks = [
  {
    name: "WhatsApp",
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    bg: "bg-[#25D366] hover:bg-[#20ba5a] text-white shadow-sm shadow-[#25D366]/30",
    icon: FaWhatsapp,
  },
  {
    name: "Telegram",
    href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
    bg: "bg-[#0088cc] hover:bg-[#0077b3] text-white shadow-sm shadow-[#0088cc]/30",
    icon: FaTelegram,
  },
  {
    name: "X (Twitter)",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    bg: "bg-[#14171A] dark:bg-white dark:text-black hover:bg-black text-white shadow-sm",
    icon: FaXTwitter,
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    bg: "bg-[#1877F2] hover:bg-[#166fe5] text-white shadow-sm shadow-[#1877F2]/30",
    icon: FaFacebookF,
  },
];
---

<div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
  <span class="text-xs font-extrabold text-text-muted uppercase tracking-wider hidden md:inline-block mr-0.5">
    शेअर:
  </span>
  <div class="flex items-center gap-2 sm:gap-2">
    {
      shareLinks.map((item) => {
        const Icon = item.icon;
        return (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`flex items-center justify-center w-9.5 h-9.5 sm:w-8 sm:h-8 rounded-full transition-all duration-300 transform hover:scale-110 active:scale-95 shrink-0 ${item.bg}`}
            title={`${item.name} वर शेअर करा`}
            aria-label={`Share on ${item.name}`}
          >
            <Icon className="text-base sm:text-sm" />
          </a>
        );
      })
    }
    <button
      id="native-share-btn"
      data-title={title}
      data-url={currentUrl}
      class="flex items-center justify-center w-9.5 h-9.5 sm:w-8 sm:h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary transition-all duration-300 transform hover:scale-110 active:scale-95 border border-primary/20 cursor-pointer shrink-0 shadow-xs"
      title="More Share Options"
      aria-label="More share options"
    >
      <FaShareNodes className="text-base sm:text-sm" />
    </button>
  </div>
</div>

<script>
  function setupShare() {
    const btn = document.getElementById('native-share-btn');
    if (btn && !btn.hasAttribute('data-initialized')) {
      btn.setAttribute('data-initialized', 'true');
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-title') || document.title;
        const url = btn.getAttribute('data-url') || window.location.href;

        if (navigator.share) {
          try {
            await navigator.share({ title, url });
          } catch (err) {
            // User cancelled share dialog
          }
        } else {
          try {
            await navigator.clipboard.writeText(url);
            alert('लिंक यशस्वीरित्या कॉपी झाली आहे! (Link copied to clipboard)');
          } catch (e) {
            // Copy fallback failed
          }
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupShare);
</script>
