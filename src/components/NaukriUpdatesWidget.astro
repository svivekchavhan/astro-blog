---
import { HiOutlineBell, HiOutlineChevronRight } from "react-icons/hi2";
import { naukriUpdates, type NaukriUpdate } from "../constants/naukriUpdates";
import { isWithin7Days } from "../utils/dateUtils";

interface Props {
  limit?: number;
  showViewAll?: boolean;
}

const { limit = 3, showViewAll = true } = Astro.props;

// Filter out items where show === false
const activeUpdates = naukriUpdates.filter(update => update.show !== false);
const visibleUpdates = limit ? activeUpdates.slice(0, limit) : activeUpdates;

function truncateWords(str: string, wordLimit: number = 10): string {
  if (!str) return "";
  const words = str.trim().split(/\s+/);
  if (words.length <= wordLimit) return str;
  return words.slice(0, wordLimit).join(" ") + "...";
}
---

<div class="flex flex-col">
  <!-- Heading Container for Latest Naukri Updates -->
  <div class="bg-primary text-white px-5 py-3 rounded-t-2xl font-bold flex items-center gap-2 border border-primary border-b-0 shadow-xs mt-0">
    <HiOutlineBell className="text-white text-[1.1rem] shrink-0" />
    <span class="text-xs font-extrabold uppercase tracking-wider">Latest Naukri Updates (नवीन नोकरी अपडेट्स)</span>
  </div>
  
  <!-- Content Container for Latest Naukri Updates -->
  <div class="bg-bg-surface border border-border-card border-t-0 p-5 rounded-b-2xl transition-all duration-300 shadow-sm mt-0 relative overflow-hidden">
    <div class="absolute -right-24 -top-24 w-48 h-48 bg-primary/5 rounded-full blur-3xl -z-10"></div>
    <div class="flex flex-col">
      {visibleUpdates.length === 0 ? (
        <p class="text-xs text-text-muted text-center py-2 m-0">No naukri updates available.</p>
      ) : (
        visibleUpdates.map((update) => (
          <div class="py-3 border-b border-border-card dark:border-border-card/30 last:border-b-0 last:pb-0">
            <a
              href={update.link}
              class="flex flex-col gap-1 text-text-muted hover:text-primary transition-colors duration-300 no-underline group/link"
            >
              <div class="flex items-start justify-between gap-2.5">
                <span class="flex items-start gap-1.5 text-[0.75rem] font-bold text-text-main group-hover/link:text-primary transition-colors min-w-0 flex-1">
                  <HiOutlineChevronRight className="text-primary text-[0.85rem] shrink-0 mt-1 transform group-hover/link:translate-x-0.5 transition-transform" />
                  <span class="leading-relaxed pt-0.5 line-clamp-2">{truncateWords(update.titleHi, 10)}</span>
                </span>
                {update.badge && isWithin7Days(update.date) && (
                  <span class={`shrink-0 text-[0.5rem] px-1.5 py-0.5 rounded font-extrabold uppercase tracking-widest ${
                    update.badgeType === "new" 
                      ? "bg-emerald-500 text-white" 
                      : update.badgeType === "important" 
                      ? "bg-rose-500 text-white" 
                      : "bg-amber-500 text-white"
                  }`}>
                    {update.badge}
                  </span>
                )}
              </div>
              <span class="text-[0.65rem] text-text-muted/80 pl-5 font-semibold line-clamp-1">{truncateWords(update.titleEn, 8)}</span>
            </a>
          </div>
        ))
      )}

      {showViewAll && (
        <div class="pt-3 border-t border-border-card/30 dark:border-border-card/10 mt-3 flex justify-center">
          <a
            href="/naukri-updates"
            class="inline-flex items-center gap-1 text-[0.7rem] font-bold text-primary hover:text-secondary uppercase tracking-wider no-underline transition-colors group/all"
          >
            <span>View All Updates</span>
            <HiOutlineChevronRight className="text-xs transform group-hover/all:translate-x-0.5 transition-transform" />
          </a>
        </div>
      )}
    </div>
  </div>
</div>
