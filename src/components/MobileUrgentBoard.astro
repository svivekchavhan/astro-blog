---
import {
  HiOutlineMegaphone,
  HiOutlineChevronRight,
  HiOutlineSparkles,
  HiOutlineChevronDown,
  HiOutlineCalendarDays,
} from "react-icons/hi2";
import { importantUpdates } from "../constants/importantUpdates";
import { isWithin7Days, isNotExpired } from "../utils/dateUtils";

// Filter active and non-expired updates
const activeUpdates = importantUpdates.filter(
  (update) => update.show !== false && isNotExpired(update.expiry),
);
const initialVisibleCount = 3;
---

{activeUpdates.length > 0 && (
  <div class="block md:hidden w-full px-3 py-2.5 bg-gradient-to-r from-rose-500/10 via-amber-500/10 to-rose-500/10 border-b border-rose-500/30 mobile-urgent-board transition-all duration-300">
    <div class="max-w-[1200px] mx-auto">
      <!-- Board Header Badge -->
      <div class="flex items-center justify-between gap-2 mb-2">
        <div class="flex items-center gap-1.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-600"></span>
          </span>
          <span class="bg-rose-500 text-white text-[0.65rem] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full flex items-center gap-1 shadow-xs">
            <HiOutlineMegaphone className="text-xs animate-bounce" /> Important Update (महत्वाचे अपडेट)
          </span>
        </div>
        <span class="text-[0.65rem] font-bold text-rose-600 dark:text-rose-400 flex items-center gap-0.5">
          <HiOutlineSparkles className="text-xs animate-pulse" /> Live
        </span>
      </div>

      <!-- Urgent Item List / Cards -->
      <div class="flex flex-col gap-1.5" id="mobile-urgent-list">
        {activeUpdates.map((update, index) => {
          const isExtra = index >= initialVisibleCount;
          return (
            <a
              href={update.link}
              class={`group flex items-center justify-between gap-2 p-2 bg-bg-surface/90 hover:bg-bg-surface border border-rose-500/25 rounded-xl no-underline shadow-xs transition-all active:scale-[0.99] ${
                isExtra ? "mobile-urgent-extra-item hidden" : ""
              }`}
            >
              <div class="flex items-start gap-2 min-w-0">
                <HiOutlineChevronRight className="text-rose-500 text-sm shrink-0 mt-0.5 group-hover:translate-x-0.5 transition-transform" />
                <div class="flex flex-col gap-0.5 min-w-0">
                  <span class="text-xs font-extrabold text-text-main group-hover:text-rose-600 dark:group-hover:text-rose-400 line-clamp-2 leading-snug">
                    {update.title}
                  </span>
                  <span class="text-[0.65rem] font-bold text-text-muted flex items-center gap-1">
                    <HiOutlineCalendarDays className="text-[0.75rem] text-rose-500 shrink-0" />
                    {update.date}
                  </span>
                </div>
              </div>
              
              {update.badge ? (
                <span
                  class={`shrink-0 text-[0.55rem] px-1.5 py-0.5 rounded font-extrabold uppercase tracking-widest select-none ${
                    update.badgeType === "result"
                      ? "bg-rose-600 text-white"
                      : update.badgeType === "admit"
                        ? "bg-indigo-600 text-white"
                        : update.badgeType === "extended"
                          ? "bg-amber-500 text-white"
                          : update.badgeType === "important"
                            ? "bg-purple-600 text-white"
                            : "bg-emerald-600 text-white"
                  }`}
                >
                  {update.badge}
                </span>
              ) : isWithin7Days(update.date) ? (
                <span 
                  class="urgent-new-badge shrink-0 text-[0.5rem] bg-rose-500 text-white px-1.5 py-0.5 rounded font-black uppercase tracking-wider select-none animate-pulse self-start mt-0.5"
                  data-expiry={update.expiry}
                >
                  NEW
                </span>
              ) : null}
            </a>
          );
        })}
      </div>

      <!-- Show More / Show Less Button -->
      {activeUpdates.length > initialVisibleCount && (
        <button
          id="mobile-board-toggle-btn"
          type="button"
          class="w-full mt-2 py-1.5 px-3 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 font-extrabold text-[0.7rem] uppercase tracking-wider rounded-xl border border-rose-500/30 flex items-center justify-center gap-1.5 transition-all cursor-pointer"
        >
          <span id="mobile-board-toggle-text">
            अधिक पाहा / Show More ({activeUpdates.length - initialVisibleCount} आणखी)
          </span>
          <HiOutlineChevronDown id="mobile-board-toggle-icon" className="text-xs transition-transform duration-300 shrink-0" />
        </button>
      )}
    </div>
  </div>
)}

<script>
  function setupMobileBoardToggle() {
    const toggleBtn = document.getElementById("mobile-board-toggle-btn");
    const toggleText = document.getElementById("mobile-board-toggle-text");
    const toggleIcon = document.getElementById("mobile-board-toggle-icon");
    const extraItems = document.querySelectorAll(".mobile-urgent-extra-item");

    if (toggleBtn && extraItems.length > 0) {
      let isExpanded = false;
      const hiddenCount = extraItems.length;

      toggleBtn.addEventListener("click", () => {
        isExpanded = !isExpanded;
        extraItems.forEach((item) => {
          if (isExpanded) {
            item.classList.remove("hidden");
          } else {
            item.classList.add("hidden");
          }
        });

        if (toggleText) {
          toggleText.textContent = isExpanded
            ? "कमी दाखवा / Show Less"
            : `अधिक पाहा / Show More (${hiddenCount} आणखी)`;
        }
        if (toggleIcon) {
          toggleIcon.style.transform = isExpanded ? "rotate(180deg)" : "rotate(0deg)";
        }
      });
    }
  }

  // Run setup on initial load and view transitions
  setupMobileBoardToggle();
  document.addEventListener("astro:page-load", setupMobileBoardToggle);
</script>
