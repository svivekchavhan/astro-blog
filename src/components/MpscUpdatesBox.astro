---
import { 
  HiOutlineBell, 
  HiOutlineCalendarDays, 
  HiOutlineChevronRight,
  HiOutlineSparkles
} from "react-icons/hi2";

const updates = [
  {
    titleMr: "MPSC WRD कनिष्ठ अभियंता (यांत्रिकी) सेवाप्रवेश नियम २०२६ जाहीर",
    titleEn: "MPSC WRD Junior Engineer (Mechanical) Recruitment Rules 2026 Released",
    date: "July 05, 2026",
    badge: "Recruitment Rules",
    badgeClass: "text-rose-600 dark:text-rose-400 bg-rose-500/10 border-rose-500/20",
    hasPulse: true,
    link: "/mpsc-wrd-recruitment-rules-2026"
  },
 
];
---

<div class="bg-bg-surface border border-border-card rounded-2xl p-4 md:p-5 shadow-sm relative overflow-hidden mb-6">
  <!-- Decorative Background Glow -->
  <div class="absolute -right-24 -top-24 w-60 h-60 bg-primary/5 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -left-24 -bottom-24 w-60 h-60 bg-emerald-500/5 rounded-full blur-3xl -z-10"></div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-border-card/30 mb-4">
    <div class="flex items-center gap-2.5">
      <div class="p-2.5 bg-primary/10 text-primary rounded-xl animate-bounce">
        <HiOutlineBell className="text-xl" />
      </div>
      <div>
        <h3 class="text-base md:text-lg text-text-main font-black tracking-tight m-0 flex items-center gap-2">
          MPSC NEW UPDATES
          <span class="inline-flex items-center gap-1 text-[0.6rem] font-bold uppercase tracking-wider text-rose-500 bg-rose-500/10 px-2 py-0.5 rounded-full border border-rose-500/20">
            <HiOutlineSparkles className="animate-pulse" /> Live updates
          </span>
        </h3>
        <p class="text-[0.7rem] text-text-muted m-0 mt-0.5">
          MPSC Updates, Notifications & Announcements (English & Marathi)
        </p>
      </div>
    </div>
  </div>

  <!-- Updates list in compact flex row items -->
  <div class="flex flex-col gap-3">
    {updates.map((update) => (
      <a 
        href={update.link}
        class="group flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 bg-bg-base/30 hover:bg-primary/5 border border-border-card/20 hover:border-primary/40 rounded-xl transition-all duration-300 no-underline"
      >
        <div class="flex-1 min-w-0 space-y-2">
          <!-- Badges & Date -->
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class={`text-[0.6rem] px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border whitespace-nowrap flex items-center gap-1 ${update.badgeClass}`}>
              {update.hasPulse && (
                <span class="relative flex h-1.5 w-1.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-500 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-600"></span>
                </span>
              )}
              {update.badge}
            </span>
            <span class="flex items-center gap-1 text-[0.65rem] text-text-muted font-medium">
              <HiOutlineCalendarDays className="text-xs text-primary" />
              {update.date}
            </span>
          </div>

          <!-- Titles (Bilingual) -->
          <div class="space-y-0.5">
            <p class="text-sm font-bold text-text-main group-hover:text-primary transition-colors m-0 leading-snug">
              {update.titleMr}
            </p>
            <p class="text-[0.7rem] text-text-muted m-0 leading-relaxed italic">
              {update.titleEn}
            </p>
          </div>
        </div>

        <!-- Read Action: Positioned on the right side of the row -->
        <div class="shrink-0 self-end sm:self-center">
          <div class="inline-flex items-center gap-1 px-3 py-1.5 bg-primary/10 border border-primary/20 text-primary group-hover:bg-primary group-hover:text-white rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-300">
            <span>पहा (View)</span>
            <HiOutlineChevronRight className="text-sm shrink-0" />
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
