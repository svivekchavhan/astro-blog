---
import { 
  HiOutlineBell, 
  HiOutlineCalendarDays, 
  HiOutlineChevronRight,
  HiOutlineSparkles
} from "react-icons/hi2";

const updates = [
  {
    titleMr: "MPSC WRD कनिष्ठ अभियंता (यांत्रिकी) सेवाप्रवेश नियम २०२६ जाहीर",
    titleEn: "MPSC WRD Junior Engineer (Mechanical) Recruitment Rules 2026 Released",
    date: "July 05, 2026",
    badge: "Recruitment Rules",
    badgeClass: "text-rose-600 dark:text-rose-400 bg-rose-500/10 border-rose-500/20",
    hasPulse: true,
    link: "/mpsc-wrd-recruitment-rules-2026"
  },
 
];
---

<div class="bg-bg-surface border border-border-card rounded-3xl p-6 md:p-8 shadow-sm relative overflow-hidden mb-8">
  <!-- Decorative Background Glow -->
  <div class="absolute -right-24 -top-24 w-72 h-72 bg-primary/5 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -left-24 -bottom-24 w-72 h-72 bg-emerald-500/5 rounded-full blur-3xl -z-10"></div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border-card/30 mb-6">
    <div class="flex items-center gap-3">
      <div class="p-3 bg-primary/10 text-primary rounded-2xl animate-bounce">
        <HiOutlineBell className="text-2xl" />
      </div>
      <div>
        <h3 class="text-lg md:text-xl text-text-main font-black tracking-tight m-0 flex items-center gap-2">
          MPSC NEW UPDATES
          <span class="inline-flex items-center gap-1 text-[0.65rem] font-bold uppercase tracking-wider text-rose-500 bg-rose-500/10 px-2.5 py-0.5 rounded-full border border-rose-500/20">
            <HiOutlineSparkles className="animate-pulse" /> Live updates
          </span>
        </h3>
        <p class="text-xs text-text-muted m-0 mt-0.5">
          MPSC Updates, Notifications & Announcements (English & Marathi)
        </p>
      </div>
    </div>
  </div>

  <!-- Updates list in flex row -->
  <div class="flex flex-col lg:flex-row gap-4">
    {updates.map((update) => (
      <a 
        href={update.link}
        class="group flex flex-col justify-between gap-4 p-5 bg-bg-base/30 hover:bg-primary/5 border border-border-card/20 hover:border-primary/40 rounded-2xl transition-all duration-300 no-underline flex-1"
      >
        <div class="space-y-3">
          <!-- Badges & Date -->
          <div class="flex items-center justify-between gap-2.5 flex-wrap">
            <span class={`text-[0.65rem] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border whitespace-nowrap flex items-center gap-1 ${update.badgeClass}`}>
              {update.hasPulse && (
                <span class="relative flex h-1.5 w-1.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-500 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-600"></span>
                </span>
              )}
              {update.badge}
            </span>
            <span class="flex items-center gap-1 text-[0.7rem] text-text-muted font-medium">
              <HiOutlineCalendarDays className="text-xs text-primary" />
              {update.date}
            </span>
          </div>

          <!-- Titles (Bilingual) -->
          <div class="space-y-1">
            <!-- Marathi Title -->
            <p class="text-sm font-bold text-text-main group-hover:text-primary transition-colors m-0 leading-snug">
              {update.titleMr}
            </p>
            <!-- English Title -->
            <p class="text-xs text-text-muted m-0 leading-relaxed italic">
              {update.titleEn}
            </p>
          </div>
        </div>

        <!-- Read Action -->
        <div class="flex items-center text-xs font-bold text-primary gap-1 group-hover:gap-1.5 transition-all pt-3 border-t border-border-card/30 uppercase tracking-wider">
          <span>पहा (View)</span>
          <HiOutlineChevronRight className="text-sm" />
        </div>
      </a>
    ))}
  </div>
</div>
