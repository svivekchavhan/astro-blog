    <style is:global>
      /* Ensure breadcrumbs are strictly horizontal on all screen sizes */
      nav[aria-label="Breadcrumb"] {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        align-items: center !important;
      }
      nav[aria-label="Breadcrumb"] * {
        display: inline-flex !important;
        flex-direction: row !important;
        align-items: center !important;
        white-space: nowrap !important;
      }

      /* Minimize top and bottom padding/margin for the content following the breadcrumbs */
      nav[aria-label="Breadcrumb"] + article,
      nav[aria-label="Breadcrumb"] + section,
      nav[aria-label="Breadcrumb"] + div {
        padding-top: 0.25rem !important;
        margin-top: 0 !important;
      }
    </style>
