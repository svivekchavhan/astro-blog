---
import Navbar from "../components/Navbar.astro";
import Marquee from "../components/Marquee.astro";
import UpdatesSeparator from "../components/UpdatesSeparator.astro";
import { ClientRouter } from "astro:transitions";
import { HiOutlineBriefcase, HiOutlineBell, HiOutlineMegaphone, HiOutlineShare } from "react-icons/hi2";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  canonicalURL?: string;
  hideSidebar?: boolean;
}

const {
  title,
  description = "MahaDisha - Your trusted source for latest government jobs, sarkari naukri, exam results, admit cards, answer keys, and college admissions in India.",
  image = "/blog-placeholder.jpg",
  article = false,
  canonicalURL: customCanonicalURL,
  hideSidebar = false,
} = Astro.props;

const canonicalURL = customCanonicalURL
  ? new URL(customCanonicalURL, Astro.site || "https://mahadisha.in")
  : new URL(Astro.url.pathname, Astro.site || "https://mahadisha.in");

const latestJobs = [
  {
    title: "UPSC Civil Services Examination 2026",
    link: "/latest-job",
  },
  {
    title: "SSC CGL Recruitment 2026",
    link: "/latest-job",
  },
  {
    title: "SBI Probationary Officers (PO) 2026",
    link: "/latest-job",
  },
  {
    title: "RRB Assistant Loco Pilot (ALP) Vacancies",
    link: "/latest-job",
  },
  {
    title: "MPSC State Services Examination 2026",
    link: "/latest-job",
  },
];

const urgentUpdates = [
  {
    title: "BSNL JTO Recruitment 2026: Online Form Started",
    link: "/bsnl-bharti-2026",
    expiry: "2026-06-18T18:00:00Z",
  },
  {
    title: "MPSC State Services 2026 Hall Ticket Download Link",
    link: "/admit-card",
    expiry: "2026-06-15T18:00:00Z",
  },
  {
    title: "Agniveer Admit Card 2026 Download Active",
    link: "/agniveer-admit-card-2026",
    expiry: "2026-06-08T00:00:00Z",
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;800&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Force clean light mode theme default
      document.documentElement.removeAttribute("data-theme");
      localStorage.removeItem("theme");

      // Expiration check for urgent updates new badges
      function checkUrgentBadges() {
        const badges = document.querySelectorAll(".urgent-new-badge");
        badges.forEach(badge => {
          const expiryStr = badge.getAttribute("data-expiry");
          if (expiryStr) {
            const expiryTime = new Date(expiryStr).getTime();
            if (Date.now() > expiryTime) {
              badge.style.display = "none";
            }
          }
        });
      }

      // Toggle QR code reveal (blur/unblur)
      function setupQrReveal() {
        const containers = document.querySelectorAll(".qr-reveal-container");
        containers.forEach(container => {
          if (container.getAttribute("data-listener-added") === "true") return;
          container.setAttribute("data-listener-added", "true");

          container.addEventListener("click", () => {
            const isRevealed = container.getAttribute("data-revealed") === "true";
            const img = container.querySelector(".qr-image");
            const overlay = container.querySelector(".qr-overlay");

            if (isRevealed) {
              // Re-blur
              if (img) img.classList.add("blur-md");
              if (overlay) overlay.classList.remove("opacity-0", "pointer-events-none");
              container.setAttribute("data-revealed", "false");
            } else {
              // Reveal
              if (img) img.classList.remove("blur-md");
              if (overlay) overlay.classList.add("opacity-0", "pointer-events-none");
              container.setAttribute("data-revealed", "true");
            }
          });
        });
      }

      // Run on initial load
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          checkUrgentBadges();
          setupQrReveal();
        });
      } else {
        checkUrgentBadges();
        setupQrReveal();
      }

      // Run on View Transition navigation
      document.addEventListener("astro:page-load", () => {
        checkUrgentBadges();
        setupQrReveal();
      });
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "MahaDisha",
        "description": "A premium portal for latest jobs and exam details.",
        "url": "https://mahadisha.in"
      }
    </script>
    <ClientRouter />
  </head>
  <body>
    <Navbar />

    <div
      class="max-w-[1200px] mx-auto px-4 sm:px-10 lg:px-14 w-full flex-1 flex flex-col lg:flex-row gap-8 md:gap-12 py-6 sm:py-12"
    >
      <main
        class:list={[
          "min-w-0 prose dark:prose-invert prose-headings:text-text-main max-w-none",
          hideSidebar ? "w-full flex-1" : "flex-[3]",
        ]}
      >
        <slot />
        <div class={article ? "space-y-8 mt-10 block" : "hidden"}>
          <!-- Important Updates Section -->
          <div class="space-y-4 not-prose">
            <UpdatesSeparator />
            <div class="bg-bg-surface border border-border-card p-6 rounded-3xl flex flex-col gap-4 shadow-xs">
              {urgentUpdates.map((update) => (
                <div class="flex items-center justify-between gap-4 py-1.5 last:border-b-0 border-b border-border-card/20 last:pb-0 first:pt-0">
                  <a
                    href={update.link}
                    class="flex items-center gap-2.5 text-text-muted hover:text-rose-500 transition-colors font-semibold text-sm md:text-[0.95rem] no-underline group/link"
                  >
                    <svg 
                      class="w-4.5 h-4.5 text-rose-500 transform group-hover/link:translate-x-1 transition-transform shrink-0" 
                      fill="none" 
                      stroke="currentColor" 
                      stroke-width="2.5" 
                      viewBox="0 0 24 24" 
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                    <span>{update.title}</span>
                  </a>
                  <span 
                    class="urgent-new-badge shrink-0 text-[0.55rem] bg-rose-500 text-white px-2 py-0.5 rounded font-bold uppercase tracking-wider select-none animate-pulse"
                    data-expiry={update.expiry}
                  >
                    NEW
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Share Card Section -->
          <div class="mt-6 pt-6 border-t border-border-card dark:border-border-card/30 not-prose animate-[fadeInUp_0.5s_ease_forwards]">
            <div class="bg-bg-surface border border-border-card p-6 md:p-8 rounded-3xl relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-6">
              <!-- Ambient Glow background effect -->
              <div class="absolute -right-24 -top-24 w-48 h-48 bg-primary/5 rounded-full blur-3xl -z-10"></div>
              
              <div class="space-y-4 max-w-lg text-center md:text-left">
                <h3 class="text-lg md:text-xl font-extrabold text-text-main m-0 flex items-center justify-center md:justify-start gap-2">
                  <span class="text-primary flex items-center shrink-0">
                    <HiOutlineShare className="text-[1.25rem]" />
                  </span>
                  <span>Share This Article / शेअर करा</span>
                </h3>
                <p class="text-xs md:text-sm text-text-secondary leading-relaxed m-0">
                  If you found this information helpful, please share it with your friends and groups on WhatsApp and Telegram.
                </p>
                
                <div class="flex flex-wrap justify-center md:justify-start gap-3 !mt-5">
                  <!-- WhatsApp Share -->
                  <a 
                    href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + " - " + Astro.url.href)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-sm no-underline"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.455 5.703 1.458h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                    <span>WhatsApp</span>
                  </a>
                  
                  <!-- Telegram Share -->
                  <a 
                    href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(title)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-sky-500 hover:bg-sky-600 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-sm no-underline"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-1-.65-.35-1 .22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.94-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.37.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .24z"/>
                  </svg>
                  <span>Telegram</span>
                </a>
              </div>
              
              <!-- Page URL QR Code -->
              <div class="flex flex-col items-center text-center gap-1.5 shrink-0 self-center">
                <div class="w-32 h-32 bg-white p-2.5 rounded-xl border border-border-card shadow-xs flex items-center justify-center">
                  <img 
                    src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(Astro.url.href)}`} 
                    alt="Article QR Code" 
                    class="w-full h-full"
                    loading="lazy"
                  />
                </div>
                <span class="text-[0.6rem] font-bold text-text-secondary uppercase tracking-wider">Scan to Share</span>
              </div>

            </div>
          </div>
        </div>
      </main>

      {
        !hideSidebar && (
          <aside class="flex-1 space-y-10 lg:sticky lg:top-[calc(var(--navbar-height,190px)+20px)] h-fit">
            <!-- Urgent Updates Widget -->
            <div class="bg-bg-surface border border-rose-500/20 hover:border-rose-500 p-6 rounded-xl relative overflow-hidden transition-all duration-300 shadow-sm">

              <h4 class="text-[1.1rem] text-text-main border-b-2 border-rose-500 inline-flex items-center gap-2 pb-1.5 mb-4 font-semibold">
                <span class="text-rose-500 flex items-center shrink-0">
                  <HiOutlineMegaphone className="text-rose-500 text-[1.15rem]" />
                </span>
                <span>Important Updates</span>
              </h4>
              
              <div class="flex flex-col">
                {urgentUpdates.map((update) => (
                  <div class="group/item flex items-start justify-between gap-3 py-3 border-b border-border-card dark:border-border-card/30 last:border-b-0 last:pb-0 first:pt-0">
                    <a
                      href={update.link}
                      class="text-text-muted text-[0.88rem] hover:text-rose-500 transition-colors duration-300 font-semibold leading-snug no-underline"
                    >
                      {update.title}
                    </a>
                    
                    <span 
                      class="urgent-new-badge shrink-0 text-[0.55rem] bg-rose-500 text-white px-2 py-0.5 rounded font-bold uppercase tracking-wider select-none animate-pulse"
                      data-expiry={update.expiry}
                    >
                      NEW
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Latest Jobs Widget -->
            <div class="bg-bg-surface border border-border-card p-6 rounded-xl">
              <h4 class="text-[1.1rem] text-text-main border-b-2 border-primary inline-flex items-center gap-2 pb-1.5 mb-4 font-semibold">
                <span class="text-primary flex items-center shrink-0">
                  <HiOutlineBriefcase className="text-primary text-[1.15rem]" />
                </span>
                <span>Latest Jobs</span>
              </h4>
              <div class="flex flex-col">
                {latestJobs.map((job, idx) => (
                  <div class="flex gap-2.5 py-3 border-b border-border-card dark:border-border-card/30 last:border-b-0 last:pb-0 first:pt-0">
                    <span class="text-primary font-bold text-xs select-none mt-0.5 shrink-0">
                      0{idx + 1}.
                    </span>
                    <a
                      href={job.link}
                      class="text-text-muted text-[0.9rem] hover:text-primary transition-colors duration-300 block font-medium leading-snug"
                    >
                      {job.title}
                    </a>
                  </div>
                ))}
              </div>
            </div>

            <!-- Latest Updates Widget -->
            <div class="bg-bg-surface border border-border-card p-6 rounded-xl relative overflow-hidden">
              <!-- Accent Glow background effect -->
              <div class="absolute -right-24 -top-24 w-48 h-48 bg-primary/5 rounded-full blur-3xl -z-10"></div>
              
              <h4 class="text-[1.1rem] text-text-main border-b-2 border-primary inline-flex items-center gap-2 pb-1.5 mb-4 font-semibold">
                <span class="text-primary flex items-center shrink-0">
                  <HiOutlineBell className="text-primary text-[1.15rem]" />
                </span>
                <span>Latest Updates</span>
              </h4>
              <p class="text-xs text-text-secondary leading-relaxed mb-4">
                Join our channels to get immediate updates on new jobs, admit cards, results, and notifications directly on your mobile.
              </p>
              
              <div class="flex flex-col gap-6">
                <!-- WhatsApp Section -->
                <div class="space-y-3">
                  <a 
                    href="https://google.com" 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between p-3.5 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 hover:border-emerald-500/40 rounded-xl text-emerald-600 dark:text-emerald-400 transition-all duration-300 group/link no-underline font-bold text-xs uppercase tracking-wider"
                  >
                    <div class="flex items-center gap-2.5">
                      <svg class="w-4.5 h-4.5 shrink-0 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.455 5.703 1.458h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                      </svg>
                      <span>WhatsApp Group</span>
                    </div>
                    <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                    </svg>
                  </a>
                  
                  <div class="flex justify-center">
                    <div 
                      class="flex flex-col items-center text-center group/qr cursor-pointer qr-reveal-container select-none"
                      data-revealed="false"
                    >
                      <div class="w-32 h-32 bg-white p-2.5 rounded-xl border border-border-card group-hover/qr:border-emerald-500/50 flex items-center justify-center shadow-xs transition-colors duration-300 relative overflow-hidden">
                        <img 
                          src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://google.com" 
                          alt="WhatsApp Group QR Code" 
                          class="w-full h-full qr-image blur-md transition-all duration-300"
                          loading="lazy"
                        />
                        <div class="absolute inset-0 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-[2px] flex items-center justify-center qr-overlay transition-all duration-300">
                          <span class="bg-emerald-500 text-white text-[0.65rem] px-2.5 py-1.5 rounded-lg font-bold shadow-xs uppercase tracking-wider pointer-events-none">
                            Show Code
                          </span>
                        </div>
                      </div>
                      <span class="text-[0.6rem] font-bold text-text-secondary uppercase tracking-wider mt-1.5 group-hover/qr:text-emerald-500 transition-colors">Scan WhatsApp QR</span>
                    </div>
                  </div>
                </div>

                <div class="h-[1px] w-full bg-border-card/30 dark:bg-border-card/10"></div>

                <!-- Telegram Section -->
                <div class="space-y-3">
                  <a 
                    href="https://google.com" 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between p-3.5 bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/20 hover:border-sky-500/40 rounded-xl text-sky-600 dark:text-sky-400 transition-all duration-300 group/link no-underline font-bold text-xs uppercase tracking-wider"
                  >
                    <div class="flex items-center gap-2.5">
                      <svg class="w-4.5 h-4.5 shrink-0 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-1-.65-.35-1 .22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.94-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.37.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .24z"/>
                      </svg>
                      <span>Telegram Channel</span>
                    </div>
                    <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                    </svg>
                  </a>
                  
                  <div class="flex justify-center">
                    <div 
                      class="flex flex-col items-center text-center group/qr cursor-pointer qr-reveal-container select-none"
                      data-revealed="false"
                    >
                      <div class="w-32 h-32 bg-white p-2.5 rounded-xl border border-border-card group-hover/qr:border-sky-500/50 flex items-center justify-center shadow-xs transition-colors duration-300 relative overflow-hidden">
                        <img 
                          src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://google.com" 
                          alt="Telegram Channel QR Code" 
                          class="w-full h-full qr-image blur-md transition-all duration-300"
                          loading="lazy"
