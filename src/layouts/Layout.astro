          <span class="text-border-card dark:text-border-card/50">|</span>
          <a href="/disclaimer" class="hover:text-primary transition-colors inline-flex items-center gap-1.5 no-underline">
            <HiOutlineExclamationTriangle className="text-amber-500 text-[1.1rem]" />
            <span>Disclaimer</span>
