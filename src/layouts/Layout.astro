---
import Navbar from '../components/Navbar.astro';
import Marquee from '../components/Marquee.astro';
import { ClientRouter } from 'astro:transitions';
import { HiOutlineBriefcase } from 'react-icons/hi2';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	article?: boolean;
	canonicalURL?: string;
	hideSidebar?: boolean;
}

const { 
	title, 
	description = "MahaDisha - Your trusted source for latest government jobs, sarkari naukri, exam results, admit cards, answer keys, and college admissions in India.", 
	image = "/blog-placeholder.jpg",
	article = false,
	canonicalURL: customCanonicalURL,
	hideSidebar = false
} = Astro.props;

const canonicalURL = customCanonicalURL 
	? new URL(customCanonicalURL, Astro.site || "https://mahadisha.in")
	: new URL(Astro.url.pathname, Astro.site || "https://mahadisha.in");

const latestJobs = [
  {
    title: "UPSC Civil Services Examination 2026",
    link: "/latest-job"
  },
  {
    title: "SSC CGL Recruitment 2026",
    link: "/latest-job"
  },
  {
    title: "SBI Probationary Officers (PO) 2026",
    link: "/latest-job"
  },
  {
    title: "RRB Assistant Loco Pilot (ALP) Vacancies",
    link: "/latest-job"
  },
  {
    title: "MPSC State Services Examination 2026",
    link: "/latest-job"
  }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalURL)} />

		<!-- Robots -->
		<meta name="robots" content="index, follow" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<script is:inline>
			// Force clean light mode theme default
			document.documentElement.removeAttribute('data-theme');
			localStorage.removeItem('theme');
		</script>
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Blog",
				"name": "MahaDisha",
				"description": "A premium portal for latest jobs and exam details.",
				"url": "https://mahadisha.in"
			}
		</script>
		<ClientRouter />
	</head>
	<body>
		<Navbar />

		<div class="max-w-[1200px] mx-auto px-4 sm:px-10 lg:px-14 w-full flex-1 flex flex-col lg:flex-row gap-8 md:gap-12 py-6 sm:py-12">
			<main class:list={["min-w-0 prose dark:prose-invert prose-headings:text-text-main max-w-none", hideSidebar ? "w-full flex-1" : "flex-[3]"]}>
				<slot />
			</main>
			
			{!hideSidebar && (
				<aside class="flex-1 space-y-10 lg:sticky lg:top-[calc(var(--navbar-height,190px)+20px)] h-fit">
					<div class="bg-bg-surface border border-border-card p-6 rounded-xl">
						<h4 class="text-[1.1rem] text-text-main border-b-2 border-primary inline-flex items-center gap-2 pb-1.5 mb-4 font-semibold">
							<span class="text-primary flex items-center shrink-0">
								<HiOutlineBriefcase className="text-primary text-[1.15rem]" />
							</span>
							<span>Latest Jobs</span>
						</h4>
						<div class="flex flex-col">
							{latestJobs.map((job, idx) => (
								<div class="flex gap-2.5 py-3 border-b border-border-card dark:border-border-card/30 last:border-b-0 last:pb-0 first:pt-0">
									<span class="text-primary font-bold text-xs select-none mt-0.5 shrink-0">
										0{idx + 1}.
									</span>
									<a 
										href={job.link} 
										class="text-text-muted text-[0.9rem] hover:text-primary transition-colors duration-300 block font-medium leading-snug"
									>
										{job.title}
									</a>
								</div>
							))}
						</div>
					</div>
				</aside>
			)}
		</div>

		<footer class="bg-bg-surface border-t border-border-card pt-12 pb-8 mt-16 transition-colors duration-300">
			<div class="max-w-[1200px] mx-auto px-6 w-full flex flex-col items-center gap-6 text-center">
				<div>
					<a href="/" class="text-2xl font-bold text-text-main"><span class="gradient-text">Maha</span>Disha</a>
					<p class="text-text-muted mt-2 text-[0.9rem]">Your trusted source for latest government jobs, exams, admit cards, and results.</p>
				</div>

				<div class="flex flex-wrap justify-center items-center gap-x-4 gap-y-2 text-sm text-text-muted font-medium">
					<a href="/privacy-policy" class="hover:text-primary transition-colors">Privacy Policy</a>
					<span class="text-border-card dark:text-border-card/50">|</span>
					<a href="/terms-of-service" class="hover:text-primary transition-colors">Terms of Service</a>
					<span class="text-border-card dark:text-border-card/50">|</span>
					<a href="/disclaimer" class="hover:text-primary transition-colors">Disclaimer</a>
					<span class="text-border-card dark:text-border-card/50">|</span>
					<a href="/sitemap" class="hover:text-primary transition-colors">Sitemap</a>
					<span class="text-border-card dark:text-border-card/50">|</span>
					<a href="/contact-us" class="hover:text-primary transition-colors">Contact Us</a>
				</div>

				<div class="w-full border-t border-border-card pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-text-muted">
					<p>&copy; 2026 MahaDisha. All rights reserved.</p>
					<p class="flex items-center gap-1">
						Made with <span class="text-rose-500 animate-pulse">❤️</span> in India
					</p>
				</div>
			</div>
		</footer>
	</body>
</html>
