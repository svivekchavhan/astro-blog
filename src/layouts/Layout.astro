---
import Navbar from "../components/Navbar.astro";
import Marquee from "../components/Marquee.astro";
import UpdatesSeparator from "../components/UpdatesSeparator.astro";
import { ClientRouter } from "astro:transitions";
import { 
  HiOutlineBriefcase, 
  HiOutlineBell, 
  HiOutlineMegaphone, 
  HiOutlineShare, 
  HiOutlineHome, 
  HiOutlineChevronRight,
  HiOutlineShieldCheck,
  HiOutlineDocumentText,
  HiOutlineExclamationTriangle,
  HiOutlineMap,
  HiOutlineEnvelope,
  HiOutlineMapPin
} from "react-icons/hi2";
import { OFFICIAL_LINKS } from "../constants/links";
import { naukriUpdates } from "../constants/naukriUpdates";
import { MAHARASHTRA_DISTRICTS } from "../constants/districts";
import { isWithin7Days } from "../utils/dateUtils";
import ImportantUpdatesWidget from "../components/ImportantUpdatesWidget.astro";
import NaukriUpdatesWidget from "../components/NaukriUpdatesWidget.astro";
import WhatsAppChannelWidget from "../components/WhatsAppChannelWidget.astro";
import MobileUrgentBoard from "../components/MobileUrgentBoard.astro";
import FloatingWhatsAppWidget from "../components/FloatingWhatsAppWidget.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: string;
  date?: string;
  category?: string;
  canonicalURL?: string;
  hideSidebar?: boolean;
  customBreadcrumbs?: { name: string; url?: string }[];
}

const {
  title,
  description = "MahaSandhi - Your trusted source for latest government jobs, sarkari naukri, exam results, admit cards, answer keys, and college admissions in India.",
  image = "/blog-placeholder.jpg",
  article = false,
  pubDate,
  date: articleDate,
  category,
  canonicalURL: customCanonicalURL,
  hideSidebar = false,
  customBreadcrumbs,
} = Astro.props;

const dateToDisplay = pubDate || articleDate;

let rawPath = customCanonicalURL
  ? new URL(customCanonicalURL, Astro.site || "https://mahasandhi.in").pathname
  : Astro.url.pathname;

if (rawPath.length > 1 && rawPath.endsWith("/")) {
  rawPath = rawPath.slice(0, -1);
}

const canonicalURL = new URL(rawPath, Astro.site || "https://mahasandhi.in").href;

const latestJobs = [
  {
    title: "UPSC Civil Services Examination 2026",
    link: "/current-recruitment",
  },
  {
    title: "SSC CGL Recruitment 2026",
    link: "/current-recruitment",
  },
  {
    title: "SBI Probationary Officers (PO) 2026",
    link: "/current-recruitment",
  },
  {
    title: "RRB Assistant Loco Pilot (ALP) Vacancies",
    link: "/current-recruitment",
  },
  {
    title: "MPSC State Services Examination 2026",
    link: "/current-recruitment",
  },
];

const urgentUpdates = [
  {
    title: "🚨 मुंबई पोलीस शिपाई भरती २०२४-२५: ३,५२१ पदांची अंतिम निवड यादी (Final Selection List) व प्रतीक्षा यादी जाहीर",
    link: "/mumbai-police-constable-final-selection-list-2026",
    date: "August 07, 2026",
    expiry: "2026-09-15T00:00:00.000Z"
  },
  {
    title: "MPSC गट-क सेवा संयुक्त पूर्व परीक्षा २०२६: ५,७०७ जागांसाठी शुद्धिपत्रक प्रसिद्ध, अर्ज मुदतवाढ",
    link: "/mpsc-group-c-bharti-2026",
    date: "August 05, 2026",
    expiry: "2026-08-30T00:00:00.000Z"
  },
  {
    title: "MH SET 2026 Exam Date Postponed - Check Revised Schedule",
    link: "/admit-card/maharashtra-set-exam-date-postponed",
    date: "July 20, 2026",
    expiry: "2026-09-27T00:00:00.000Z"
  },
  {
    title: "MHT CET Online Engineering Admission Started 2026 - Register Now",
    link: "/admission/mht-cet-counselling-registration-documents-2026",
    date: "July 05, 2026",
    expiry: "2026-08-15T00:00:00.000Z"
  }
];

const pathSegments = Astro.url.pathname.split("/").filter(Boolean);

let breadcrumbs = [];

if (customBreadcrumbs && customBreadcrumbs.length > 0) {
  breadcrumbs = customBreadcrumbs.map((crumb) => ({
    name: crumb.name,
    url: crumb.url ? new URL(crumb.url, Astro.url).pathname : ""
  }));
} else {
  breadcrumbs = pathSegments.map((segment, index) => {
    const path = "/" + pathSegments.slice(0, index + 1).join("/");
    const url = new URL(path, Astro.url).pathname;
    
    let name = segment
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, (char) => char.toUpperCase());

    if (index === pathSegments.length - 1 && title) {
      const cleanTitle = title.split(/[|:-]/)[0].trim();
      name = cleanTitle || name;
    }

    return { name, url };
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": new URL("/", Astro.url).href
    },
    ...breadcrumbs.map((crumb, idx) => ({
      "@type": "ListItem",
      "position": idx + 2,
      "name": crumb.name,
      "item": crumb.url ? new URL(crumb.url, Astro.url).href : new URL("/", Astro.url).href
    }))
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V2VJMCV1HW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-V2VJMCV1HW');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;800&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Force clean light mode theme default
      document.documentElement.removeAttribute("data-theme");
      localStorage.removeItem("theme");

      // Expiration check for urgent updates new badges
      function checkUrgentBadges() {
        const badges = document.querySelectorAll(".urgent-new-badge");
        badges.forEach(badge => {
          const expiryStr = badge.getAttribute("data-expiry");
          if (expiryStr) {
            const expiryTime = new Date(expiryStr).getTime();
            if (Date.now() > expiryTime) {
              badge.style.display = "none";
            }
          }
        });
      }

      // Toggle QR code reveal (blur/unblur)
      function setupQrReveal() {
        const containers = document.querySelectorAll(".qr-reveal-container");
        containers.forEach(container => {
          if (container.getAttribute("data-listener-added") === "true") return;
          container.setAttribute("data-listener-added", "true");

          container.addEventListener("click", () => {
            const isRevealed = container.getAttribute("data-revealed") === "true";
            const img = container.querySelector(".qr-image");
            const overlay = container.querySelector(".qr-overlay");

            if (isRevealed) {
              // Re-blur
              if (img) img.classList.add("blur-md");
              if (overlay) overlay.classList.remove("opacity-0", "pointer-events-none");
              container.setAttribute("data-revealed", "false");
            } else {
              // Reveal
              if (img) img.classList.remove("blur-md");
              if (overlay) overlay.classList.add("opacity-0", "pointer-events-none");
              container.setAttribute("data-revealed", "true");
            }
          });
        });
      }

      // Universal Article Image Skeleton & Blur Fade-In Manager
      function setupArticleImageSkeleton() {
        const images = document.querySelectorAll(
          "article img, .prose img, .article-content-wrapper img, .article-img, .img-skeleton img"
        );
        
        images.forEach(img => {
          if (img.classList.contains("no-skeleton")) return;

          const parentSkeleton = img.closest(".img-skeleton");

          const handleLoaded = () => {
            img.classList.add("img-loaded");
            if (parentSkeleton) {
              parentSkeleton.classList.remove("img-skeleton");
            }
          };

          const handleError = () => {
            img.classList.add("img-error");
            if (parentSkeleton) {
              parentSkeleton.classList.remove("img-skeleton");
            }
          };

          if (img.complete && img.naturalWidth !== 0) {
            handleLoaded();
          } else {
            img.addEventListener("load", handleLoaded, { once: true });
            img.addEventListener("error", handleError, { once: true });
          }
        });
      }

      // Run on initial load
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          checkUrgentBadges();
          setupQrReveal();
          setupArticleImageSkeleton();
        });
      } else {
        checkUrgentBadges();
        setupQrReveal();
        setupArticleImageSkeleton();
      }

      // Run on View Transition navigation
      document.addEventListener("astro:page-load", () => {
        checkUrgentBadges();
        setupQrReveal();
        setupArticleImageSkeleton();
      });
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "MahaSandhi",
        "description": "A premium portal for latest jobs and exam details.",
        "url": "https://mahasandhi.in"
      }
    </script>
    {
      pathSegments.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
      )
    }
    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <MobileUrgentBoard />

    <div
      class:list={[
        "max-w-[1260px] mx-auto px-4 sm:px-6 lg:px-8 w-full flex-1 flex flex-col lg:flex-row gap-8 lg:gap-10",
        pathSegments.length > 0 ? "py-4 sm:py-6" : "py-6 sm:py-12",
      ]}
    >
      <main
        class:list={[
          "min-w-0 prose dark:prose-invert prose-headings:text-text-main max-w-none w-full",
          hideSidebar ? "flex-1" : "lg:flex-1 min-w-0",
        ]}
      >
        {
          pathSegments.length > 0 && (
            <nav class="not-prose flex flex-row items-center gap-1.5 sm:gap-2 text-xs font-semibold text-text-secondary mb-4 border border-border-card bg-bg-surface/50 rounded-xl px-3.5 py-2 backdrop-blur-xs w-fit max-w-full overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
              <a href="/" class="inline-flex items-center gap-1.5 hover:text-primary transition-colors text-text-muted no-underline shrink-0">
                <HiOutlineHome className="text-[0.95rem] shrink-0" />
                <span>Home</span>
              </a>
              {breadcrumbs.map((crumb, idx) => (
                <span class="inline-flex items-center gap-1.5 sm:gap-2 shrink-0">
                  <HiOutlineChevronRight className="text-[0.8rem] text-text-muted/50 shrink-0" />
                  {idx === breadcrumbs.length - 1 || !crumb.url ? (
                    <span class="text-text-main font-bold truncate max-w-[200px] sm:max-w-[300px] shrink-0" aria-current="page">
                      {crumb.name}
                    </span>
                  ) : (
                    <a href={crumb.url} class="hover:text-primary transition-colors text-text-muted truncate max-w-[150px] no-underline shrink-0">
                      {crumb.name}
                    </a>
                  )}
                </span>
              ))}
            </nav>
          )
        }
        {
          article ? (
            <div class="article-content-wrapper relative">
              {(category || dateToDisplay) && (
                <div class="flex items-center gap-2 flex-wrap mb-2 pb-2.5 border-b border-border-card/20 not-prose">
                  {category && (
                    <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider shrink-0 border border-primary/20">
                      {category}
                    </span>
                  )}
                  {dateToDisplay && (
                    <span class="text-text-muted text-xs sm:text-sm font-medium shrink-0">
                      {category ? `• ${dateToDisplay}` : dateToDisplay}
                    </span>
                  )}
                </div>
              )}
              <slot />
            </div>
          ) : (
            <slot />
          )
        }
        {
          article && (
            <p class="text-xs md:text-sm text-text-secondary italic border-l-4 border-primary/50 pl-4 my-6 select-none leading-relaxed">
              Source: Official Notification released by concerned department.
            </p>
          )
        }
        <div class={article ? "space-y-8 mt-10 block" : "hidden"}>
          {
            urgentUpdates.length > 0 && (
              <!-- Important Updates Section -->
              <div class="space-y-4 not-prose mb-6">
                <UpdatesSeparator />
                <div class="bg-bg-surface border border-border-card p-6 rounded-3xl flex flex-col gap-4 shadow-xs">
                  {urgentUpdates.map((update) => (
                    <div class="py-2 last:border-b-0 border-b border-border-card/20 last:pb-0 first:pt-0">
                      <a
                        href={update.link}
                        class="flex items-center justify-between w-full gap-4 text-text-muted hover:text-rose-500 transition-colors font-semibold text-sm md:text-[0.95rem] no-underline group/link"
                      >
                        <span class="flex items-start gap-2.5">
                          <HiOutlineChevronRight className="text-rose-500 text-[1.1rem] shrink-0 mt-0.5 transform group-hover/link:translate-x-1 transition-transform" />
                          <span>{update.title}</span>
                        </span>
                        <span 
                          class="urgent-new-badge shrink-0 text-[0.55rem] bg-rose-500 text-white px-2 py-0.5 rounded font-bold uppercase tracking-wider select-none animate-pulse"
                          data-expiry={update.expiry}
                        >
                          NEW
                        </span>
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Share Card Section -->
          <div class="mt-6 pt-6 border-t border-border-card dark:border-border-card/30 not-prose animate-[fadeInUp_0.5s_ease_forwards]">
            <div class="bg-bg-surface border border-border-card p-6 md:p-8 rounded-3xl relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-6">
              <!-- Ambient Glow background effect -->
              <div class="absolute -right-24 -top-24 w-48 h-48 bg-primary/5 rounded-full blur-3xl -z-10"></div>
              
              <div class="space-y-4 max-w-lg text-center md:text-left md:pr-36">
                <h3 class="text-lg md:text-xl font-extrabold text-text-main m-0 flex items-center justify-center md:justify-start gap-2">
                  <span class="text-primary flex items-center shrink-0">
                    <HiOutlineShare className="text-[1.25rem]" />
                  </span>
                  <span>Share This Article / शेअर करा</span>
                </h3>
                <p class="text-xs md:text-sm text-text-secondary leading-relaxed m-0">
                  If you found this information helpful, please share it with your friends and groups on WhatsApp and Telegram.
                </p>
                
                <div class="flex flex-wrap justify-center md:justify-start gap-3 !mt-5">
                  <!-- WhatsApp Share -->
                  <a 
                    href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + " - " + Astro.url.href)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-sm no-underline"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.455 5.703 1.458h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                    <span>WhatsApp</span>
                  </a>
                  
                  <!-- Telegram Share -->
                  <a 
                    href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(title)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-sky-500 hover:bg-sky-600 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-sm no-underline"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-1-.65-.35-1 .22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.94-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.37.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .24z"/>
                  </svg>
                  <span>Telegram</span>
                </a>
              </div>
              
              <!-- Page URL QR Code -->
              <div class="flex flex-col items-center text-center gap-1.5 shrink-0 self-center md:absolute md:top-8 md:right-8 md:self-auto">
                <div class="w-32 h-32 bg-white p-2.5 rounded-xl border border-border-card shadow-xs flex items-center justify-center">
                  <img 
                    src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(Astro.url.href)}`} 
                    alt="Article QR Code" 
                    class="w-full h-full"
                    loading="lazy"
                  />
                </div>
                <span class="text-[0.6rem] font-bold text-text-secondary uppercase tracking-wider">Scan to Share</span>
              </div>

            </div>
          </div>
        </div>
      </main>
      {
        !hideSidebar && (
          <aside class="w-full lg:w-[350px] xl:w-[380px] shrink-0 space-y-6 lg:sticky lg:top-[calc(var(--navbar-height,190px)+16px)] h-fit">
            <!-- Important Updates Widget (Placed at Top) -->
            <ImportantUpdatesWidget />

            <!-- Latest Naukri Updates Widget -->
            <NaukriUpdatesWidget limit={3} />

            <!-- WhatsApp Channel QR Code Widget -->
            <WhatsAppChannelWidget />

            <!-- District Wise Jobs Widget -->
            <div class="flex flex-col">
              <div class="bg-emerald-600 text-white px-5 py-3 rounded-t-2xl font-bold flex items-center gap-2 border border-emerald-600 border-b-0 shadow-xs mt-0">
                <HiOutlineMapPin className="text-white text-[1.1rem] shrink-0" />
                <span class="text-xs font-extrabold uppercase tracking-wider">District Jobs (जिल्ह्यानुसार भरती)</span>
              </div>
              
              <div class="bg-bg-surface border border-emerald-500/20 border-t-0 p-4 rounded-b-2xl transition-all duration-300 shadow-sm mt-0 relative overflow-hidden">
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {MAHARASHTRA_DISTRICTS.slice(0, 12).map((dist) => (
                    <a
                      href={`/district/${dist.slug}`}
                      class="px-2.5 py-1 bg-bg-base hover:bg-emerald-500/10 border border-border-card hover:border-emerald-500/30 text-text-main hover:text-emerald-600 dark:hover:text-emerald-400 rounded-lg text-[0.7rem] font-bold transition-all no-underline inline-flex items-center gap-1"
                    >
                      <span>{dist.nameMr}</span>
                    </a>
                  ))}
                </div>

                <div class="pt-2 border-t border-border-card/30 flex justify-center">
                  <a
                    href="/district"
                    class="inline-flex items-center gap-1 text-[0.7rem] font-bold text-emerald-600 dark:text-emerald-400 hover:underline uppercase tracking-wider no-underline transition-colors group/dist"
                  >
                    <span>सर्व 36 जिल्हे पाहा (View All)</span>
                    <HiOutlineChevronRight className="text-xs transform group-hover/dist:translate-x-0.5 transition-transform" />
                  </a>
                </div>
              </div>
            </div>

            {false && (
              <!-- Latest Jobs Widget -->
              <div class="bg-bg-surface border border-border-card p-6 rounded-xl">
                <h4 class="text-[1.1rem] text-text-main border-b-2 border-primary inline-flex items-center gap-2 pb-1.5 mb-4 font-semibold">
                  <span class="text-primary flex items-center shrink-0">
                    <HiOutlineBriefcase className="text-primary text-[1.15rem]" />
                  </span>
                  <span>Latest Jobs</span>
                </h4>
                <div class="flex flex-col">
                  {latestJobs.map((job, idx) => (
