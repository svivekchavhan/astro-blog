              <span
                class="px-1.5 py-0.5 text-[0.68rem] font-extrabold tracking-wider text-white uppercase rounded-md bg-gradient-to-r from-secondary to-primary shadow-xs transition-all duration-300 group-hover:from-primary group-hover:to-secondary"
              >
                in
              </span>
            </div>
