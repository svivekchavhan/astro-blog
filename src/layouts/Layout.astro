---
import Navbar from '../components/Navbar.astro';
import Marquee from '../components/Marquee.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "A premium blog layout built with Astro." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<script is:inline>
			const applyTheme = () => {
				const theme = (() => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						return 'dark';
					}
					return 'light';
				})();
			
				if (theme === 'light') {
					document.documentElement.setAttribute('data-theme', 'light');
				} else {
					document.documentElement.removeAttribute('data-theme');
				}

				// Also sync the icon in the Navbar if it exists
				const themeToggle = document.getElementById('theme-toggle');
				if (themeToggle) {
					themeToggle.setAttribute('data-theme', theme);
				}
			};

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Blog",
				"name": "AstroBlog",
				"description": "A premium blog layout built with Astro.",
				"url": "https://techfixsteps.com"
			}
		</script>
		<ClientRouter />
	</head>
	<body>
		<Navbar />

		<div class="max-w-[1200px] mx-auto px-6 w-full flex-1 flex flex-col lg:flex-row gap-12 py-12">
			<main class="flex-[3] min-w-0 prose prose-invert prose-headings:text-text-main prose-p:text-text-muted max-w-none">
				<slot />
			</main>
			
			<aside class="flex-1 space-y-10 lg:sticky lg:top-[100px] h-fit">
				<div class="bg-bg-surface border border-border-card p-6 rounded-xl">
					<h4 class="text-[1.1rem] text-text-main border-b-2 border-primary inline-block pb-1 mb-4 font-semibold">About Me</h4>
					<p class="text-text-muted text-[0.9rem] leading-[1.6]">I'm Vivek, a developer and designer passionate about building beautiful web experiences with Astro.</p>
				</div>
				<div class="bg-bg-surface border border-border-card p-6 rounded-xl">
					<h4 class="text-[1.1rem] text-text-main border-b-2 border-primary inline-block pb-1 mb-4 font-semibold">Categories</h4>
					<ul class="space-y-3">
						<li><a href="#" class="text-text-muted text-[0.9rem] hover:text-primary transition-colors duration-300 block">Web Development</a></li>
						<li><a href="#" class="text-text-muted text-[0.9rem] hover:text-primary transition-colors duration-300 block">AI & Machine Learning</a></li>
						<li><a href="#" class="text-text-muted text-[0.9rem] hover:text-primary transition-colors duration-300 block">Design Systems</a></li>
						<li><a href="#" class="text-text-muted text-[0.9rem] hover:text-primary transition-colors duration-300 block">Astro Tutorials</a></li>
					</ul>
				</div>
				<div class="bg-bg-surface border border-border-card p-6 rounded-xl">
					<h4 class="text-[1.1rem] text-text-main border-b-2 border-primary inline-block pb-1 mb-4 font-semibold">Newsletter</h4>
					<p class="text-text-muted text-[0.9rem] leading-[1.6] mb-4">Get the latest articles delivered to your inbox.</p>
					<form class="flex flex-col gap-3">
						<input type="email" placeholder="Email address" class="p-2.5 bg-bg-base/50 dark:bg-black/20 border border-border-card rounded-md text-text-main font-sans outline-none focus:border-primary transition-colors" />
						<button type="submit" class="btn-primary">Join</button>
					</form>
				</div>
			</aside>
		</div>

		<footer class="bg-bg-surface border-t border-border-card pt-16 pb-8 mt-16 transition-colors duration-300">
			<div class="max-w-[1200px] mx-auto px-6 w-full grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
				<div class="md:col-span-2">
					<a href="/" class="text-2xl font-bold text-text-main"><span class="gradient-text">Astro</span>Blog</a>
					<p class="text-text-muted mt-4 text-[0.95rem]">Crafting beautiful digital experiences with Astro.</p>
				</div>
				<div class="flex flex-col gap-4">
					<h4 class="text-[1.1rem] text-text-main font-semibold">Platform</h4>
					<a href="/" class="text-text-muted text-[0.9rem] hover:text-text-main transition-colors">Home</a>
					<a href="/blog" class="text-text-muted text-[0.9rem] hover:text-text-main transition-colors">Blog</a>
					<a href="/about" class="text-text-muted text-[0.9rem] hover:text-text-main transition-colors">About Us</a>
				</div>
			</div>
			<div class="max-w-[1200px] mx-auto px-6 w-full border-t border-border-card pt-8 text-center">
				<p class="text-text-muted text-[0.85rem]">&copy; 2026 AstroBlog. Built with passion.</p>
			</div>
		</footer>
	</body>
</html>
