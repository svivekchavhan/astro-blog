---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineExclamationTriangle,
  HiOutlineSparkles,
} from "react-icons/hi2";

const title =
  "RRB JE / DMS Recruitment 2026: रेल्वे भरती बोर्डात ३,९९३ जागांसाठी भरती (CEN 04/2026)";
const description =
  "RRB JE / DMS Recruitment 2026 (CEN 04/2026): Railway Recruitment Boards (RRB) invites online applications for 3,993 Junior Engineer (JE) & Depot Material Superintendent (DMS) posts. Initial Pay ₹35,400 (Level 6). Apply Online 14 Aug to 13 Sep 2026.";
const canonicalURL = "https://mahasandhi.in/rrb-je-dms-recruitment-2026";
const date = "August 14, 2026";
const category = "Railway Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1474487548417-781cb71495f3?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Mega Recruitment", url: "/mega-recruitment" },
    { name: "RRB JE DMS Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language & Navigation Links -->
    <div class="flex flex-wrap items-center gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="/mega-recruitment"
        class="text-sky-600 dark:text-sky-400 font-bold text-sm hover:underline flex items-center gap-1"
        >🚆 सर्व मेगा भरती अपडेट्स (Mega Hub) →</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          रेल्वे भरती बोर्ड (RRB) ज्युनियर इंजिनिअर (JE) व DMS भरती २०२६ जाहिरात
          (CEN 04/2026)
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>RRB JE Recruitment 2026:</strong> रेल्वे भरती बोर्ड (Railway Recruitment
            Boards - RRB) द्वारे केंद्रीय रोजगार बातमी (CEN No. 04/2026) अंतर्गत <strong
              >ज्युनियर इंजिनिअर (JE)</strong
            > आणि <strong>डेपो मटेरियल सुपरिंटेंडेंट (DMS)</strong> या पदांच्या एकूण
            <strong>३,९९३ जागांसाठी</strong> महाभरतीची घोषणा करण्यात आली आहे.
          </p>
          <p>
            या भरतीमध्ये <strong>Level 6 (आरंभिक वेतन ₹३५,४००/- + भत्ते)</strong
            > नुसार आकर्षक वेतन श्रेणी देण्यात येणार आहे. अधिकृत सूचनेनुसार ऑनलाईन
            अर्ज प्रक्रिया <strong>१४ ऑगस्ट २०२६</strong> पासून सुरू होत असून अर्ज
            सादर करण्याची अंतिम तारीख <strong
              >१३ सप्टेंबर २०२६ (रात्री ११:५९ वाजेपर्यंत)</strong
            > आहे.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Highlight Box for Civil Diploma/Degree Engineers -->
        <div
          class="bg-gradient-to-r from-amber-500/10 via-primary/10 to-emerald-500/10 border-2 border-amber-500/30 p-5 rounded-2xl mb-8"
        >
          <div class="flex items-start gap-3">
            <HiOutlineSparkles
              className="text-amber-500 text-2xl shrink-0 mt-1"
            />
            <div>
              <h3 class="text-base font-extrabold text-text-main m-0 mb-1">
                📌 सिव्हिल (Civil) इंजिनिअर्ससाठी विशेष संधी!
              </h3>
              <p class="text-xs text-text-muted m-0 leading-relaxed">
                सर्वात महत्त्वाचे: जर आपण Civil मध्ये Diploma किंवा B.E./B.Tech
                पूर्ण केलेले असेल, तर या जाहिरातीमध्ये आपल्यासाठी <strong
                  >JE Civil</strong
                > अंतर्गत विविध प्रवर्गांच्या जागा उपलब्ध आहेत—जसे की <strong
                  >P.Way, Works, Bridge, Design/Drawing/Estimation</strong
                > इत्यादी.
              </p>
            </div>
          </div>
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >संस्था / मंडळ</span
              >
              <span class="text-text-main font-semibold text-sm"
                >Railway Recruitment Boards (RRB)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineDocumentText
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >जाहिरात क्रमांक (CEN)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >CEN 04/2026</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण पदे व वेतन</span
              >
              <span class="text-text-main font-semibold text-sm"
                >३,९९३ पदे (Pay Level 6: ₹३५,४००+)</span
              >
            </div>
          </div>
        </div>

        <!-- Summary Table -->
        <h2
          id="summary"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          भरती संक्षेप माहिती (Recruitment Overview)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >📌 माहिती (Parameter)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >विवरण (Details)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🏢 संघटन (Organization)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >रेल्वे भरती बोर्ड (Railway Recruitment Boards - RRB)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >📄 जाहिरात क्र. (CEN No.)</td
                >
                <td class="p-3 border border-border-card font-bold text-primary"
                  >CEN 04/2026</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >👷 पदाचे नाव (Posts)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >ज्युनियर इंजिनिअर (JE) + डेपो मटेरियल सुपरिंटेंडेंट (DMS)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🔢 एकूण जागा (Vacancies)</td
                >
                <td
                  class="p-3 border border-border-card font-extrabold text-rose-500 text-base"
                  >३,९९३ पदे</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >💰 वेतन श्रेणी (Pay Level)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >Level 6 (आरंभिक वेतन ₹३५,४००/- + इतर भत्ते)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🎂 वयोमर्यादा (Age Limit)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >१८ ते ३३ वर्षे (दि. ०१ जानेवारी २०२७ रोजी)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >📝 अर्ज सुरू तारीख</td
                >
                <td
                  class="p-3 border border-border-card text-emerald-600 dark:text-emerald-400 font-bold"
                  >१४ ऑगस्ट २०२६</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >⏰ ऑनलाईन अर्ज शेवटची तारीख</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-extrabold"
                  >१३ सप्टेंबर २०२६ (रात्री ११:५९ वाजेपर्यंत)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >💳 फी भरण्याची अंतिम तारीख</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >१५ सप्टेंबर २०२६</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🖥️ निवड प्रक्रिया (Selection Process)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >CBT (संगणकावर आधारित परीक्षा) → कागदपत्र पडताळणी (DV) →
                  वैद्यकीय तपासणी (Medical)</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Post Names & Vacancies Distribution Table -->
        <h2
          id="vacancy-details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          पदांचे नाव आणि एकूण जागा (Post Name & Total Vacancies)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >अ. क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >एकूण जागा (Total Vacancies)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted text-center"
                  >१</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >ज्युनियर इंजिनिअर (JE) - सिव्हिल (Civil Engineering Cadres)</td
                >
                <td
                  class="p-3 border border-border-card font-semibold text-text-main text-center"
                  >विविध कॅटेगरी (P.Way, Works, Bridge, Design)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted text-center"
                  >२</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >ज्युनियर इंजिनिअर (JE) - इलेक्ट्रिकल (Electrical Engineering)</td
                >
                <td
                  class="p-3 border border-border-card font-semibold text-text-main text-center"
                  >विविध रेल्वे झोन नुसार पदे</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted text-center"
                  >३</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >ज्युनियर इंजिनिअर (JE) - मेकॅनिकल (Mechanical Engineering)</td
                >
                <td
                  class="p-3 border border-border-card font-semibold text-text-main text-center"
                  >विविध वर्कशॉप्स व कॅरेज</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted text-center"
                  >४</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >ज्युनियर इंजिनिअर (JE) - S&T / संगणक (Signal & Telecom / IT)</td
                >
                <td
                  class="p-3 border border-border-card font-semibold text-text-main text-center"
                  >सिग्नल व टेलिकॉम विभाग</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted text-center"
                  >५</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >डेपो मटेरियल सुपरिंटेंडेंट (DMS - Stores Dept)</td
                >
                <td
                  class="p-3 border border-border-card font-semibold text-text-main text-center"
                  >स्टोअर्स व मटेरियल डेपो</td
                >
              </tr>
              <tr class="bg-primary/5">
                <td
                  colspan="2"
                  class="p-3 border border-border-card font-extrabold text-text-main text-right"
                  >एकूण पदसंख्या (Total Posts)</td
                >
                <td
                  class="p-3 border border-border-card font-black text-rose-500 text-center text-base"
                  >३,९९३ जागा</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Post Details & Educational Qualification Table -->
        <h2
          id="qualification"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          पदनिहाय शैक्षणिक पात्रता (Post-wise Qualification)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव / शाखा</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक अर्हता (Educational Qualifications)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >Civil JE (सिव्हिल ज्युनियर इंजिनिअर)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • <strong>3-year Diploma in Civil Engineering</strong>, किंवा<br
                  />
                  • <strong>3-year B.Sc. in Civil Engineering</strong>, किंवा<br
                  />
                  • Civil Engineering च्या संबंधित उप-शाखांचे (sub-streams) कॉम्बिनेशन.<br
                  />
                  <span
                    class="text-xs text-amber-600 dark:text-amber-400 font-semibold"
                    >(P.Way, Works, Bridge, Design/Drawing/Estimation इत्यादी
                    कॅटेगरींचा समावेश)</span
                  >
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >Electrical JE (इलेक्ट्रिकल ज्युनियर इंजिनिअर)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • <strong
                    >3-year Diploma in Electrical / Electronics / Mechanical
                    Engineering</strong
                  > किंवा संबंधित पात्र कॉम्बिनेशन.
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >Mechanical JE (मेकॅनिकल ज्युनियर इंजिनिअर)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • <strong
                    >3-year Diploma in Mechanical / Production / Automobile /
                    Electrical / Electronics / Instrumentation & Control</strong
                  > इत्यादी विहीत शाखांमधील डिप्लोमा/पदवी.
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >S&T / Computer Related JE</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • Electrical / Electronics / IT / Communication / Computer
                  Science & Engineering / Computer Science / Computer
                  Engineering इत्यादींमध्ये <strong>3-year Diploma</strong> किंवा
                  विहित कॉम्बिनेशन्स.
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >DMS (Depot Material Superintendent)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • कोणत्याही शाखेतील <strong
                    >3-year Diploma in Engineering</strong
                  >.<br />
                  • Diploma च्या ऐवजी त्याच शाखेतील <strong
                    >B.E. / B.Tech</strong
                  > पदवी देखील ग्राह्य धरली जाईल.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Warning Alert Box for Qualification Result Date -->
        <div
          class="bg-rose-500/10 border-l-4 border-rose-500 p-4 rounded-r-xl my-6 flex items-start gap-3"
        >
          <HiOutlineExclamationTriangle
            className="text-rose-500 text-xl shrink-0 mt-0.5"
          />
          <div class="text-xs text-text-main">
            <strong class="font-bold text-rose-600 dark:text-rose-400"
              >⚠️ महत्त्वाचे अट (Qualification Deadline):</strong
            ><br />
            शैक्षणिक अर्हतेचा <strong
              >अंतिम निकाल १३ सप्टेंबर २०२६ पर्यंत</strong
            > जाहीर झालेला असणे आवश्यक आहे. ज्या उमेदवारांचा निकाल प्रलंबित (Result
            Awaiting) आहे, ते उमेदवार या भरतीसाठी पात्र असणार नाहीत.
          </div>
        </div>

        <!-- Age Limit & Category Relaxation Table -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वयोमर्यादा व शिथिलता (Age Limit & Relaxation)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          उमेदवाराचे वय <strong>०१ जानेवारी २०२७</strong> रोजी <strong
