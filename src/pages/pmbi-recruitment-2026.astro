---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineClipboardDocumentCheck,
} from "react-icons/hi2";

const title =
  "PMBI भरती २०२६: फार्मास्युटिकल्स अँड मेडिकल डिव्हाइसेस ब्युरो ऑफ इंडिया मध्ये १७८ जागांसाठी भरती जाहीर!";
const description =
  "PMBI Recruitment 2026 (Advt No. 02/2026): Pharmaceuticals & Medical Devices Bureau of India (implementing agency of PMBJP) invites applications for 178 Manager, Executive, Officer & Pharmacist posts. Check department-wise vacancies, qualification, age limit, selection process, and official PDF download.";
const canonicalURL =
  "https://mahasandhi.in/pmbi-recruitment-2026";
const date = "September 26, 2026";
const category = "Central Govt";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "PMBI Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Main Article Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Jump Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- Banner Image -->
    <div class="mb-8 rounded-3xl overflow-hidden border border-border-card shadow-lg bg-bg-surface p-2 sm:p-4">
      <img
        src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&q=80&w=1200"
        alt="Pharmaceuticals & Medical Devices Bureau of India PMBI Recruitment 2026 Notification"
        class="w-full h-auto max-h-[500px] object-cover mx-auto rounded-2xl"
        loading="eager"
      />
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          फार्मास्युटिकल्स अँड मेडिकल डिव्हाइसेस ब्युरो ऑफ इंडिया (PMBI) कंत्राटी पदभरती २०२६ (जाहिरात क्र. ०२/२०२६)
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>PMBI Bharti 2026:</strong> रसायन आणि खते मंत्रालय, भारत सरकार (Ministry of Chemicals & Fertilizers, Govt. of India) अंतर्गत <strong>'प्रधानमंत्री भारतीय जनऔषधी योजना' (PMBJP)</strong> ची अंमलबजावणी करणारी संस्था <strong>फार्मास्युटिकल्स अँड मेडिकल डिव्हाइसेस ब्युरो ऑफ इंडिया (PMBI)</strong> द्वारे तब्बल <strong>१७८ विविध कंत्राटी पदांची</strong> मोठी भरती जाहिरात (Advt No. 02/2026) प्रसिद्ध करण्यात आली आहे.
          </p>
          <p>
            या भरती प्रक्रियेत जनरल मॅनेजर, डेप्युटी जनरल मॅनेजर, मॅनेजर, असिस्टंट मॅनेजर, सिनियर एक्झिक्युटिव्ह, मार्केटिंग ऑफिसर, फार्मसिस्ट, लीगल व मीडिया ऑफिसर यांसारख्या ११ विविध पदांचा समावेश आहे. पात्र आणि इच्छुकांनी आपले अर्ज आवश्यक कागदपत्रांसह हार्ड कॉपी (Hard Copy) द्वारे <strong>२४ सप्टेंबर २०२६</strong> पर्यंत सादर करायचे आहेत.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >संस्था / विभाग</span
              >
              <span class="text-text-main font-semibold text-sm"
                >PMBI (केमिकल्स व फर्टिलायझर्स मंत्रालय, भारत सरकार)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण</span
              >
              <span class="text-text-main font-semibold text-sm"
                >नवी दिल्ली व भारतभर (All India)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण रिक्त पदे</span
              >
              <span class="text-text-main font-semibold text-sm"
                >१७८ पदे (178 Vacancies)</span
              >
            </div>
          </div>
        </div>

        <!-- Post-wise Vacancy Breakdown Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          १. पदांचे नाव व पदसंख्या (Post Name & Vacancy Breakdown)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          PMBI भरती २०२६ अंतर्गत ११ विविध प्रवर्गातील १७८ रिक्त जागांचा तपशील खालीलप्रमाणे आहे:
        </p>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center w-16"
                  >अ.क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >रिक्त जागा (Vacancies)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">१</td>
                <td class="p-3 border border-border-card font-bold text-text-main">General Manager (जनरल मॅनेजर)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०३</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">२</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Dy. General Manager (डेप्युटी जनरल मॅनेजर)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">३</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Manager (मॅनेजर)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">४</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Deputy Manager (डेप्युटी मॅनेजर)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०४</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">५</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Assistant Manager (असिस्टंट मॅनेजर)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">३१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">६</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Senior Executive (सिनियर एक्झिक्युटिव्ह)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">६१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">७</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Senior Marketing Officer (सिनियर मार्केटिंग ऑफिसर)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">१५</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">८</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Senior Pharmacist (सिनियर फार्मसिस्ट)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">९</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Executive (एक्झिक्युटिव्ह)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">१०</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">१०</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Marketing Officer (मार्केटिंग ऑफिसर)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">३०</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">११</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Pharmacist (फार्मसिस्ट)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०६</td>
              </tr>
              <tr class="bg-primary/10">
                <td colspan="2" class="p-3 border border-border-card font-bold text-text-main text-right">
                  🔢 एकूण रिक्त पदे (Total Vacancies)
                </td>
                <td class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-lg">
                  १७८ पदे
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="bg-bg-surface border border-border-card p-4 rounded-2xl text-xs text-text-muted mb-8">
          📌 <strong>सदर पदे १०+ विभागांमध्ये विभागली आहेत:</strong> Sales & Marketing, Procurement, Quality, Logistics & Supply Chain, Finance & Accounts, IT & MIS, HR & Administration, Legal, Media, Grievance Division, International Assistance Division, व Coordination Cell.
        </div>

        <!-- Educational Qualifications -->
        <h2
          id="eligibility"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎓 २. पदनिहाय शैक्षणिक पात्रता (Educational Qualifications)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">पदाचे नाव (Post Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">आवश्यक शैक्षणिक पात्रता</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">General Manager</td>
                <td class="p-3 border border-border-card text-text-muted">B.Pharma / B.Sc (Medicinal Chem) / M.Pharma / M.Com / B.Tech (विभागाच्या आवश्यकतेनुसार)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Dy. General Manager</td>
                <td class="p-3 border border-border-card text-text-muted">B.Pharma / M.Pharma / B.Com, M.Com / B.Tech, MCA</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Manager</td>
                <td class="p-3 border border-border-card text-text-muted">BVSc & AH / B.Pharma (QA) / पदवीधर (विभागानुसार)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Deputy Manager</td>
                <td class="p-3 border border-border-card text-text-muted">B.Pharma / पदवीधर / B.Tech / MCA</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Assistant Manager</td>
                <td class="p-3 border border-border-card text-text-muted">पदवीधर / B.Pharma / BVSc & AH / B.Tech, MCA (MBA पदवी असणाऱ्यास प्राधान्य)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Senior Executive</td>
                <td class="p-3 border border-border-card text-text-muted">पदवीधर / B.Pharma / B.Com (Hons) (विभागाच्या आवश्यकतेनुसार)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Senior Marketing Officer / Marketing Officer</td>
                <td class="p-3 border border-border-card text-text-muted">B.Pharma / B.Sc (Biotech / Medicinal / Pharma Chemistry)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Senior Pharmacist / Pharmacist</td>
                <td class="p-3 border border-border-card text-text-muted">B.Pharma (फार्मसी पदवी)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Executive</td>
                <td class="p-3 border border-border-card text-text-muted">B.Com / BCA / B.Tech / पदवीधर (विभागानुसार)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Legal Posts (विधी पदे)</td>
                <td class="p-3 border border-border-card text-text-muted">LLB (कायदा पदवी) (LLM पदवी असणाऱ्यास प्राधान्य)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Media Posts (मीडिया पदे)</td>
                <td class="p-3 border border-border-card text-text-muted">Graduation in Mass Communication / Journalism (मास कम्युनिकेशन किंवा जर्नलिझम मध्ये पदवी)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit Table -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎂 ३. वयोमर्यादा (Age Limit)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">पदाचे नाव (Post Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">कमाल वयोमर्यादा (Max Age Limit)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">General Manager</td>
                <td class="p-3 border border-border-card font-bold text-primary">५५ वर्षे (55 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Dy. General Manager</td>
                <td class="p-3 border border-border-card font-bold text-primary">५० वर्षे (50 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Manager</td>
                <td class="p-3 border border-border-card font-bold text-primary">४० वर्षे (40 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Deputy Manager</td>
                <td class="p-3 border border-border-card font-bold text-primary">३५ वर्षे (35 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Assistant Manager</td>
                <td class="p-3 border border-border-card font-bold text-primary">३३ वर्षे (33 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Senior Executive / Sr. Marketing Officer / Sr. Pharmacist</td>
                <td class="p-3 border border-border-card font-bold text-primary">३० वर्षे (30 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Executive / Marketing Officer / Pharmacist</td>
                <td class="p-3 border border-border-card font-bold text-primary">३० वर्षे (30 Years)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Calculator Button -->
        <div class="my-6">
          <a
            href="/mpsc-age-calculator-marathi"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-secondary hover:shadow-lg text-white font-bold text-sm rounded-xl transition-all no-underline border-none"
          >
            <HiOutlineCalculator className="text-lg shrink-0" />
            <span>तुमचे वय मोजा - Govt Age Calculator Tool</span>
          </a>
        </div>

        <!-- Selection Process -->
        <h2
          id="selection-process"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔍 ४. निवड प्रक्रिया (Selection Process)
        </h2>
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3">
          <p class="font-bold text-text-main m-0">PMBI पदभरती निवड प्रक्रिया ३ टप्प्यांत पार पडेल:</p>
          <ol class="list-decimal pl-5 space-y-2 text-text-muted">
            <li><strong>स्क्रीनिंग (Screening of Applications):</strong> प्राप्त अर्जांची पात्रता आणि अनुभवानुसार छाननी केली जाईल.</li>
            <li><strong>लिखित परीक्षा (Written Exam):</strong> शॉर्टलिस्ट केलेल्या उमेदवारांची परीक्षा घेतली जाईल.</li>
            <li><strong>मुलाखत (Personal Interaction cum Interview):</strong> गुणवत्ता यादीतील उमेदवारांची वैयक्तिक मुलाखत घेऊन अंतिम निवड केली जाईल.</li>
          </ol>
        </div>

        <!-- How to Apply (Hard Copy Submission) -->
        <h2
          id="how-to-apply"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          📝 ५. अर्ज कसा करावा? (Application Procedure - Hard Copy)
        </h2>
        <div class="bg-primary/5 border border-primary/20 p-5 rounded-2xl text-sm space-y-3 text-text-main">
          <p class="font-bold text-primary m-0">अर्ज करण्याची सोपी पद्धत:</p>
