---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";
import { HiOutlineArrowTopRightOnSquare } from "react-icons/hi2";

const title = "India Post GDS Result 2026: Merit List & Cutoff Marks";
const description = "Download India Post GDS Result 2026 PDF. Check circle-wise merit lists, expected cutoff marks, and document verification schedules.";
const canonicalURL = "https://mahasandhi.in/post-office-gds-result-2026";
const date = "May 25, 2026";
const category = "Result";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1596715582885-3075c13b28b7?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents (Marathi) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          या लेखातील मुख्य मुद्दे (मराठी)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li>
            <a
              href="#gds-overview"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >GDS निकाल 2026 सविस्तर माहिती</a
            >
          </li>
          <li>
            <a
              href="#how-to-check"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >निकाल कसा तपासावा? (पायऱ्या)</a
            >
          </li>
          <li>
            <a
              href="#cutoff-marks"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >अपेक्षित कट-ऑफ मार्क्स 2026</a
            >
          </li>
          <li>
            <a
              href="#next-steps"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >निकालानंतरची प्रक्रिया (कागदपत्र पडताळणी)</a
            >
          </li>
          <li>
            <a
              href="#important-links"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >महत्त्वाच्या लिंक्स (Important Links)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <p>
          भारतीय टपाल विभागाने (India Post) देशातील विविध मंडळांमधील ग्रामीण डाक सेवक (GDS), शाखा पोस्टमास्तर (BPM) आणि सहाय्यक शाखा पोस्टमास्तर (ABPM) पदांसाठी भरती परीक्षेचा निकाल आणि गुणवत्ता यादी जाहीर केली आहे. ही भरती पूर्णपणे १० वीच्या गुणांवर आधारित असल्यामुळे उमेदवारांना लेखी परीक्षा देण्याची आवश्यकता नव्हती.
        </p>

        <!-- Overview Table (Marathi) -->
        <div class="overflow-x-auto my-6 border border-border-card rounded-2xl bg-bg-surface p-4">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th colspan="2" class="p-3 text-center font-bold text-text-main text-base border border-border-card">
                  भारतीय पोस्ट ऑफिस GDS निकाल 2026 संक्षिप्त माहिती
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main w-[40%] bg-primary/5">विभाग (Department)</td>
                <td class="p-3 border border-border-card text-text-muted">भारतीय टपाल विभाग (India Post)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">पदाचे नाव (Post Name)</td>
                <td class="p-3 border border-border-card text-text-muted">ग्रामीण डाक सेवक (GDS), BPM, ABPM</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">एकूण पदे (Total Vacancies)</td>
                <td class="p-3 border border-border-card text-text-muted">४०,२२० पदे</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">निकाल स्थिती (Status)</td>
                <td class="p-3 border border-border-card text-emerald-500 font-bold">जाहीर (Declared)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">निकालाची तारीख (Result Date)</td>
                <td class="p-3 border border-border-card text-text-muted">२५ मे २०२६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">अधिकृत वेबसाईट (Official Link)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://indiapostgdsonline.gov.in" target="_blank" rel="noopener noreferrer" class="text-primary font-bold hover:underline inline-flex items-center gap-1">
                    indiapostgdsonline.gov.in <HiOutlineArrowTopRightOnSquare className="text-xs shrink-0" />
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="gds-overview">GDS निकाल 2026 सविस्तर माहिती</h2>
        <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
          <p class="m-0">
            ग्रामीण डाक सेवक भरती २०२६ अंतर्गत देशभरात हजारो जागांसाठी अर्ज मागवण्यात आले होते. या पदांसाठीची निवड प्रक्रिया केवळ १० वीच्या बोर्ड परीक्षेत मिळालेल्या टक्केवारीवर आधारलेली आहे. निवड झालेल्या उमेदवारांची यादी टपाल विभागाच्या अधिकृत संकेतस्थळावर प्रसिद्ध करण्यात आली आहे.
          </p>
        </div>

        <h2 id="how-to-check">पोस्ट ऑफिस GDS निकाल २०२६ कसा तपासावा?</h2>
        <p>GDS गुणवत्ता यादीमध्ये आपले नाव तपासण्यासाठी खालील पायऱ्यांचे अनुसरण करा:</p>
        
        <div class="space-y-6 pl-2 border-l-2 border-primary/30">
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">1</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 1: अधिकृत वेबसाइटला भेट द्या</h4>
            <p class="text-sm text-text-muted m-0">सर्वप्रथम भारतीय टपाल विभागाच्या अधिकृत GDS पोर्टलला (<strong>indiapostgdsonline.gov.in</strong>) भेट द्या.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">2</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 2: वर्तुळ (Circle) निवडा</h4>
            <p class="text-sm text-text-muted m-0">होमपेजवर डाव्या बाजूला असलेल्या "Shortlisted Candidates" या पर्यायावर क्लिक करून आपले राज्य किंवा वर्तुळ निवडा (उदा. महाराष्ट्र).</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">3</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 3: PDF गुणवत्ता यादी डाउनलोड करा</h4>
            <p class="text-sm text-text-muted m-0">आपल्या वर्तुळावर क्लिक करताच निकालाची PDF फाईल डाउनलोड होईल.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">4</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 4: आपले नाव किंवा नोंदणी क्रमांक शोधा</h4>
            <p class="text-sm text-text-muted m-0">PDF मध्ये आपला <strong>नोंदणी क्रमांक (Registration Number)</strong> शोधण्यासाठी Ctrl+F (संगणकावर) किंवा सर्च बार (मोबाईलवर) वापरा.</p>
          </div>
        </div>

        <h2 id="cutoff-marks">अपेक्षित कट-ऑफ मार्क्स २०२६</h2>
        <p>यावर्षी विविध प्रवर्गासाठी अपेक्षित कट-ऑफ खालीलप्रमाणे राहण्याची शक्यता आहे:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 my-8">
          {[
            { title: "सामान्य प्रवर्ग (UR)", desc: "९५% ते ९८%" },
            { title: "ओबीसी (OBC)", desc: "९३% ते ९६%" },
            { title: "एससी (SC)", desc: "९०% ते ९४%" },
            { title: "एसटी (ST)", desc: "८८% ते ९२%" }
          ].map((item) => (
            <div class="bg-bg-card border border-border-card p-4 rounded-xl text-center">
              <strong class="text-text-main block mb-1">{item.title}</strong>
              <span class="text-lg font-bold text-primary">{item.desc}</span>
            </div>
          ))}
        </div>

        <h2 id="next-steps">गुणवत्ता यादीनंतर कागदपत्र पडताळणी (Document Verification)</h2>
        <p>निवड झालेल्या उमेदवारांनी पुढील कागदपत्रांसह संबंधित पडताळणी अधिकाऱ्याकडे हजर राहावे:</p>
        <ul>
          <li>१० वीचे मूळ गुणपत्रक (SSC Marksheet) व बोर्ड प्रमाणपत्र</li>
          <li>जातीचे प्रमाणपत्र (लागू असल्यास)</li>
          <li>रहिवासी प्रमाणपत्र (Domicile Certificate)</li>
          <li>वैद्यकीय प्रमाणपत्र (Medical Certificate)</li>
          <li>आधार कार्ड किंवा पॅन कार्ड</li>
        </ul>

        <!-- Important Links Table (Marathi) -->
        <h2 id="important-links" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">महत्त्वाच्या लिंक्स (Important Links)</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Link Description)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">लिंक (Download / Action)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">पोस्ट ऑफिस GDS निकाल २०२६ (Merit List)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://indiapostgdsonline.gov.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto no-underline">
                    <HiOutlineArrowTopRightOnSquare className="text-base shrink-0" /> निकाल पहा (Check Result)
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">अधिकृत संकेतस्थळ (Official Website)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://indiapostgdsonline.gov.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-emerald-500/20 w-full sm:w-auto no-underline">
                    <HiOutlineArrowTopRightOnSquare className="text-base shrink-0" /> वेबसाइटला भेट द्या
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative">
      <span class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md">
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-text-main mb-4">
          Post Office GDS Result 2026: State-wise Merit List & Cutoff Marks
        </h2>
        <p class="text-text-muted leading-relaxed italic">
          India Post has declared the Gramin Dak Sevak (GDS), Branch Postmaster (BPM), and Assistant Branch Postmaster (ABPM) results and merit list for various circles across the country. Candidates can download the result PDF files and check the cutoff scores online.
        </p>
      </div>

      <!-- Table of Contents (English) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          Key Topics in this Article (English)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li>
            <a
              href="#en-gds-overview"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >GDS Recruitment Overview</a
            >
          </li>
          <li>
            <a
              href="#en-how-to-check"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >How to Check the Result (Steps)</a
            >
          </li>
          <li>
            <a
              href="#en-cutoff-marks"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Expected Category-wise Cutoffs</a
            >
          </li>
          <li>
            <a
              href="#en-next-steps"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Next Stage: Document Verification</a
            >
          </li>
          <li>
            <a
              href="#en-important-links"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Important Links</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (English) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <p>
          The India Post has announced the results for Gramin Dak Sevak (GDS) recruitment 2026. The selection has been conducted on the basis of 10th-grade (SSC) board marks without any written examination. Shortlisted candidates are selected to serve as GDS, BPM, or ABPM across different pin circles.
        </p>

        <!-- Overview Table (English) -->
        <div class="overflow-x-auto my-6 border border-border-card rounded-2xl bg-bg-surface p-4">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th colspan="2" class="p-3 text-center font-bold text-text-main text-base border border-border-card">
                  India Post GDS Result 2026 Overview
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main w-[40%] bg-primary/5">Department</td>
                <td class="p-3 border border-border-card text-text-muted">Department of Posts (India Post)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">Post Names</td>
                <td class="p-3 border border-border-card text-text-muted">Gramin Dak Sevak (GDS), BPM, ABPM</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">Total Vacancies</td>
                <td class="p-3 border border-border-card text-text-muted">40,220</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">Result Status</td>
                <td class="p-3 border border-border-card text-emerald-500 font-bold">Declared</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">Result Date</td>
                <td class="p-3 border border-border-card text-text-muted">25 May 2026</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main bg-primary/5">Official GDS Link</td>
                <td class="p-3 border border-border-card">
                  <a href="https://indiapostgdsonline.gov.in" target="_blank" rel="noopener noreferrer" class="text-primary font-bold hover:underline inline-flex items-center gap-1">
                    indiapostgdsonline.gov.in <HiOutlineArrowTopRightOnSquare className="text-xs shrink-0" />
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="en-gds-overview">GDS Recruitment 2026 Overview</h2>
        <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
          <p class="m-0">
            India Post GDS recruitment is one of the most popular direct-entry government job recruitments in India. Candidates are selected based on an automated system-generated merit list generated purely on their Class 10 marksheet percentage. Circle-wise result PDFs are now online.
          </p>
        </div>

        <h2 id="en-how-to-check">How to Check India Post GDS Result 2026?</h2>
        <p>Follow these steps to access your result and check your status in the merit list:</p>
        
        <div class="space-y-6 pl-2 border-l-2 border-primary/30">
          <div class="relative pl-8">
