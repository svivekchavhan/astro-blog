---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineClock,
  HiOutlineClipboardDocumentList,
  HiOutlineExclamationTriangle,
  HiOutlineShieldCheck,
} from "react-icons/hi2";

const title =
  "बँक ऑफ बडोदा मध्ये 'लोकल बँक ऑफिसर' २५०० जागांसाठी भरती २०२५: ऑनलाईन अर्ज सुरू (BOB LBO Bharti)";
const description =
  "Bank of Baroda LBO Recruitment 2025: Bank of Baroda invites online applications for 2,500 Local Bank Officer (JMG/S-I) vacancies (Advt No. BOB/HRM/REC/ADVT/2025/05). Graduation degree + 1 year officer experience in RBI Second Schedule Commercial Bank/RRB eligible. Apply online by 7 September 2026.";
const canonicalURL =
  "https://mahasandhi.in/bank-of-baroda-lbo-recruitment-2025";
const date = "August 18, 2026";
const category = "Bank Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Bank of Baroda LBO Bharti 2025" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-3"
      >
        <HiOutlineBriefcase className="text-sm" /> Advt No: BOB/HRM/REC/ADVT/2025/05
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          बँक ऑफ बडोदा (Bank of Baroda) 'लोकल बँक ऑफिसर' (LBO) पदभरती २०२५
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Bank of Baroda LBO Recruitment 2025:</strong> भारतातील अग्रगण्य
            सार्वजनिक क्षेत्रातील बँकांपैकी एक असलेल्या <strong
              >बँक ऑफ बडोदा (BOB)</strong
            > द्वारे <strong
              >'लोकल बँक ऑफिसर' (Local Bank Officer - JMG/S-I)</strong
            > या पदांच्या एकूण <strong>२,५०० रिक्त जागा</strong> भरण्यासाठी अधिकृत
            भरती जाहिरात (Advt No. <strong>BOB/HRM/REC/ADVT/2025/05</strong>)
            प्रसिद्ध करण्यात आली आहे. पात्र भारतीय नागरिकांकडून ऑनलाईन अर्ज
            मागविण्यात येत आहेत.
          </p>
          <p>
            ऑनलाईन नोंदणी व अर्ज भरण्याची प्रक्रिया <strong
              >१८ ऑगस्ट २०२६ ते ०७ सप्टेंबर २०२६</strong
            > पर्यंत सुरू राहील. उमेदवारांची निवड ते अर्ज करत असलेल्या संबंधित राज्यासाठीच
            केली जाईल.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >बँकेचे नाव</span
              >
              <span class="text-text-main font-semibold text-sm"
                >बँक ऑफ बडोदा (BOB)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >पदाचे नाव व श्रेणी</span
              >
              <span class="text-text-main font-semibold text-sm"
                >Local Bank Officer (JMG/S-I)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण पदे व पोस्टिंग</span
              >
              <span class="text-text-main font-semibold text-sm"
                >२,५०० पदे (अर्ज केलेल्या राज्यातच)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCalendarDays
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >अंतिम तारीख</span
              >
              <span class="text-rose-500 font-bold text-sm"
                >०७ सप्टेंबर २०२६</span
              >
            </div>
          </div>
        </div>

        <!-- Vacancy Details Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          पदसंख्या, शैक्षणिक पात्रता, अनुभव व वयोमर्यादा (दि. ०१.०७.२०२५ रोजी)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव व श्रेणी</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >एकूण जागा</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा (01.07.2025 रोजी)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >शैक्षणिक अर्हता व अनुभव</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-primary text-base"
                >
                  लोकल बँक ऑफिसर<br />
                  <span class="text-xs text-text-muted font-normal"
                    >(Local Bank Officer - JMG/S-I)</span
                  >
                </td>
                <td
                  class="p-3 border border-border-card font-black text-rose-500 text-center text-xl"
                >
                  २,५००
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  • किमान: <strong>२१ वर्षे</strong><br />
                  • कमाल: <strong>३० वर्षे</strong><br />
                  <span class="text-xs text-text-muted"
                    >(नियमानुसार मागासवर्गीय उमेदवारांना वयोमर्यादेत सवलत लागू)</span
                  >
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  <p class="mb-2">
                    🎓 <strong>शैक्षणिक पात्रता:</strong> मान्यताप्राप्त विद्यापीठातून
                    कोणत्याही शाखेतील <strong>पदवी (Graduation / IDD)</strong>.
                    (Chartered Accountant (CA), Cost Accountant, Engineering,
                    किंवा Medical पदवीधर देखील पात्र).
                  </p>
                  <p class="mb-2">
                    💼 <strong>अनुभव:</strong> RBI च्या दुसऱ्या अनुसूचीतील कोणत्याही
                    <strong
                      >अनुसूचित व्यावसायिक बँक (Scheduled Commercial Bank)</strong
                    > किंवा <strong>प्रादेशिक ग्रामीण बँकेत (RRB)</strong> अधिकारी
                    (Officer) म्हणून किमान <strong>१ वर्षाचा अनुभव</strong> आवश्यक.
                  </p>
                  <p class="m-0 text-xs text-primary font-semibold">
                    🗣️ <strong>भाषा प्राविण्य:</strong> अर्ज केलेल्या राज्याची स्थानिक
                    भाषा वाचता, लिहिता, बोलता आणि समजता येणे अनिवार्य आहे.
                  </p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Experience Ineligibility Box -->
        <div
          class="bg-amber-500/10 border border-amber-500/30 p-5 rounded-2xl text-sm mb-6"
        >
          <h3
            class="text-amber-600 dark:text-amber-400 font-extrabold text-base flex items-center gap-2 mt-0 mb-3 border-none p-0"
          >
            <HiOutlineExclamationTriangle className="text-xl shrink-0" /> महत्त्वाचे:
            कोणत्या अनुभवाला मान्यता असणार नाही? (Experience Exclusion Rules)
          </h3>
          <ul class="list-disc pl-6 space-y-1.5 text-text-main">
            <li>
              NBFCs, सहकारी बँका (Cooperative Banks), पेमेंट्स बँक्स (Payment
              Banks), स्मॉल फायनान्स बँक्स (Small Finance Banks) किंवा फिनटेक
              (Fintech) कंपन्यांमधील अनुभव ग्राह्य धरला जाणार नाही.
            </li>
            <li>
              कोणत्याही संस्थेतील ६ महिन्यांपेक्षा कमी कालावधीचा पदोत्तर अनुभव
              आणि लिपिक संवर्गातील (Clerical Cadre) अनुभव विचारात घेतला जाणार
              नाही.
            </li>
          </ul>
        </div>

        <!-- Selection Procedure & Important Conditions -->
        <h2
          id="selection-process"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          निवड पद्धत व महत्त्वाच्या अटी (Selection Procedure & Key Rules)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3"
        >
          <ul class="list-disc pl-6 space-y-2 text-text-muted">
            <li>
              <strong>निवड पद्धत:</strong> अर्जांची शॉर्टलिस्टिंग (Short-listing)
              आणि मुलाखत / निवड पद्धतीद्वारे निवड केली जाईल. हे शॉर्टलिस्टिंग तात्पुरत्या
              स्वरूपाचे (Purely Provisional) असेल.
            </li>
            <li>
              <strong>मूलभूत कागदपत्र पडताळणी:</strong> बँकेने बोलावल्यास सर्व मूळ
              कागदपत्रांची पडताळणी अनिवार्य असेल.
            </li>
            <li>
              <strong>स्थानिक पदस्थापना:</strong> निवड झालेल्या उमेदवारांची नियुक्ती
              त्यांनी अर्ज केलेल्या संबंधित राज्यातच केली जाईल.
            </li>
            <li>
              <strong>अर्जाची पावती:</strong> ऑनलाईन पद्धतीने शुल्क भरल्यानंतरच अर्ज
              प्रक्रिया पूर्ण मानली जाईल. उमेदवारांनी ॲकनॉलेजमेंट नंबर (Acknowledgement
              Number) व अर्जाची प्रत जपून ठेवावी.
            </li>
            <li>
              <strong>अधिकृत माहिती व अपडेट्स:</strong> सर्व सुधारणा / शुद्धिपत्रक
              (Corrigendum) बँकेच्या अधिकृत संकेतस्थळावर ('Current Opportunities')
              प्रसिद्ध केले जातील. सर्व पत्रव्यवहार ऑनलाईन अर्जात दिलेल्या ई-मेल आयडीवरच
              केला जाईल.
            </li>
          </ul>
        </div>

        <!-- Important Dates & Links Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          {
            translateMarathi(
              "महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)",
            )
          }
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तारीख / दुवा (Date / Action)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज व शुल्क भरण्याची सुरुवात</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >18 August 2026</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज सादर करण्याची व शुल्क भरण्याची अंतिम तारीख (Last
                  Date)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-rose-500 text-lg shrink-0"
                    /> ०७ सप्टेंबर २०२६</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >Official Apply Link
                </td>
                <td class="p-3 border border-border-card">
                  <a
                    href="https://ibpsreg.ibps.in/bobjul26/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto"
                  >
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> BOB
                    LBO Apply Online (IBPS Portal)
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >बँक ऑफ बडोदा अधिकृत संकेतस्थळ (Official Website)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://bankofbaroda.bank.in/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> bankofbaroda.bank.in
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2
          id="faq"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न १: बँक ऑफ बडोदा LBO भरती २०२५ साठी ऑनलाईन अर्ज करण्याची
              शेवटची तारीख कोणती आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: ऑनलाईन अर्ज सादर करण्याची व परीक्षा शुल्क भरण्याची शेवटची
              तारीख ०७ सप्टेंबर २०२६ आहे.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न २: या भरतीमध्ये एकूण किती जागा आहेत?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: लोकल बँक ऑफिसर (LBO) पदाच्या एकूण २,५०० जागांसाठी भरती
              प्रक्रिया राबवली जात आहे.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न ३: सहकारी बँक किंवा स्मॉल फायनान्स बँकेतील अनुभव ग्राह्य
              धरला जाईल का?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: नाही. NBFCs, सहकारी बँका, पेमेंट्स बँक्स, स्मॉल फायनान्स
              बँक्स किंवा फिनटेक कंपन्यांमधील अनुभव ग्राह्य धरला जाणार नाही.
              केवळ RBI च्या दुसऱ्या अनुसूचीतील Scheduled Commercial Bank किंवा
              RRB मधील १ वर्षाचा अधिकारी अनुभव आवश्यक आहे.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न ४: वयोमर्यादा काय आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: दि. ०१.०७.२०२५ रोजी उमेदवाराचे वय किमान २१ वर्षे व कमाल ३०
              वर्षे असावे (नियमानुसार सवलत लागू).
            </p>
          </div>
        </div>

        <!-- ================= LANGUAGE SEPARATOR ================= -->
        <div
          class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative"
        >
          <span
