---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import { OFFICIAL_LINKS } from "../constants/links";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineArrowLeft,
  HiOutlineBell,
  HiOutlineShieldCheck,
  HiOutlineCamera,
  HiOutlineClipboardDocumentCheck,
} from "react-icons/hi2";
import { FaWhatsapp } from "react-icons/fa";

const title =
  "दिल्ली उच्च न्यायालय भरती २०२६: सिनियर पर्सनल असिस्टंट (SPA) व पर्सनल असिस्टंट (PA) १५० जागांसाठी ऑनलाईन अर्ज सुरू!";
const description =
  "Delhi High Court SPA & PA Recruitment 2026: High Court of Delhi announces 150 Senior Personal Assistant (117) & Personal Assistant (33) vacancies. Graduate pass eligible. Online registration from 15 Sep to 05 Oct 2026. Selection via Typing, Shorthand, Mains & Interview.";
const canonicalURL = "https://mahasandhi.in/delhi-high-court-spa-pa-recruitment-2026";
const date = "September 16, 2026";
const category = "Central Govt";
const applyUrl = OFFICIAL_LINKS.delhiHighCourtApplyPortal;
const officialWebsiteUrl = OFFICIAL_LINKS.delhiHighCourtPortal;
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Delhi High Court SPA PA Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Back Button -->
    <div class="mb-6 not-prose">
      <a
        href="/current-recruitment"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-text-muted hover:text-primary bg-bg-surface border border-border-card rounded-xl transition-all duration-300 no-underline"
      >
        <HiOutlineArrowLeft className="text-sm" /> back to current recruitment / मागे जा
      </a>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span
          class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-emerald-500/20 flex items-center gap-1.5 shadow-xs"
        >
          <HiOutlineBell className="text-sm shrink-0 animate-pulse" />
          {category} (ऑनलाईन अर्ज सुरू)
        </span>
        <span
          class="bg-rose-500/10 text-rose-600 dark:text-rose-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-rose-500/20 flex items-center gap-1.5"
        >
          <HiOutlineCalendarDays className="text-sm" /> अर्ज अंतिम तारीख: ०५ ऑक्टोबर २०२६
        </span>
        <span class="text-text-muted text-xs font-semibold">• {date}</span>
      </div>

      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-4 sm:pl-6 py-2 italic font-medium"
      >
        {description}
      </p>
    </div>

    <!-- Quick Action Apply Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 not-prose">
      <a
        href={applyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-5 bg-gradient-to-br from-primary to-indigo-700 text-white rounded-2xl transition-all duration-300 shadow-md hover:shadow-primary/20 flex items-center justify-between no-underline"
      >
        <div>
          <span
            class="text-[0.65rem] uppercase font-extrabold tracking-wider bg-white/20 px-2.5 py-0.5 rounded text-white block w-fit mb-1"
            >Delhi High Court Recruitment Portal</span
          >
          <h3
            class="text-base sm:text-lg font-extrabold text-white m-0 flex items-center gap-1.5"
          >
            Apply Online Portal <HiOutlineArrowTopRightOnSquare
              className="text-xl shrink-0"
            />
          </h3>
          <p class="text-xs text-white/90 m-0 mt-1">
            १५ सप्टेंबर ते ०५ ऑक्टोबर २०२६ पर्यंत ऑनलाईन अर्ज करा
          </p>
        </div>
        <div
          class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform"
        >
          <HiOutlineCursorArrowRays className="text-2xl" />
        </div>
      </a>

      <a
        href={officialWebsiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 bg-bg-surface border border-border-card hover:border-primary/50 rounded-2xl flex items-center justify-between transition-all duration-300 no-underline group shadow-xs"
      >
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform"
          >
            <HiOutlineBuildingOffice className="text-2xl" />
          </div>
          <div>
            <span
              class="text-xs text-text-muted font-bold uppercase tracking-wider block"
              >अधिकृत संकेतस्थळ</span
            >
            <h4
              class="text-sm font-bold text-text-main m-0 group-hover:text-primary transition-colors flex items-center gap-1"
            >
              delhihighcourt.nic.in <HiOutlineArrowTopRightOnSquare className="text-xs" />
            </h4>
            <p class="text-xs text-text-muted m-0 mt-0.5">
              High Court of Delhi Official Portal
            </p>
          </div>
        </div>
      </a>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex flex-wrap items-center gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Summary</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2
          id="main-keyword-mr"
          class="text-xl md:text-2xl font-black text-text-main mt-2"
        >
          🏛️ दिल्ली उच्च न्यायालय (Delhi High Court) SPA व PA पदभरती जाहिरात २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6 space-y-4">
          <p>
            <strong>Delhi High Court SPA & PA Recruitment 2026:</strong> दिल्ली उच्च
            न्यायालयाने (High Court of Delhi) <strong
              >Senior Personal Assistant (SPA)</strong
            > आणि <strong>Personal Assistant (PA)</strong> या पदांच्या एकूण <strong>१५० जागांसाठी</strong>
            अधिकृत भरती जाहिरात प्रसिद्ध केली आहे.
          </p>
          <p>
            या भरती अंतर्गत <strong>Senior Personal Assistant (SPA) च्या ११७ जागा</strong> आणि
            <strong>Personal Assistant (PA) च्या ३३ जागा</strong> भरण्यात येणार आहेत. मान्यताप्राप्त
            विद्यापीठाचे पदवीधर उमेदवार ज्यांच्याकडे इंग्रजी शॉर्टहँड व टायपिंगचे कौशल्य आहे, ते या
            भरतीसाठी पात्र आहेत. ऑनलाईन अर्ज प्रक्रिया <strong
              class="text-rose-600 dark:text-rose-400">१५ सप्टेंबर २०२६ (सकाळी ११:०० वा.)</strong
            > पासून सुरू झाली असून अंतिम तारीख <strong
              class="text-rose-600 dark:text-rose-400">०५ ऑक्टोबर २०२६ (रात्री ११:०० वा.)</strong
            > आहे.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >संस्थेचे नाव</span
              >
              <span class="text-text-main font-semibold text-sm"
                >दिल्ली उच्च न्यायालय (Delhi High Court)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण पदे (Total Vacancies)</span
              >
              <span class="text-text-main font-bold text-sm text-primary"
                >१५० (SPA: ११७, PA: ३३)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >निवड टप्पे (Selection Stages)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >४ टप्पे (Typing, Shorthand, Mains, Interview)</span
              >
            </div>
          </div>
        </div>

        <!-- Vacancy Details Table -->
        <h2
          id="vacancy-details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 पदनिहाय रिक्त जागा (Post Wise Vacancy Summary)
        </h2>
        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3.5 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3.5 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >एकूण जागा (Total Vacancies)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3.5 border border-border-card font-bold text-primary"
                >
                  Senior Personal Assistant (SPA)
                </td>
                <td
                  class="p-3.5 border border-border-card font-black text-emerald-600 dark:text-emerald-400 text-center text-base"
                >
                  ११७
                </td>
              </tr>
              <tr>
                <td
                  class="p-3.5 border border-border-card font-bold text-primary"
                >
                  Personal Assistant (PA)
                </td>
                <td
                  class="p-3.5 border border-border-card font-black text-emerald-600 dark:text-emerald-400 text-center text-base"
                >
                  ३३
                </td>
              </tr>
              <tr class="bg-primary/5 font-extrabold">
                <td class="p-3.5 border border-border-card text-text-main">
                  एकूण पदे (Total Vacancies)
                </td>
                <td
                  class="p-3.5 border border-border-card text-rose-600 dark:text-rose-400 text-center text-lg"
                >
                  १५०
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Educational Qualification -->
        <h2
          id="qualification"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 शैक्षणिक पात्रता (Educational Qualification)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-4 mb-6"
        >
          <div class="border-b border-border-card pb-3">
            <h3 class="text-base font-bold text-primary mb-1">
              १. Senior Personal Assistant (SPA):
            </h3>
            <ul class="list-disc pl-6 space-y-1 text-text-main font-medium m-0">
              <li>मान्यताप्राप्त विद्यापीठाची <strong>कोणत्याही शाखेतील पदवी (Graduation Degree)</strong>.</li>
              <li>इंग्रजी शॉर्टहँड (English Shorthand): <strong>११० शब्द प्रति मिनिट (110 wpm)</strong> गति.</li>
              <li>संगणकावर इंग्रजी टंकलेखन (English Typewriting on Computer): <strong>४० शब्द प्रति मिनिट (40 wpm)</strong> गति.</li>
            </ul>
          </div>
          <div>
            <h3 class="text-base font-bold text-primary mb-1">
              २. Personal Assistant (PA):
            </h3>
            <ul class="list-disc pl-6 space-y-1 text-text-main font-medium m-0">
              <li>मान्यताप्राप्त विद्यापीठाची <strong>कोणत्याही शाखेतील पदवी (Graduation Degree)</strong>.</li>
              <li>इंग्रजी शॉर्टहँड (English Shorthand): <strong>१०० शब्द प्रति मिनिट (100 wpm)</strong> गति.</li>
              <li>संगणकावर इंग्रजी टंकलेखन (English Typewriting on Computer): <strong>४० शब्द प्रति मिनिट (40 wpm)</strong> गति.</li>
            </ul>
          </div>
        </div>

        <!-- Age Limit Details -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 वयोमर्यादा (Age Limit - दि. ०१ जानेवारी २०२६ रोजी)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3 mb-6"
        >
          <p class="m-0 text-text-main font-bold">
            वय मोजण्याचा दिनांक: <span class="text-rose-600 dark:text-rose-400"
              >०१ जानेवारी २०२६</span
            > (उमेदवाराचा जन्म <strong>०२-०१-१९९४ ते ०१-०१-२००८</strong> दरम्यान असावा)
          </p>
          <p class="m-0 text-text-main font-semibold">
            कमीत कमी वय: <strong>१८ वर्षे</strong> | कमाल वय: <strong>३२ वर्षे</strong> (SPA व PA दोन्ही पदांसाठी)
          </p>
          <hr class="border-border-card/60 my-2" />
          <h4 class="text-xs uppercase font-extrabold tracking-wider text-primary m-0">
            प्रवर्गनिहाय वयोमर्यादा सूट (Upper Age Relaxation):
          </h4>
          <ul class="list-disc pl-6 space-y-1 text-text-muted m-0">
            <li><strong>SC / ST प्रवर्ग:</strong> ०५ वर्षे सूट (१८ ते ३७ वर्षे)</li>
            <li><strong>OBC-NCL प्रवर्ग:</strong> ०३ वर्षे सूट (१८ ते ३५ वर्षे)</li>
            <li><strong>PwBD (General / EWS):</strong> १० वर्षे सूट (१८ ते ४२ वर्षे)</li>
            <li><strong>PwBD (OBC):</strong> १३ वर्षे सूट (१८ ते ४५ वर्षे)</li>
            <li><strong>PwBD (SC / ST):</strong> १५ वर्षे सूट (१८ ते ४७ वर्षे)</li>
            <li><strong>माजी सैनिक (Ex-Servicemen):</strong> ०३ वर्षे अतिरिक्त सूट</li>
          </ul>
        </div>

        <!-- Application Fee Details -->
        <h2
          id="application-fee"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 ऑनलाईन अर्ज शुल्क (Application Fee)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-2 mb-6"
        >
          <ul class="list-disc pl-6 space-y-1.5 text-text-main font-medium m-0">
            <li>
              <strong>General / OBC-NCL / EWS प्रवर्ग:</strong>
              <span class="text-primary font-extrabold">₹१,५००/-</span> (+ बँक ट्रान्सअॅक्शन शुल्क)
            </li>
            <li>
              <strong>SC / ST / PwBD (४०% किंवा अधिक अपंगत्व) प्रवर्ग:</strong>
              <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">₹१,३००/-</span> (+ बँक ट्रान्सअॅक्शन शुल्क)
            </li>
          </ul>
          <p class="text-xs text-text-muted m-0 pt-2 border-t border-border-card/50">
            * टीप: अर्ज शुल्क Non-refundable आहे. शुल्क भरणा UPI, Net Banking, Credit Card किंवा Debit Card द्वारे ऑनलाईन केला जाऊ शकतो.
          </p>
        </div>

        <!-- Application & Registration Process -->
        <h2
          id="registration-process"
          class="text-xl md:text-2xl font-black text-primary mb-3 mt-8 border-l-4 border-primary pl-3 flex items-center gap-2"
        >
          <span>📝 अर्ज करण्याची पद्धत व महत्त्वाच्या सूचना (Registration Guidelines)</span>
        </h2>

        <!-- Alert Notice Banner -->
        <div class="mb-6 bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 flex items-center gap-3 text-amber-700 dark:text-amber-300">
          <HiOutlineShieldCheck className="text-2xl shrink-0 text-amber-500" />
          <p class="text-xs sm:text-sm font-semibold m-0 leading-relaxed">
            <strong>महत्त्वाची सूचना:</strong> अर्ज फक्त ऑनलाईन पद्धतीने स्वीकारले जातील. ऑफलाईन अर्ज किंवा टपालाद्वारे पाठवलेले अर्ज स्वीकारले जाणार नाहीत.
          </p>
        </div>

        <!-- Visual Step-by-Step Registration Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 not-prose">
          <!-- Step 1 -->
          <div class="bg-bg-surface border border-border-card hover:border-primary/50 p-5 rounded-2xl transition-all duration-300 shadow-xs hover:shadow-md flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-[0.65rem] font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  Step 1 • नोंदणी
                </span>
                <HiOutlineCursorArrowRays className="text-xl text-primary" />
              </div>
              <h3 class="text-base font-extrabold text-text-main mb-1.5 m-0">
                १. ऑनलाईन नोंदणी (Registration)
              </h3>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                वैध ईमेल आयडी (Email ID) आणि मोबाईल नंबर वापरून ऑनलाईन पोर्टलवर नोंदणी करा. प्राप्त झालेला Application / Registration Number सुरक्षित लिहून ठेवा.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="bg-bg-surface border border-border-card hover:border-primary/50 p-5 rounded-2xl transition-all duration-300 shadow-xs hover:shadow-md flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-[0.65rem] font-black uppercase tracking-wider bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">
                  Step 2 • लाईव्ह फोटो
                </span>
                <HiOutlineCamera className="text-xl text-indigo-500" />
              </div>
              <h3 class="text-base font-extrabold text-text-main mb-1.5 m-0">
                २. थेट फोटो कॅप्चर (Live Photo Capture)
              </h3>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                ऑनलाईन अर्जामध्ये वेबकॅम (Webcam) किंवा मोबाईल कॅमेऱ्याद्वारे <strong>Live Photograph</strong> कॅप्चर करणे अनिवार्य आहे.
              </p>
            </div>
          </div>

