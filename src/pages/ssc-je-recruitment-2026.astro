---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineExclamationTriangle,
  HiOutlineSparkles,
  HiOutlineUserGroup,
  HiOutlineArrowTopRightOnSquare,
} from "react-icons/hi2";

const title =
  "SSC JE Recruitment 2026: स्टाफ सिलेक्शन कमिशन द्वारे १,७४८ जागांसाठी कनिष्ठ अभियंता (JE) भरती जाहीर!";
const description =
  "SSC Junior Engineer (JE) Recruitment 2026: Staff Selection Commission (SSC) द्वारे १,७४८ कनिष्ठ अभियंता (Civil, Mechanical, Electrical & Scientific Assistant) पदांसाठी ऑनलाईन अर्ज सुरू. अर्ज मुदत: २२ सप्टेंबर २०२६. ऑनलाईन अर्ज, पात्रता, वयोमर्यादा व अधिकृत जाहिरात एकाच ठिकाणी.";
const canonicalURL = "https://mahasandhi.in/ssc-je-recruitment-2026";
const date = "September 02, 2026";
const category = "SSC Recruitment";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Mega Recruitment", url: "/mega-recruitment" },
    { name: "SSC JE Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20 flex items-center gap-1.5"
        >
          <HiOutlineSparkles className="text-sm" />
          {category} (केन्द्रीय भरती)
        </span>
        <span
          class="bg-rose-500/10 text-rose-600 dark:text-rose-400 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border border-rose-500/20"
        >
          १,७४८ पदे (Tentative)
        </span>
        <span class="text-text-muted text-sm font-semibold">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language & Navigation Links -->
    <div class="flex flex-wrap items-center gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#important-links"
        class="text-rose-600 dark:text-rose-400 font-bold text-sm hover:underline flex items-center gap-1"
        >🔗 अर्ज दुवे व पीडीएफ (Official Links) →</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          कर्मचारी निवड आयोग (SSC) कनिष्ठ अभियंता (JE) भरती २०२६ जाहिरात
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>SSC JE Recruitment 2026:</strong> कर्मचारी निवड आयोगामार्फत (Staff Selection Commission - SSC) केंद्र सरकारच्या विविध मंत्रालये व विभागांमधील <strong>कनिष्ठ अभियंता (Junior Engineer - JE)</strong> पदांच्या अंदाजे <strong>१,७४८ जागांसाठी</strong> अधिकृत भरती जाहिरात प्रसिद्ध करण्यात आली आहे.
          </p>
          <p>
            या भरती अंतर्गत <strong>सिव्हिल (Civil), मेकॅनिकल (Mechanical), इलेक्ट्रिकल (Electrical) इंजिनिअरिंग</strong> पदविका (Diploma) किंवा पदवी (Degree) धारक उमेदवारांना केंद्र सरकारी नोकरीची सुवर्णसंधी उपलब्ध झाली आहे. ऑनलाईन अर्ज प्रक्रिया <strong>०२ सप्टेंबर २०२६</strong> पासून सुरू झाली असून अर्ज करण्याची अंतिम मुदत <strong>२२ सप्टेंबर २०२६ (रात्री ११:०० वाजेपर्यंत)</strong> आहे.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >आयोजक संस्था</span
              >
              <span class="text-text-main font-semibold text-sm"
                >Staff Selection Commission (SSC)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >पदाचे नाव व जागा</span
              >
              <span class="text-text-main font-semibold text-sm"
                >कनिष्ठ अभियंता (१,७४८ पदे)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineCalendarDays
              className="text-rose-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >अर्ज अंतिम मुदत</span
              >
              <span class="text-rose-600 dark:text-rose-400 font-extrabold text-sm"
                >२२ सप्टेंबर २०२६ (११:०० PM)</span
              >
            </div>
          </div>
        </div>

        <!-- Summary Table -->
        <h2
          id="summary"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          SSC JE भरती २०२६: थोडक्यात माहिती (Recruitment Overview)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >📌 घटक (Parameter)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >विवरण (Details)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🏢 भरती संस्था (Organization)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >कर्मचारी निवड आयोग (Staff Selection Commission - SSC)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >👷 पदाचे नाव (Post Name)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >कनिष्ठ अभियंता (Junior Engineer - Civil, Electrical, Mechanical & Scientific Assistant)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🔢 एकूण पदसंख्या (Total Vacancies)</td
                >
                <td
                  class="p-3 border border-border-card font-extrabold text-rose-600 dark:text-rose-400 text-base"
                  >१,७४८ पदे (अंदाजीत / Tentative)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🎓 शैक्षणिक पात्रता (Qualification)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >सिव्हिल / मेकॅनिकल / इलेक्ट्रिकल मध्ये डिप्लोमा किंवा B.E./B.Tech पदवी (किंवा B.Sc./Computer Science/Physics)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🎂 वयोमर्यादा (Age Limit)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >१८ ते ३०/३२ वर्षे (दि. ०१ ऑगस्ट २०२६ रोजी, नियमांनुसार सवलत)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >💵 अर्ज शुल्क (Application Fee)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  ><strong>₹१००/-</strong> (महिला/SC/ST/PwBD/Ex-SM उमेदवारांना <strong>मोफत / शुल्क नाही</strong>)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >📝 ऑनलाईन अर्ज मुदत (Application Window)</td
                >
                <td
                  class="p-3 border border-border-card text-emerald-600 dark:text-emerald-400 font-bold"
                  >०२ सप्टेंबर ते २२ सप्टेंबर २०२६ (रात्री ११:०० वाजेपर्यंत)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >💳 ऑनलाईन शुल्क भरण्याची अंतिम तारीख</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >२३ सप्टेंबर २०२६ (रात्री ११:०० वाजेपर्यंत)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >✏️ अर्ज दुरुस्ती कालावधी (Correction Window)</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-amber-600 dark:text-amber-400"
                  >२८ सप्टेंबर ते ३० सप्टेंबर २०२६</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🗓️ परीक्षा दिनांक (Exam Dates)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >• Paper-I: <strong>ऑक्टोबर / नोव्हेंबर २०२६ (Tentative)</strong><br />
                  • Paper-II: <strong>डिसेंबर २०२६ (Tentative)</strong></td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-semibold text-text-main"
                  >🖥️ निवड प्रक्रिया (Selection Process)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >Paper-1 CBT (ऑब्जेक्टिव्ह) → Paper-2 CBT (संगणक आधारित) → कागदपत्र पडताळणी (DV)</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Post Names & Eligibility Details -->
        <h2
          id="qualification"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          पदनिहाय शैक्षणिक पात्रता व पात्र शाखा (Eligibility & Streams)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          SSC JE भरती २०२६ अंतर्गत विविध अभियांत्रिकी शाखांसाठी खालीलप्रमाणे पात्रता आवश्यक आहे:
        </p>

        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >कनिष्ठ अभियंता शाखा / विभाग</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक अर्हता (Educational Qualification)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >Civil Engineering (सिव्हिल इंजिनिअरिंग)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • सिव्हिल इंजिनिअरिंग मधील <strong>3-वर्षीय डिप्लोमा (Diploma in Civil)</strong> किंवा मान्यताप्राप्त विद्यापीठाची <strong>B.E. / B.Tech पदवी</strong>.
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >Mechanical Engineering (मेकॅनिकल इंजिनिअरिंग)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • मेकॅनिकल इंजिनिअरिंग मधील <strong>3-वर्षीय डिप्लोमा (Diploma in Mechanical)</strong> किंवा मान्यताप्राप्त संस्था/विद्यापीठाची <strong>B.E. / B.Tech पदवी</strong>.
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >Electrical Engineering (इलेक्ट्रिकल इंजिनिअरिंग)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • इलेक्ट्रिकल इंजिनिअरिंग मधील <strong>3-वर्षीय डिप्लोमा (Diploma in Electrical)</strong> किंवा मान्यताप्राप्त विद्यापीठाची <strong>B.E. / B.Tech पदवी</strong>.
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-primary"
                  >Scientific Assistant (IMD) / इतर पदे</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • भौतिकशास्त्र (Physics) विषयासह विज्ञान शाखेतील पदवी <strong>(B.Sc. with Physics)</strong>, किंवा<br />
                  • संगणक शास्त्र / संगणक अर्ज / इलेक्ट्रॉनिक्स पदवी <strong>(Computer Science / Applications / Electronics)</strong> किंवा समतुल्य अर्हता.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit Section -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वयोमर्यादा व शिथिलता (Age Limit Criteria)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          उमेदवाराचे वय <strong>०१ ऑगस्ट २०२६</strong> रोजी <strong>१८ ते ३० वर्षे / ३२ वर्षे</strong> (विशिष्ट पदनिहाय नियमांनुसार) असणे आवश्यक आहे.
        </p>

        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >प्रवर्ग (Category)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा सवलत (Age Relaxation)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main"
                  >👤 अराखीव (UR) / EWS</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >कमाल ३० किंवा ३२ वर्षे (पदनिहाय)</td
                >
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main"
                  >🟠 OBC</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  ><strong>+३ वर्षे सूट</strong> (कमाल ३३ किंवा ३५ वर्षे)</td
                >
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main"
                  >🔵 SC / ST</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  ><strong>+५ वर्षे सूट</strong> (कमाल ३५ किंवा ३७ वर्षे)</td
                >
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main"
                  >♿ PwBD (दिव्यांग)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  ><strong>+१० वर्षे (UR), +१३ वर्षे (OBC), +१५ वर्षे (SC/ST)</strong></td
                >
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main"
                  >🪖 माजी सैनिक (Ex-Servicemen)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >शासकीय नियमांनुसार सेवा कालावधी वजा करून सवलत</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Application Fee Section -->
        <h2
          id="fee-details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          अर्ज शुल्क (Application Fee)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-4 mb-8 shadow-xs"
        >
          <div class="flex items-start gap-3">
            <HiOutlineCurrencyRupee
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <h3 class="text-base font-bold text-text-main m-0 mb-1">
                General / OBC / EWS (पुरुष उमेदवार):
              </h3>
              <p class="text-text-muted text-xs m-0">
                • <strong>ऑनलाईन परीक्षा शुल्क: ₹१००/- (रुपये शंभर फक्त)</strong><br />
                • शुल्काचा भरणा ऑनलाईन पद्धतीने (UPI, Net Banking, Debit/Credit Card) करता येईल.
              </p>
            </div>
          </div>
          <hr class="border-border-card" />
          <div class="flex items-start gap-3">
            <HiOutlineCheckCircle
              className="text-emerald-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <h3 class="text-base font-bold text-emerald-600 dark:text-emerald-400 m-0 mb-1">
                सर्व महिला / SC / ST / PwBD / Ex-Servicemen उमेदवार:
              </h3>
              <p class="text-text-muted text-xs m-0">
                • <strong>कोणतेही परीक्षा शुल्क नाही (Free / Exempted)</strong>.
              </p>
            </div>
          </div>
        </div>

        <!-- Important Dates & Official Links Table -->
        <h2
