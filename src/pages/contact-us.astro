---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us - Get in Touch for Queries & Feedback | MahaSandhi" description="Contact MahaSandhi team for queries, feedback, or collaboration about government jobs, exam updates, and recruitment notifications. Reach us at mahasandhi.in.">
  <section class="py-8 pb-24">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-text-main m-0">Get in <span class="gradient-text">Touch</span></h1>
      <p class="text-text-secondary text-[1.1rem] max-w-[700px] mx-auto m-0 leading-relaxed">Have a question or want to collaborate? We'd love to hear from you. Send us a message and we'll get back to you as soon as possible.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-12 items-start">
      <div class="bg-black/5 dark:bg-white/5 border border-border-card rounded-3xl p-6 md:p-10 transition-colors duration-300">
        <form id="contact-form" class="flex flex-col gap-6">
          <!-- Honeypot (hidden) -->
          <div class="hidden" aria-hidden="true">
            <label for="honeypot">Leave this field empty</label>
            <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex flex-col gap-2">
            <label for="name" class="text-[0.9rem] font-medium text-text-main">Full Name</label>
            <input type="text" id="name" name="name" placeholder="John Doe" required class="bg-black/5 dark:bg-white/5 border border-border-card rounded-xl px-4 py-3 text-text-main font-sans outline-none focus:border-primary focus:bg-white/10 transition-colors" />
            <span id="name-error" class="text-xs text-rose-500 mt-1 hidden"></span>
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="text-[0.9rem] font-medium text-text-main">Email Address</label>
            <input type="email" id="email" name="email" placeholder="john@example.com" required class="bg-black/5 dark:bg-white/5 border border-border-card rounded-xl px-4 py-3 text-text-main font-sans outline-none focus:border-primary focus:bg-white/10 transition-colors" />
            <span id="email-error" class="text-xs text-rose-500 mt-1 hidden"></span>
          </div>

          <div class="flex flex-col gap-2">
            <label for="subject" class="text-[0.9rem] font-medium text-text-main">Subject</label>
            <select id="subject" name="subject" class="bg-black/5 dark:bg-white/5 border border-border-card rounded-xl px-4 py-3 text-text-main font-sans outline-none focus:border-primary focus:bg-white/10 transition-colors [&>option]:bg-bg-base">
              <option value="general">General Inquiry</option>
              <option value="collaboration">Collaboration</option>
              <option value="feedback">Feedback</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="text-[0.9rem] font-medium text-text-main">Your Message</label>
            <textarea id="message" name="message" rows="5" placeholder="How can we help you?" required class="bg-black/5 dark:bg-white/5 border border-border-card rounded-xl px-4 py-3 text-text-main font-sans outline-none focus:border-primary focus:bg-white/10 transition-colors resize-y"></textarea>
            <span id="message-error" class="text-xs text-rose-500 mt-1 hidden"></span>
          </div>

          <!-- Robot Protection / Math Captcha -->
          <div class="flex flex-col gap-2 bg-black/10 dark:bg-white/5 p-4 rounded-xl border border-border-card">
            <label for="captcha" class="text-[0.9rem] font-medium text-text-main flex items-center gap-2">
              🛡️ Safety Check: <span id="captcha-label" class="font-bold text-primary">Prove you are human</span>
            </label>
            <input type="number" id="captcha" name="captcha" placeholder="Enter your answer" required class="bg-black/5 dark:bg-white/5 border border-border-card rounded-xl px-4 py-3 text-text-main font-sans outline-none focus:border-primary focus:bg-white/10 transition-colors" />
            <span id="captcha-error" class="text-xs text-rose-500 mt-1 hidden"></span>
          </div>

          <!-- Global Form Status Message -->
          <div id="form-status" class="hidden p-4 rounded-xl text-sm font-semibold"></div>

          <button type="submit" id="submit-btn" class="mt-4 py-4 px-8 bg-gradient-to-r from-primary to-secondary text-white border-none rounded-xl font-bold text-base cursor-pointer flex items-center justify-center gap-3 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/20 disabled:opacity-50 disabled:pointer-events-none">
            <span id="btn-text">Send Message</span>
            <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </form>
      </div>

      <div class="flex flex-col gap-8">
        <div class="bg-black/5 dark:bg-white/5 border border-border-card rounded-3xl p-8 transition-colors duration-300">
          <h3 class="text-xl font-bold text-text-main mb-6">Follow Us</h3>
          <div class="flex flex-wrap gap-4">
            <a href="#" class="bg-black/10 dark:bg-white/5 px-4 py-2 rounded-lg no-underline text-text-main text-[0.9rem] transition-colors hover:bg-primary hover:text-white">Twitter</a>
            <a href="#" class="bg-black/10 dark:bg-white/5 px-4 py-2 rounded-lg no-underline text-text-main text-[0.9rem] transition-colors hover:bg-primary hover:text-white">LinkedIn</a>
            <a href="#" class="bg-black/10 dark:bg-white/5 px-4 py-2 rounded-lg no-underline text-text-main text-[0.9rem] transition-colors hover:bg-primary hover:text-white">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    if (!form) return;

    const nameInput = document.getElementById("name") as HTMLInputElement;
    const emailInput = document.getElementById("email") as HTMLInputElement;
    const messageInput = document.getElementById("message") as HTMLTextAreaElement;
    const honeypotInput = document.getElementById("honeypot") as HTMLInputElement;
    const captchaInput = document.getElementById("captcha") as HTMLInputElement;
    const captchaLabel = document.getElementById("captcha-label");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");
    const formStatus = document.getElementById("form-status");

    // Error message elements
    const nameError = document.getElementById("name-error");
    const emailError = document.getElementById("email-error");
    const messageError = document.getElementById("message-error");
    const captchaError = document.getElementById("captcha-error");

    // Generate Math Challenge values
    let num1 = Math.floor(Math.random() * 9) + 1;
    let num2 = Math.floor(Math.random() * 9) + 1;
    let correctSum = num1 + num2;

    if (captchaLabel) {
      captchaLabel.textContent = `What is ${num1} + ${num2}?`;
    }

    function resetCaptcha() {
      num1 = Math.floor(Math.random() * 9) + 1;
      num2 = Math.floor(Math.random() * 9) + 1;
      correctSum = num1 + num2;
      if (captchaLabel) {
        captchaLabel.textContent = `What is ${num1} + ${num2}?`;
      }
      captchaInput.value = "";
    }

    function showError(element: HTMLElement | null, message: string) {
      if (element) {
        element.textContent = message;
        element.classList.remove("hidden");
      }
    }

    function clearErrors() {
      [nameError, emailError, messageError, captchaError].forEach(err => {
        if (err) {
          err.textContent = "";
          err.classList.add("hidden");
        }
      });
      if (formStatus) {
        formStatus.textContent = "";
        formStatus.classList.add("hidden");
        formStatus.className = "hidden p-4 rounded-xl text-sm font-semibold";
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearErrors();

      let hasErrors = false;

      // 1. Honeypot check (immediate silent drop/success representation to confuse bots)
      if (honeypotInput.value !== "") {
        console.warn("Honeypot triggered - bot submission blocked.");
        if (formStatus) {
          formStatus.textContent = "🎉 Message sent successfully! We will get back to you shortly.";
          formStatus.className = "p-4 rounded-xl text-sm font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25";
          formStatus.classList.remove("hidden");
        }
        form.reset();
        resetCaptcha();
        return;
      }

      // 2. Full Name validation
      const nameVal = nameInput.value.trim();
      if (nameVal.length < 2) {
        showError(nameError, "Please enter a valid full name (minimum 2 characters).");
        hasErrors = true;
      }

      // 3. Email validation
      const emailVal = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailVal)) {
        showError(emailError, "Please enter a valid email address.");
        hasErrors = true;
      }

      // 4. Message validation
      const messageVal = messageInput.value.trim();
      if (messageVal.length < 10) {
        showError(messageError, "Your message is too short (minimum 10 characters).");
        hasErrors = true;
      }

      // 5. Captcha verification
      const captchaVal = parseInt(captchaInput.value.trim(), 10);
      if (isNaN(captchaVal) || captchaVal !== correctSum) {
        showError(captchaError, `Incorrect math answer. Please try again.`);
        hasErrors = true;
        resetCaptcha();
      }

      if (hasErrors) {
        if (formStatus) {
          formStatus.textContent = "Please correct the errors marked above.";
          formStatus.className = "p-4 rounded-xl text-sm font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/25";
          formStatus.classList.remove("hidden");
        }
        return;
      }

      // Valid: simulate submit
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Sending...";

      try {
        await new Promise((resolve) => setTimeout(resolve, 1200));

        if (formStatus) {
          formStatus.textContent = "🎉 Message sent successfully! We will get back to you shortly.";
          formStatus.className = "p-4 rounded-xl text-sm font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25";
          formStatus.classList.remove("hidden");
        }
        form.reset();
        resetCaptcha();
      } catch (error) {
        if (formStatus) {
          formStatus.textContent = "Something went wrong. Please try again later.";
          formStatus.className = "p-4 rounded-xl text-sm font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/25";
          formStatus.classList.remove("hidden");
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = "Send Message";
      }
    });
  }

  // Handle load and page-load transitions
  document.addEventListener("DOMContentLoaded", initContactForm);
  document.addEventListener("astro:page-load", initContactForm);
</script>
