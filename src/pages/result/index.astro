---
import Layout from "../../layouts/Layout.astro";
import { HiOutlineCalendarDays, HiOutlineArrowTopRightOnSquare, HiOutlineBell, HiOutlineBuildingOffice } from "react-icons/hi2";

const results: any[] = [
  {
    title: "मुंबई पोलीस शिपाई भरती २०२४-२५: ३,५२१ पदांची अंतिम निवड यादी व प्रतीक्षा यादी कट-ऑफसह प्रसिद्ध",
    organisation: "बृहन्मुंबई पोलीस आयुक्त कार्यालय (Brihanmumbai Police)",
    category: "Police Bharti",
    status: "declared",
    examDate: "2024-2025",
    releaseDate: "07 August 2026",
    link: "/mumbai-police-constable-final-selection-list-2026"
  },
  {
    title: "लातूर जिल्हा मध्यवर्ती बँक भरती २०२६: ३७५ पदांपैकी २६३ उमेदवारांची Phase 1 निवड यादी प्रसिद्ध",
    organisation: "दि लातूर जिल्हा मध्यवर्ती सहकारी बँक लि. (Latur DCCB)",
    category: "Bank Result",
    status: "declared",
    examDate: "July 2026",
    releaseDate: "28 July 2026",
    link: "/latur-dcc-bank-result-2026"
  },
  {
    title: "लातूर जिल्हा मध्यवर्ती बँक भरती २०२६: संवर्गनिहाय २०% सुधारीत प्रतीक्षा यादी (Revised Waiting List) प्रसिद्ध",
    organisation: "दि लातूर जिल्हा मध्यवर्ती सहकारी बँक लि. (Latur DCCB)",
    category: "Bank Result",
    status: "declared",
    examDate: "July 2026",
    releaseDate: "03 August 2026",
    link: "/latur-dcc-bank-revised-waiting-list-2026"
  }
];
---

<Layout title="Government Exam Results 2026 - Cutoff Marks & Merit List Download | MahaSandhi" description="Check latest government exam results 2026. Download official scorecards, cutoff marks, and merit lists for UPSC, SSC, SBI, IBPS, RRB, MPSC exams. Get direct result check links at mahasandhi.in.">
  <section class="pt-4 pb-16 not-prose">
    <h1 class="sr-only">Exam Results</h1>

    <div class="max-w-[1000px] mx-auto px-4 sm:px-6 md:px-0">
      <!-- Header -->
      <div class="mb-8 border-b border-border-card dark:border-border-card/30 pb-4">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-text-main m-0 uppercase italic flex items-center gap-2">
          Latest <span class="gradient-text pr-3 py-1">Exam Results</span>
        </h2>
      </div>

      <!-- Results Grid (Cards) -->
      <div id="results-grid" class="flex flex-col gap-3 md:gap-4 transition-all duration-300">
        {results.length === 0 ? (
          <div class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl">
            <p class="text-text-muted text-sm m-0">No active result announcements at the moment. Please check back later!</p>
          </div>
        ) : (
          results.map((card, index) => (
            <div
              data-title={card.title}
              data-org={card.organisation}
              data-category={card.category}
              class="group result-item flex flex-col md:flex-row md:items-center justify-between p-4 md:p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-emerald-500 gap-3 md:gap-4"
            >
              <!-- Left: Extended Info Block -->
              <div class="flex-1 min-w-0 pr-0 md:pr-4">
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <span class="text-[0.65rem] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-emerald-500/20 whitespace-nowrap">
                    {card.category}
                  </span>

                  {card.status === "declared" && (
                    <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Declared
                    </span>
                  )}

                  {card.status === "expected" && (
                    <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1 h-1 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Expected Soon
                    </span>
                  )}

                  {card.releaseDate && (
                    <span class="text-text-muted text-xs font-semibold ml-auto sm:ml-0">• {card.releaseDate}</span>
                  )}
                </div>

                <a href={card.link} class="no-underline hover:no-underline block">
                  <h3 class="text-base sm:text-lg text-text-main font-bold leading-relaxed mb-1.5 group-hover:text-primary transition-colors">{card.title}</h3>
                </a>
                <div class="flex items-center gap-1.5 text-xs text-text-muted">
                  <HiOutlineBuildingOffice className="shrink-0 text-xs text-primary/70" />
                  <span class="truncate">{card.organisation}</span>
                </div>
              </div>

              <!-- Right: CTA Button -->
              <div class="shrink-0 w-full md:w-auto md:min-w-[160px]">
                {card.status === "declared" && (
                  <a
                    href={card.link}
                    class="w-full md:w-auto btn-primary !bg-gradient-to-r !from-emerald-600 !to-teal-600 hover:!from-emerald-500 hover:!to-teal-500 !border-transparent !rounded-xl !py-2.5 flex items-center justify-center gap-2 group/btn text-[0.65rem] font-bold uppercase tracking-wider px-5 shadow-sm shadow-emerald-500/20 no-underline"
                  >
                    <span>Check Result</span>
                    <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                  </a>
                )}

                {card.status === "expected" && (
                  <button
                    type="button"
                    disabled
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 bg-amber-500/10 border border-solid border-amber-500/20 text-amber-600 dark:text-amber-400 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center animate-pulse"
                  >
                    <HiOutlineBell className="text-xs shrink-0" />
                    <span>Expected Soon</span>
                  </button>
                )}
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </section>
</Layout>
