      <!-- TAB 3: अॅक्टिव्ह रिकॉल (फ्लॅशकार्ड्स) -->
      <div id="flashcard-tab" class="tab-content">
        <h2>अॅक्टिव्ह रिकॉल फ्लॅशकार्ड्स</h2>
        <p>खालील कार्ड्सवर क्लिक करून प्रश्न वाचा आणि स्वतः उत्तर आठवण्याचा प्रयत्न करा. क्लिक केल्यावर कार्ड उलटून तुम्हाला त्याचे योग्य उत्तर दिसेल:</p>
        
        <div class="flashcards-container">
          <!-- Card 1 -->
