  // Tab switching logic
  function switchTab(tabId) {
    // Hide all tab contents
    document.querySelectorAll(".tab-content").forEach(content => {
      content.classList.remove("active");
    });
    // Remove active class from all buttons
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.classList.remove("active");
    });
    
    // Show target content
    const targetContent = document.getElementById(tabId);
    if (targetContent) {
      targetContent.classList.add("active");
    }
    
    // Add active class to corresponding button
    const activeBtn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
    if (activeBtn) {
      activeBtn.classList.add("active");
    }
  }

  // Setup event listeners for tab buttons
  document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const tabId = btn.getAttribute("data-tab");
      switchTab(tabId);
    });
  });

  // Setup click handler for Interactive Words in Preamble Card
  function showWordDetail(wordKey) {
    const detailBox = document.getElementById("word-detail");
    const titleEl = document.getElementById("word-title");
    const descEl = document.getElementById("word-desc");
    
    const wordData = wordExplanations[wordKey];
    if (wordData && detailBox && titleEl && descEl) {
      titleEl.textContent = wordData.title;
      descEl.innerHTML = wordData.desc;
      detailBox.style.display = "block";
    }
  }

  document.querySelectorAll(".interactive-word").forEach(wordSpan => {
    wordSpan.addEventListener("click", () => {
      const wordKey = wordSpan.getAttribute("data-word");
      showWordDetail(wordKey);
    });
  });

  // Setup timeline case detail modal opening
  function showModal(caseKey) {
    const modal = document.getElementById("case-modal");
    const modalTitle = document.getElementById("modal-case-title");
    const modalBody = document.getElementById("modal-case-body");
    
    const caseData = caseDetails[caseKey];
    if (caseData && modal && modalTitle && modalBody) {
      modalTitle.textContent = caseData.title;
      modalBody.innerHTML = caseData.body;
      modal.style.display = "flex";
    }
  }

  document.querySelectorAll(".timeline-item").forEach(item => {
    item.addEventListener("click", () => {
      const caseKey = item.getAttribute("data-case");
      showModal(caseKey);
    });
  });

  // Setup modal close handler
  const closeModalBtn = document.getElementById("close-modal");
  const modalContainer = document.getElementById("case-modal");
  if (closeModalBtn && modalContainer) {
    closeModalBtn.addEventListener("click", () => {
      modalContainer.style.display = "none";
    });
    
    // Close modal on background click
    window.addEventListener("click", (e) => {
      if (e.target === modalContainer) {
        modalContainer.style.display = "none";
      }
    });
  }

