    const explanation = card.querySelector(".pyq-explanation-box");
    
    options.forEach(option => {
      option.addEventListener("click", () => {
        // Disable subsequent clicks on this question
        options.forEach(opt => opt.style.pointerEvents = "none");
        
        // Show correct / wrong styles
        const isCorrect = option.getAttribute("data-correct") === "true";
        if (isCorrect) {
          option.classList.add("correct");
        } else {
          option.classList.add("wrong");
          // Highlight correct answer too
          options.forEach(opt => {
            if (opt.getAttribute("data-correct") === "true") {
              opt.classList.add("correct");
            }
          });
        }
        
        // Reveal explanation box
        if (explanation) {
          explanation.style.display = "block";
        }
      });
    });
  });

  // Setup Mock Quiz Logic
  let currentQuestionIndex = 0;
  let score = 0;
  const quizQuestions = document.querySelectorAll("#quiz-questions-container .question-card");
  const totalQuestions = quizQuestions.length;
  const progressText = document.getElementById("quiz-progress");
  const prevBtn = document.getElementById("prev-btn");
  const nextBtn = document.getElementById("next-btn");
  const quizControls = document.getElementById("quiz-controls");
  const resultScreen = document.getElementById("result-screen");
  const resultScoreText = document.getElementById("result-score");
  const resultMessage = document.getElementById("result-message");
  const restartBtn = document.getElementById("restart-btn");

  function updateQuizUI() {
    // Hide all question cards
    quizQuestions.forEach(q => q.classList.remove("active"));
    
    if (currentQuestionIndex < totalQuestions) {
      // Show active question
      quizQuestions[currentQuestionIndex].classList.add("active");
      progressText.textContent = `प्रश्न ${currentQuestionIndex + 1} पैकी ${totalQuestions}`;
      
      // Update buttons state
      prevBtn.disabled = currentQuestionIndex === 0;
      
      if (currentQuestionIndex === totalQuestions - 1) {
        nextBtn.textContent = "चाचणी पूर्ण करा 🏁";
      } else {
        nextBtn.textContent = "पुढे 👉";
      }
    } else {
      // Show results
      showQuizResults();
    }
  }

  function showQuizResults() {
    document.getElementById("quiz-questions-container").style.display = "none";
    quizControls.style.display = "none";
    progressText.style.display = "none";
    
    resultScoreText.textContent = `${score} / ${totalQuestions}`;
    if (score === totalQuestions) {
      resultMessage.textContent = "उत्कृष्ट! उद्देशिकेचा तुमचा अभ्यास अत्यंत परिपूर्ण आहे. 🏆";
    } else if (score >= 3) {
      resultMessage.textContent = "उत्तम प्रयत्न! तुम्हाला बऱ्यापैकी माहिती आहे. अधिक गुणांसाठी नोट्स पुन्हा वाचा.";
    } else {
      resultMessage.textContent = "तुम्हाला अधिक सरावाची गरज आहे. पुन्हा नोट्स अभ्यासा आणि चाचणी द्या.";
    }
    
    resultScreen.style.display = "block";
  }

  // Option select in mock quiz
  quizQuestions.forEach((card, cardIndex) => {
    const options = card.querySelectorAll(".option-item");
    const explanation = card.querySelector(".explanation-box");
    
    options.forEach(option => {
      option.addEventListener("click", () => {
        // Only allow clicking if not already answered
        if (card.dataset.answered === "true") return;
        
        // Remove selected class from other options
        options.forEach(opt => opt.classList.remove("selected"));
        
        // Mark option as selected
        option.classList.add("selected");
        
        // Set card selection metadata
        card.dataset.selectedOpt = option.getAttribute("data-opt");
        card.dataset.isCorrect = option.getAttribute("data-correct");
      });
    });
  });

  // Next Button Clicked
  nextBtn.addEventListener("click", () => {
    const currentCard = quizQuestions[currentQuestionIndex];
    
    // Check if an option was selected
    if (!currentCard.dataset.selectedOpt) {
      alert("कृपया एक पर्याय निवडा!");
      return;
    }

    // Process correctness on first submission of this card
    if (currentCard.dataset.answered !== "true") {
      currentCard.dataset.answered = "true";
      
      const options = currentCard.querySelectorAll(".option-item");
      options.forEach(opt => {
        const isOptCorrect = opt.getAttribute("data-correct") === "true";
        const isOptSelected = opt.classList.contains("selected");
        
        if (isOptCorrect) {
          opt.classList.add("correct");
        } else if (isOptSelected && !isOptCorrect) {
          opt.classList.add("wrong");
        }
        
        // Disable cursor interaction
        opt.style.pointerEvents = "none";
      });

      // Show explanation box
      const explanation = currentCard.querySelector(".explanation-box");
      if (explanation) {
        explanation.style.display = "block";
      }

      // Add to score
      if (currentCard.dataset.isCorrect === "true") {
        score++;
      }
    }

    // Wait a brief second to let user read the explanation before moving, or just let them click next again
    if (currentCard.dataset.stepComplete === "true") {
      // Proceed to next question
      currentQuestionIndex++;
      updateQuizUI();
    } else {
      // Mark step complete (they will click again to go next)
      currentCard.dataset.stepComplete = "true";
      nextBtn.textContent = currentQuestionIndex === totalQuestions - 1 ? "निकाल पहा 🎯" : "पुढे जा 👉";
    }
  });

  // Prev Button Clicked
  prevBtn.addEventListener("click", () => {
    if (currentQuestionIndex > 0) {
      currentQuestionIndex--;
      updateQuizUI();
      // Since it's already answered, adjust next button text back to go next
      const currentCard = quizQuestions[currentQuestionIndex];
      if (currentCard.dataset.answered === "true") {
        currentCard.dataset.stepComplete = "true";
        nextBtn.textContent = currentQuestionIndex === totalQuestions - 1 ? "निकाल पहा 🎯" : "पुढे जा 👉";
      }
    }
  });

  // Restart Quiz
  restartBtn.addEventListener("click", () => {
    score = 0;
    currentQuestionIndex = 0;
    
    // Reset cards and options state
    quizQuestions.forEach(card => {
      delete card.dataset.selectedOpt;
      delete card.dataset.isCorrect;
      delete card.dataset.answered;
      delete card.dataset.stepComplete;
      
      const options = card.querySelectorAll(".option-item");
      options.forEach(opt => {
        opt.classList.remove("selected", "correct", "wrong");
        opt.style.pointerEvents = "auto";
      });
      
      const explanation = card.querySelector(".explanation-box");
      if (explanation) {
        explanation.style.display = "none";
      }
    });

    document.getElementById("quiz-questions-container").style.display = "block";
    quizControls.style.display = "flex";
    progressText.style.display = "inline-block";
    resultScreen.style.display = "none";
    
    updateQuizUI();
  });

  // Initialize Quiz on load
  updateQuizUI();
</script>
