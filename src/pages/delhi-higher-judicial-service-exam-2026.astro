---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineAcademicCap,
  HiOutlineIdentification,
} from "react-icons/hi2";

const title =
  "Delhi Higher Judicial Service Examination 2026: Apply Online for 27 DHJS Vacancies";
const description =
  "Delhi High Court DHJS Recruitment 2026: Apply Online for 27 Higher Judicial Service posts. Check eligibility, age limit, selection process, syllabus, exam date, and official notification.";
const canonicalURL =
  "https://mahasandhi.in/delhi-higher-judicial-service-exam-2026";
const date = "July 01, 2026";
const category = "Latest Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Delhi Judicial Service" },
  ]}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          दिल्ली उच्चतर न्यायिक सेवा परीक्षा २०२६ (DHJS Recruitment)
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Introduction:</strong> दिल्ली उच्च न्यायालयाने (High Court of
            Delhi) थेट भरतीद्वारे <strong
              >दिल्ली उच्चतर न्यायिक सेवा (Delhi Higher Judicial Service)</strong
            > अंतर्गत २७ न्यायिक अधिकारी पदांसाठी अधिकृत जाहिरात प्रसिद्ध केली आहे.
            यासाठी वकील आणि पात्र न्यायिक अधिकाऱ्यांकडून ऑनलाइन अर्ज मागविण्यात येत
            आहेत. या भरतीचे सविस्तर निकष, पात्रता आणि अर्जासंबंधीची माहिती खालीलप्रमाणे
            आहे.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineDocumentText
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >जाहिरात विभाग (Authority)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >दिल्ली उच्च न्यायालय (Delhi High Court)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण (Job Location)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >नवी दिल्ली (New Delhi)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCurrencyRupee
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >अर्ज शुल्क (Application Fees)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >खुला प्रवर्ग: ₹२,००० | SC / ST / PwD: ₹५००</span
              >
            </div>
          </div>
        </div>

        <!-- Post Details & Education Qualification Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          रिक्त पदे आणि शैक्षणिक पात्रता (Post Details & Eligibility)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap"
                  ><span class="flex items-center gap-1.5"
                    ><HiOutlineDocumentText className="text-primary" /> पदाचे नाव
                    (Post Name)</span
                  ></th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >एकूण पदे (Total Vacancies)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक पात्रता (Eligibility Criteria)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >दिल्ली उच्चतर न्यायिक सेवा (Delhi Higher Judicial Service -
                  DHJS)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  ><strong>२७ पदे</strong> <br /> (२४ विद्यमान + ०३ अंदाजित)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  <ul class="list-disc pl-5 m-0 space-y-1.5 text-xs">
                    <li>उमेदवार हा भारताचा नागरिक असणे आवश्यक आहे.</li>
                    <li>
                      <strong>वकिलांसाठी:</strong> अर्जदाराने वकिली व्यवसायात १५.०७.२०२६
                      पर्यंत सलग ७ वर्षांपेक्षा कमी नसलेला कालावधी पूर्ण केलेला असावा.
                    </li>
                    <li>
                      <strong>न्यायालयीन अधिकाऱ्यांसाठी:</strong> दुय्यम न्यायिक सेवेत
                      रुजू होण्यापूर्वी बारमध्ये किमान ७ वर्षांची वकिली पूर्ण केलेली
                      असावा, किंवा १५.०७.२०२६ रोजी वकील आणि न्यायिक अधिकारी म्हणून
                      एकूण एकत्रित ७ वर्षांचा अनुभव असावा.
                    </li>
                  </ul>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit & Total Posts Table -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वयोमर्यादा आणि पगार (Age Limit & Salary)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा (Age Limit)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वेतनमान / पगार (Pay Scale)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >Delhi Higher Judicial Service</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  किमान <strong>३५ वर्षे</strong> पूर्ण असावीत आणि कमाल <strong
                    >४५ वर्षांपेक्षा</strong
                  > जास्त नसावी. <br /> (वय मोजण्याचा दिनांक: १५.०७.२०२६)
                </td>
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                >
                  ₹१,४४,८४० - ₹१,९४,६६० (J-5 Scale)
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Selection Stages -->
        <h2
          id="selection"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          निवड पद्धत (Selection Process)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl space-y-3"
        >
          <p class="m-0 text-sm">
            भरतीची निवड प्रक्रिया खालील तीन टप्प्यांत घेण्यात येईल:
          </p>
          <ul class="list-decimal pl-5 m-0 space-y-2 text-sm text-text-muted">
            <li>
              <strong>पूर्व परीक्षा (Preliminary Exam):</strong> वस्तुनिष्ठ (Objective)
              स्वरूपाची परीक्षा असेल. यामध्ये २५% (०.२५ गुण) नकारात्मक गुणांकन (Negative
              Marking) असेल.
            </li>
            <li>
              <strong>मुख्य परीक्षा (Mains Exam):</strong> पूर्व परीक्षेत पात्र ठरलेल्या
              उमेदवारांची लेखी (Written) मुख्य परीक्षा होईल.
            </li>
            <li>
              <strong>मुलाखत (Viva-Voce):</strong> मुख्य परीक्षेत उत्तीर्ण उमेदवारांना
              मुलाखतीसाठी बोलावण्यात येईल.
            </li>
          </ul>
        </div>

        <!-- Important Dates & Links Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          {translateMarathi("महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)")}
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तारीख / लिंक (Date / Action)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाइन अर्ज सुरू होण्याची तारीख (Start Date)</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-primary text-lg shrink-0"
                    /> ०१ जुलै २०२६ (सकाळी १०:०० वा.)</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाइन अर्ज करण्याची शेवटची तारीख (End Date)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-rose-500 text-lg shrink-0"
                    /> १५ जुलै २०२६ (सायंकाळी ०५:३० वा.)</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >पूर्व परीक्षा दिनांक (Preliminary Exam Date)</td
                >
                <td
                  class="p-3 border border-border-card text-amber-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-amber-500 text-lg shrink-0"
                    /> २६ जुलै २०२६ (रविवार)</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अधिकृत जाहिरात (Official Notification PDF)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://applycareer.co.in/DHC/HighCourt2026DHJSE/Adv-Eng.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> PDF जाहिरात
                    पहा
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाइन अर्ज लिंक (Online Application Link)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://applycareer.co.in/DHC/HighCourt2026DHJSE/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto"
                  >
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> अर्ज
                    करा (Apply Online)
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2
          id="faq"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न १: दिल्ली उच्चतर न्यायिक सेवा भरतीसाठी अर्ज करण्याची शेवटची
              तारीख काय आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: या भरतीसाठी ऑनलाइन अर्ज भरण्याची आणि पेमेंट करण्याची अंतिम
              तारीख १५ जुलै २०२६ (सायंकाळी ०५:३० वाजेपर्यंत) आहे.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न २: परीक्षा पद्धत आणि वयोमर्यादा काय आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: ३५ ते ४५ वर्षे वयोगटातील उमेदवार यासाठी पात्र आहेत.
              उमेदवारांची निवड पूर्व परीक्षा (२५% उणे गुणांकनासह), मुख्य परीक्षा
              आणि मुलाखतीद्वारे केली जाईल.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न ३: अर्जाचे शुल्क किती आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: खुल्या प्रवर्गातील उमेदवारांसाठी ₹२,००० आणि राखीव
              प्रवर्गातील उमेदवारांसाठी (SC, ST, PwD) ₹५०० अर्ज शुल्क निश्चित
              करण्यात आले आहे.
            </p>
          </div>
        </div>

        <!-- Call to Action -->
        <div
          class="bg-primary/5 border border-primary/20 p-8 rounded-3xl text-center my-8"
        >
          <h2
            class="text-xl font-black text-text-main mb-4 border-none p-0 mt-0"
          >
            ताज्या अपडेट्ससाठी जॉईन करा!
          </h2>
          <p class="text-text-muted mb-6 text-sm">
            सर्व सरकारी नोकऱ्या आणि निकालाच्या ताज्या अपडेट्स मिळवण्यासाठी
            आमच्या टेलिग्राम आणि व्हॉट्सॲप चॅनेलमध्ये सामील व्हा.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://chat.whatsapp.com"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              WhatsApp Group
            </a>
            <a
              href="https://t.me"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              Telegram Channel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div
      class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative"
    >
      <span
        class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md"
      >
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-en" class="text-2xl font-bold mt-2">
          Delhi Higher Judicial Service Examination 2026 Notification
        </h2>

        <!-- Key Information -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineDocumentText
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Advertisement Authority</span
              >
              <span class="text-text-main font-semibold text-sm"
                >High Court of Delhi</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Job Location</span
              >
              <span class="text-text-main font-semibold text-sm">New Delhi</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCurrencyRupee
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
