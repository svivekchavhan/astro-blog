---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineBuildingOffice,
} from "react-icons/hi2";

const title =
  "ISRO Bharti 2026: भारतीय अंतराळ संशोधन संस्थेत 267 जागांसाठी भरती! ऑनलाईन अर्ज करा";
const description =
  "ISRO Recruitment 2026 Notification: Apply Online for 267 Assistant, Junior Personal Assistant (JPA), Upper Division Clerk (UDC), and Stenographer Vacancies. Check eligibility, age limit, fee refund & last date.";
const canonicalURL = "https://mahasandhi.in/isro-recruitment-2026";
const date = "August 19, 2026";
const category = "Central Govt";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "ISRO Recruitment 2026" },
  ]}
>
  <article class="py-6 sm:py-8">
    <!-- Header -->
    <div class="mb-8 md:mb-12">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <span
          class="px-3 py-1 bg-primary/10 text-primary border border-primary/20 rounded-full text-xs font-bold uppercase tracking-wider"
        >
          {category}
        </span>
        <span
          class="px-3 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 rounded-full text-xs font-bold uppercase tracking-wider flex items-center gap-1.5"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
          ></span>
          ऑनलाईन अर्ज सुरू (Apply Online Active)
        </span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-4 sm:pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div
      class="flex gap-4 mb-8 p-4 bg-bg-surface border border-border-card rounded-xl"
    >
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline flex items-center gap-1"
        >↓ मराठी माहिती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline flex items-center gap-1"
        >↓ English Summary</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-8 text-text-main leading-relaxed">
        <!-- SEO Title Main Keyword -->
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          🚀 ISRO भरती 2026: भारतीय अंतराळ संशोधन संस्थेत नोकरीची मोठी संधी!
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p class="text-base leading-relaxed">
            <strong>ISRO Bharti 2026:</strong> भारतीय अंतराळ संशोधन संस्था (ISRO -
            Indian Space Research Organisation) अंतर्गत विविध प्रशासकीय व तांत्रिक
            सहाय्यक पदांसाठी पात्र पदवीधर उमेदवारांकडून ऑनलाईन अर्ज मागविण्यात येत
            आहेत. या भरती मोहिमेद्वारे
            <strong>असिस्टंट (Assistant)</strong>, <strong
              >ज्युनियर पर्सनल असिस्टंट (JPA)</strong
            >,
            <strong>अप्पर डिव्हिजन क्लार्क (UDC)</strong> आणि <strong
              >स्टेनोग्राफर (Stenographer)</strong
            > अशा एकूण <span class="line-through text-text-muted font-normal">२४४</span> <strong>२६७ जागा</strong> भरल्या जाणार आहेत. इच्छुक उमेदवारांनी
            अंतिम तारखेपूर्वी अधिकृत संकेतस्थळावरून ऑनलाईन अर्ज सादर करावा.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineDocumentText
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण पदे (Total Vacancies)</span
              >
              <span class="text-text-main font-bold text-base text-primary"
                ><span class="line-through text-text-muted/70 text-xs font-normal">२४४</span> २६७ पदे (267 Posts)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण (Job Location)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >अखिल भारत (All India ISRO Centres)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineCurrencyRupee
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >अर्ज शुल्क (Fee / Refund)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >₹५०० (परीक्षेनंतर परतावा लागू)</span
              >
            </div>
          </div>
        </div>

        <!-- Post Details & Vacancies Table -->
        <h2
          id="post-details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 एकूण पदे व पदांचे नाव (Post Name & Vacancy Details)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap"
                  >अ.क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >एकूण पदे (Vacancies)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted text-center"
                  >१</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  असिस्टंट (Assistant)
                </td>
                <td
                  class="p-3 border border-border-card text-text-main font-bold text-center"
                >
                  <span class="line-through text-text-muted font-normal">११३</span> <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">१३५</span> पदे
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted text-center"
                  >२</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  ज्युनियर पर्सनल असिस्टंट (Junior Personal Assistant - JPA)
                </td>
                <td
                  class="p-3 border border-border-card text-text-main font-bold text-center"
                >
                  ८१ पदे
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted text-center"
                  >३</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  अप्पर डिव्हिजन क्लार्क (Upper Division Clerk - UDC)
                </td>
                <td
                  class="p-3 border border-border-card text-text-main font-bold text-center"
                >
                  <span class="line-through text-text-muted font-normal">२२</span> <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">२३</span> पदे
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted text-center"
                  >४</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  स्टेनोग्राफर (Stenographer)
                </td>
                <td
                  class="p-3 border border-border-card text-text-main font-bold text-center"
                >
                  १० पदे
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted text-center"
                  >५</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  असिस्टंट - स्वायत्त संस्था (Assistant - Autonomous Institutions)
                </td>
                <td
                  class="p-3 border border-border-card text-text-main font-bold text-center"
                >
                  १७ पदे
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted text-center"
                  >६</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  ज्युनियर पर्सनल असिस्टंट - स्वायत्त संस्था (JPA - Autonomous Institutions)
                </td>
                <td
                  class="p-3 border border-border-card text-text-main font-bold text-center"
                >
                  ०१ पद
                </td>
              </tr>
              <tr class="bg-primary/5 font-bold">
                <td
                  colspan="2"
                  class="p-3 border border-border-card text-right text-text-main"
                >
                  एकूण रिक्त पदे (Total Vacancies)
                </td>
                <td
                  class="p-3 border border-border-card text-center text-primary text-base"
                >
                  <span class="line-through text-text-muted font-normal text-sm">२४४</span> <span class="text-emerald-600 dark:text-emerald-400 font-extrabold text-lg">२६७ पदे</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Educational Qualification Table -->
        <h2
          id="qualification"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 शैक्षणिक पात्रता (Educational Qualification)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक पात्रता व कौशल्ये</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  <span class="text-primary font-bold block mb-1">पद क्र. १, ३ व ५:</span>
                  असिस्टंट / अप्पर डिव्हिजन क्लार्क (Assistant / UDC)
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  <ul class="list-disc pl-5 space-y-1.5 m-0">
                    <li>
                      मान्यताप्राप्त विद्यापीठातून कोणत्याही शाखेतील पदवी
                      (Graduation in any discipline) <strong
                        >किमान ६०% गुणांसह</strong
                      > (किंवा CGPA 6.32/10).
                    </li>
                    <li>
                      संगणक वापराचे उत्तम ज्ञान (Proficiency in the use of
                      computers).
                    </li>
                  </ul>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-main font-semibold"
                >
                  <span class="text-primary font-bold block mb-1">पद क्र. २, ४ व ६:</span>
                  ज्युनियर पर्सनल असिस्टंट / स्टेनोग्राफर (JPA / Stenographer)
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  <ul class="list-disc pl-5 space-y-1.5 m-0">
                    <li>
                      किमान <strong>६०% गुणांसह पदवी</strong> (किंवा CGPA 6.32/10)
                      <strong>किंवा</strong> ६०% गुणांसह Commercial / Secretarial
                      Practice मधील डिप्लोमा + १ वर्षाचा Stenographer/Steno-Typist
                      म्हणून अनुभव.
                    </li>
                    <li>
                      इंग्रजी लघुलेखन गती किमान <strong
                        >६० शब्द प्रति मिनिट</strong
                      > (English Stenography speed 60 w.p.m.).
                    </li>
                    <li>
                      संगणक वापराचे उत्तम ज्ञान (Proficiency in the use of
                      computers).
                    </li>
                  </ul>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit & Relaxations -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 वयोमर्यादा (Age Limit - दि. १६/०८/२०२६ रोजी)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm mb-8"
        >
          <p class="font-bold text-text-main mb-3">
            वय मोजण्याचा अंतिम दिनांक: <span
              class="text-rose-500 font-extrabold">१६ ऑगस्ट २०२६</span
            >
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-primary/10">
                  <th
                    class="p-2.5 border border-border-card font-bold text-text-main"
                    >प्रवर्ग (Category)</th
                  >
                  <th
                    class="p-2.5 border border-border-card font-bold text-text-main"
                    >वयोमर्यादा (Age Limit)</th
                  >
                  <th
                    class="p-2.5 border border-border-card font-bold text-text-main"
                    >जन्म तारीख अट</th
                  >
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td
                    class="p-2.5 border border-border-card font-medium text-text-muted"
                    >खुला / ई.डब्ल्यू.एस. (UR / EWS)</td
                  >
                  <td
                    class="p-2.5 border border-border-card font-bold text-text-main"
                    >१८ ते २८ वर्षे</td
                  >
                  <td class="p-2.5 border border-border-card text-text-muted"
                    >जन्म १७/०८/१९९८ किंवा त्यानंतरचा असावा</td
                  >
                </tr>
                <tr>
                  <td
                    class="p-2.5 border border-border-card font-medium text-text-muted"
                    >इतर मागासवर्गीय (OBC)</td
                  >
                  <td
                    class="p-2.5 border border-border-card font-bold text-text-main"
                    >३१ वर्षांपर्यंत (३ वर्षे सूट)</td
                  >
                  <td class="p-2.5 border border-border-card text-text-muted"
                    >जन्म १७/०८/१९९५ किंवा त्यानंतरचा असावा</td
                  >
                </tr>
                <tr>
                  <td
                    class="p-2.5 border border-border-card font-medium text-text-muted"
                    >अनुसूचित जाती / जमाती (SC / ST)</td
                  >
                  <td
                    class="p-2.5 border border-border-card font-bold text-text-main"
                    >३३ वर्षांपर्यंत (५ वर्षे सूट)</td
                  >
                  <td class="p-2.5 border border-border-card text-text-muted"
                    >जन्म १७/०८/१९९३ किंवा त्यानंतरचा असावा</td
                  >
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-text-muted mt-3 mb-0 italic">
            * शासकीय नियमांनुसार PwBD (दिव्यांग), माजी सैनिक व पात्र
            कर्मचाऱ्यांना नियमानुसार वयोमर्याधेत अतिरिक्त सूट लागू राहील.
          </p>
        </div>

        <!-- Application Fee Table & Refund Policy -->
        <h2
          id="application-fee"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 अर्ज शुल्क आणि फी परतावा (Application Fee & Refund Details)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >प्रवर्ग / उमेदवार (Category)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >प्रारंभिक शुल्क (Processing Fee)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >परीक्षा दिल्यानंतर परतावा (Refund on CBT)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >निव्वळ अर्ज फी (Net Fee)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                >
                  महिला / SC / ST / PwBD / माजी सैनिक (Ex-Servicemen)
                </td>
                <td
                  class="p-3 border border-border-card text-text-muted font-bold"
                  >₹५००/-</td
                >
                <td
                  class="p-3 border border-border-card text-emerald-600 dark:text-emerald-400 font-bold"
                >
                  ₹५००/- पूर्ण परतावा (Full Refund)
                </td>
                <td
                  class="p-3 border border-border-card text-emerald-600 dark:text-emerald-400 font-black"
                >
                  ₹०/- (मोफत / Free)
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                >
                  इतर सर्व उमेदवार (UR / OBC / EWS पुरुष उमेदवार)
                </td>
                <td
                  class="p-3 border border-border-card text-text-muted font-bold"
                  >₹५००/-</td
                >
                <td
                  class="p-3 border border-border-card text-blue-600 dark:text-blue-400 font-bold"
                >
                  ₹४००/- परतावा (Refund)
                </td>
                <td
                  class="p-3 border border-border-card text-primary font-black"
                >
                  ₹१००/-
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Job Location List -->
        <h2
          id="job-location"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 नोकरीचे ठिकाण (Job Location)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm mb-8"
        >
          <p class="text-text-main font-medium mb-3">
            निवड झालेल्या उमेदवारांची नियुक्ती खालील विविध इस्रो केंद्रे व DOS
            संस्थांमध्ये केली जाईल:
          </p>
          <div class="flex flex-wrap gap-2">
            <span
              class="px-3 py-1.5 bg-primary/10 text-primary font-bold rounded-lg border border-primary/20 text-xs"
              >अहमदाबाद (Ahmedabad)</span
            >
            <span
              class="px-3 py-1.5 bg-primary/10 text-primary font-bold rounded-lg border border-primary/20 text-xs"
              >बंगळुरू (Bengaluru)</span
            >
            <span
