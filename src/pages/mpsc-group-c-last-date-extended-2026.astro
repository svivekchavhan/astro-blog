---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineQueueList,
  HiOutlineCheckBadge,
  HiOutlineMegaphone,
  HiOutlineMapPin,
  HiOutlinePhone,
  HiOutlineQuestionMarkCircle,
  HiOutlineExclamationTriangle,
  HiOutlineShieldCheck,
  HiOutlineUserGroup,
  HiOutlineArrowLeft
} from "react-icons/hi2";

const title = "MPSC गट-क संयुक्त पूर्व परीक्षा २०२६: मुदतवाढ शुद्धिपत्रक प्रसिद्ध! १० ऑगस्ट २०२६ पर्यंत अर्ज करण्यास मुदतवाढ";
const description = "महाराष्ट्र लोकसेवा आयोग (MPSC) गट-क सेवा संयुक्त पूर्व परीक्षा २०२६ मधील ५,७०७ पदांसाठी अर्ज सादर करण्यास १० ऑगस्ट २०२६ पर्यंत मुदतवाढ देण्यात आली आहे. अधिकृत शुद्धिपत्रक, सुधारित वेळापत्रक व पेसा (PESA) तलाठी अटी येथे पाहा.";
const canonicalURL = "https://mahasandhi.in/mpsc-group-c-last-date-extended-2026";
const date = "August 05, 2026";
const category = "Important Update";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "MPSC", url: "/mpsc" },
    { name: "Group C Bharti 2026", url: "/mpsc-group-c-bharti-2026" },
    { name: "Last Date Extended" }
  ]}
>
  <article class="py-8">
    <!-- Back Button -->
    <div class="mb-6 not-prose">
      <a 
        href="/mpsc-group-c-bharti-2026" 
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-text-muted hover:text-primary bg-bg-surface border border-border-card rounded-xl transition-all duration-300 no-underline"
      >
        <HiOutlineArrowLeft className="text-sm" /> back to group c bharti hub / मागे जा
      </a>
    </div>

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6 flex-wrap">
        <span class="bg-rose-500/10 text-rose-600 dark:text-rose-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-rose-500/20 flex items-center gap-1.5">
          <HiOutlineMegaphone className="text-sm animate-pulse" /> {category} (महत्वाचे अपडेट)
        </span>
        <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20 flex items-center gap-1.5">
          <HiOutlineBuildingOffice className="text-sm" /> MPSC जाहिरात क्र. ०१७/२०२६
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]">
        {title}
      </h1>
      <p class="text-text-muted text-lg leading-relaxed border-l-4 border-rose-500 pl-6 py-2 italic">
        {description}
      </p>
    </div>

    <!-- Quick Highlights Banner -->
    <div class="bg-gradient-to-br from-rose-500/10 via-amber-500/5 to-transparent border border-rose-500/20 rounded-3xl p-4 sm:p-6 mb-12 shadow-xs">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        <div class="p-3 bg-bg-surface/80 backdrop-blur-xs rounded-2xl border border-border-card flex flex-col justify-center">
          <span class="text-[11px] sm:text-xs text-text-muted block uppercase font-bold tracking-wider mb-1 leading-snug">अर्ज करण्याची नवीन अंतिम तारीख</span>
          <span class="text-sm sm:text-base md:text-lg font-black text-rose-600 dark:text-rose-400">10 ऑगस्ट 2026 (23:59 वा.)</span>
        </div>
        <div class="p-3 bg-bg-surface/80 backdrop-blur-xs rounded-2xl border border-border-card flex flex-col justify-center">
          <span class="text-[11px] sm:text-xs text-text-muted block uppercase font-bold tracking-wider mb-1 leading-snug">ऑनलाईन शुल्क भरण्याची तारीख</span>
          <span class="text-sm sm:text-base md:text-lg font-black text-emerald-600 dark:text-emerald-400">13 ऑगस्ट 2026 (23:59 वा.)</span>
        </div>
        <div class="p-3 bg-bg-surface/80 backdrop-blur-xs rounded-2xl border border-border-card flex flex-col justify-center">
          <span class="text-[11px] sm:text-xs text-text-muted block uppercase font-bold tracking-wider mb-1 leading-snug">एकूण सुधारित पदे (Total Posts)</span>
          <span class="text-base sm:text-lg md:text-xl font-black text-primary">5,707 पदे</span>
        </div>
        <div class="p-3 bg-bg-surface/80 backdrop-blur-xs rounded-2xl border border-border-card flex flex-col justify-center">
          <span class="text-[11px] sm:text-xs text-text-muted block uppercase font-bold tracking-wider mb-1 leading-snug">शुद्धिपत्रक दिनांक</span>
          <span class="text-xs sm:text-sm md:text-base font-bold text-text-main">05 ऑगस्ट 2026</span>
        </div>
      </div>
    </div>

    <!-- Direct Action Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12 not-prose">
      <a 
        href="https://mpsconline.gov.in" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-gradient-to-br from-rose-600 to-amber-600 text-white rounded-2xl transition-all duration-300 shadow-md hover:shadow-rose-500/20 flex items-center justify-between no-underline"
      >
        <div>
          <span class="text-[0.65rem] uppercase font-extrabold tracking-wider bg-white/20 px-2.5 py-0.5 rounded text-white block w-fit mb-1">MPSC ऑनलाईन पोर्टल</span>
          <h3 class="text-base font-extrabold text-white m-0 flex items-center gap-1.5">
            ऑनलाईन अर्ज करा (Apply Online) <HiOutlineArrowTopRightOnSquare className="text-lg" />
          </h3>
          <p class="text-xs text-white/80 m-0 mt-0.5">mpsconline.gov.in वर लॉगिन करून अर्ज भरा</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform">
          <HiOutlineCursorArrowRays className="text-2xl" />
        </div>
      </a>

      <a 
        href="https://mpsc.gov.in" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-5 bg-bg-surface border border-border-card hover:border-primary/50 rounded-2xl flex items-center justify-between transition-all duration-300 no-underline group"
      >
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
            <HiOutlineDocumentText className="text-2xl" />
          </div>
          <div>
            <span class="text-xs text-text-muted font-bold uppercase tracking-wider block">अधिकृत वेबसाईट</span>
            <h4 class="text-sm font-bold text-text-main m-0 group-hover:text-primary transition-colors flex items-center gap-1">
              MPSC अधिकृत शुद्धिपत्रक पाहा <HiOutlineArrowTopRightOnSquare className="text-xs" />
            </h4>
            <p class="text-xs text-text-muted m-0">mpsc.gov.in वर अधिकृत परिपत्रक उपलब्ध</p>
          </div>
        </div>
      </a>
    </div>

    <!-- Official MPSC Corrigendum Document Display Box (Verbatim Notice Text) -->
    <div class="bg-gradient-to-br from-rose-500/10 via-amber-500/5 to-transparent border border-rose-500/30 rounded-3xl p-6 md:p-8 mb-12 shadow-sm">
      <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
        <div class="flex items-center gap-3">
          <span class="p-2 bg-rose-500 text-white rounded-xl">
            <HiOutlineDocumentText className="text-xl" />
          </span>
          <div>
            <h3 class="text-lg font-black text-text-main m-0 uppercase tracking-wide">
              -: महाराष्ट्र लोकसेवा आयोग शुद्धिपत्रक :-
            </h3>
            <span class="text-xs text-text-muted font-semibold">क्रमांक: सीएमए-०४२६/प्र.क्र.४२/२०२६/जाहिरात | दिनांक: ०५ ऑगस्ट, २०२६</span>
          </div>
        </div>
        <span class="text-xs font-extrabold text-rose-600 dark:text-rose-400 bg-rose-500/10 px-3 py-1 rounded-full border border-rose-500/20">
          जाहिरात क्रमांक: ०१७/२०२६
        </span>
      </div>

      <div class="bg-bg-surface/90 border border-border-card p-5 md:p-6 rounded-2xl leading-relaxed text-text-main text-sm sm:text-base space-y-4">
        <div class="text-center font-bold text-primary text-base sm:text-lg border-b border-border-card pb-3">
          महाराष्ट्र गट-क सेवा संयुक्त पूर्व परीक्षा - २०२६
        </div>
        
        <p class="m-0 text-text-main leading-relaxed">
          आयोगामार्फत <strong>महाराष्ट्र गट-क सेवा संयुक्त पूर्व परीक्षा - २०२६</strong> मधून एकूण <strong>२६१९ रिक्त पदे</strong> भरण्यासाठी दिनांक २५ जून, २०२६ रोजी जाहिरात प्रसिद्ध करण्यात आली आहे. आयोगाच्या दिनांक २२ जुलै, २०२६ रोजीच्या शुद्धिपत्रकानुसार प्रस्तुत परीक्षेमध्ये विविध नवीन संवर्गांचा समावेश करून एकूण <strong>५७०७ पदांकरिता</strong> भरतीप्रक्रिया राबविण्यात येणार असल्याचे प्रसिद्ध करण्यात आले आहे. सदर शुद्धिपत्रकानुसार अर्ज सादर करण्याचा दिनांक ०५ ऑगस्ट, २०२६ पर्यंत मुदतवाढ देण्यात आली आहे. तथापि, प्रस्तुत परीक्षेस अर्ज सादर करण्यास आणखी मुदतवाढ देण्याबाबतची उमेदवारांची मागणी विचारात घेऊन प्रस्तुत परीक्षेस अर्ज सादर करण्यास खालीलप्रमाणे मुदतवाढ देण्यात येत आहे:
        </p>

        <!-- Corrigendum Dates Table -->
        <div class="overflow-x-auto my-4">
          <table class="w-full text-left border-collapse border border-border-card rounded-xl overflow-hidden">
            <thead>
              <tr class="bg-rose-500/10 text-rose-700 dark:text-rose-300">
                <th class="p-3 border border-border-card font-extrabold text-xs sm:text-sm">अ.क्र.</th>
                <th class="p-3 border border-border-card font-extrabold text-xs sm:text-sm">तपशील</th>
                <th class="p-3 border border-border-card font-extrabold text-xs sm:text-sm">विहित कालावधी</th>
              </tr>
            </thead>
            <tbody class="text-xs sm:text-sm">
              <tr class="bg-bg-surface">
                <td class="p-3 border border-border-card font-bold text-center">१</td>
                <td class="p-3 border border-border-card font-bold">अर्ज सादर करण्याचा अंतिम दिनांक</td>
                <td class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-sm sm:text-base">
                  दिनांक १० ऑगस्ट, २०२६ रोजी २३:५९ वाजेपर्यंत
                </td>
              </tr>
              <tr class="bg-bg-surface">
                <td class="p-3 border border-border-card font-bold text-center">२</td>
                <td class="p-3 border border-border-card font-bold">ऑनलाईन पद्धतीने विहित परीक्षा शुल्क भरण्याचा अंतिम दिनांक</td>
                <td class="p-3 border border-border-card font-black text-emerald-600 dark:text-emerald-400 text-sm sm:text-base">
                  दिनांक १३ ऑगस्ट, २०२६ रोजी २३:५९ वाजेपर्यंत
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-700 dark:text-amber-400 text-xs sm:text-sm font-semibold flex items-start gap-2.5">
          <HiOutlineExclamationTriangle className="text-lg shrink-0 mt-0.5 text-amber-500" />
          <span>
            <strong>महत्त्वाची नोंद:</strong> चलनाद्वारे परीक्षा शुल्क भरण्याची सवलत बंद करण्यात आली असून उमेदवारांनी फक्त ऑनलाईन पद्धतीने (डेबिट कार्ड, क्रेडिट कार्ड, नेट बँकिंग, UPI) शुल्क भरणे आवश्यक आहे.
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी माहिती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-6 md:p-8 mb-12">
        <h2 class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none">
          <HiOutlineQueueList className="text-primary" />
          या लेखातील मुख्य मुद्दे (Table of Contents)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li><a href="#overview-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">१. MPSC गट-क पूर्व परीक्षा २०२६ मुदतवाढ पार्श्वभूमी</a></li>
          <li><a href="#dates-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">२. सुधारित महत्त्वाच्या तारखा (Revised Timetable)</a></li>
          <li><a href="#talathi-pesa-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">३. ग्राम महसूल अधिकारी (तलाठी) व PESA क्षेत्र अपडेट्स</a></li>
          <li><a href="#pesa-rules-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">४. पेसा (PESA) क्षेत्रातील तलाठी पदाचे महत्त्वाचे नियम व अटी</a></li>
          <li><a href="#how-to-apply-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">५. ऑनलाईन अर्ज भरण्याच्या पायऱ्या व महत्त्वाच्या सूचना</a></li>
          <li><a href="#links-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">६. अधिकृत वेबसाईट लिंक्स व हेल्पलाइन</a></li>
        </ul>
      </div>

      <!-- Main Article Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <h2 id="overview-mr" class="text-xl md:text-2xl font-black text-primary mb-2 border-l-4 border-primary pl-3">
          १. MPSC गट-क संयुक्त पूर्व परीक्षा २०२६: मुदतवाढ पार्श्वभूमी व तपशील
        </h2>
        <p>
          महाराष्ट्र लोकसेवा आयोगामार्फत (MPSC) <strong>महाराष्ट्र गट-क सेवा संयुक्त पूर्व परीक्षा - २०२६</strong> ची मूळ जाहिरात (जाहिरात क्र. ०१७/२०२६) दिनांक <strong>२५ जून २०२६</strong> रोजी २,६१९ पदांसाठी प्रसिद्ध करण्यात आली होती. त्यानंतर आयोगाने दिनांक २२ जुलै २०२६ रोजी शुद्धिपत्रक जारी करून विविध नवीन संवर्गांचा समावेश केला व एकूण पदांची संख्या <strong>५,७०७</strong> वर वाढवली.
        </p>
        <p>
          वाढलेल्या पदसंख्येमुळे आणि अनेक उमेदवारांनी अर्ज सादर करण्यासाठी वेळ वाढवून देण्याची विनंती केल्यामुळे आयोगाने दिनांक <strong>०५ ऑगस्ट २०२६</strong> रोजी नवीन शुद्धिपत्रक जारी करून अर्ज सादर करण्याची अंतिम मुदत <strong>१० ऑगस्ट २०२६ (२३:५९ वाजेपर्यंत)</strong> वाढवली आहे.
        </p>

        <!-- Revised Timetable Table (Marathi) -->
        <h2 id="dates-mr" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">
          २. सुधारित महत्त्वाच्या तारखा (Revised Important Dates)
        </h2>
        <p>उमेदवारांनी नवीन सुधारित वेळापत्रकाची नोंद घ्यावी:</p>

        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse border border-border-card rounded-2xl overflow-hidden shadow-sm">
            <thead>
              <tr class="bg-primary/10 text-text-main">
                <th class="p-3.5 border border-border-card font-extrabold text-sm">टप्पा / तपशील</th>
                <th class="p-3.5 border border-border-card font-extrabold text-sm">पूर्वीची तारीख</th>
                <th class="p-3.5 border border-border-card font-extrabold text-sm">नवीन सुधारित अंतिम तारीख</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold">ऑनलाईन अर्ज सादर करणे</td>
                <td class="p-3.5 border border-border-card text-text-muted line-through">०५ ऑगस्ट २०२६</td>
                <td class="p-3.5 border border-border-card font-black text-rose-600 dark:text-rose-400 text-base">१० ऑगस्ट २०२६ (रात्री २३:५९ वा.)</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold">ऑनलाईन परीक्षा शुल्क भरणे (UPI/Card/NetBanking)</td>
                <td class="p-3.5 border border-border-card text-text-muted line-through">०५ ऑगस्ट २०२६</td>
                <td class="p-3.5 border border-border-card font-black text-emerald-600 dark:text-emerald-400 text-base">१३ ऑगस्ट २०२६ (रात्री २३:५९ वा.)</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold">चलन पद्धतीने परीक्षा शुल्क भरणे</td>
                <td class="p-3.5 border border-border-card text-text-muted">सवलत उपलब्ध होती</td>
                <td class="p-3.5 border border-border-card font-bold text-rose-600 dark:text-rose-400">पूर्णपणे बंद (फक्त ऑनलाईन माध्यम)</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
