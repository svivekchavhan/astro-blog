              </tr>

              <!-- SBC -->
              <tr class="hover:bg-bg-surface/50">
                <td
                  class="p-3.5 border border-border-card font-bold text-text-main"
                  rowspan="2">SBC (विशेष मागास प्रवर्ग)</td
                >
                <td class="p-3.5 border border-border-card font-medium"
                  >GENERAL</td
                >
                <td
                  class="p-3.5 border border-border-card font-extrabold text-center"
                  >772</td
                >
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-medium"
                  >FEMALE</td
                >
                <td
                  class="p-3.5 border border-border-card font-extrabold text-center"
