---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
} from "react-icons/hi2";

const title =
  "GMC Gondia भरती २०२६: शासकीय वैद्यकीय महाविद्यालय गोंदिया सहाय्यक प्राध्यापक १३ जागांसाठी जाहिरात प्रसिद्ध";
const description =
  "Government Medical College Gondia Assistant Professor Recruitment 2026 (Advt dated 05/08/2026): Apply for 13 Assistant Professor and Statistician-cum-Assistant Professor vacancies in GMC Gondia. Read department-wise vacancy breakdown, qualification, MD/MS/DNB criteria, age limit, and official PDF link.";
const canonicalURL =
  "https://mahasandhi.in/gmc-gondia-assistant-professor-recruitment-2026";
const date = "August 15, 2026";
const category = "Latest Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://lh3.googleusercontent.com/d/1qMZYMWkp1Z1zKUWgRTdDwKMpJje5PSwd"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "GMC Gondia Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- Featured Image Banner -->
    <div class="mb-8 rounded-3xl overflow-hidden border border-border-card shadow-lg bg-bg-surface p-2 sm:p-4">
      <img
        src="https://lh3.googleusercontent.com/d/1qMZYMWkp1Z1zKUWgRTdDwKMpJje5PSwd"
        alt="GMC Gondia Assistant Professor Recruitment 2026 Notification"
        class="w-full h-auto max-h-[550px] object-contain mx-auto rounded-2xl"
        loading="eager"
      />
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          शासकीय वैद्यकीय महाविद्यालय, गोंदिया (GMC Gondia) सहाय्यक प्राध्यापक
          भरती जाहिरात (दिनांक ०५/०८/२०२६)
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>GMC Gondia Bharti 2026:</strong> शासकीय वैद्यकीय महाविद्यालय,
            गोंदिया (Government Medical College, Gondia) द्वारे प्रसिद्ध करण्यात आलेली
            सहाय्यक प्राध्यापक पदभरती जाहिरात (दिनांक ०५/०८/२०२६) अधिकृत वेबसाईटवर
            प्रसिद्ध करण्यात आली आहे. या भरती प्रक्रियेद्वारे वैद्यकीय विभागांमधील
            <strong>सहाय्यक प्राध्यापक (Assistant Professor)</strong> आणि <strong
              >सांख्यिकीशास्त्रज्ञ तथा सहाय्यक प्राध्यापक
              (Statistician-cum-Assistant Professor)</strong
            > या एकूण <strong>१३ पदांसाठी</strong> अर्ज मागविण्यात येत आहेत.
          </p>
          <p>
            मुख्य सहाय्यक प्राध्यापक तक्त्यामध्ये ७ विविध वैद्यकीय विषयांसाठी १२
            पदे असून, कम्युनिटी मेडिसिन विभागात सांख्यिकीशास्त्रज्ञ तथा सहाय्यक
            प्राध्यापक चे १ पद समाविष्ट आहे. अशा प्रकारे एकूण १३ पदे भरली जाणार
            आहेत.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >संस्था / विभाग</span
              >
              <span class="text-text-main font-semibold text-sm"
                >शासकीय वैद्यकीय महाविद्यालय, गोंदिया</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण</span
              >
              <span class="text-text-main font-semibold text-sm"
                >गोंदिया, महाराष्ट्र (Gondia)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण रिक्त पदे</span
              >
              <span class="text-text-main font-semibold text-sm"
                >१३ जागा (13 Posts)</span
              >
            </div>
          </div>
        </div>

        <!-- Post Details & Vacancy Breakdown Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          १. पदांचे नाव व पदसंख्या (Post Name & Total Posts Breakdown)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          Government Medical College Gondia कडून विविध विषयांसाठी जाहीर केलेल्या
          रिक्त जागांचा तपशील खालीलप्रमाणे आहे:
        </p>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center w-16"
                  >अ.क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >एकूण जागा (Total Posts)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >१</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >👨‍⚕️ Assistant Professor – Physiology (शरीरक्रियाशास्त्र)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०२</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >२</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >💊 Assistant Professor – Pharmacology (औषधनिर्माणशास्त्र)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०१</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >३</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >🧪 Assistant Professor – Biochemistry (जीवरसायनशास्त्र)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०२</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >४</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >🫀 Assistant Professor – Anatomy (शरीररचनाशास्त्र)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०२</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >५</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >⚖️ Assistant Professor – Forensic Medicine
                  (न्यायवैद्यकशास्त्र)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०१</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >६</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >👥 Assistant Professor – Community Medicine
                  (जनआरोग्यवैद्यकशास्त्र)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०३</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >७</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >🤰 Assistant Professor – Obstetrics & Gynaecology (स्त्रीरोग
                  व प्रसूतिशास्त्र)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०१</td
                >
              </tr>
              <tr class="bg-primary/5">
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >८</td
                >
                <td class="p-3 border border-border-card font-bold text-primary"
                  >📊 Statistician-cum-Assistant Professor – Community Medicine
                  (सांख्यिकीशास्त्रज्ञ तथा सहाय्यक प्राध्यापक)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-rose-500 text-base"
                  >०१</td
                >
              </tr>
              <tr class="bg-primary/10">
                <td
                  colspan="2"
                  class="p-3 border border-border-card font-bold text-text-main text-right"
                  >🔢 एकूण रिक्त पदे (Total Vacancies)</td
                >
                <td
                  class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-lg"
                  >१३ पदे</td
                >
              </tr>
            </tbody>
          </table>
        </div>
        <p
          class="text-xs text-text-muted italic bg-bg-surface border border-border-card p-3 rounded-xl"
        >
          📌 <strong>विशेष टीप:</strong> जाहिरातीतील मुख्य Assistant Professor तक्त्यामध्ये
          १२ पदे आहेत; याव्यतिरिक्त Community Medicine विभागात Statistician-cum-Assistant
          Professor ची १ पद आहे. त्यामुळे जाहिरातीत एकूण १३ पदे निश्चित होतात.
        </p>

        <!-- Educational Qualification Requirements -->
        <h2
          id="eligibility"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎓 २. पदनिहाय शैक्षणिक पात्रता व अनुभव (Educational Qualification &
          Experience)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक पात्रता व अनुभव</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >👨‍⚕️ Assistant Professor (Physiology, Pharmacology,
                  Biochemistry, Anatomy, Forensic Medicine, Community Medicine,
                  Obstetrics & Gynaecology)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  मान्यताप्राप्त विद्यापीठाची संबंधित विषयातील पदव्युत्तर पदवी
                  (MD / MS / DNB) + संबंधित विषयात ज्येष्ठ निवासी डॉक्टर (Senior
                  Resident) म्हणून १ वर्षाचा अनुभव आवश्यक. (टीचिंग अनुभवास
                  प्राधान्य दिले जाईल).
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >📊 Statistician-cum-Assistant Professor – Community Medicine</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  सांख्यिकीशास्त्र विषयातील एम.एसी. पदवी (M.Sc. Statistics) +
                  सांख्यिकीशास्त्र विषयातील विद्यावाचस्पती पदवी (Ph.D.
                  Statistics).
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div
          class="bg-primary/5 border border-primary/20 p-4 rounded-2xl text-xs space-y-2 text-text-main mb-8"
        >
          <p class="font-bold m-0 text-primary">💡 महत्त्वाचे:</p>
          <p class="m-0 text-text-muted">
            सर्व वैद्यकीय सहाय्यक प्राध्यापक पदांसाठी NMC (National Medical
            Commission) / MCI नियमांनुसार मान्यताप्राप्त विद्यापीठाची पदव्युत्तर
            पदवी (MD/MS/DNB) व Senior Resident चा अनुभव अनिवार्य आहे.
          </p>
        </div>

        <!-- Age Limit -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎂 ३. वयोमर्यादा (Age Limit)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >प्रवर्ग / पदनाम (Post & Category)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा (Age Limit)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >👨‍⚕️ Assistant Professor – सर्व Medical Departments (अमागास /
                  Open Category)</td
                >
                <td class="p-3 border border-border-card font-bold text-primary"
                  >४० वर्षांपर्यंत (Up to 40 years)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >🟠 Assistant Professor – राखीव / मागासवर्गीय प्रवर्ग
                  (Reserved / Backward Category)</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-emerald-600 dark:text-emerald-400"
                  >४५ वर्षांपर्यंत (Up to 45 years)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >📊 Statistician-cum-Assistant Professor (सांख्यिकीशास्त्रज्ञ)</td
                >
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >शासकीय व NMC नियमांनुसार (Open: 40 वर्षे / Reserved: 45
                  वर्षे)</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Calculator Button -->
        <div class="my-6">
          <a
            href="/mpsc-age-calculator-marathi"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-secondary hover:shadow-lg text-white font-bold text-sm rounded-xl transition-all no-underline border-none"
          >
            <HiOutlineCalculator className="text-lg shrink-0" />
            <span>तुमचे वय मोजा - MPSC & Govt Age Calculator Tool</span>
          </a>
        </div>

        <!-- Important Schedule, Fee & Interview Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          महत्त्वाच्या तारखा, अर्ज शुल्क व मुलाखत वेळापत्रक (Important Dates & Interview Schedule)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तारीख / वेळ / माहिती (Date / Time / Link)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >जाहिरात प्रसिद्धी दिनांक (Notification Date)</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >०५ ऑगस्ट २०२६ (05/08/2026)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अर्ज उपलब्ध होण्याचा दिनांक (Form Availability Date)</td
                >
                <td
                  class="p-3 border border-border-card text-emerald-600 dark:text-emerald-400 font-bold"
                  >१० ऑगस्ट २०२६ (10/08/2026 पासून)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अर्जाचे शुल्क (Application Fee)</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >₹ १००/- (रु. १०० मात्र)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अर्ज सादर करण्याचा अंतिम दिनांक व वेळ (Last Date to Submit)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-rose-500 text-lg shrink-0"
                    /> २० ऑगस्ट २०२६ (सायंकाळ ०४:०० वाजेपर्यंत)</span
                  >
                </td>
              </tr>
              <tr class="bg-primary/5">
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >मुलाखतीचा दिनांक व वेळ (Interview Date & Time)</td
                >
                <td
