              <tr><td class="p-2.5 border border-border-card text-center font-bold">२</td><td class="p-2.5 border border-border-card font-semibold">Rifleman (Electrical Fitter Signal)</td><td class="p-2.5 border text-center">०५</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०९</td><td class="p-2.5 border text-center">०३</td><td class="p-2.5 border text-center">१३</td><td class="p-2.5 border text-center font-bold text-primary">३२</td></tr>
