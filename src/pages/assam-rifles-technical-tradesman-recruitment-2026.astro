              <tr><td class="p-2.5 border border-border-card text-center font-bold">१५</td><td class="p-2.5 border border-border-card font-semibold">Warrant Officer (Operation Theatre Technician)</td><td class="p-2.5 border text-center">००</td><td class="p-2.5 border text-center">००</td><td class="p-2.5 border text-center">००</td><td class="p-2.5 border text-center">००</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center font-bold text-primary">०१</td></tr>
