---
import Layout from "../layouts/Layout.astro";
import { OFFICIAL_LINKS } from "../constants/links";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineCurrencyRupee,
} from "react-icons/hi2";

const title =
  "Assam Rifles टेक्निकल व ट्रेड्समन भरती २०२६: ३५४ जागांसाठी ऑनलाईन अर्ज सुरू (Assam Rifles Bharti Rally 2026)";
const description =
  "Assam Rifles Technical & Tradesman Recruitment Rally 2026: Apply online for 354 Group C vacancies (Warrant Officer, Rifleman & Havildar). Check trade-wise vacancies, qualification, age limit, PST/PET standards, fee & official notification PDF link at mahasandhi.in.";
const canonicalURL =
  "https://mahasandhi.in/assam-rifles-technical-tradesman-recruitment-2026";
const date = "September 28, 2026";
const category = "Central Govt";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Assam Rifles Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Main Article Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Jump Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          आसाम रायफल्स टेक्निकल आणि ट्रेड्समन ३५४ पदे भरती रॅली जाहिरात २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Assam Rifles Recruitment 2026:</strong> आसाम रायफल्स (Office of the Directorate General Assam Rifles, Shillong) द्वारे <strong>टेक्निकल आणि ट्रेड्समन भरती रॅली २०२६ (Assam Rifles Technical and Tradesman Recruitment Rally 2026)</strong> अंतर्गत ग्रुप 'C' संवर्गातील <strong>३५४ जागांसाठी</strong> अधिकृत जाहिरात (Memo No. <code>I.12016/A Branch (Rect Cell)/2026/1310</code>) प्रसिद्ध करण्यात आली आहे.
          </p>
          <p>
            या भरती अंतर्गत सर्व भारतातील पात्र पुरुष उमेदवारांकडून ऑनलाईन अर्ज मागविण्यात येत आहेत. ऑनलाईन अर्ज प्रक्रिया <strong>२८ सप्टेंबर २०२६ ते २८ ऑक्टोबर २०२६</strong> (रात्री २३:५० पर्यंत) खुला राहील. शारीरिक क्षमता चाचणी (PST/PET) २३ नोव्हेंबर २०२६ पासून जोरहाट (Jorhat) आणि दिफू (Diphu) येथे आयोजित केली जाईल.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >आयोजक संस्था</span
              >
              <span class="text-text-main font-semibold text-sm"
                >आसाम रायफल्स (Assam Rifles, DGAR)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >रॅली ठिकाण (Venue)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >जोरहाट व दिफू (आसाम state)</span
