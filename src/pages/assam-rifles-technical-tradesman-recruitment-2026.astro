              <tr><td class="p-2.5 border border-border-card text-center font-bold">९</td><td class="p-2.5 border border-border-card font-semibold">Rifleman (Metalsmith)</td><td class="p-2.5 border text-center">०३</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">०५</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०८</td><td class="p-2.5 border text-center font-bold text-primary">१९</td></tr>
              <tr><td class="p-2.5 border border-border-card text-center font-bold">१०</td><td class="p-2.5 border border-border-card font-semibold">Rifleman (Upholster)</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">००</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">००</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center font-bold text-primary">०३</td></tr>
              <tr><td class="p-2.5 border border-border-card text-center font-bold">११</td><td class="p-2.5 border border-border-card font-semibold">Rifleman Store Keeper Technical (EME)</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">०४</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०७</td><td class="p-2.5 border text-center font-bold text-primary">१६</td></tr>
