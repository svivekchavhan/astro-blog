              <tr><td class="p-2.5 border border-border-card text-center font-bold">५</td><td class="p-2.5 border border-border-card font-semibold">Rifleman (Engineer Equipment Mechanic)</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">०४</td><td class="p-2.5 border text-center font-bold text-primary">१०</td></tr>
              <tr><td class="p-2.5 border border-border-card text-center font-bold">६</td><td class="p-2.5 border border-border-card font-semibold">Rifleman (Recovery Vehicle Mechanic)</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">०४</td><td class="p-2.5 border text-center">०१</td><td class="p-2.5 border text-center">०५</td><td class="p-2.5 border text-center font-bold text-primary">१३</td></tr>
              <tr><td class="p-2.5 border border-border-card text-center font-bold">७</td><td class="p-2.5 border border-border-card font-semibold">Rifleman (Electrician Motor Vehicle)</td><td class="p-2.5 border text-center">०३</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०६</td><td class="p-2.5 border text-center">०२</td><td class="p-2.5 border text-center">०९</td><td class="p-2.5 border text-center font-bold text-primary">२२</td></tr>
