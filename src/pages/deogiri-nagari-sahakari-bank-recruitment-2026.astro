---
import Layout from "../layouts/Layout.astro";
import ImportantUpdatesWidget from "../components/ImportantUpdatesWidget.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCurrencyRupee,
  HiOutlineClipboardDocumentList,
  HiOutlineCheckCircle,
} from "react-icons/hi2";

const title =
  "Deogiri Nagari Sahakari Bank Ltd. Trainee Junior Officer Recruitment 2026 – 100 Vacancies";
const description =
  "Apply online for 100 Trainee Junior Officer vacancies at Deogiri Nagari Sahakari Bank Ltd., Chhatrapati Sambhajinagar via MUCBF Portal. Application window: 14 Oct – 31 Oct 2026. Fee: ₹944. Stipend: ₹15,000–₹18,000/month.";
const canonicalURL =
  "https://mahasandhi.in/deogiri-nagari-sahakari-bank-recruitment-2026";
const date = "October 16, 2026";
const category = "Bank Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Deogiri Nagari Sahakari Bank Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Main Article Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-5 leading-tight"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base md:text-lg leading-relaxed border-l-4 border-primary pl-4 sm:pl-6 py-2 italic font-medium"
      >
        {description}
      </p>
    </div>

    <!-- Quick Info Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6 not-prose">
      <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex flex-col gap-1">
        <HiOutlineBuildingOffice className="text-primary text-xl shrink-0" />
        <span class="text-[0.65rem] text-text-muted uppercase font-bold tracking-wider">Organization</span>
        <span class="text-text-main font-semibold text-xs">Deogiri Nagari Sahakari Bank</span>
      </div>
      <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex flex-col gap-1">
        <HiOutlineBriefcase className="text-primary text-xl shrink-0" />
        <span class="text-[0.65rem] text-text-muted uppercase font-bold tracking-wider">Post</span>
        <span class="text-text-main font-semibold text-xs">Trainee Junior Officer</span>
      </div>
      <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex flex-col gap-1">
        <HiOutlineClipboardDocumentList className="text-primary text-xl shrink-0" />
        <span class="text-[0.65rem] text-text-muted uppercase font-bold tracking-wider">Vacancies</span>
        <span class="text-text-main font-bold text-lg text-primary">100</span>
      </div>
      <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex flex-col gap-1">
        <HiOutlineCalendarDays className="text-rose-500 text-xl shrink-0" />
        <span class="text-[0.65rem] text-text-muted uppercase font-bold tracking-wider">Last Date</span>
        <span class="text-rose-600 dark:text-rose-400 font-bold text-xs">31 Oct 2026</span>
      </div>
    </div>

    <!-- Advt Notice -->
    <div class="bg-primary/5 border border-primary/20 rounded-2xl px-5 py-3 text-sm mb-8 not-prose">
      <strong>Advertisement Notice No.:</strong> जाहिरात कोड क्र. १३०/२०२६-२७ (Advt. Code No. 130/2026-27)
    </div>

    <!-- Post Details & Vacancies -->
    <h2
      id="post-details"
      class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
    >
      Post Details &amp; Vacancies
    </h2>
    <div class="overflow-x-auto mt-3 mb-8">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-primary/10">
            <th class="p-3 border border-border-card font-bold text-text-main">Post Name</th>
            <th class="p-3 border border-border-card font-bold text-text-main">Posting Location</th>
            <th class="p-3 border border-border-card font-bold text-text-main text-center">Vacancies</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-3 border font-semibold">Trainee Junior Officer<br /><span class="text-text-muted font-normal text-xs">(प्रशिक्षणार्थी कनिष्ठ अधिकारी)</span></td>
            <td class="p-3 border text-text-muted">Bank Branches &amp; Departments<br /><span class="text-xs">(बँकेचे शाखा व विभाग)</span></td>
            <td class="p-3 border text-center font-black text-primary text-lg">100</td>
          </tr>
          <tr class="bg-primary/5">
            <td class="p-3 border font-black text-right" colspan="2">Grand Total Vacancies</td>
            <td class="p-3 border text-center font-black text-rose-600 text-lg">100</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Eligibility & Qualification -->
    <h2
      id="eligibility"
      class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
    >
      🎓 Eligibility &amp; Qualification
    </h2>
    <p class="text-sm text-text-muted mb-4"><em>Cut-off Date: As on 30.09.2026</em></p>
    <div class="overflow-x-auto mt-3 mb-8">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-primary/10">
            <th class="p-3 border border-border-card font-bold text-text-main">Criteria</th>
            <th class="p-3 border border-border-card font-bold text-text-main">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-card/30">
          <tr>
            <td class="p-3 border font-bold">Graduation Degree (आवश्यक)</td>
            <td class="p-3 border text-text-muted">Bachelor's degree in any discipline from a recognized University.</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Computer Certification (आवश्यक)</td>
            <td class="p-3 border text-text-muted">MS-CIT or an equivalent computer course certificate.</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Language Proficiency (आवश्यक)</td>
            <td class="p-3 border text-text-muted">Must be proficient in writing and speaking Marathi, English, and Hindi.</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Desirable / Preference</td>
            <td class="p-3 border text-text-muted">JAIIB / CAIIB / GDC&amp;A or recognized diploma in Banking, Cooperation, or Law (ICM, IIBF, VAMNICOM etc.). Relevant experience in banks, credit co-ops, or financial institutions.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Age Limit -->
    <h2
      id="age-limit"
      class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
    >
      🎂 Age Limit
    </h2>
    <p class="text-sm text-text-muted mb-4"><em>Crucial Date: As on 01.10.2026</em></p>
    <div class="overflow-x-auto mt-3 mb-8">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-primary/10">
            <th class="p-3 border border-border-card font-bold text-text-main">Post Name</th>
            <th class="p-3 border border-border-card font-bold text-text-main text-center">Minimum Age</th>
            <th class="p-3 border border-border-card font-bold text-text-main text-center">Maximum Age</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-3 border font-semibold">Trainee Junior Officer</td>
            <td class="p-3 border text-center font-bold text-primary">22 Years</td>
            <td class="p-3 border text-center font-bold text-primary">35 Years</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Application Fee & Stipend -->
    <h2
      id="fees-stipend"
      class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
    >
      💳 Application Fee, Stipend &amp; Security Deposit
    </h2>
    <div class="overflow-x-auto mt-3 mb-8">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-primary/10">
            <th class="p-3 border border-border-card font-bold text-text-main">Item</th>
            <th class="p-3 border border-border-card font-bold text-text-main">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-card/30">
          <tr>
            <td class="p-3 border font-bold">Application Fee</td>
            <td class="p-3 border font-bold text-rose-500">₹800 + 18% GST = <strong>₹944/-</strong> (non-refundable, online)</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Training Stipend (First 6 months)</td>
            <td class="p-3 border text-emerald-600 dark:text-emerald-400 font-bold">₹15,000/- gross per month</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Training Stipend (Next 6 months)</td>
            <td class="p-3 border text-emerald-600 dark:text-emerald-400 font-bold">₹18,000/- gross per month <span class="text-text-muted font-normal text-xs">(subject to satisfactory performance)</span></td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Probation Period (6 months)</td>
            <td class="p-3 border text-text-muted">Standard bank pay scale on satisfactory evaluation → permanent appointment</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Security Bond</td>
            <td class="p-3 border text-text-muted">₹500/- stamp paper indemnity at appointment</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">Fixed Deposit / Term Deposit</td>
            <td class="p-3 border text-text-muted">₹30,000/- FD with the bank (refundable with interest after 5 continuous years of service)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Important Dates & Links -->
    <h2
      id="important-dates"
      class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
    >
      📅 Important Dates &amp; Links
    </h2>
    <div class="overflow-x-auto mt-3 mb-8">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-primary/10">
            <th class="p-3 border border-border-card font-bold text-text-main">Event / Resource</th>
            <th class="p-3 border border-border-card font-bold text-text-main">Detail / Link</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-card/30">
          <tr>
            <td class="p-3 border font-semibold">Official Application Portal</td>
            <td class="p-3 border">
              <a
                href="http://www.mucbf.in/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-primary font-bold underline hover:no-underline"
              >
                <HiOutlineCursorArrowRays className="text-base shrink-0" />
                www.mucbf.in
              </a>
            </td>
          </tr>
          <tr>
            <td class="p-3 border font-semibold">Online Application Start Date</td>
            <td class="p-3 border text-emerald-600 dark:text-emerald-400 font-bold">14 October 2026 (from 11:00 AM)</td>
          </tr>
          <tr>
            <td class="p-3 border font-semibold">Last Date for Application &amp; Fee Payment</td>
            <td class="p-3 border text-rose-600 dark:text-rose-400 font-bold">31 October 2026 (until 11:59 PM)</td>
          </tr>
          <tr>
            <td class="p-3 border font-semibold">Admit Card &amp; Interview Schedule</td>
            <td class="p-3 border text-text-muted">To be notified on www.mucbf.in</td>
          </tr>
          <tr>
            <td class="p-3 border font-semibold">Examination Centre</td>
            <td class="p-3 border text-text-muted">Chhatrapati Sambhajinagar</td>
          </tr>
          <tr>
            <td class="p-3 border font-semibold">Helpline</td>
            <td class="p-3 border text-text-muted">
              Email: <a href="mailto:exam@mucbf.in" class="text-primary font-bold">exam@mucbf.in</a>
              &nbsp;|&nbsp; Mobile: 80871 41209
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Apply Online Button -->
    <div class="not-prose my-8 flex flex-wrap gap-4">
      <a
        href="http://www.mucbf.in/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl transition-colors shadow-sm"
      >
        <HiOutlineCursorArrowRays className="text-lg shrink-0" />
        Apply Online at MUCBF Portal
      </a>
    </div>

    <!-- Selection Process -->
    <h2
      id="selection-process"
      class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
    >
      🔍 Selection Process
    </h2>
    <div class="overflow-x-auto mt-3 mb-8">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-primary/10">
            <th class="p-3 border border-border-card font-bold text-text-main">Stage</th>
            <th class="p-3 border border-border-card font-bold text-text-main">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-card/30">
          <tr>
            <td class="p-3 border font-bold">1. Online Examination</td>
            <td class="p-3 border text-text-muted">100 Marks / 120 Minutes – Quantitative Ability (40 Q, 40 M), English (20 Q, 10 M), Computer &amp; Cooperation (20 Q, 10 M), Reasoning (20 Q, 20 M), Banking &amp; GK (20 Q, 20 M). Weightage: 90 marks.</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">2. Document Verification</td>
            <td class="p-3 border text-text-muted">Shortlisted in 1:3 ratio based on online exam merit.</td>
          </tr>
          <tr>
            <td class="p-3 border font-bold">3. Oral Interview</td>
            <td class="p-3 border text-text-muted">10 Marks: 5 marks for Educational Qualification + 5 marks for Interview.</td>
          </tr>
          <tr class="bg-primary/5">
            <td class="p-3 border font-black">Final Merit List</td>
            <td class="p-3 border font-bold text-primary">90 (Exam weightage) + 10 (Interview) = 100 Marks</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Application Procedure -->
    <h2
      id="how-to-apply"
      class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
    >
      📝 Application / Registration Process
    </h2>
    <div class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3 mb-8">
      <ol class="list-decimal pl-5 space-y-3 text-text-muted">
        <li><strong class="text-text-main">Access the Portal:</strong> Visit <a href="http://www.mucbf.in/" target="_blank" rel="noopener noreferrer" class="text-primary font-bold underline">www.mucbf.in</a>.</li>
        <li><strong class="text-text-main">Fill Online Application:</strong> Enter personal information, contact details, valid email, and active mobile number.</li>
        <li><strong class="text-text-main">Educational Details:</strong> Provide marks and details of your degree qualification and computer certifications (no document uploads required at form submission stage).</li>
        <li><strong class="text-text-main">Fee Payment:</strong> Pay the non-refundable registration fee of ₹944/- online and update the payment transaction details on the portal.</li>
        <li><strong class="text-text-main">Submit &amp; Print:</strong> Submit before 31 October 2026 (11:59 PM) and retain a printed copy for document verification and interview.</li>
      </ol>
    </div>

    <ImportantUpdatesWidget />
  </article>
</Layout>
