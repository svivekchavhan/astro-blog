---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineUserGroup, 
  HiOutlineMapPin, 
  HiOutlineCalendarDays, 
  HiOutlineClock, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase, 
  HiOutlineBuildingOffice, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineCheckCircle, 
  HiOutlineDocumentCheck,
  HiOutlineMagnifyingGlass
} from "react-icons/hi2";

const walkInJobs = [
  {
    id: "w1",
    title: "AIIMS Nagpur Walk-In Interview 2026: 48 Senior Resident Positions",
    organisation: "All India Institute of Medical Sciences (AIIMS), Nagpur",
    category: "Medical & Healthcare",
    status: "upcoming",
    interviewDate: "28 July 2026",
    reportingTime: "09:00 AM to 11:00 AM",
    venue: "Executive Director Office, AIIMS Campus, MIHAN, Nagpur, Maharashtra - 441108",
    qualification: "MD / MS / DNB / Diploma in relevant discipline",
    vacancies: "48",
    documents: ["Updated Resume (2 copies)", "MD/MS Degree Certificate", "MMC Registration Proof", "Identity Card (Aadhaar/PAN)", "Passport Size Photos (4)"],
    link: "/aiims-nagpur-walk-in-2026",
    officialPdf: "https://aiimsnagpur.edu.in",
    isHot: true
  },
  {
    id: "w2",
    title: "TCS Walk-In Drive Pune 2026: Software Engineers & IT Support Roles",
    organisation: "Tata Consultancy Services (TCS)",
    category: "IT & Software",
    status: "walk-in-soon",
    interviewDate: "26 July 2026",
    reportingTime: "09:30 AM to 01:00 PM",
    venue: "TCS Sahyadri Park, Plot No. 2 & 3, Rajiv Gandhi InfoTech Park, Hinjewadi Phase 3, Pune - 411057",
    qualification: "B.E. / B.Tech / MCA / M.Sc (CS/IT) with 1 to 4 years experience",
    vacancies: "150+",
    documents: ["Updated CV", "Last 3 Months Payslips", "Degree Certificate", "Government ID Proof"],
    link: "/tcs-walk-in-pune-2026",
    officialPdf: "https://www.tcs.com",
    isHot: true
  },
  {
    id: "w3",
    title: "WALMI Aurangabad Walk-In Recruitment 2026: Assistant Engineer & Research Associate",
    organisation: "Water and Land Management Institute (WALMI), Chhatrapati Sambhajinagar",
    category: "Engineering & Technical",
    status: "upcoming",
    interviewDate: "30 July 2026",
    reportingTime: "10:00 AM",
    venue: "WALMI Campus, Kanchanwadi, Paithan Road, Chhatrapati Sambhajinagar (Aurangabad) - 431005",
    qualification: "Degree / Diploma in Civil Engineering / Agriculture",
    vacancies: "18",
    documents: ["Original Educational Certificates", "Self-Attested Photostat Copies", "Experience Certificates", "Valid Photo ID"],
    link: "/walmi-walk-in-2026",
    officialPdf: "https://walmi.org",
    isHot: false
  },
  {
    id: "w4",
    title: "Government Medical College (GMC) Nanded: Walk-In for Medical Officers & Specialists",
    organisation: "Government Medical College & Hospital, Nanded",
    category: "Medical & Healthcare",
    status: "walk-in-today",
    interviewDate: "23 July 2026 (Today)",
    reportingTime: "11:00 AM to 02:00 PM",
    venue: "Dean Office, Government Medical College Campus, Vazirabad, Nanded, Maharashtra - 431601",
    qualification: "MBBS / BAMS / MD with valid Registration",
    vacancies: "32",
    documents: ["MBBS Degree & Attempt Certificate", "Council Registration", "Age Proof Certificate", "Cast Certificate (if applicable)"],
    link: "/gmc-nanded-walk-in-2026",
    officialPdf: "https://gmcnanded.org",
    isHot: true
  },
  {
    id: "w5",
    title: "Savitribai Phule Pune University (SPPU): Walk-In Interview for Assistant Professors",
    organisation: "SPPU Department of Environmental Sciences",
    category: "Teaching & Faculty",
    status: "upcoming",
    interviewDate: "02 August 2026",
    reportingTime: "10:30 AM",
    venue: "Department of Environmental Sciences, SPPU Campus, Ganeshkhind, Pune - 411007",
    qualification: "Master's Degree with minimum 55% + NET / SET / Ph.D.",
    vacancies: "12",
    documents: ["Application Form (Format on University Site)", "NET/SET Passing Certificate", "Publication Copies", "2 Sets of Photostats"],
    link: "/sppu-faculty-walk-in-2026",
    officialPdf: "https://unipune.ac.in",
    isHot: false
  },
  {
    id: "w6",
    title: "Bank of Baroda Financial Services: Walk-In Drive for Collection Officers & Executives",
    organisation: "BOB Financial Solutions Limited",
    category: "Banking & Finance",
    status: "upcoming",
    interviewDate: "05 August 2026",
    reportingTime: "09:30 AM to 03:00 PM",
    venue: "BOB Financial Office, 3rd Floor, BKC, Bandra East, Mumbai - 400051",
    qualification: "Any Graduate (B.Com/BBA/B.Sc/B.A.) with good communication skills",
    vacancies: "65",
    documents: ["Resume", "Graduation Marksheets", "Aadhaar & PAN Card", "2 Passport Photos"],
    link: "/bob-financial-walk-in-2026",
    officialPdf: "https://www.bobfinancial.com",
    isHot: false
