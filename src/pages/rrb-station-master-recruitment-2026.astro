---
import ArticleContainer from "../components/ArticleContainer.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase, 
  HiOutlineBuildingOffice, 
  HiOutlineCheckCircle, 
  HiOutlineDocumentText, 
  HiOutlineCurrencyRupee, 
  HiOutlineUserGroup,
  HiOutlineQuestionMarkCircle,
  HiOutlineExclamationTriangle,
  HiOutlineSparkles,
  HiOutlineShieldCheck,
  HiOutlineClock
} from "react-icons/hi2";

const title = "RRB Station Master Recruitment 2026: Apply Online for 1,215 Vacancies (CEN 08/2026) - रेल्वे स्टेशन मास्टर भरती";
const description = "Railway Recruitment Boards (RRB) has released CEN 08/2026 notification for 1,215 Station Master (Level 6, Pay ₹35,400) vacancies. Check eligibility, age limit, CBT & CBAT exam pattern, syllabus, fees and apply online at rrbapply.gov.in.";
const canonicalURL = "https://mahasandhi.in/rrb-station-master-recruitment-2026";
const date = "October 27, 2026";
const category = "Railway Job";
const image = "https://images.unsplash.com/photo-1474487548417-781cb71495f3?auto=format&fit=crop&q=80&w=1200";

// JSON-LD Schemas for Schema.org SEO Validation
const jobPostingSchema = {
  "@context": "https://schema.org/",
  "@type": "JobPosting",
  "title": "RRB Station Master Recruitment 2026 (1,215 Vacancies - CEN 08/2026)",
  "description": "Railway Recruitment Boards (RRB) invites online applications for 1,215 Station Master vacancies under Centralised Employment Notice CEN 08/2026. Pay Level 6 (Initial Pay ₹35,400). Selection through CBT, CBAT, DV and Medical exam (No Interview).",
  "identifier": {
    "@type": "PropertyValue",
    "name": "Railway Recruitment Boards",
    "value": "CEN 08/2026"
  },
  "datePosted": "2026-10-27",
  "validThrough": "2026-11-25",
  "employmentType": "FULL_TIME",
  "hiringOrganization": {
    "@type": "Organization",
    "name": "Railway Recruitment Boards (RRB)",
    "sameAs": "https://www.rrbapply.gov.in"
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "All India (All RRBs including RRB Mumbai)",
      "addressCountry": "IN"
    }
  },
  "baseSalary": {
    "@type": "MonetaryAmount",
    "currency": "INR",
    "value": {
      "@type": "QuantitativeValue",
      "value": 35400,
      "unitText": "MONTH"
    }
  },
  "educationRequirements": "Graduate Degree in any stream from a recognized University or equivalent",
  "experienceRequirements": "Fresher / No prior experience required"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "RRB स्टेशन मास्टर भरती २०२६ मध्ये एकूण किती जागा आहेत? (What are total Station Master vacancies?)",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "रेल्वे भरती मंडळाने (RRB) CEN 08/2026 अंतर्गत देशभरातील सर्व RRBs मध्ये स्टेशन मास्टर पदाच्या एकूण १,२१५ (1,215) रिक्त जागांसाठी भरती जाहीर केली आहे."
      }
    },
    {
      "@type": "Question",
      "name": "RRB Station Master पदासाठी शैक्षणिक पात्रता काय आहे?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "मान्यताप्राप्त विद्यापीठाची कोणत्याही शाखेतील पदवी (Graduate Degree in any stream). अंतिम वर्षाचा निकाल प्रलंबित असलेले उमेदवार अर्ज करू शकत नाहीत; पात्रता २५ नोव्हेंबर २०२६ पर्यंत पूर्ण असावी."
      }
    },
    {
      "@type": "Question",
      "name": "स्टेशन मास्टर भरतीसाठी वयोमर्यादा काय आहे?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "०१ जानेवारी २०२७ रोजी उमेदवाराचे वय २० ते ३३ वर्षे असावे. नियमांनुसार OBC-NCL प्रवर्गास ३ वर्षे आणि SC/ST प्रवर्गास ५ वर्षे वयोमर्यादेत सूट लागू आहे."
      }
    },
    {
      "@type": "Question",
      "name": "या भरतीमध्ये मुलाखत (Interview) आहे का?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "नाही. या भरतीमध्ये कोणतीही मुलाखत (Interview) नाही. निवड केवळ CBT (संगणक आधारित चाचणी), CBAT (अ‍ॅप्टिट्यूड टेस्ट), कागदपत्र पडताळणी (DV) आणि वैद्यकीय चाचणी (Medical A-2) द्वारे होईल."
      }
    },
    {
      "@type": "Question",
      "name": "अर्ज करण्याची शेवटची तारीख काय आहे?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ऑनलाईन अर्ज करण्याची अंतिम तारीख २५ नोव्हेंबर २०२६ (रात्री ११:५९ वाजेपर्यंत) असून परीक्षा शुल्क भरण्याची मुदत २७ नोव्हेंबर २०२६ पर्यंत आहे."
      }
    }
  ]
};
---

<ArticleContainer
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  date={date}
  category={category}
  image={image}
  hideRelatedArticles={false}
  customBreadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Railway Jobs", url: "/category/railway" },
    { name: "RRB Station Master 2026" }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(jobPostingSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Quick Highlight Overview Card -->
  <div class="bg-gradient-to-r from-primary/10 via-amber-500/10 to-primary/5 border border-primary/20 rounded-3xl p-5 sm:p-8 mb-8 not-prose">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="px-3 py-1 bg-primary text-white font-extrabold text-xs uppercase tracking-wider rounded-full shadow-2xs">
        🔥 रेल्वे महाभरती CEN 08/2026
      </span>
      <span class="text-xs font-bold text-amber-700 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2.5 py-1 rounded-full">
        १,२१५ पदे जाहीर (Level 6 Pay)
      </span>
      <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full">
        मुलाखत नाही (No Interview)
      </span>
    </div>
    <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-text-main mb-3 leading-snug">
      रेल्वे भरती बोर्ड (RRB) द्वारे स्टेशन मास्टर (Station Master) पदांच्या १,२१५ जागांची भव्य भरती जाहीर!
    </h2>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed m-0 font-medium">
      भारतीय रेल्वेच्या विविध विभागीय मंडळांमध्ये (All RRBs) ७व्या वेतन आयोगानुसार <strong>Level 6 (आरंभिक वेतन ₹३५,४००/- + भत्ते)</strong> या उच्च पदावर पदवीधर उमेदवारांसाठी सुवर्णसंधी उपलब्ध झाली आहे. ऑनलाईन अर्ज प्रक्रिया <strong>२७ ऑक्टोबर २०२६ पासून सुरू झाली असून २५ नोव्हेंबर २०२६</strong> पर्यंत अर्ज करता येतील.
    </p>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-border-card/60 text-xs">
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">एकूण पदे (Vacancies)</span>
        <strong class="text-primary text-base sm:text-lg font-black">१,२१५ जागा</strong>
      </div>
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">पात्रता (Qualification)</span>
        <strong class="text-text-main text-sm font-extrabold">कोणतीही पदवी (Graduate)</strong>
      </div>
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">वेतनमान (Initial Pay)</span>
        <strong class="text-emerald-600 dark:text-emerald-400 text-sm font-extrabold">₹३५,४००/- (Level 6)</strong>
      </div>
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">शेवटची तारीख (Last Date)</span>
        <strong class="text-rose-600 dark:text-rose-400 text-sm font-extrabold">२५ नोव्हेंबर २०२६</strong>
      </div>
    </div>
  </div>

  <!-- ARTICLE BODY (MARATHI VERSION) -->
  <div class="space-y-8 text-text-main leading-relaxed">
    
    <!-- Introduction Section -->
    <section>
      <h2 class="text-xl sm:text-2xl font-black text-text-main mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-primary rounded-full"></span>
        <span>RRB Station Master भरती २०२६: थोडक्यात माहिती (Overview)</span>
      </h2>
      <p class="text-sm sm:text-base leading-relaxed text-text-secondary">
        रेल्वे भरती बोर्डाने (Railway Recruitment Boards - RRB) केंद्रीय रोजगार सूचना क्र. <strong>CEN 08/2026</strong> अंतर्गत <strong>स्टेशन मास्टर (Station Master)</strong> या अत्यंत महत्त्वाच्या व जबाबदार पदासाठी अधिकृत अधिसूचना जारी केली आहे. देशभरातील सर्व रेल्वे झोनमध्ये मिळून एकूण <strong>१,२१५ रिक्त पदे</strong> भरली जाणार आहेत.
      </p>
      <p class="text-sm sm:text-base leading-relaxed text-text-secondary">
        या भरतीचे सर्वात मोठे वैशिष्ट्य म्हणजे यामध्ये <strong>कोणतीही मुलाखत (Interview) नाही</strong>. उमेदवारांची निवड पारदर्शक पद्धतीने संगणक आधारित परीक्षा (CBT), अ‍ॅप्टिट्यूड चाचणी (CBAT), मूळ कागदपत्र पडताळणी (DV) आणि वैद्यकीय तपासणी (Medical Test - A2 Standard) या चार टप्प्यांतून केली जाईल. महाराष्ट्रातील इच्छुक व पदवीधर उमेदवारांसाठी केंद्र सरकारी सेवेत रुजू होण्याची ही उत्तम संधी आहे.
      </p>
    </section>

    <!-- Important Highlights Table -->
    <section class="not-prose">
      <div class="bg-bg-surface border border-border-card rounded-2xl overflow-hidden shadow-xs">
        <div class="bg-primary/10 px-5 py-3 border-b border-border-card flex items-center gap-2">
          <HiOutlineDocumentText className="text-primary text-lg" />
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-primary m-0">
            RRB Station Master Bharti 2026 Highlights Summary
          </h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm text-left border-collapse">
            <tbody class="divide-y divide-border-card/40">
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 w-1/3 text-text-main">भरती संस्था (Organization)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">रेल्वे भरती मंडळ (Railway Recruitment Boards - RRB)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">जाहिरात क्रमांक (Advt No.)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">CEN 08/2026 (Station Master)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">पदाचे नाव (Post Name)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">स्टेशन मास्टर (Station Master)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">एकूण रिक्त पदे (Total Vacancies)</td>
                <td class="px-4 py-3 text-primary font-black">१,२१५ जागा (All RRBs, झोननिहाय तक्ता Annexure-B मध्ये)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">वेतन श्रेणी (Pay Scale)</td>
                <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-bold">लेव्हल ६ (7th CPC), आरंभिक मूळ वेतन ₹३५,४००/- + भत्ते (DA, HRA इ.)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">आवश्यक पात्रता (Education)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">कोणत्याही मान्यताप्राप्त विद्यापीठाची पदवी (Graduate in any stream)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">वयोमर्यादा (Age Limit)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">२० ते ३३ वर्षे (०१.०१.२०२७ रोजी) + नियमांनुसार सवलत</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">निवड प्रक्रिया (Selection Stages)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">CBT (लेखी परीक्षा) → CBAT (अ‍ॅप्टिट्यूड टेस्ट) → DV → मेडिकल टेस्ट (मुलाखत नाही)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">अर्ज पद्धती (Application Mode)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">ऑनलाईन (Online Application at rrbapply.gov.in)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">अधिकृत पोर्टल (Official Portals)</td>
                <td class="px-4 py-3 text-primary font-bold">rrbapply.gov.in / rrb.indianrailways.gov.in</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Important Dates Section -->
    <section>
      <h2 class="text-xl sm:text-2xl font-black text-text-main mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-primary rounded-full"></span>
        <span>महत्त्वाच्या तारखा व वेळापत्रक (Important Dates)</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 not-prose mb-4">
        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineCalendarDays className="text-primary text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">संक्षिप्त सूचना (Employment News)</span>
            <strong class="text-text-main text-sm font-extrabold">२४ ऑक्टोबर २०२६</strong>
          </div>
        </div>

        <div class="bg-bg-surface border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3">
          <HiOutlineCalendarDays className="text-emerald-500 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">ऑनलाईन अर्ज सुरू (Start Date)</span>
            <strong class="text-emerald-600 dark:text-emerald-400 text-sm font-extrabold">२७ ऑक्टोबर २०२६</strong>
          </div>
        </div>

        <div class="bg-bg-surface border border-rose-500/30 p-4 rounded-xl flex items-start gap-3">
          <HiOutlineClock className="text-rose-500 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">अर्ज करण्याची अंतिम मुदत (Last Date)</span>
            <strong class="text-rose-600 dark:text-rose-400 text-sm font-extrabold">२५ नोव्हेंबर २०२६ (११:५९ PM)</strong>
          </div>
        </div>

        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineCurrencyRupee className="text-amber-500 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">फी भरण्याची शेवटची तारीख</span>
            <strong class="text-text-main text-sm font-extrabold">२७ नोव्हेंबर २०२६ (११:५९ PM)</strong>
          </div>
        </div>

        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineDocumentText className="text-sky-500 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">अर्ज दुरुस्ती विंडो (Correction Window)</span>
            <strong class="text-text-main text-sm font-extrabold">२८ नोव्हेंबर ते ०७ डिसेंबर २०२६</strong>
          </div>
        </div>

        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineSparkles className="text-primary text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">CBT परीक्षेची तारीख</span>
            <strong class="text-primary text-sm font-extrabold">लवकरच जाहीर केली जाईल</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Post, Pay Scale & Eligibility -->
    <section>
      <h2 class="text-xl sm:text-2xl font-black text-text-main mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-primary rounded-full"></span>
        <span>पदाचे नाव, जागा आणि शैक्षणिक पात्रता (Post & Qualification)</span>
      </h2>

      <div class="space-y-4 not-prose">
        <div class="bg-bg-surface border border-border-card rounded-2xl overflow-hidden shadow-xs">
          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm text-left border-collapse">
              <thead class="bg-bg-base border-b border-border-card text-text-main font-bold">
                <tr>
                  <th class="px-4 py-3">पदाचे नाव (Post Name)</th>
                  <th class="px-4 py-3">वेतन स्तर (Pay Level)</th>
                  <th class="px-4 py-3">आरंभिक वेतन (Initial Pay)</th>
                  <th class="px-4 py-3">एकूण पदे</th>
                  <th class="px-4 py-3">किमान शैक्षणिक पात्रता</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border-card/40 text-text-secondary font-medium">
                <tr>
                  <td class="px-4 py-3 font-bold text-text-main">
                    स्टेशन मास्टर (Station Master)
                  </td>
                  <td class="px-4 py-3">Level 6 (7th CPC)</td>
