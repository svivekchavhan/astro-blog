---
import ArticleContainer from "../components/ArticleContainer.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase, 
  HiOutlineBuildingOffice, 
  HiOutlineCheckCircle, 
  HiOutlineDocumentText, 
  HiOutlineCurrencyRupee, 
  HiOutlineUserGroup,
  HiOutlineQuestionMarkCircle,
  HiOutlineExclamationTriangle,
  HiOutlineSparkles,
  HiOutlineShieldCheck,
  HiOutlineClock
} from "react-icons/hi2";

const title = "UGC NET December 2026: Online Application Form, Exam Date (14-19 Dec), JRF, Assistant Professor & PhD Eligibility";
const description = "NTA UGC NET December 2026 Notification Out: Apply online for JRF, Assistant Professor & PhD Admission eligibility. Check category-wise criteria, 4-year degree eligibility, age relaxation, exam pattern, fees, and apply online at ugcnet.nta.nic.in.";
const canonicalURL = "https://mahasandhi.in/ugc-net-december-2026";
const date = "October 28, 2026";
const category = "Exam Alert";
const image = "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&q=80&w=1200";

// JSON-LD Schemas for Schema.org SEO Validation
const examinationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalCredential",
  "name": "UGC NET December 2026 (Junior Research Fellowship, Assistant Professor & PhD Admission)",
  "description": "National Testing Agency (NTA) conducts UGC NET December 2026 across 83 subjects in Computer Based Test (CBT) mode from 14 to 19 December 2026 for eligibility of JRF, Assistant Professor and PhD admissions.",
  "credentialCategory": "National Eligibility Test",
  "recognizedBy": {
    "@type": "Organization",
    "name": "University Grants Commission (UGC) & National Testing Agency (NTA)",
    "url": "https://ugcnet.nta.nic.in"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "UGC NET डिसेंबर २०२६ ही परीक्षा कशासाठी घेतली जाते? (What is UGC NET?)",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "UGC NET ही राष्ट्रीय स्तरावरील पात्रता परीक्षा (Eligibility Test) असून याद्वारे: १) जुनियर रिसर्च फेलोशिप (JRF) + सहाय्यक प्राध्यापक + PhD प्रवेश, २) केवळ सहाय्यक प्राध्यापक + PhD प्रवेश, आणि ३) थेट PhD प्रवेश या तीन श्रेणींसाठी पात्रता निश्चित केली जाते. ही थेट पदभरती नसून पात्रता परीक्षा आहे."
      }
    },
    {
      "@type": "Question",
      "name": "UGC NET परीक्षेसाठी शैक्षणिक पात्रता काय आहे?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "सर्वसाधारण / EWS उमेदवारांसाठी पदव्युत्तर पदवीमध्ये (Master's Degree) किमान ५५% गुण, तर OBC-NCL, SC, ST, PwD आणि तृतीयपंथी उमेदवारांसाठी किमान ५०% गुण आवश्यक आहेत. अंतिम वर्षात शिकणारे उमेदवारही तात्पुरते (Provisional) अर्ज करू शकतात. तसेच ४ वर्षांची पदवी (75% गुणांसह) उत्तीर्ण उमेदवार JRF व PhD साठी पात्र आहेत."
      }
    },
    {
      "@type": "Question",
      "name": "सहाय्यक प्राध्यापक पदासाठी वयाची काही अट आहे का?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "नाही. सहाय्यक प्राध्यापक (Assistant Professor) आणि थेट PhD प्रवेशासाठी कोणतीही कमाल वयोमर्यादा (No Upper Age Limit) नाही. केवळ JRF साठी कमाल ३० वर्षे वयोमर्यादा असून राखीव प्रवर्गांना व महिलांना ५ वर्षांपर्यंत सवलत मिळते."
      }
    },
    {
      "@type": "Question",
      "name": "UGC NET परीक्षेत निगेटिव्ह मार्किंग (Negative Marking) असते का?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "नाही. UGC NET परीक्षेत कोणतीही नकारात्मक गुण पद्धत (No Negative Marking) नाही. प्रत्येक अचूक उत्तरासाठी २ गुण दिले जातात."
      }
    },
    {
      "@type": "Question",
      "name": "अर्ज करण्याची शेवटची तारीख काय आहे?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "नियमित शुल्कासह ऑनलाईन अर्ज करण्याची अंतिम तारीख २८ ऑक्टोबर २०२६ (रात्री ११:५० वाजेपर्यंत) आहे, तर ५०० रुपये विलंब शुल्कासह २९ ते ३१ ऑक्टोबर २०२६ पर्यंत अर्ज सादर करता येतील."
      }
    }
  ]
};
---

<ArticleContainer
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  date={date}
  category={category}
  image={image}
  hideRelatedArticles={false}
  customBreadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Exam Alert", url: "/naukri-updates" },
    { name: "UGC NET December 2026" }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(examinationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Quick Highlight Overview Card -->
  <div class="bg-gradient-to-r from-primary/10 via-indigo-500/10 to-primary/5 border border-primary/20 rounded-3xl p-5 sm:p-8 mb-8 not-prose">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="px-3 py-1 bg-primary text-white font-extrabold text-xs uppercase tracking-wider rounded-full shadow-2xs">
        🎓 राष्ट्रीय पात्रता परीक्षा २०२६
      </span>
      <span class="text-xs font-bold text-indigo-700 dark:text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-2.5 py-1 rounded-full">
        JRF • सहाय्यक प्राध्यापक • PhD प्रवेश
      </span>
      <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full">
        निगेटिव्ह मार्किंग नाही
      </span>
    </div>
    <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-text-main mb-3 leading-snug">
      UGC-NET डिसेंबर २०२६ अधिकृत अधिसूचना जाहीर: जेआरएफ, प्राध्यापक व पीएचडी पात्रतेसाठी ऑनलाईन अर्ज सुरू!
    </h2>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed m-0 font-medium">
      राष्ट्रीय परीक्षा एजन्सी (NTA) द्वारे विद्यापीठ अनुदान आयोग राष्ट्रीय पात्रता परीक्षा (UGC NET December 2026) ची घोषणा झाली आहे. ही <strong>थेट नोकरी भरती नसून पात्रता परीक्षा (Eligibility Test)</strong> आहे. परीक्षा <strong>१४ ते १९ डिसेंबर २०२६</strong> दरम्यान देशभरात संगणक आधारित (CBT) पद्धतीने घेतली जाईल.
    </p>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-border-card/60 text-xs">
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">परीक्षेचे नाव (Exam)</span>
        <strong class="text-primary text-sm sm:text-base font-black">UGC NET Dec 2026</strong>
      </div>
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">किमान पात्रता (Qualification)</span>
        <strong class="text-text-main text-xs sm:text-sm font-extrabold">Master's (55% / 50%)</strong>
      </div>
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">परीक्षा दिनांक (Exam Date)</span>
        <strong class="text-indigo-600 dark:text-indigo-400 text-xs sm:text-sm font-extrabold">१४ - १९ डिसेंबर २०२६</strong>
      </div>
      <div class="bg-bg-surface p-3.5 rounded-xl border border-border-card">
        <span class="text-text-muted block text-[0.7rem] uppercase font-bold">अंतिम तारीख (Last Date)</span>
        <strong class="text-rose-600 dark:text-rose-400 text-xs sm:text-sm font-extrabold">२८ ऑक्टोबर (Late: ३१ ऑक्टोबर)</strong>
      </div>
    </div>
  </div>

  <!-- ARTICLE BODY (MARATHI VERSION) -->
  <div class="space-y-8 text-text-main leading-relaxed">
    
    <!-- Introduction Section -->
    <section>
      <h2 class="text-xl sm:text-2xl font-black text-text-main mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-primary rounded-full"></span>
        <span>UGC-NET डिसेंबर २०२६: थोडक्यात माहिती (Overview)</span>
      </h2>
      <p class="text-sm sm:text-base leading-relaxed text-text-secondary">
        नॅशनल टेस्टिंग एजन्सी (NTA) तर्फे विद्यापीठ अनुदान आयोगाच्या (UGC) वतीने भारतीय विद्यापीठे व महाविद्यालयांमध्ये कनिष्ठ संशोधन फेलोशिप (JRF), सहाय्यक प्राध्यापक (Assistant Professor) पात्रता आणि विविध विद्यापीठांमध्ये थेट <strong>पीएचडी (Ph.D.) प्रवेशासाठी</strong> राष्ट्रीय पात्रता परीक्षा म्हणजेच <strong>UGC NET डिसेंबर २०२६</strong> चे आयोजन करण्यात आले आहे.
      </p>
      <div class="bg-indigo-500/10 border border-indigo-500/20 rounded-2xl p-4 sm:p-5 text-xs sm:text-sm text-text-secondary font-medium">
        📌 <strong>महत्त्वाची नोंद:</strong> ही परीक्षा कोणतीही थेट पदभरती (Direct Job Vacancy) नसून एक राष्ट्रीय स्तरावरील पात्रता परीक्षा आहे. त्यामुळे या परीक्षेमध्ये पदांची कोणतीही निश्चित संख्या (Fixed Vacancies) नसते. सहाय्यक प्राध्यापक पात्रतेसाठी परीक्षेत बसलेल्या एकूण उमेदवारांपैकी अव्वल ६% उमेदवार पात्र ठरतात, तर JRF च्या जागांची संख्या UGC च्या निकषांनुसार निश्चित केली जाते.
      </div>
    </section>

    <!-- 3 Eligibility Categories Box -->
    <section>
      <h2 class="text-xl sm:text-2xl font-black text-text-main mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-primary rounded-full"></span>
        <span>पात्रतेच्या ३ प्रमुख श्रेणी (3 Eligibility Categories)</span>
      </h2>

      <p class="text-sm text-text-secondary mb-4">
        यूजीसीच्या नवीन नियमांनुसार, उमेदवार खालील तीन श्रेणींपैकी एकासाठी पात्र ठरतात:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 not-prose mb-4">
        <div class="bg-bg-surface border border-primary/30 p-5 rounded-2xl space-y-2">
          <span class="w-7 h-7 rounded-full bg-primary text-white font-extrabold flex items-center justify-center text-xs">१</span>
          <h3 class="text-base font-bold text-text-main m-0">कॅटेगरी - १ (Category-1)</h3>
          <p class="text-xs text-text-muted leading-relaxed m-0 font-medium">
            <strong>JRF + सहाय्यक प्राध्यापक + PhD प्रवेश:</strong> उमेदवाराला संशोधन फेलोशिप (JRF) मिळते, तो देशभरातील महाविद्यालयांमध्ये सहाय्यक प्राध्यापक पदासाठी पात्र ठरतो आणि थेट PhD प्रवेशासाठीही पात्र ठरतो.
          </p>
        </div>

        <div class="bg-bg-surface border border-indigo-500/30 p-5 rounded-2xl space-y-2">
          <span class="w-7 h-7 rounded-full bg-indigo-600 text-white font-extrabold flex items-center justify-center text-xs">२</span>
          <h3 class="text-base font-bold text-text-main m-0">कॅटेगरी - २ (Category-2)</h3>
          <p class="text-xs text-text-muted leading-relaxed m-0 font-medium">
            <strong>सहाय्यक प्राध्यापक + PhD प्रवेश (JRF नाही):</strong> उमेदवार सहाय्यक प्राध्यापक नियुक्तीसाठी आजीवन पात्र ठरतो तसेच विद्यापीठांमध्ये PhD प्रवेशासाठी पात्र मानला जातो.
          </p>
        </div>

        <div class="bg-bg-surface border border-emerald-500/30 p-5 rounded-2xl space-y-2">
          <span class="w-7 h-7 rounded-full bg-emerald-600 text-white font-extrabold flex items-center justify-center text-xs">३</span>
          <h3 class="text-base font-bold text-text-main m-0">कॅटेगरी - ३ (Category-3)</h3>
          <p class="text-xs text-text-muted leading-relaxed m-0 font-medium">
            <strong>केवळ PhD प्रवेश (Only PhD Admission):</strong> या श्रेणीतील गुण केवळ विद्यापीठांमध्ये PhD प्रवेशासाठी १ वर्षाच्या कालावधीकरिता ग्राह्य धरले जातात.
          </p>
        </div>
      </div>
    </section>

    <!-- Key Highlights Summary Table -->
    <section class="not-prose">
      <div class="bg-bg-surface border border-border-card rounded-2xl overflow-hidden shadow-xs">
        <div class="bg-primary/10 px-5 py-3 border-b border-border-card flex items-center gap-2">
          <HiOutlineDocumentText className="text-primary text-lg" />
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-primary m-0">
            UGC NET December 2026 Highlight Summary
          </h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm text-left border-collapse">
            <tbody class="divide-y divide-border-card/40">
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 w-1/3 text-text-main">परीक्षा संस्था (Exam Body)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">राष्ट्रीय परीक्षा एजन्सी (National Testing Agency - NTA)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">परीक्षेचे नाव (Exam Name)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">UGC - National Eligibility Test (NET) December 2026</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">उद्दिष्ट / उद्दिष्टे (Objective)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">JRF, सहाय्यक प्राध्यापक पात्रता आणि थेट PhD प्रवेश</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">जागांची संख्या (Vacancies)</td>
                <td class="px-4 py-3 text-primary font-bold">पात्रता परीक्षा (Fixed Posts नसतात; ६% निकष)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">परीक्षा पद्धती (Exam Mode)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">संगणक आधारित परीक्षा (CBT - Computer Based Test)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">परीक्षेचा कालावधी</td>
                <td class="px-4 py-3 text-text-secondary font-medium">१८० मिनिटे (३ तास) - पेपर १ व पेपर २ मध्ये कोणतीही सुट्टी नाही</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">प्रश्न व गुण</td>
                <td class="px-4 py-3 text-text-secondary font-medium">१५० प्रश्न, ३०० गुण (निगेटिव्ह मार्किंग नाही)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">परीक्षेचे माध्यम (Language Medium)</td>
                <td class="px-4 py-3 text-text-secondary font-medium">इंग्रजी आणि हिंदी (भाषा विषय वगळून)</td>
              </tr>
              <tr class="hover:bg-primary/5">
                <td class="px-4 py-3 font-bold bg-bg-base/50 text-text-main">अधिकृत संकेतस्थळ</td>
                <td class="px-4 py-3 text-primary font-bold">ugcnet.nta.nic.in</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Important Dates & Schedule -->
    <section>
      <h2 class="text-xl sm:text-2xl font-black text-text-main mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-primary rounded-full"></span>
        <span>महत्त्वाच्या तारखा व वेळापत्रक (Important Dates)</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 not-prose mb-4">
        <div class="bg-bg-surface border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3">
          <HiOutlineCalendarDays className="text-emerald-500 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">ऑनलाईन अर्ज सुरू (Start Date)</span>
            <strong class="text-emerald-600 dark:text-emerald-400 text-sm font-extrabold">०८ ऑक्टोबर २०२६</strong>
          </div>
        </div>

        <div class="bg-bg-surface border border-rose-500/30 p-4 rounded-xl flex items-start gap-3">
          <HiOutlineClock className="text-rose-500 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">नियमित अर्ज शेवटची तारीख</span>
            <strong class="text-rose-600 dark:text-rose-400 text-sm font-extrabold">२८ ऑक्टोबर २०२६ (११:५० PM)</strong>
          </div>
        </div>

        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineCurrencyRupee className="text-amber-500 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">नियमित फी भरण्याची अंतिम मुदत</span>
