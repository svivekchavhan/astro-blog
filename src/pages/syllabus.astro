---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineAcademicCap,
  HiOutlineDocumentText,
  HiOutlineSparkles,
  HiOutlineBuildingLibrary,
  HiOutlineBookOpen,
  HiOutlineQueueList,
  HiOutlineBriefcase,
  HiOutlineShieldCheck,
} from "react-icons/hi2";

const title =
  "Exam Syllabus 2026: परीक्षा अभ्यासक्रम व परीक्षेचे स्वरूप | MahaSandhi";
const description =
  "MPSC, UPSC, Banking, SSC, Police Bharti व महाराष्ट्र शासन सरळसेवा परीक्षांचा सविस्तर अभ्यासक्रम (Exam Syllabus & Pattern 2026) मराठीमध्ये.";
const canonicalURL = "https://mahasandhi.in/syllabus";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  customBreadcrumbs={[{ name: "Syllabus" }]}
>
  <section class="pt-2 pb-16 not-prose">
    <div class="max-w-[1100px] mx-auto px-2 md:px-0">
      <!-- Hero Banner -->
      <div
        class="relative bg-gradient-to-br from-primary/15 via-secondary/10 to-primary/5 border border-primary/25 p-6 md:p-10 rounded-3xl mb-10 overflow-hidden shadow-xs"
      >
        <div
          class="absolute -right-20 -top-20 w-72 h-72 bg-primary/10 rounded-full blur-3xl -z-10"
        >
        </div>
        <div
          class="absolute -left-20 -bottom-20 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl -z-10"
        >
        </div>

        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span
              class="text-[0.65rem] bg-primary text-white px-3 py-1 rounded-full font-extrabold uppercase tracking-wider inline-flex items-center gap-1 shadow-xs"
            >
              <HiOutlineSparkles className="text-xs" /> Syllabus Hub 2026
            </span>
            <span
              class="text-[0.65rem] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full font-bold uppercase tracking-wider"
            >
              Updated Exam Patterns
            </span>
          </div>

          <h1
            class="text-3xl md:text-5xl font-black text-text-main leading-tight mb-4 tracking-tight"
          >
            स्पर्धा परीक्षा अभ्यासक्रम (Exam Syllabus 2026)
          </h1>
          <p
            class="text-xs md:text-base text-text-secondary leading-relaxed mb-6"
          >
            MPSC, UPSC, Banking, SSC, Police Bharti, Talathi Bharti आणि
            महाराष्ट्र सरळसेवा परीक्षांचे सविस्तर अपडेटेड अभ्यासक्रम व परीक्षेचे
            स्वरूप.
          </p>

          <div
            class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-semibold"
          >
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div class="p-2 bg-primary/10 text-primary rounded-xl shrink-0">
                <HiOutlineAcademicCap className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >MPSC & UPSC</span
                >
                <span class="text-text-main font-extrabold"
                  >राज्यसेवा व संयुक्त</span
                >
              </div>
            </div>
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div
                class="p-2 bg-emerald-500/10 text-emerald-500 rounded-xl shrink-0"
              >
                <HiOutlineBriefcase className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >बँक व SSC</span
                >
                <span class="text-text-main font-extrabold"
                  >IBPS, SBI & SSC</span
                >
              </div>
            </div>
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div
                class="p-2 bg-amber-500/10 text-amber-600 rounded-xl shrink-0"
              >
                <HiOutlineShieldCheck className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >पोलीस व सरळसेवा</span
                >
                <span class="text-text-main font-extrabold"
                  >तलाठी व मनपा भरती</span
                >
              </div>
            </div>
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div class="p-2 bg-rose-500/10 text-rose-500 rounded-xl shrink-0">
                <HiOutlineDocumentText className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >PDF</span
                >
                <span class="text-text-main font-extrabold"
                  >अधिकृत अभ्यासक्रम PDF</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Clean Section Container -->
      <div
        class="bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-10 shadow-xs space-y-6"
      >
        <div
          class="flex items-center justify-between border-b border-border-card/40 pb-4 flex-wrap gap-2"
        >
          <div>
            <h2
              class="text-xl md:text-2xl font-black text-text-main m-0 flex items-center gap-2"
            >
              <HiOutlineBookOpen className="text-primary text-2xl" />
              परीक्षा अभ्यासक्रम सूची (Syllabus Directory)
            </h2>
            <p class="text-xs text-text-muted m-0 mt-1">
              सर्व स्पर्धा परीक्षांचे नवीन व अपडेटेड अभ्यासक्रम
            </p>
          </div>
        </div>

        <!-- Clean Placeholder Box for User Data Insertion -->
        <div
          class="border-2 border-dashed border-border-card/80 p-10 md:p-14 rounded-2xl text-center space-y-3 bg-bg-surface/40"
        >
          <div
            class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-2 text-xl font-bold"
          >
            <HiOutlineQueueList />
          </div>
          <div class="text-lg font-extrabold text-text-main">
            📚 येथे परीक्षा अभ्यासक्रम लवकरच उपलब्ध होईल.
          </div>
          <p
            class="text-xs text-text-muted max-w-md mx-auto m-0 leading-relaxed"
          >
            लवकरच सर्व परीक्षा अभ्यासक्रम उपलब्ध होतील . यामध्ये विषय, गुण
            विभागणी आणि अधिकृत PDF लिंक्स मिळेल .
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
