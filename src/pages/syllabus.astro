---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineAcademicCap,
  HiOutlineDocumentText,
  HiOutlineSparkles,
  HiOutlineBuildingLibrary,
  HiOutlineBookOpen,
  HiOutlineQueueList,
  HiOutlineBriefcase,
  HiOutlineShieldCheck,
  HiOutlineArrowRight,
  HiOutlineArrowDownTray
} from "react-icons/hi2";

const title = "Exam Syllabus 2026: परीक्षा अभ्यासक्रम व परीक्षेचे स्वरूप | MahaSandhi";
const description = "MPSC, UPSC, Banking, SSC, Police Bharti व महाराष्ट्र शासन सरळसेवा परीक्षांचा सविस्तर अभ्यासक्रम (Exam Syllabus & Pattern 2026) मराठीमध्ये.";
const canonicalURL = "https://mahasandhi.in/syllabus";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  customBreadcrumbs={[{ name: "Syllabus" }]}
  hideSidebar={true}
>
  <section class="pt-2 pb-16 not-prose">
    <div class="max-w-[1100px] mx-auto px-2 md:px-0">
      <!-- Hero Banner -->
      <div
        class="relative bg-gradient-to-br from-primary/15 via-secondary/10 to-primary/5 border border-primary/25 p-6 md:p-10 rounded-3xl mb-8 overflow-hidden shadow-xs"
      >
        <div
          class="absolute -right-20 -top-20 w-72 h-72 bg-primary/10 rounded-full blur-3xl -z-10"
        >
        </div>
        <div
          class="absolute -left-20 -bottom-20 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl -z-10"
        >
        </div>

        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span
              class="text-[0.65rem] bg-primary text-white px-3 py-1 rounded-full font-extrabold uppercase tracking-wider inline-flex items-center gap-1 shadow-xs"
            >
              <HiOutlineSparkles className="text-xs" /> Syllabus Hub 2026
            </span>
            <span
              class="text-[0.65rem] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full font-bold uppercase tracking-wider"
            >
              Updated Exam Patterns
            </span>
          </div>

          <h1
            class="text-3xl md:text-5xl font-black text-text-main leading-tight mb-4 tracking-tight"
          >
            स्पर्धा परीक्षा अभ्यासक्रम (Exam Syllabus 2026)
          </h1>
          <p
            class="text-xs md:text-base text-text-secondary leading-relaxed mb-6"
          >
            MPSC, UPSC, Banking, SSC, Police Bharti, Talathi Bharti आणि
            महाराष्ट्र सरळसेवा परीक्षांचे सविस्तर अपडेटेड अभ्यासक्रम व परीक्षेचे
            स्वरूप.
          </p>

          <div
            class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-semibold"
          >
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div class="p-2 bg-primary/10 text-primary rounded-xl shrink-0">
                <HiOutlineAcademicCap className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >MPSC & UPSC</span
                >
                <span class="text-text-main font-extrabold"
                  >राज्यसेवा व संयुक्त</span
                >
              </div>
            </div>
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div
                class="p-2 bg-emerald-500/10 text-emerald-500 rounded-xl shrink-0"
              >
                <HiOutlineBriefcase className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >बँक व SSC</span
                >
                <span class="text-text-main font-extrabold"
                  >IBPS, SBI & SSC</span
                >
              </div>
            </div>
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div
                class="p-2 bg-amber-500/10 text-amber-600 rounded-xl shrink-0"
              >
                <HiOutlineShieldCheck className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >पोलीस व सरळसेवा</span
                >
                <span class="text-text-main font-extrabold"
                  >तलाठी व मनपा भरती</span
                >
              </div>
            </div>
            <div
              class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
            >
              <div class="p-2 bg-rose-500/10 text-rose-500 rounded-xl shrink-0">
                <HiOutlineDocumentText className="text-lg" />
              </div>
              <div>
                <span
                  class="block text-[0.65rem] text-text-muted font-bold uppercase"
                  >PDF</span
                >
                <span class="text-text-main font-extrabold"
                  >अधिकृत अभ्यासक्रम PDF</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Clean Section Container -->
      <div
        class="bg-bg-surface border border-border-card rounded-3xl p-5 sm:p-8 shadow-xs space-y-6"
      >
        <div
          class="flex items-center justify-between border-b border-border-card/40 pb-4 flex-wrap gap-2"
        >
          <div>
            <h2
              class="text-xl md:text-2xl font-black text-text-main m-0 flex items-center gap-2"
            >
              <HiOutlineBookOpen className="text-primary text-2xl" />
              परीक्षा अभ्यासक्रम सूची (Syllabus Directory)
            </h2>
            <p class="text-xs text-text-muted m-0 mt-1">
              सर्व स्पर्धा परीक्षांचे नवीन व अपडेटेड अभ्यासक्रम
            </p>
          </div>
        </div>

        <!-- Horizontal Syllabus Cards Stack -->
        <div class="flex flex-col gap-4">
          <!-- Card 1: MPSC Group C Syllabus 2026 -->
          <a
            href="/mpsc/mpsc-group-c-syllabus-2026"
            class="group bg-bg-surface border border-border-card hover:border-amber-500 rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-4 no-underline"
          >
            <div class="flex items-start gap-4 flex-1 min-w-0">
              <div
                class="p-3 bg-amber-500/10 text-amber-600 rounded-xl group-hover:bg-amber-500 group-hover:text-white transition-all duration-300 shrink-0 hidden sm:flex items-center justify-center"
              >
                <HiOutlineDocumentText className="text-2xl" />
              </div>

              <div class="space-y-1.5 flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span
                    class="text-[0.65rem] bg-amber-500/10 text-amber-600 px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-amber-500/20"
                  >
                    Group C Syllabus
                  </span>
                  <span
                    class="text-[0.65rem] bg-emerald-500/10 text-emerald-600 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20"
                  >
                    PDF Available
                  </span>
                </div>

                <h3
                  class="text-base sm:text-lg text-text-main font-bold leading-snug m-0 group-hover:text-amber-600 transition-colors"
                >
                  MPSC Group C Syllabus 2026: संयुक्त गट क अभ्यासक्रम व स्वरूप PDF
                </h3>

                <p class="text-xs text-text-secondary leading-relaxed m-0">
                  लिपिक-टंकलेखक, कर सहाय्यक व दुय्यम निरीक्षक पदांचा संयुक्त पूर्व परीक्षा (१०० गुण) व मुख्य परीक्षा (४०० गुण) सविस्तर विषयनिहाय अभ्यासक्रम व PDF.
                </p>

                <div class="flex items-center gap-3 text-[0.75rem] text-text-muted pt-1 flex-wrap font-medium">
                  <span class="flex items-center gap-1">
                    <HiOutlineAcademicCap className="text-amber-500 text-sm shrink-0" /> पूर्व (१०० गुण) व मुख्य (४०० गुण)
                  </span>
                  <span>•</span>
                  <span class="flex items-center gap-1">
                    <HiOutlineArrowDownTray className="text-amber-500 text-sm shrink-0" /> अधिकृत PDF डाऊनलोड
                  </span>
                </div>
              </div>
            </div>

            <div
              class="shrink-0 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-amber-600 sm:self-center bg-amber-500/5 sm:bg-transparent px-3 py-2 sm:p-0 rounded-lg group-hover:translate-x-1 transition-transform"
            >
              <span>View Syllabus</span>
              <HiOutlineArrowRight className="text-sm" />
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
