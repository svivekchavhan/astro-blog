---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import { 
  HiOutlineCalendarDays, 
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle
} from "react-icons/hi2";

const title = "सोलापूर महानगरपालिका भरती २०२६: १३० पदांच्या पदभरतीस शासन मान्यता जाहीर (शासन निर्णय)";
const description = "Solapur Mahanagarpalika Bharti 2026: Maharashtra Urban Development Department issues official Govt approval (दि. ०६.०८.२०२६) to fill 130 vacant posts in Solapur Municipal Corporation via TCS / IBPS online examination. Read vacancy breakdown, 15 post categories, GR details, and official notification.";
const canonicalURL = "https://mahasandhi.in/solapur-mahanagarpalika-bharti-2026";
const date = "August 06, 2026";
const category = "State Govt";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1577495508048-b635879837f1?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Solapur Mahanagarpalika Bharti" }
  ]}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">सोलापूर महानगरपालिका १३० जागांसाठी शासन मान्यता आदेश (पत्र क्र. सोम्मा -२०२३/प्र.क्र.४७/नवि-१८)</h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>सोलापूर महानगरपालिका भरती २०२६:</strong> महाराष्ट्र शासनाच्या नगर विकास विभागाने (मंत्रालय, मुंबई) सोलापूर महानगरपालिकेतील अत्यावश्यक व अत्यंत गरजेची पदे भरण्यासाठी ३५% आस्थापना खर्चाची अट शिथील करून <strong>१३० रिक्त पदांच्या भरतीस अधिकृत मान्यता</strong> दिली आहे. या संदर्भातील शासन निर्णय व अधिकृत पत्र क्र. <em>सोम्मा -२०२३/प्र.क्र.४७/नवि-१८ दिनांक ०६ ऑगस्ट २०२६</em> रोजी निर्गमित करण्यात आले आहे.
          </p>
          <p>
            सदर भरती प्रक्रिया ऑनलाईन पद्धतीने <strong>TCS iON (टाटा कन्सल्टन्सी सर्व्हिसेस लि.)</strong> किंवा <strong>IBPS (आय.बी.पी.एस.)</strong> या अधिकृत परीक्षा घेणाऱ्या कंपन्यांमार्फत राबविण्याचे निर्देश देण्यात आले आहेत.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBuildingOffice className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">विभाग / प्राधिकरण</span>
              <span class="text-text-main font-semibold text-sm">सोलापूर महानगरपालिका (Solapur Municipal Corp)</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineMapPin className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">नोकरीचे ठिकाण</span>
              <span class="text-text-main font-semibold text-sm">सोलापूर (Solapur, Maharashtra)</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineCurrencyRupee className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">परीक्षा घेणारी यंत्रणा</span>
              <span class="text-text-main font-semibold text-sm">TCS iON किंवा IBPS (ऑनलाईन परीक्षा)</span>
            </div>
          </div>
        </div>

        <!-- Post Details & Vacancy Breakdown Table -->
        <h2 id="details" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">पदनिहाय रिक्त जागांचा तक्ता (Vacancies Breakdown Table - 130 Posts)</h2>
        <p class="text-sm text-text-muted mb-4">शासन पत्रात नमूद केल्यानुसार सोलापूर महानगरपालिकेत भरतीस मान्यता दिलेल्या १५ विविध संवर्गातील १३० पदांची तपशीलवार यादी खालीलप्रमाणे आहे:</p>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main text-center w-16">अ.क्र.</th>
                <th class="p-3 border border-border-card font-bold text-text-main">संवर्ग / पदाचे नाव (Post Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main text-center">गट (Group)</th>
                <th class="p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap">मान्यता दिलेली पदे</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">१</td>
                <td class="p-3 border border-border-card font-bold text-text-main">कनिष्ठ अभियंता सहाय्यक</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">१५</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">२</td>
                <td class="p-3 border border-border-card font-bold text-text-main">सहाय्यक कामगार कल्याण व जनसंपर्क अधिकारी</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">३</td>
                <td class="p-3 border border-border-card font-bold text-text-main">सहाय्यक प्रयोगशाळा तंत्रज्ञ</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०१</td>
              </tr>
              <tr class="bg-primary/5">
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">४</td>
                <td class="p-3 border border-border-card font-bold text-primary">लिपिक / लिपिक टंकलेखक (Clerk / Clerk Typist)</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-rose-500 text-base">४१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">५</td>
                <td class="p-3 border border-border-card font-bold text-text-main">फिटर इलेक्ट्रीशियन</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">६</td>
                <td class="p-3 border border-border-card font-bold text-text-main">फायर मोटार मेकॅनिक</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">७</td>
                <td class="p-3 border border-border-card font-bold text-text-main">फायरमॅन (Fireman)</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०७</td>
              </tr>
              <tr class="bg-primary/5">
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">८</td>
                <td class="p-3 border border-border-card font-bold text-primary">कनिष्ठ अभियंता (स्थापत्य) - Junior Engineer Civil</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-rose-500 text-base">३०</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">९</td>
                <td class="p-3 border border-border-card font-bold text-text-main">कनिष्ठ अभियंता (विद्युत) - Junior Engineer Electrical</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०१</td>
              </tr>
              <tr class="bg-primary/5">
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">१०</td>
                <td class="p-3 border border-border-card font-bold text-primary">मिडवाइफ (Midwife)</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-rose-500 text-base">२२</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">११</td>
                <td class="p-3 border border-border-card font-bold text-text-main">पाईप फिटर</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०२</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">१२</td>
                <td class="p-3 border border-border-card font-bold text-text-main">पंप ऑपरेटर</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०२</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">१३</td>
                <td class="p-3 border border-border-card font-bold text-text-main">सीवरेज इन्स्पेक्टर</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०४</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">१४</td>
                <td class="p-3 border border-border-card font-bold text-text-main">लघुलेखक (Stenographer)</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center text-text-muted font-bold">१५</td>
                <td class="p-3 border border-border-card font-bold text-text-main">महिला व बाल विकास अधिकारी</td>
                <td class="p-3 border border-border-card text-center text-text-muted">गट-क</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">०१</td>
              </tr>
              <tr class="bg-primary/10">
                <td colspan="3" class="p-3 border border-border-card font-bold text-text-main text-right">एकूण पदभरतीस दिलेली मान्यता (Total Approved Posts)</td>
                <td class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-lg">१३० पदे</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Educational Qualification & Selection Process -->
        <h2 id="eligibility" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">निवड प्रक्रिया व परीक्षा पद्धत (Selection Process & Online Exam Mode)</h2>
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3">
          <p class="m-0 text-text-main font-semibold">
            📌 <strong>शासकीय निर्देशांनुसार ऑनलाईन परीक्षा:</strong>
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-text-muted">
            <li>शासनाच्या सामान्य प्रशासन विभागाच्या २९.११.२०२२ च्या शासन निर्णयानुसार ही भरती प्रक्रिया <strong>TCS iON (Tata Consultancy Services Ltd.)</strong> किंवा <strong>IBPS (Institute of Banking Personnel Selection)</strong> या मान्यताप्राप्त कंपनीद्वारे कॉम्प्युटर बेस्ड ऑनलाईन परीक्षा (CBT) पद्धतीने घेतली जाईल.</li>
            <li>कनिष्ठ अभियंता (स्थापत्य/विद्युत/सहाय्यक) पदांसाठी पदवी किंवा पदविका (Degree / Diploma in Civil/Electrical Engg) आवश्यक राहील.</li>
            <li>लिपिक टंकलेखक पदासाठी पदवी + मराठी टंकलेखन (३० श.प्र.मि.) / इंग्रजी टंकलेखन (४० श.प्र.मि.) व MS-CIT संगणक प्रमाणपत्र आवश्यक.</li>
            <li>सविस्तर जाहिरात सोलापूर महानगरपालिकेच्या अधिकृत वेबसाईटवर प्रसिद्ध झाल्यानंतर ऑनलाईन अर्ज लिंक सुरू होईल.</li>
          </ul>
        </div>

        <!-- Important Dates & Links Table -->
        <h2 id="important-dates" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">{translateMarathi("महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)")}</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Event)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">तारीख / दुवा (Date / Action)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">नगर विकास विभाग शासन मान्यता पत्र दिनांक</td>
                <td class="p-3 border border-border-card text-text-main font-bold">०६ ऑगस्ट २०२६ (06 August 2026)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">ऑनलाईन अर्ज सुरू होण्याचा दिनांक</td>
                <td class="p-3 border border-border-card text-amber-500 font-bold whitespace-nowrap">
                  लवकरच उपलब्ध (Notification Coming Soon)
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">सोलापूर महानगरपालिका अधिकृत वेबसाईट</td>
                <td class="p-3 border border-border-card">
                  <a href="https://www.solapurcorporation.gov.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto">
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> solapurcorporation.gov.in
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">शासन निर्णय पत्र पाहण्यासाठी (Official GR Order PDF)</td>
                <td class="p-3 border border-border-card">
                  <a href="/contact-us" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-rose-500/30 w-full sm:w-auto">
                    <HiOutlineDocumentText className="text-base shrink-0" /> शासनादेश पत्र क्र. सोम्मा-२०२३
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2 id="faq" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">वारंवार विचारले जाणारे प्रश्न (FAQ)</h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">प्रश्न १: सोलापूर महानगरपालिकेत एकूण किती पदांच्या भरतीस मान्यता मिळाली आहे?</h3>
            <p class="text-text-muted text-xs m-0">उत्तर: नगर विकास विभागाने ३५% आस्थापना खर्चाची अट शिथील करून एकूण १३० पदांच्या भरतीस मान्यता दिली आहे.</p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">प्रश्न २: यामध्ये लिपिक टंकलेखक व कनिष्ठ अभियंता किती पदे आहेत?</h3>
            <p class="text-text-muted text-xs m-0">उत्तर: लिपिक टंकलेखक ४१ पदे, कनिष्ठ अभियंता (स्थापत्य) ३० पदे, कनिष्ठ अभियंता सहाय्यक १५ पदे आणि मिडवाइफ २२ पदे समाविष्ट आहेत.</p>
