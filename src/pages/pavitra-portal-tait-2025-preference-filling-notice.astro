---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineQueueList,
  HiOutlineCheckBadge,
  HiOutlineMegaphone,
  HiOutlineQuestionMarkCircle,
  HiOutlineExclamationTriangle,
  HiOutlineShieldCheck,
  HiOutlineUserGroup,
  HiOutlineArrowLeft,
  HiOutlineCheckCircle,
  HiOutlineKey,
  HiOutlineGlobeAlt,
  HiOutlineDevicePhoneMobile,
  HiOutlineCog6Tooth,
} from "react-icons/hi2";

const title =
  "पवित्र पोर्टल TAIT 2025: शिक्षक पदभरती प्राधान्यक्रम जनरेट व लॉक करण्याबाबत सर्वसाधारण सूचना जाहीर!";
const description =
  "शिक्षक अभियोग्यता व बुद्धिमत्ता चाचणी (TAIT 2025) नुसार पवित्र पोर्टलमार्फत शिक्षक पदभरती प्राधान्यक्रम (Preferences) जनरेट करणे, लॉक करणे, लॉगिन आयडी रचना, OTP अडचण उपाय व Incognito Window संदर्भातील ०८/०८/२०२६ रोजीचे अधिकृत परिपत्रक पाहा.";
const canonicalURL =
  "https://mahasandhi.in/pavitra-portal-tait-2025-preference-filling-notice";
const date = "August 08, 2026";
const category = "Pavitra Portal Update";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  article={true}
  customBreadcrumbs={[
    { name: "Naukri Updates", url: "/naukri-updates" },
    { name: "Pavitra Portal TAIT 2025 Preference Notice" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Back Button -->
    <div class="mb-6 not-prose">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-text-muted hover:text-primary bg-bg-surface border border-border-card rounded-xl transition-all duration-300 no-underline shadow-xs hover:border-primary/30"
      >
        <HiOutlineArrowLeft className="text-sm" /> back to home / मुख्यपृष्ठावर जा
      </a>
    </div>

    <!-- Header Description -->
    <div class="mb-8">
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic bg-primary/5 rounded-r-xl"
      >
        शिक्षक अभियोग्यता व बुद्धिमत्ता चाचणी -२०२५ (TAIT 2025) नुसार पवित्र पोर्टलमार्फत शिक्षक पदभरतीसाठीच्या रिक्त जागांसाठी प्राधान्यक्रम (Preferences) जनरेट करणे व लॉक करण्याबाबत शालेय शिक्षण विभागाकडून दिनांक ०८/०८/२०२६ रोजी अधिकृत सूचना प्रसिद्ध करण्यात आली आहे.
      </p>
    </div>

    <!-- Urgent Notification Callout Banner -->
    <div
      class="mb-10 p-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border border-amber-500/30 not-prose"
    >
      <div class="flex items-start gap-4">
        <div class="p-3 bg-amber-500/20 text-amber-600 dark:text-amber-400 rounded-xl shrink-0">
          <HiOutlineExclamationTriangle className="text-2xl" />
        </div>
        <div>
          <h2 class="text-xl font-bold text-text-main mb-2">
            📌 पवित्र पोर्टल TAIT-2025 प्राधान्यक्रम भरतीबाबत महत्त्वाची माहिती
          </h2>
          <p class="text-text-muted text-sm leading-relaxed mb-3">
            पवित्र पोर्टलवर सध्या स्व-प्रमाणपत्र (Self-Certification) पूर्ण असलेल्या उमेदवारांकडून प्राधान्यक्रम जनरेट करणे व लॉक करण्याची कार्यवाही सुरु आहे. ०८/०८/२०२६ रोजी रात्री ९:०० वाजेपर्यंत <strong>मुलाखतीशिवाय ५८,२५१</strong> तर <strong>मुलाखतीसह ३८,५८२</strong> उमेदवारांचे प्राधान्यक्रम जनरेट झालेले आहेत.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://pavitra.mahasch.in"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all duration-200 no-underline shadow-sm"
            >
              Pavitra Portal Login <HiOutlineArrowTopRightOnSquare />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div
      class="mb-10 p-6 bg-bg-surface border border-border-card rounded-2xl not-prose shadow-sm"
    >
      <h2
        class="text-lg font-black text-text-main mb-4 flex items-center gap-2 border-b border-border-card/50 pb-3"
      >
        <HiOutlineQueueList className="text-primary text-xl" /> या लेखातील महत्त्वाचे मुद्दे (Table of Contents)
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm font-semibold text-text-muted">
        <li>
          <a href="#quick-highlights" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span> थोडक्यात माहिती (Quick Highlights)
          </a>
        </li>
        <li>
          <a href="#statistics" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span> प्राधान्यक्रम जनरेट आकडेवारी (Statistics)
          </a>
        </li>
        <li>
          <a href="#key-instructions" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span> सर्वसाधारण ४ महत्त्वाच्या सूचना
          </a>
        </li>
        <li>
          <a href="#otp-solution" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span> OTP अडचण व Incognito Window उपाय
          </a>
        </li>
        <li>
          <a href="#login-format" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span> Login ID फॉरमॅट व पासवर्ड रीसेट
          </a>
        </li>
        <li>
          <a href="#faq" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span> सतत विचारले जाणारे प्रश्न (FAQs)
          </a>
        </li>
      </ul>
    </div>

    <!-- Quick Highlights Table Section -->
    <section id="quick-highlights" class="mb-12">
      <h2 class="text-2xl font-black text-text-main mb-6 flex items-center gap-2.5">
        <HiOutlineDocumentText className="text-primary text-3xl" />
        TAIT 2025 पवित्र पोर्टल सूचनेचा सारांश (Quick Summary)
      </h2>
      <div class="overflow-x-auto not-prose rounded-2xl border border-border-card shadow-xs">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-primary/10 text-primary font-black border-b border-border-card">
              <th class="p-4 uppercase tracking-wider">बाब / तपशील</th>
              <th class="p-4 uppercase tracking-wider">अधिकृत माहिती</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-card/50 bg-bg-surface">
            <tr>
              <td class="p-4 font-bold text-text-main">विभाग (Department)</td>
              <td class="p-4 text-text-muted">शालेय शिक्षण व क्रीडा विभाग, महाराष्ट्र शासन</td>
            </tr>
            <tr class="bg-bg-subtle/40">
              <td class="p-4 font-bold text-text-main">परीक्षा (Exam Name)</td>
              <td class="p-4 text-text-muted">शिक्षक अभियोग्यता व बुद्धिमत्ता चाचणी (TAIT-2025)</td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-text-main">विषय (Subject)</td>
              <td class="p-4 text-text-muted font-semibold text-primary">
                शिक्षक पदभरतीसाठी प्राधान्यक्रम (Preferences) जनरेट व लॉक करण्याबाबत
              </td>
            </tr>
            <tr class="bg-bg-subtle/40">
              <td class="p-4 font-bold text-text-main">सूचना दिनांक (Notice Date)</td>
              <td class="p-4 text-text-muted">०८ ऑगस्ट २०२६ (08/08/2026)</td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-text-main">मुलाखतीशिवाय प्राधान्यक्रम संख्या</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-extrabold">
                ५८,२५१ उमेदवार (रात ९:०० वाजेपर्यंत)
              </td>
            </tr>
            <tr class="bg-bg-subtle/40">
              <td class="p-4 font-bold text-text-main">मुलाखतीसह प्राधान्यक्रम संख्या</td>
              <td class="p-4 text-purple-600 dark:text-purple-400 font-extrabold">
                ३८,५८२ उमेदवार (रात ९:०० वाजेपर्यंत)
              </td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-text-main">लॉगिन आयडी (Login ID Format)</td>
              <td class="p-4 text-text-main font-mono font-bold bg-primary/10 rounded-lg inline-block my-1">
                25_XXXXXXXXXX (१० अंकी TAIT 2025 रोल नंबर)
              </td>
            </tr>
            <tr class="bg-bg-subtle/40">
              <td class="p-4 font-bold text-text-main">अधिकृत संकेतस्थळ (Official Website)</td>
              <td class="p-4">
                <a
                  href="https://pavitra.mahasch.in"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary font-bold hover:underline"
                >
                  pavitra.mahasch.in
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Detailed Statistics Grid -->
    <section id="statistics" class="mb-12">
      <h2 class="text-2xl font-black text-text-main mb-6 flex items-center gap-2.5">
        <HiOutlineUserGroup className="text-primary text-3xl" />
        प्राधान्यक्रम जनरेट आकडेवारी (08/08/2026 स्थिती)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
        <div class="p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/30">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-500/20 px-3 py-1 rounded-full">
              Without Interview / मुलाखतीशिवाय
            </span>
            <HiOutlineCheckBadge className="text-2xl text-emerald-500" />
          </div>
          <p class="text-3xl font-black text-text-main mb-1">५८,२५१</p>
          <p class="text-xs text-text-muted">
            ०८/०८/२०२६ रात्री ९:०० वाजेपर्यंत मुलाखतीशिवाय या प्रकारात प्राधान्यक्रम जनरेट केलेल्या उमेदवारांची एकूण संख्या.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-purple-500/10 border border-purple-500/30">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-black uppercase tracking-wider text-purple-600 dark:text-purple-400 bg-purple-500/20 px-3 py-1 rounded-full">
              With Interview / मुलाखतीसह
            </span>
            <HiOutlineBuildingOffice className="text-2xl text-purple-500" />
          </div>
          <p class="text-3xl font-black text-text-main mb-1">३८,५८२</p>
          <p class="text-xs text-text-muted">
            ०८/०८/२०२६ रात्री ९:०० वाजेपर्यंत मुलाखतीसह या प्रकारात प्राधान्यक्रम जनरेट केलेल्या उमेदवारांची एकूण संख्या.
          </p>
        </div>
      </div>
    </section>

    <!-- Key Official Directives -->
    <section id="key-instructions" class="mb-12">
      <h2 class="text-2xl font-black text-text-main mb-6 flex items-center gap-2.5">
        <HiOutlineShieldCheck className="text-primary text-3xl" />
        उमेदवारांसाठी प्राधान्यक्रमाबाबत अधिकृत सर्वसाधारण सूचना (Official Points)
      </h2>
      <div class="space-y-6 not-prose">
        <div class="p-6 rounded-2xl bg-bg-surface border border-border-card shadow-xs">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-white font-black text-sm shrink-0">
              १
            </span>
            <div>
              <h3 class="text-lg font-bold text-text-main mb-2">
                प्राधान्यक्रम जनरेट व लॉक करण्याची कार्यवाही सुरू
              </h3>
              <p class="text-text-muted text-sm leading-relaxed">
                पवित्र पोर्टलवर सध्या <strong>स्व प्रमाणपत्र (Self Certificate)</strong> पूर्ण असलेल्या उमेदवारांकडून प्राधान्यक्रम जनरेट करणे व लॉक करण्याची कार्यवाही सुरु आहे. ०८/०८/२०२६ रोजी रात्री ९:०० वाजेपर्यंत मुलाखतीशिवाय प्रकारात ५८,२५१ उमेदवारांनी तर मुलाखतीसह प्रकारात ३८,५८२ उमेदवारांनी प्राधान्यक्रम जनरेट केलेले आहेत.
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-bg-surface border border-border-card shadow-xs">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-white font-black text-sm shrink-0">
              २
            </span>
            <div>
              <h3 class="text-lg font-bold text-text-main mb-2">
                संकेतस्थळावर (Portal Server Load) तांत्रिक भार येण्याचे कारण
              </h3>
              <p class="text-text-muted text-sm leading-relaxed">
                जाहिरातींची संख्या जास्त असल्याने उमेदवाराची शैक्षणिक व व्यावसायिक पात्रता तपासून सिस्टीमद्वारे प्राधान्यक्रम जनरेट होतात. त्यामुळे एकाच वेळी अनेक उमेदवार एकाच वेळी लॉगिन करत असल्याने संकेतस्थळावर भार (Server Load) येत आहे.
              </p>
            </div>
          </div>
        </div>

        <div id="otp-solution" class="p-6 rounded-2xl bg-bg-surface border border-amber-500/40 bg-amber-500/5 shadow-xs">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-amber-500 text-white font-black text-sm shrink-0">
              ३
            </span>
            <div>
              <h3 class="text-lg font-bold text-text-main mb-2 flex items-center gap-2">
                <HiOutlineDevicePhoneMobile className="text-amber-500 text-xl" />
                OTP मिळण्यात अडचणी येत असल्यास महत्त्वाचा उपाय!
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-3">
                ज्या उमेदवारांना मोबाईलवर OTP मिळण्यात अडचणी येत आहेत, अशा उमेदवारांनी खालील उपाययोजना कराव्यात:
              </p>
              <ul class="list-disc list-inside text-sm text-text-main space-y-1.5 font-medium">
                <li>आपण वापरत असलेल्या वेब ब्राऊझरची (Browser) <strong>History व Cache clear</strong> करावी.</li>
                <li>त्यानंतरही OTP ची समस्या सुटली नाही तर <strong>Incognito Window (Private Window)</strong> चा वापर करून लॉगिन करावे.</li>
              </ul>
            </div>
          </div>
        </div>

        <div id="login-format" class="p-6 rounded-2xl bg-bg-surface border border-border-card shadow-xs">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-white font-black text-sm shrink-0">
              ४
            </span>
            <div>
              <h3 class="text-lg font-bold text-text-main mb-2 flex items-center gap-2">
                <HiOutlineKey className="text-primary text-xl" />
                लॉगिन आयडी (Login ID) रचना व पासवर्ड रीसेट
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-2">
                उमेदवारांचा लॉगिन आयडी (Login ID) हा <strong class="text-primary font-mono bg-primary/10 px-2 py-0.5 rounded">25_xxxxxxxxxx</strong> (दहाअंकी TAIT 2025 चा रोल नंबर) या प्रमाणे असेल.
              </p>
              <p class="text-text-muted text-sm leading-relaxed">
                जर आपण पासवर्ड विसरला असाल तर पोर्टलवरील <strong>Forgot Password</strong> या सुविधेचा वापर करून नवीन पासवर्ड तयार करता येईल.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Important Official Links Box -->
    <section class="mb-12 not-prose">
      <div class="p-8 rounded-3xl bg-gradient-to-br from-primary/10 via-bg-surface to-primary/5 border border-primary/20 shadow-md">
        <h2 class="text-2xl font-black text-text-main mb-4 flex items-center gap-2.5">
          <HiOutlineGlobeAlt className="text-primary text-3xl" />
          महत्त्वाच्या अधिकृत लिंक्स (Important Links)
        </h2>
        <p class="text-text-muted text-sm mb-6">
          प्राधान्यक्रम जनरेट करणे व लॉक करण्यासाठी खालील अधिकृत लिंक्सचा वापर करा:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href="https://pavitra.mahasch.in"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 bg-primary hover:bg-primary/90 text-white rounded-2xl font-extrabold text-sm transition-all duration-300 no-underline shadow-sm hover:scale-[1.02]"
          >
            <span class="flex items-center gap-2">
              <HiOutlineCursorArrowRays className="text-xl" /> Pavitra Portal Login
            </span>
            <HiOutlineArrowTopRightOnSquare className="text-lg" />
          </a>

          <a
            href="https://mahateacherrecruitment.org.in"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 bg-bg-surface hover:bg-bg-subtle text-text-main border border-border-card rounded-2xl font-extrabold text-sm transition-all duration-300 no-underline shadow-xs hover:border-primary/40"
          >
            <span class="flex items-center gap-2">
              <HiOutlineGlobeAlt className="text-xl text-primary" /> Teacher Recruitment Portal
            </span>
            <HiOutlineArrowTopRightOnSquare className="text-lg text-text-muted" />
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="mb-12">
      <h2 class="text-2xl font-black text-text-main mb-6 flex items-center gap-2.5">
