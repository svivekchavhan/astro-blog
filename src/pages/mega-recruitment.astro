---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineBell, 
  HiOutlineXCircle, 
  HiOutlineBuildingOffice, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase,
  HiOutlineMagnifyingGlass,
  HiOutlineUser,
  HiOutlineCreditCard,
  HiOutlineBanknotes,
  HiOutlineDocumentText,
  HiOutlineChevronDown
} from "react-icons/hi2";

const title = "Mega Recruitment 2026 - Latest Govt Job Openings & Vacancies";
const description = "Find all active and upcoming government mega recruitments in India and Maharashtra. Filter by qualification, search jobs, and apply online for Police Bharti, Railway RRB, SSC, MPSC, Banking, and Zilla Parishad exams.";
const canonicalURL = "https://mahasandhi.in/mega-recruitment";

// Realistic mega recruitment campaigns for 2026
const recruitments = [];

const totalVacancies = "0";
const activeCount = 0;
const upcomingCount = 0;
---

<Layout 
  title={`${title} | Live Gov Job Updates - MahaSandhi`} 
  description={description}
  canonicalURL={canonicalURL}
>
  <section class="py-4 pb-16 not-prose">
    
    <!-- Hero Dashboard Header -->
    <div class="relative bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-10 mb-10 overflow-hidden shadow-sm">
      <div class="absolute -right-16 -top-16 w-48 h-48 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-48 h-48 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative flex flex-col items-center text-center max-w-[800px] mx-auto">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-600 dark:text-fuchsia-400 text-xs font-bold uppercase tracking-wider mb-4 animate-pulse">
          <HiOutlineBriefcase className="text-sm shrink-0" /> 2026 Mega Bharti Updates
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-text-main m-0 leading-tight mb-4">
          Government <span class="gradient-text">Mega Recruitment</span> Hub
        </h1>
        <p class="text-text-secondary text-sm sm:text-base leading-relaxed m-0 mb-8 max-w-[650px]">
          Access active and upcoming large-scale recruitments in Railways, Banking, Staff Selection, MPSC, and Maharashtra Government departments. Find full vacancy details, syllabus, criteria, and apply links.
        </p>

        <!-- KPI Metrics Row -->
        <div class="grid grid-cols-3 gap-3 w-full max-w-[600px] border-t border-border-card dark:border-border-card/30 pt-6">
          <div class="text-center">
            <span class="block text-2xl md:text-3xl font-extrabold text-primary tracking-tight">{totalVacancies}</span>
            <span class="block text-[0.65rem] md:text-xs text-text-muted uppercase font-semibold tracking-wider mt-1">Total Posts</span>
          </div>
          <div class="text-center border-x border-border-card dark:border-border-card/30">
            <span class="block text-2xl md:text-3xl font-extrabold text-emerald-500 tracking-tight">{activeCount}</span>
                {recruitments.length === 0 ? (
        <div class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl w-full">
          <p class="text-text-muted text-sm m-0">No active mega recruitments currently available. Please check back later.</p>
        </div>
      ) : (
        recruitments.map((job) => (
          <div 
            data-id={job.id}
            data-category={job.category}
            data-qualification={job.qualification}
            data-title={job.title.toLowerCase()}
            data-org={job.organisation.toLowerCase()}
            class="job-card bg-bg-surface border border-border-card rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary hover:shadow-md"
          >
            <!-- Top Row Summary Card -->
            <div class="p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 cursor-pointer select-none card-header-click">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2.5 flex-wrap">
                  <span class="text-[0.6rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                    {job.category === "maharashtra" ? "Maharashtra Gov" : job.category === "central" ? "Central Gov" : job.category}
                  </span>

                  {job.status === "apply-now" && (
                    <span class="text-[0.55rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Apply Active
                    </span>
                  )}

                  {job.status === "upcoming" && (
                    <span class="text-[0.55rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Upcoming
                    </span>
                  )}

                  {job.status === "closed" && (
                    <span class="text-[0.55rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 bg-rose-500 rounded-full inline-block"></span>
                      Closed
                    </span>
                  )}
                </div>

                <h3 class="text-lg md:text-xl text-text-main font-bold leading-tight mb-2 m-0 group-hover:text-primary transition-colors">
                  {job.title}
                </h3>
                
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-text-muted">
                  <span class="flex items-center gap-1"><HiOutlineBuildingOffice className="text-primary/70 shrink-0 text-sm" /> {job.organisation}</span>
                  <span class="flex items-center gap-1"><HiOutlineAcademicCap className="text-primary/70 shrink-0 text-sm" /> {job.qualification}</span>
                </div>
              </div>

              <!-- Total posts & Last date Summary badges -->
              <div class="flex items-center flex-wrap md:flex-nowrap gap-3 shrink-0">
                <div class="bg-primary/5 border border-primary/20 rounded-xl px-3.5 py-2 text-center min-w-[95px] md:min-w-[110px]">
                  <span class="block text-[0.55rem] text-text-muted uppercase tracking-wider font-semibold">Vacancies</span>
                  <span class="block text-xs md:text-sm font-black text-primary mt-0.5">{job.vacancies}</span>
                </div>
                
                <div class="bg-rose-500/5 dark:bg-rose-500/10 border border-rose-500/25 rounded-xl px-3.5 py-2 text-center min-w-[100px] md:min-w-[115px]">
                  <span class="block text-[0.55rem] text-rose-600 dark:text-rose-400 uppercase tracking-wider font-semibold">Last Date</span>
                  <span class="block text-xs md:text-sm font-black text-rose-600 dark:text-rose-400 mt-0.5">{job.lastDate}</span>
                </div>

                <!-- Collapsible Chevron Button -->
                <button 
                  type="button"
                  aria-label="Toggle Details" 
                  class="w-9 h-9 flex items-center justify-center border border-border-card rounded-full text-text-muted hover:text-primary hover:border-primary transition-colors cursor-pointer toggle-chevron-btn shrink-0"
                >
                  <HiOutlineChevronDown className="text-lg transition-transform duration-300" />
                </button>
              </div>
            </div>

            <!-- Slide Open Details Drawer -->
            <div class="job-details-drawer max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out border-t border-border-card/0">
              <div class="p-5 sm:p-6 bg-bg-base/30 dark:bg-black/10">
                
                <!-- Quick Info Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                  <div class="bg-bg-surface border border-border-card rounded-xl p-4 flex gap-3.5">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                      <HiOutlineUser className="text-xl" />
                    </div>
                    <div>
                      <span class="block text-[0.65rem] text-text-muted uppercase tracking-wider font-bold mb-0.5">Age Limit</span>
                      <p class="text-xs text-text-main m-0 leading-relaxed font-semibold">{job.ageLimit}</p>
                    </div>
                  </div>

                  <div class="bg-bg-surface border border-border-card rounded-xl p-4 flex gap-3.5">
                    <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
                      <HiOutlineBanknotes className="text-xl" />
                    </div>
                    <div>
                      <span class="block text-[0.65rem] text-text-muted uppercase tracking-wider font-bold mb-0.5">Pay Scale / Salary</span>
                      <p class="text-xs text-text-main m-0 leading-relaxed font-semibold">{job.salary}</p>
                    </div>
                  </div>

                  <div class="bg-bg-surface border border-border-card rounded-xl p-4 flex gap-3.5">
                    <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
                      <HiOutlineCreditCard className="text-xl" />
                    </div>
                    <div>
                      <span class="block text-[0.65rem] text-text-muted uppercase tracking-wider font-bold mb-0.5">Application Fee</span>
                      <p class="text-xs text-text-main m-0 leading-relaxed font-semibold">{job.appFee}</p>
                    </div>
                  </div>
                </div>

                <!-- Syllabus, Pattern & Bilingual Details Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                  <!-- Left Column: Syllabus & Selection -->
                  <div class="bg-bg-surface border border-border-card rounded-xl p-4">
                    <h4 class="text-xs uppercase tracking-wider font-extrabold text-primary flex items-center gap-1.5 mt-0 mb-3 border-none pb-0">
                      <HiOutlineDocumentText className="text-base shrink-0" /> Syllabus & Selection Process
                    </h4>
                    <p class="text-xs text-text-secondary leading-relaxed m-0">{job.syllabus}</p>
                  </div>

                  <!-- Right Column: Bilingual Summaries -->
                  <div class="bg-bg-surface border border-border-card rounded-xl p-4">
                    <!-- Lang Switch Tab Buttons inside accordion -->
                    <div class="flex items-center justify-between border-b border-border-card dark:border-border-card/30 pb-2 mb-3">
                      <span class="text-xs uppercase tracking-wider font-extrabold text-primary flex items-center gap-1.5 border-none pb-0">
                        📝 Recruitment Summary
                      </span>
                      <div class="flex gap-2">
                        <button data-lang="mr" class="lang-switch active px-2.5 py-0.5 rounded text-[0.65rem] font-bold uppercase tracking-wider cursor-pointer border border-primary/20 transition-all">मराठी</button>
                        <button data-lang="en" class="lang-switch px-2.5 py-0.5 rounded text-[0.65rem] font-bold uppercase tracking-wider cursor-pointer border border-border-card text-text-muted hover:border-primary/50 transition-all">English</button>
                      </div>
                    </div>

                    <!-- Summary Content -->
                    <div class="summary-text-box">
                      <p class="mr-text text-xs text-text-secondary leading-relaxed m-0 font-medium">{job.summaryMr}</p>
                      <p class="en-text text-xs text-text-secondary leading-relaxed m-0 font-medium hidden">{job.summaryEn}</p>
                    </div>
                  </div>
                </div>

                <!-- CTA Links Footer -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between border-t border-border-card/30 dark:border-border-card/10 pt-4 gap-3">
                  <span class="text-xs text-text-muted font-semibold italic">Double check qualifications on the official website before applying.</span>
                  <div class="flex gap-3 shrink-0">
                    <a 
                      href={job.notifLink} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="px-4 py-2 border border-border-card hover:border-primary text-text-main hover:text-primary rounded-xl text-xs font-bold uppercase tracking-wider transition-colors duration-200 no-underline"
                    >
                      View Notification
                    </a>
                    
                    {job.status === "apply-now" && (
                      <a 
                        href={job.applyLink} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="px-4 py-2 bg-gradient-to-r from-primary to-secondary text-white rounded-xl text-xs font-bold uppercase tracking-wider transition-all hover:shadow-md hover:shadow-primary/20 flex items-center gap-1.5 no-underline"
                      >
                        Apply Online <HiOutlineArrowTopRightOnSquare className="text-sm shrink-0" />
                      </a>
                    )}

                    {job.status === "upcoming" && (
                      <button 
                        type="button" 
                        disabled 
                        class="px-4 py-2 bg-amber-500/10 border border-amber-500/35 text-amber-600 dark:text-amber-400 rounded-xl text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-not-allowed"
                      >
                        <HiOutlineBell className="text-sm shrink-0 animate-bounce" /> Announcement Soon
                      </button>
                    )}

                    {job.status === "closed" && (
                      <button 
                        type="button" 
                        disabled 
                        class="px-4 py-2 bg-rose-500/5 border border-rose-500/20 text-rose-500/50 dark:text-rose-400/50 rounded-xl text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-not-allowed"
                      >
                        <HiOutlineXCircle className="text-sm shrink-0" /> Closed
                      </button>
                    )}
                  </div>
                </div>

              </div>
            </div>

          </div>
        ))
      )}

      <!-- No Results Card -->
      <div id="no-jobs-found" class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl hidden">
        <p class="text-text-muted text-sm m-0">No recruitments match your current search and filter selections.</p>
      </div>
    </div>

  </section>
</Layout>

<style>
  /* Custom interactive styling for the recruitment tabs and transitions */
  .cat-tab.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.25);
  }
  
  .lang-switch.active {
    background-color: rgba(56, 189, 248, 0.15);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Smooth drawer expand rules */
  .job-details-drawer.expanded {
    max-height: 1200px;
    opacity: 1;
    border-color: var(--color-border-card);
  }
</style>

<script>
  // Setup interactive client logic
  function initMegaRecruitment() {
    const jobCards = document.querySelectorAll(".job-card") as NodeListOf<HTMLDivElement>;
    if (jobCards.length === 0) return;
    
    const searchInput = document.getElementById("job-search") as HTMLInputElement;
    const qualSelect = document.getElementById("qual-select") as HTMLSelectElement;
    const noJobsFound = document.getElementById("no-jobs-found");

    let activeQual = "all";
    let searchQuery = "";

    // Filters and search evaluator
    function filterJobs() {
      let matchCount = 0;
      
      jobCards.forEach(card => {
        const cat = card.dataset.category || "";
        const qual = card.dataset.qualification || "";
        const title = card.dataset.title || "";
        const org = card.dataset.org || "";
        
        // Category search helper mapping (supports bilingual search matching)
        const categorySearchText = (
          cat === "maharashtra" ? "maharashtra gov government state state-gov राज्य शासन पोलीस" : 
          cat === "central" ? "central gov government केंद्र शासन टपाल पोस्ट" : 
          cat === "railways" ? "railway railways rrb alp रेल्वे लोको पायलट" : 
          cat === "banking-ssc" ? "banking bank ssc staff selection commission लिपिक बँक" : 
          cat
        ).toLowerCase();
        
        // Qualification check
        const matchesQual = (activeQual === "all" || qual === activeQual);
        
        // Search text check (evaluating title, department, qualification, and sector names)
        const matchesSearch = (
          title.includes(searchQuery) || 
          org.includes(searchQuery) ||
          qual.toLowerCase().includes(searchQuery) ||
          categorySearchText.includes(searchQuery)
        );

        if (matchesQual && matchesSearch) {
          card.classList.remove("hidden");
          matchCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (noJobsFound) {
        if (matchCount === 0) {
          noJobsFound.classList.remove("hidden");
        } else {
          noJobsFound.classList.add("hidden");
        }
      }
    }

    // Bind Search input
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterJobs();
      });
    }

    // Bind Qualification select
    if (qualSelect) {
      qualSelect.addEventListener("change", (e) => {
        activeQual = (e.target as HTMLSelectElement).value;
        filterJobs();
      });
    }

    // Accordion Toggle Drawer Logic
    jobCards.forEach(card => {
      const header = card.querySelector(".card-header-click");
      const drawer = card.querySelector(".job-details-drawer");
      const chevron = card.querySelector(".toggle-chevron-btn svg");
      
      if (header && drawer) {
        header.addEventListener("click", (e) => {
          // Prevent trigger if clicking directly on anchor tags or CTA buttons
          const target = e.target as HTMLElement;
          if (target.closest("a") || target.closest("button:not(.toggle-chevron-btn)")) {
            return;
          }

          const isExpanded = drawer.classList.contains("expanded");
          
          // Close other drawers for accordion behavior
          jobCards.forEach(c => {
            const d = c.querySelector(".job-details-drawer");
            const ch = c.querySelector(".toggle-chevron-btn svg");
            if (d && d !== drawer) {
              d.classList.remove("expanded");
              if (ch) (ch as HTMLElement).style.transform = "rotate(0deg)";
            }
          });

          // Toggle current
          if (isExpanded) {
            drawer.classList.remove("expanded");
            if (chevron) (chevron as HTMLElement).style.transform = "rotate(0deg)";
          } else {
            drawer.classList.add("expanded");
            if (chevron) (chevron as HTMLElement).style.transform = "rotate(180deg)";
          }
        });
      }

      // Bilingual toggle inside expanded drawer
      const mrSwitch = card.querySelector('[data-lang="mr"]');
      const enSwitch = card.querySelector('[data-lang="en"]');
      const mrText = card.querySelector(".mr-text");
      const enText = card.querySelector(".en-text");

      if (mrSwitch && enSwitch && mrText && enText) {
        mrSwitch.addEventListener("click", (e) => {
          e.stopPropagation();
          mrSwitch.classList.add("active");
          enSwitch.classList.remove("active");
          mrText.classList.remove("hidden");
          enText.classList.add("hidden");
        });

        enSwitch.addEventListener("click", (e) => {
          e.stopPropagation();
          enSwitch.classList.add("active");
          mrSwitch.classList.remove("active");
          enText.classList.remove("hidden");
          mrText.classList.add("hidden");
        });
      }
    });
  }

  // Bind init functions on loads (supports client routing / transitions)
  document.addEventListener("astro:page-load", initMegaRecruitment);
</script>
