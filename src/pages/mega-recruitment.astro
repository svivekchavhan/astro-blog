            <span class="block text-2xl md:text-3xl font-extrabold text-emerald-500 tracking-tight">{activeCount}</span>
            <span class="block text-[0.65rem] md:text-xs text-text-muted uppercase font-semibold tracking-wider mt-1">Active Exams (Live)</span>
