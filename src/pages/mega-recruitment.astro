// Helper to determine if recruitment application last date has NOT expired yet
function isRecruitmentActive(job: typeof recruitments[0]): boolean {
  if (job.status === "closed" || job.status === "declared") return false;
  if (!job.lastDate || job.lastDate === "Result Out") return false;
  
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const dateStr = (job as any).extendedDate || job.lastDate;
  const parsedDate = new Date(dateStr);
  
  if (isNaN(parsedDate.getTime())) return true;
  parsedDate.setHours(23, 59, 59, 999);
  
  return parsedDate >= today;
}

// Separate recruitments into active vs expired/closed
const activeJobs = recruitments.filter(job => isRecruitmentActive(job));
const expiredJobs = recruitments.filter(job => !isRecruitmentActive(job));

// Active count metric ONLY includes non-expired active application exams
const activeCount = activeJobs.length;

// Total vacancies sum across all active exams
const totalVacanciesSum = activeJobs.reduce((sum, job) => sum + (parseInt(job.vacancies.replace(/[^0-9]/g, ''), 10) || 0), 0);
const totalVacancies = totalVacanciesSum.toLocaleString("en-IN") + "+";
---

<Layout 
  title={`${title} | Live Gov Job Updates - MahaSandhi`} 
  description={description}
  canonicalURL={canonicalURL}
