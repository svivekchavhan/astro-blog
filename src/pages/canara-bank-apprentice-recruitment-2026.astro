---
import Layout from "../layouts/Layout.astro";
import { OFFICIAL_LINKS } from "../constants/links";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineCurrencyRupee,
} from "react-icons/hi2";

const title =
  "कॅनरा बँक ग्रॅज्युएट अप्रेंटिस भरती २०२६: ३,५०० जागांसाठी ऑनलाईन अर्ज सुरू (रु. १६,६५० स्टायपेन्ड)";
const description =
  "Canara Bank Graduate Apprentice Recruitment FY 2026-27: Apply online for 3,500 training vacancies (205 in Maharashtra) with Rs. 16,650 monthly stipend. No written exam - selection strictly based on 12th/Diploma merit marks. Check state-wise seats, eligibility, age limit, fee & official links at mahasandhi.in.";
const canonicalURL =
  "https://mahasandhi.in/canara-bank-apprentice-recruitment-2026";
const date = "October 01, 2026";
const category = "Bank Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Canara Bank Apprentice Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Main Article Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Jump Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          कॅनरा बँक (Canara Bank) ग्रॅज्युएट अप्रेंटिस ३,५०० जागा महाभरती जाहिरात २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Canara Bank Apprentice Bharti 2026:</strong> कॅनरा बँक (Canara Bank) द्वारे वित्तीय वर्ष २०२६-२७ अंतर्गत <strong>ग्रॅज्युएट अप्रेंटिस (Graduate Apprentice)</strong> पदांच्या तब्बल <strong>३,५०० प्रशिक्षण जागांसाठी</strong> अधिकृत भरती जाहिरात प्रसिद्ध करण्यात आली आहे.
          </p>
          <p>
            या भरती अंतर्गत निवड झालेल्या उमेदवारांना १ वर्षाच्या प्रशिक्षणादरम्यान दरमहा <strong>रु. १६,६५०/- स्टायपेन्ड (Stipend)</strong> दिला जाईल. सर्वात महत्त्वाचे म्हणजे <strong>कोणतीही लिखित परीक्षा नाही</strong>; १२वी किंवा डिप्लोमाच्या गुणांच्या मेरिटच्या आधारे निवड केली जाईल. महाराष्ट्रात २०५ जागा उपलब्ध असून ऑनलाईन अर्ज प्रक्रिया <strong>०१ ऑक्टोबर २०२६ ते १७ ऑक्टोबर २०२६</strong> दरम्यान सुरू राहील.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >आयोजक बँक</span
              >
              <span class="text-text-main font-semibold text-sm"
                >कॅनरा बँक (Canara Bank)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण</span
              >
              <span class="text-text-main font-semibold text-sm"
                >महाराष्ट्र (२०५ जागा) व भारतभर</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण प्रशिक्षण जागा</span
              >
              <span class="text-text-main font-semibold text-sm"
                >३,५०० जागा (3,500 Seats)</span
              >
            </div>
          </div>
        </div>

        <!-- Category & State Breakdown Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          १. प्रवर्गनिहाय व राज्यनिहाय जागांचा तपशील (Vacancy Breakdown)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          कॅनरा बँक अप्रेंटिस भरती २०२६ अंतर्गत प्रवर्गनिहाय आणि प्रमुख राज्यांतील जागांची विभागणी खालीलप्रमाणे आहे:
        </p>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">प्रवर्ग / राज्य (Category / State)</th>
                <th class="p-3 border border-border-card font-bold text-text-main text-center">जागांची संख्या (Seat Breakdown)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr><td class="p-3 border font-bold">सर्वसाधारण (UR / Open)</td><td class="p-3 border text-center font-bold text-primary">१,५४१</td></tr>
              <tr><td class="p-3 border font-bold">इतर मागासवर्गीय (OBC)</td><td class="p-3 border text-center font-bold text-primary">८४५</td></tr>
              <tr><td class="p-3 border font-bold">अनुसूचित जाती (SC)</td><td class="p-3 border text-center font-bold text-primary">५५३</td></tr>
              <tr><td class="p-3 border font-bold">आर्थिकदृष्ट्या दुर्बल (EWS)</td><td class="p-3 border text-center font-bold text-primary">३३५</td></tr>
              <tr><td class="p-3 border font-bold">अनुसूचित जमाती (ST)</td><td class="p-3 border text-center font-bold text-primary">२२६</td></tr>
              <tr class="bg-primary/10"><td class="p-3 border font-black text-right">एकूण भारतभर जागा (Total Seats)</td><td class="p-3 border text-center font-black text-rose-600 text-base">३,५०० जागा</td></tr>
            </tbody>
          </table>
        </div>

        <div class="bg-bg-surface border border-border-card p-4 rounded-2xl text-xs text-text-muted mb-6">
          📍 <strong>महाराष्ट्रासह प्रमुख राज्यांतील जागा:</strong> महाराष्ट्र (२०५), उत्तर प्रदेश (४०९), तामिळनाडू (३९१), कर्नाटक (५८१), केरळ (२४०), आंध्र प्रदेश (२४७), पश्चिम बंगाल (१५०), बिहार (१२२), मध्य प्रदेश (११०), ओडिशा (१०४), गुजरात (८९), राजस्थान (९६), पंजाब (९६), हरियाणा (११४).
        </div>

        <!-- Educational Qualification Table -->
        <h2
          id="eligibility"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎓 २. शैक्षणिक पात्रता व अटी (Educational Qualification Criteria)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">बाबी (Criteria)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">सविस्तर अट (Details - Cutoff: 01.09.2026)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border font-bold">पदवी शैक्षणिक पात्रता (Graduation Degree)</td>
                <td class="p-3 border text-text-muted">मान्यताप्राप्त विद्यापीठाची कोणत्याही शाखेतील पदवी (Bachelor's Degree in any discipline).</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold">पदवी उत्तीर्ण वर्ष (Passing Window)</td>
                <td class="p-3 border text-text-muted">उमेदवाराने आपली पदवी <strong>०१ जानेवारी २०२३ ते ०१ सप्टेंबर २०२६</strong> दरम्यान उत्तीर्ण केलेली असावी.</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold">१२वी / डिप्लोमा किमान गुण (Merit Marks)</td>
                <td class="p-3 border text-text-muted">१२वी (HSC/10+2) किंवा डिप्लोमा परीक्षेत <strong>किमान ६०% गुण</strong> असणे आवश्यक. (SC, ST व PwBD उमेदवारांसाठी किमान ५५% गुण आवश्यक).</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold">अपात्रता (Exclusions)</td>
                <td class="p-3 border text-rose-500 font-semibold">पदवीनंतर १ वर्ष किंवा त्याहून अधिक कामाचा अनुभव असणारे किंवा आधी अप्रेंटिसशिप केलेले उमेदवार पात्र नाहीत.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit Table -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎂 ३. वयोमर्यादा व सवलत (Age Limit Criteria as on 01.09.2026)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">प्रवर्ग (Category)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">वयोमर्यादा (Age Limit)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border font-bold">सर्वसाधारण / EWS (General)</td>
                <td class="p-3 border font-bold text-primary">२० ते २८ वर्षे (जन्म ०२/०९/१९९८ ते ०१/०९/२००६)</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold">इतर मागासवर्गीय (OBC Non-Creamy Layer)</td>
                <td class="p-3 border font-bold text-primary">२० ते ३१ वर्षे (०३ वर्षे सूट)</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold">अनुसूचित जाती / जमाती (SC / ST)</td>
                <td class="p-3 border font-bold text-primary">२० ते ३३ वर्षे (०५ वर्षे सूट)</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold">दिव्यांग उमेदवार (PwBD)</td>
                <td class="p-3 border font-bold text-primary">२० ते ३८ वर्षे (१० वर्षे सूट)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Calculator Button -->
        <div class="my-6">
          <a
            href="/mpsc-age-calculator-marathi"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-secondary hover:shadow-lg text-white font-bold text-sm rounded-xl transition-all no-underline border-none"
          >
            <HiOutlineCalculator className="text-lg shrink-0" />
            <span>तुमचे वय मोजा - Age Calculator Tool</span>
          </a>
        </div>

        <!-- Application Fees & Stipend -->
        <h2
          id="fees"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          💳 ४. परीक्षा शुल्क व दरमहा स्टायपेन्ड (Fee & Monthly Stipend)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">बाबी (Item)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">रक्कम / तपशील (Amount / Detail)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border font-bold text-text-main">General / OBC / EWS अर्ज शुल्क</td>
                <td class="p-3 border font-bold text-rose-500">₹ ५००/- (रु. ५०० मात्र)</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold text-text-main">SC / ST / PwBD अर्ज शुल्क</td>
                <td class="p-3 border font-bold text-emerald-600 dark:text-emerald-400">मोफत (Nil)</td>
              </tr>
              <tr>
                <td class="p-3 border font-bold text-text-main">दरमहा स्टायपेन्ड (Monthly Stipend)</td>
                <td class="p-3 border font-extrabold text-emerald-600 dark:text-emerald-400 text-base">
                  ₹ १६,६५०/- प्रति महिना<br />
                  <span class="text-xs font-normal text-text-muted">(कॅनरा बँक: ₹१०,५०० + NATS DBT सबसिडी: ₹६,१५०)</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Selection Process -->
        <h2
          id="selection-process"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔍 ५. निवड प्रक्रिया (Selection Process - No Written Exam)
        </h2>
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3">
          <ul class="list-disc pl-5 space-y-2 text-text-muted">
            <li><strong>१. राज्यनिहाय मेरिट यादी (Merit List):</strong> १२वी (10+2) किंवा डिप्लोमाच्या परीक्षेतील गुणांच्या टक्क्यांवरून कोणतीही लिखित परीक्षा न घेता मेरिट लिस्ट तयार केली जाईल.</li>
            <li><strong>२. स्थानिक भाषा चाचणी (Local Language Test):</strong> १०वी किंवा १२वीमध्ये संबंधित राज्याची भाषा शिकल्याचे गुणपत्रक असल्यास भाषा चाचणीतून सूट.</li>
            <li><strong>३. कागदपत्र पडताळणी (Document Verification):</strong> मूळ शैक्षणिक प्रमाणपत्रे व NATS नोंदणी पडताळणी.</li>
            <li><strong>४. वैद्यकीय तपासणी व १ वर्षाचे अप्रेंटिस कंत्राट.</strong></li>
          </ul>
        </div>

        <!-- Important Dates Schedule Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          📅 ६. महत्त्वाच्या तारखा व वेळापत्रक (Important Schedule)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Event)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">तारीख (Date)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border text-text-muted font-medium">ऑनलाईन अर्ज नोंदणी कालावधी</td>
                <td class="p-3 border text-emerald-600 dark:text-emerald-400 font-bold">०१ ऑक्टोबर २०२६ ते १७ ऑक्टोबर २०२६</td>
              </tr>
              <tr>
                <td class="p-3 border text-text-muted font-medium">प्रशिक्षण कालावधी (Duration of Apprenticeship)</td>
                <td class="p-3 border text-text-main font-bold">१२ महिने (१ वर्ष)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Step-by-Step Application Process -->
        <h2
          id="how-to-apply"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          📝 ७. ऑनलाईन अर्ज करण्याची सोपी पद्धत (Step-by-Step Registration)
        </h2>
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3">
          <ol class="list-decimal pl-5 space-y-2 text-text-muted">
            <li><strong>पायरी १ (NATS नोंदणी):</strong> सर्वप्रथम <a href={OFFICIAL_LINKS.natsPortal} target="_blank" rel="noopener noreferrer" class="text-primary font-bold underline">nats.education.gov.in</a> पोर्टलवर १००% प्रोफाईल पूर्ण करून Enrollment Number मिळवा.</li>
            <li><strong>पायरी २ (बँक वेबसाईट अर्ज):</strong> कॅनरा बँकेच्या Careers Page वर जाऊन "Click Here for New Registration" वर क्लिक करा.</li>
            <li><strong>पायरी ३ (माहिती भरा):</strong> NATS ID, वैयक्तिक माहिती, १ राज्य निवड व १२वी/डिप्लोमाचे गुण भरा.</li>
            <li><strong>पायरी ४ (कागदपत्रे अपलोड करा):</strong> फोटो (20-50KB), सही (10-20KB), डाव्या हाताच्या अंगठ्याचा ठसा (20-50KB) आणि हस्तलिखित जाहीरनामा (50-100KB) अपलोड करा.</li>
