---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineClipboardDocumentCheck,
  HiOutlineCurrencyRupee,
} from "react-icons/hi2";

const title =
  "IBPS RRB भरती २०२६: प्रादेशिक ग्रामीण बँकांमध्ये १३,६८८ जागांसाठी महाभरती जाहीर! ऑनलाईन अर्ज सुरू";
const description =
  "IBPS CRP RRBs-XV Recruitment 2026: Apply online for 13,688 Office Assistant (Multipurpose) and Officer Scale I, II, III vacancies across 28 Regional Rural Banks. Read post-wise vacancy, qualification, age limit, selection process, fee & official apply link at mahasandhi.in.";
const canonicalURL =
  "https://mahasandhi.in/ibps-rrb-recruitment-2026";
const date = "September 27, 2026";
const category = "Bank Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "IBPS RRB Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Main Article Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Jump Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          IBPS प्रादेशिक ग्रामीण बँक (IBPS RRB XV) १३,६८८ जागा महाभरती जाहिरात २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>IBPS RRB Bharti 2026:</strong> इन्स्टिट्यूट ऑफ बँकिंग पर्सनल सिलेक्शन (IBPS) द्वारे भारतातील २८ प्रादेशिक ग्रामीण बँकांमध्ये (Regional Rural Banks - RRBs) <strong>ऑफिस असिस्टंट (बहुउद्देशीय / Office Assistant Multipurpose)</strong> आणि <strong>ऑफिसर स्केल-I, II, III (Officer Scale I, II & III)</strong> पदांच्या तब्बल <strong>१३,६८८ जागांसाठी</strong> अधिकृत भरती जाहिरात (CRP RRBs-XV) जाहीर करण्यात आली आहे.
          </p>
          <p>
            बँकिंग क्षेत्रात करिअर करू इच्छिणाऱ्या पदवीधर उमेदवारांसाठी ही सुवर्णसंधी आहे. या भरती अंतर्गत ऑफिस असिस्टंटच्या ८,१८३ जागा आणि ऑफिसर संवर्गातील ५,५०५ जागा भरल्या जाणार आहेत. ऑनलाईन अर्ज प्रक्रिया ०१ सप्टेंबर २०२६ पासून सुरू झाली असून मुदतवाढ देऊन <strong>२७ सप्टेंबर २०२६</strong> पर्यंत ऑनलाईन अर्ज सादर करता येतील.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >आयोजक संस्था</span
              >
              <span class="text-text-main font-semibold text-sm"
                >IBPS (२८ प्रादेशिक ग्रामीण बँका)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण</span
              >
              <span class="text-text-main font-semibold text-sm"
                >महाराष्ट्र व संपूर्ण भारतभर</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण रिक्त पदे</span
              >
              <span class="text-text-main font-semibold text-sm"
                >१३,६८८ पदे (13,688 Posts)</span
              >
            </div>
          </div>
        </div>

        <!-- Post-wise Vacancy Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          १. पदांचे नाव व पदसंख्या (Post Name & Vacancy Breakdown)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          IBPS RRB XV भरती २०२६ अंतर्गत विविध पदांच्या रिक्त जागांचा तपशील खालीलप्रमाणे आहे:
        </p>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center w-16"
                  >अ.क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >रिक्त जागा (Vacancies)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">१</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Office Assistant (Multipurpose) — ऑफिस असिस्टंट (लिपिक)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">८,१८३</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">२</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-I (Assistant Manager) — सहाय्यक व्यवस्थापक</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">४,२५६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">३</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (General Banking Officer) — व्यवस्थापक</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">६६६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">४</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Information Technology Officer)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">१८२</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">५</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Chartered Accountant - CA)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">८१</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">६</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Law Officer) — विधी अधिकारी</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">४६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">७</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Marketing Officer)</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">१६</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">८</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Agricultural Officer) — कृषी अधिकारी</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">३८</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold">९</td>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-III (Senior Manager) — वरिष्ठ व्यवस्थापक</td>
                <td class="p-3 border border-border-card text-center font-extrabold text-primary">२२०</td>
              </tr>
              <tr class="bg-primary/10">
                <td colspan="2" class="p-3 border border-border-card font-bold text-text-main text-right">
                  🔢 एकूण रिक्त पदे (Grand Total)
                </td>
                <td class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-lg">
                  १३,६८८ पदे
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Educational Qualification Table -->
        <h2
          id="eligibility"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎓 २. पदनिहाय शैक्षणिक पात्रता (Educational Qualification & Experience)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">पदाचे नाव (Post Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">आवश्यक शैक्षणिक पात्रता व अनुभव</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Office Assistant (Multipurpose)</td>
                <td class="p-3 border border-border-card text-text-muted">कोणत्याही शाखेतील पदवी (Bachelor's Degree) + स्थानिक भाषेचे ज्ञान + संगणकाचे मूलभूत ज्ञान. (कोणताही अनुभव आवश्यक नाही).</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-I (Assistant Manager)</td>
                <td class="p-3 border border-border-card text-text-muted">कोणत्याही शाखेतील पदवी (कृषी, फलोत्पादन, पशुसंवर्धन, IT, व्यवस्थापन, विधी, अर्थशास्त्र किंवा कॉमर्स पदवीधरांना प्राधान्य).</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (General Banking Officer)</td>
                <td class="p-3 border border-border-card text-text-muted">किमान ५०% गुणांसह पदवी + बँक किंवा वित्तीय संस्थेत अधिकारी म्हणून किमान २ वर्षांचा अनुभव.</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (IT Officer)</td>
                <td class="p-3 border border-border-card text-text-muted">Electronics / Communication / Computer Science / IT मध्ये ५०% गुणांसह पदवी + १ वर्षाचा अनुभव.</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Chartered Accountant - CA)</td>
                <td class="p-3 border border-border-card text-text-muted">ICAI कडून CA परीक्षा उत्तीर्ण + १ वर्षाचा अनुभव.</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Law Officer)</td>
                <td class="p-3 border border-border-card text-text-muted">५०% गुणांसह कायदा पदवी (LLB) + वकील म्हणून किंवा बँकेत विधी अधिकारी म्हणून २ वर्षांचा अनुभव.</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Treasury / Marketing Officer)</td>
                <td class="p-3 border border-border-card text-text-muted">MBA (Finance / Marketing) किंवा CA + १ वर्षाचा अनुभव.</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Agricultural Officer)</td>
                <td class="p-3 border border-border-card text-text-muted">कृषी / फलोत्पादन / पशुसंवर्धन / डेअरी पदवी (५०% गुण) + २ वर्षांचा अनुभव.</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-III (Senior Manager)</td>
                <td class="p-3 border border-border-card text-text-muted">किमान ५०% गुणांसह पदवी + बँक किंवा वित्तीय संस्थेत अधिकारी म्हणून किमान ५ वर्षांचा अनुभव.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit Table -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎂 ३. वयोमर्यादा (दिनांक ०१/०९/२०२६ रोजी)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">पदाचे नाव (Post Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">वयोमर्यादा (Age Limit)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Office Assistant (Multipurpose)</td>
                <td class="p-3 border border-border-card font-bold text-primary">१८ ते २८ वर्षे (18 to 28 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-I (Assistant Manager)</td>
                <td class="p-3 border border-border-card font-bold text-primary">१८ ते ३० वर्षे (18 to 30 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-II (Manager)</td>
                <td class="p-3 border border-border-card font-bold text-primary">२१ ते ३२ वर्षे (21 to 32 Years)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">Officer Scale-III (Senior Manager)</td>
                <td class="p-3 border border-border-card font-bold text-primary">२१ ते ४० वर्षे (21 to 40 Years)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="bg-bg-surface border border-border-card p-4 rounded-2xl text-xs text-text-muted mb-6">
          📌 <strong>वयोमर्यादेमध्ये सूट (Age Relaxation):</strong> SC/ST उमेदवारांना ०५ वर्षे, OBC उमेदवारांना ०३ वर्षे आणि दिव्यांग (PwBD) उमेदवारांना १० वर्षे सूट.
        </div>

        <!-- Age Calculator Button -->
        <div class="my-6">
          <a
            href="/mpsc-age-calculator-marathi"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-secondary hover:shadow-lg text-white font-bold text-sm rounded-xl transition-all no-underline border-none"
          >
            <HiOutlineCalculator className="text-lg shrink-0" />
            <span>तुमचे वय मोजा - IBPS Age Calculator Tool</span>
          </a>
        </div>

        <!-- Application Fees -->
        <h2
          id="fees"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          💳 ४. परीक्षा शुल्क (Application Fee)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">प्रवर्ग (Category)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">शुल्क (Fee Amount)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">SC / ST / PwBD / ESM उमेदवारांसाठी</td>
                <td class="p-3 border border-border-card font-bold text-emerald-600 dark:text-emerald-400">₹ १७५/- (रु. १७५ मात्र)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card font-bold text-text-main">General / OBC / EWS (इतर सर्व उमेदवारांसाठी)</td>
                <td class="p-3 border border-border-card font-bold text-rose-500">₹ ८५०/- (रु. ८५० मात्र)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Selection Process -->
        <h2
          id="selection-process"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔍 ५. निवड प्रक्रिया (Selection Process)
        </h2>
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3">
          <ul class="list-disc pl-5 space-y-2 text-text-muted">
            <li><strong>Office Assistant (Multipurpose):</strong> पूर्व परीक्षा (Preliminary Exam) ➔ मुख्य परीक्षा (Main Exam). <em>(या पदासाठी मुलाखत / Interview नाही; मुख्य परीक्षेच्या गुणांवर थेट निवड होईल).</em></li>
            <li><strong>Officer Scale-I:</strong> पूर्व परीक्षा (Preliminary Exam) ➔ मुख्य परीक्षा (Main Exam) ➔ वैयक्तिक मुलाखत (Personal Interview).</li>
            <li><strong>Officer Scale-II & III:</strong> एकच मुख्य परीक्षा (Single Level Exam) ➔ वैयक्तिक मुलाखत (Personal Interview).</li>
          </ul>
        </div>

        <!-- Important Dates Schedule Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          📅 ६. महत्त्वाच्या तारखा व वेळापत्रक (Important Schedule)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Event)</th>
