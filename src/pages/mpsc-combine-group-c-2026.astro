---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineAcademicCap,
  HiOutlineDocumentText,
  HiOutlineCalendarDays,
  HiOutlineSparkles,
  HiOutlineQueueList,
  HiOutlineUserGroup,
  HiOutlineArrowRight,
  HiOutlineCursorArrowRays,
  HiOutlineClock,
} from "react-icons/hi2";

const title =
  "MPSC Combine Group C 2026: गट-क संयुक्त परीक्षा ५,७०७ पदे भरती, मुदतवाढ व सर्व माहिती | MahaSandhi";
const description =
  "MPSC Combine Group C Exam 2026: महाराष्ट्र लोकसेवा आयोग गट-क संयुक्त पूर्व परीक्षा ५,७०७ जागा (तलाठी १५३९, लिपिक ३१९७ पदे). पूर्व परीक्षा २५ ऑक्टोबर २०२६. अर्ज मुदतवाढ १० ऑगस्ट २०२६. सविस्तर जाहिरात, अभ्यासक्रम व लाइव्ह काउंटडाउन एकाच ठिकाणी.";
const canonicalURL = "https://mahasandhi.in/mpsc-combine-group-c-2026";

interface UpdateArticle {
  id: string;
  title: string;
  link: string;
  publishedAt: string; // ISO String
  isMega?: boolean;
}

const updatesArticles: UpdateArticle[] = [
  {
    id: "mpsc-group-c-pesa-update-2026",
    title:
      "MPSC गट-क परीक्षा: पेसा (PESA) रहिवासी व माजी सैनिक आरक्षणाबाबत परिपत्रक जारी",
    link: "/mpsc-group-c-pesa-update-2026",
    publishedAt: "2026-08-07T11:00:00.000Z", // Published today -> Red font + NEW UPDATE badge!
  },
  {
    id: "mpsc-group-c-last-date-extended-2026",
    title: "MPSC गट-क परीक्षा अर्ज भरण्यास मुदतवाढ : १० ऑगस्ट 2026",
    link: "/mpsc-group-c-last-date-extended-2026",
    publishedAt: "2026-08-06T12:00:00.000Z", // <48 Hours -> Red title font + NEW UPDATE badge!
  },
  {
    id: "mpsc-group-c-bharti-2026",
    title:
      "MPSC गट-क सेवा संयुक्त पूर्व परीक्षा २०२६: ५,७०७ जागांसाठी भरती जाहिरात व ऑनलाईन अर्ज",
    link: "/mpsc-group-c-bharti-2026",
    publishedAt: "2026-07-22T00:00:00.000Z", // >48 Hours -> Black title font
    isMega: true,
  },
];

// Helper function to check if published within 48 hours
function isNewArticle(dateString: string): boolean {
  const publishedDate = new Date(dateString).getTime();
  const currentDate = new Date().getTime();
  const hoursDifference = (currentDate - publishedDate) / (1000 * 60 * 60);
  return hoursDifference <= 48;
}
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  customBreadcrumbs={[
    { name: "MPSC Exam Hub", url: "/mpsc" },
    { name: "MPSC Combine Group C 2026" },
  ]}
>
  <section class="pt-2 pb-16 not-prose">
    <div class="max-w-[1100px] mx-auto px-2 md:px-0">
      <!-- Live Exam Countdown Banner (Simple & Light Background) -->
      <div
        class="mb-6 p-5 sm:p-6 md:p-8 rounded-3xl bg-gradient-to-br from-violet-500/10 via-primary/5 to-emerald-500/10 border border-violet-500/25 shadow-xs relative overflow-hidden"
      >
        <div
          class="flex flex-col md:flex-row items-center justify-between gap-5 relative z-10"
        >
          <div class="text-center md:text-left space-y-1.5">
            <div
              class="inline-flex items-center gap-1.5 px-3 py-1 bg-violet-500/10 text-violet-600 dark:text-violet-400 rounded-full text-xs font-black uppercase tracking-wider border border-violet-500/20"
            >
              <HiOutlineClock className="text-sm animate-spin" />
              <span>Exam Countdown</span>
            </div>
            <h2
              class="text-xl sm:text-2xl md:text-3xl font-black text-text-main m-0 leading-tight"
            >
              MPSC गट-क संयुक्त पूर्व परीक्षा २०२६
            </h2>
            <p class="text-xs sm:text-sm text-text-secondary m-0 font-medium">
              परीक्षेचा दिनांक: <span
                class="font-black text-violet-600 dark:text-violet-400 text-sm sm:text-base"
                >२५ ऑक्टोबर २०२६
              </span>
            </p>
          </div>

          <!-- Countdown Timer Display Boxes (Light Styled Cards) -->
          <div
            class="grid grid-cols-4 gap-2 sm:gap-3 text-center shrink-0 w-full md:w-auto"
          >
            <div
              class="bg-bg-surface/90 backdrop-blur-xs border border-violet-500/25 p-2.5 sm:p-3.5 rounded-2xl min-w-[65px] sm:min-w-[80px] shadow-xs"
            >
              <span
                id="cd-days"
                class="block text-2xl sm:text-3xl font-black text-violet-600 dark:text-violet-400 leading-none"
                >00</span
              >
              <span
                class="text-[0.65rem] sm:text-xs font-bold text-text-muted uppercase tracking-wider"
                >दिवस</span
              >
            </div>
            <div
              class="bg-bg-surface/90 backdrop-blur-xs border border-border-card/80 p-2.5 sm:p-3.5 rounded-2xl min-w-[65px] sm:min-w-[80px] shadow-xs"
            >
              <span
                id="cd-hours"
                class="block text-2xl sm:text-3xl font-black text-text-main leading-none"
                >00</span
              >
              <span
                class="text-[0.65rem] sm:text-xs font-bold text-text-muted uppercase tracking-wider"
                >तास</span
              >
            </div>
            <div
              class="bg-bg-surface/90 backdrop-blur-xs border border-border-card/80 p-2.5 sm:p-3.5 rounded-2xl min-w-[65px] sm:min-w-[80px] shadow-xs"
            >
              <span
                id="cd-minutes"
                class="block text-2xl sm:text-3xl font-black text-text-main leading-none"
                >00</span
              >
              <span
                class="text-[0.65rem] sm:text-xs font-bold text-text-muted uppercase tracking-wider"
                >मिनिटे</span
              >
            </div>
            <div
              class="bg-bg-surface/90 backdrop-blur-xs border border-rose-500/25 p-2.5 sm:p-3.5 rounded-2xl min-w-[65px] sm:min-w-[80px] shadow-xs"
            >
              <span
                id="cd-seconds"
                class="block text-2xl sm:text-3xl font-black text-rose-500 leading-none"
                >00</span
              >
              <span
                class="text-[0.65rem] sm:text-xs font-bold text-text-muted uppercase tracking-wider"
                >सेकंद</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Below Countdown: Total Applications Card -->
      <div
        class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-amber-500/10 via-primary/5 to-amber-500/10 border border-amber-500/20 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left"
      >
        <div class="flex items-center gap-3">
          <div
            class="p-2.5 bg-amber-500/15 text-amber-600 dark:text-amber-400 rounded-xl shrink-0"
          >
            <HiOutlineUserGroup className="text-2xl" />
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-black text-text-main m-0">
              MPSC गट क पूर्व २०२६
            </h3>
            <p class="text-xs text-text-muted m-0">
              ५,७०७ पदांसाठी प्राप्त ऑनलाईन अर्ज
            </p>
          </div>
        </div>

        <div
          class="px-5 py-2.5 bg-bg-surface/90 backdrop-blur-xs border border-amber-500/30 rounded-xl shadow-xs shrink-0"
        >
          <span
            class="text-lg sm:text-xl font-black text-amber-600 dark:text-amber-400"
          >
            👉 अर्ज - १२ लाख +
          </span>
        </div>
      </div>
    </div>

    <!-- Hero Header -->
    <div
      class="relative bg-gradient-to-br from-violet-500/15 via-primary/10 to-emerald-500/10 border border-violet-500/30 p-6 md:p-10 rounded-3xl my-8 md:my-10 overflow-hidden shadow-xs"
    >
      <div
        class="absolute -right-20 -top-20 w-72 h-72 bg-violet-500/10 rounded-full blur-3xl -z-10"
      >
      </div>
      <div
        class="absolute -left-20 -bottom-20 w-72 h-72 bg-primary/10 rounded-full blur-3xl -z-10"
      >
      </div>

      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <span
            class="text-[0.65rem] bg-violet-600 text-white px-3 py-1 rounded-full font-extrabold uppercase tracking-wider inline-flex items-center gap-1 shadow-xs"
          >
            <HiOutlineSparkles className="text-xs" /> MPSC Official Mega Bharti 2026
          </span>
          <span
            class="text-[0.65rem] bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 px-3 py-1 rounded-full font-bold uppercase tracking-wider"
          >
            एकूण ५,७०७ पदे
          </span>
          <span
            class="text-[0.65rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 px-3 py-1 rounded-full font-bold uppercase tracking-wider"
          >
            अर्ज मुदत: १० ऑगस्ट २०२६ पर्यंत
          </span>
        </div>

        <h1
          class="text-3xl md:text-5xl font-black text-text-main leading-tight mb-4 tracking-tight"
        >
          MPSC Combine Group C Exam 2026 (महाराष्ट्र गट-क संयुक्त परीक्षा)
        </h1>
        <p
          class="text-xs md:text-base text-text-secondary leading-relaxed mb-6"
        >
          महाराष्ट्र लोकसेवा आयोग (MPSC) द्वारे गट-क संवर्गातील ५,७०७ रिक्त
          पदांसाठी अर्ज प्रक्रिया सुरू आहे. ऑनलाईन अर्ज करण्याची सुधारित अंतिम मुदत <strong class="text-rose-600 dark:text-rose-400">१० ऑगस्ट २०२६</strong> पर्यंत आहे.
        </p>

        <div
          class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-semibold"
        >
          <div
            class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
          >
            <div
              class="p-2 bg-violet-500/10 text-violet-500 rounded-xl shrink-0"
            >
              <HiOutlineUserGroup className="text-lg" />
            </div>
            <div>
              <span
                class="block text-[0.65rem] text-text-muted font-bold uppercase"
                >एकूण जागा</span
              >
              <span class="text-text-main font-extrabold">५,७०७ पदे</span>
            </div>
          </div>
          <div
            class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
          >
            <div
              class="p-2 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded-xl shrink-0"
            >
              <HiOutlineCalendarDays className="text-lg" />
            </div>
            <div>
              <span
                class="block text-[0.65rem] text-text-muted font-bold uppercase"
                >अर्ज अंतिम मुदत</span
              >
              <span class="text-rose-600 dark:text-rose-400 font-extrabold"
                >१० ऑगस्ट २०२६</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
          >
            <div class="p-2 bg-rose-500/10 text-rose-500 rounded-xl shrink-0">
              <HiOutlineCalendarDays className="text-lg" />
            </div>
            <div>
              <span
                class="block text-[0.65rem] text-text-muted font-bold uppercase"
                >पूर्व परीक्षा</span
              >
              <span class="text-emerald-600 dark:text-emerald-400 font-extrabold"
                >२५ ऑक्टोबर २०२६</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5"
          >
            <div
              class="p-2 bg-emerald-500/10 text-emerald-500 rounded-xl shrink-0"
            >
              <HiOutlineAcademicCap className="text-lg" />
            </div>
            <div>
              <span
                class="block text-[0.65rem] text-text-muted font-bold uppercase"
                >पात्रता</span
              >
              <span class="text-text-main font-extrabold"
                >कोणतीही पदवी (Degree)</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Related MPSC Group C Articles Table -->
    <div class="mb-12 space-y-4">
      <div class="border-b border-border-card/40 pb-3">
        <h2
          class="text-xl md:text-2xl font-black text-text-main m-0 flex items-center gap-2"
        >
          <HiOutlineDocumentText className="text-primary text-2xl" />
          MPSC गट-क संयुक्त परीक्षा संबंधित महत्त्वाचे Updates
        </h2>
      </div>

      <div
        class="overflow-x-auto bg-bg-surface border border-border-card rounded-2xl shadow-xs"
      >
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-primary/10">
              <th
                class="p-3.5 border-b border-border-card font-bold text-text-main text-center w-16"
                >अ.क्र.</th
              >
              <th
                class="p-3.5 border-b border-border-card font-bold text-text-main"
                >महत्त्वाच्या लेखाचे नाव (Article Title)</th
              >
              <th
                class="p-3.5 border-b border-border-card font-bold text-text-main text-center w-36"
                >लिंक (View Link)</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-border-card/30">
            {
              updatesArticles.map((article, idx) => {
                const isNew = isNewArticle(article.publishedAt);
                return (
                  <tr
                    class={
                      isNew
                        ? "bg-rose-500/5 hover:bg-rose-500/10 transition-colors update-row"
                        : "hover:bg-primary/5 transition-colors update-row"
                    }
                    data-published={article.publishedAt}
                  >
                    <td
                      class={`p-2.5 sm:p-3.5 text-center font-bold text-xs sm:text-sm ${
                        isNew
                          ? "text-rose-600 dark:text-rose-400"
                          : "text-text-muted"
                      }`}
                    >
                      {idx + 1}
                    </td>
                    <td class="p-2.5 sm:p-3.5">
                      <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
                        <a
                          href={article.link}
                          class={`font-bold transition-colors text-xs sm:text-sm md:text-base leading-snug no-underline inline-flex items-center gap-1.5 update-title ${
                            isNew
                              ? "text-rose-600 dark:text-rose-400 font-black hover:text-rose-700"
                              : "text-text-main font-bold hover:text-primary"
                          }`}
                        >
                          <span>{article.title}</span>
                        </a>
                        {isNew && (
                          <span class="new-badge inline-flex items-center gap-1 px-2 py-0.5 bg-rose-600 text-white text-[0.6rem] sm:text-[0.65rem] font-black rounded-md uppercase tracking-wider shadow-xs animate-pulse">
                            NEW UPDATE
                          </span>
                        )}
                        {!isNew && article.isMega && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-violet-600 text-white text-[0.6rem] sm:text-[0.65rem] font-black rounded-md uppercase tracking-wider shadow-xs">
                            🔥 MEGA BHARTI
                          </span>
                        )}
                      </div>
                    </td>
                    <td class="p-2.5 sm:p-3.5 text-center">
                      <a
                        href={article.link}
                        class={`inline-flex items-center justify-center gap-1 px-2.5 py-1 sm:px-3.5 sm:py-1.5 text-[0.7rem] sm:text-xs font-bold rounded-lg transition-colors no-underline ${
                          isNew
                            ? "bg-rose-600 text-white hover:bg-rose-700 shadow-xs"
                            : "bg-primary/10 hover:bg-primary/20 text-primary"
                        }`}
                      >
                        <span>वाचा</span>
                        <HiOutlineArrowRight className="text-[0.65rem] sm:text-xs" />
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Vacancy Distribution Table -->
    <div
      class="bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-8 space-y-6 shadow-xs mb-10"
    >
      <div class="border-b border-border-card/40 pb-3">
        <h2
          class="text-xl font-black text-text-main m-0 border-l-4 border-primary pl-3"
        >
          MPSC गट-क पदनिहाय जागा तपशील (Vacancy Breakdown - 5,707 Posts)
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-primary/10">
              <th class="p-3.5 border border-border-card font-bold"
                >पदाचे नाव (Post Name)</th
              >
              <th class="p-3.5 border border-border-card font-bold text-center"
                >एकूण जागा</th
              >
              <th class="p-3.5 border border-border-card font-bold"
                >शैक्षणिक पात्रता</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-border-card/30">
            <tr>
              <td
                class="p-3.5 border border-border-card font-bold text-primary"
              >
                ग्राम महसूल अधिकारी (तलाठी / Gram Mahasul Adhikari)
              </td>
              <td
                class="p-3.5 border border-border-card font-black text-rose-500 text-center text-base"
              >
                १,५३९
              </td>
              <td
                class="p-3.5 border border-border-card text-text-muted text-xs"
              >
                कोणत्याही शाखेतील पदवी (Graduate in any discipline)
              </td>
            </tr>
            <tr>
              <td
                class="p-3.5 border border-border-card font-bold text-text-main"
              >
                लिपिक-टंकलेखक (Clerk-Typist)
              </td>
              <td
                class="p-3.5 border border-border-card font-black text-rose-500 text-center text-base"
              >
                ३,१९७
              </td>
              <td
                class="p-3.5 border border-border-card text-text-muted text-xs"
              >
                पदवी + मराठी/इंग्रजी टंकलेखन (Typing GCC-TBC certificate)
              </td>
            </tr>
            <tr>
              <td
                class="p-3.5 border border-border-card font-bold text-text-main"
              >
                कर सहाय्यक (Tax Assistant)
              </td>
              <td
                class="p-3.5 border border-border-card font-black text-rose-500 text-center text-base"
              >
                ४६८
              </td>
              <td
                class="p-3.5 border border-border-card text-text-muted text-xs"
              >
                पदवी + टंकलेखन प्रमाणपत्र
              </td>
            </tr>
            <tr>
              <td
                class="p-3.5 border border-border-card font-bold text-text-main"
              >
                दुय्यम निरीक्षक, राज्य उत्पादन शुल्क (Excise Sub Inspector)
              </td>
              <td
                class="p-3.5 border border-border-card font-black text-rose-500 text-center text-base"
              >
                १९०
              </td>
              <td
                class="p-3.5 border border-border-card text-text-muted text-xs"
              >
                पदवी + शारीरिक पात्रता
              </td>
            </tr>
            <tr>
              <td
                class="p-3.5 border border-border-card font-bold text-text-main"
              >
                तांत्रिक सहाय्यक, उद्योग व इतर पदे
              </td>
              <td
                class="p-3.5 border border-border-card font-black text-rose-500 text-center text-base"
              >
                ३१३
              </td>
              <td
                class="p-3.5 border border-border-card text-text-muted text-xs"
              >
                संबंधित शाखेतील पदवी / पदविका
              </td>
            </tr>
            <tr class="bg-primary/10">
              <td
                class="p-3.5 border border-border-card font-bold text-text-main text-right"
              >
                एकूण गट-क पदे (Total Group C Vacancies)
              </td>
              <td
                class="p-3.5 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-lg"
              >
                ५,७०७
              </td>
              <td
                class="p-3.5 border border-border-card font-bold text-primary text-xs"
              >
                MPSC Official Advertisement 2026
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Action Apply Container -->
    <div
      class="p-8 rounded-3xl bg-gradient-to-r from-primary/10 via-violet-500/10 to-primary/10 border border-primary/25 text-center space-y-4 shadow-sm"
    >
      <h2 class="text-2xl font-black text-text-main m-0">
        MPSC गट-क संयुक्त पूर्व परीक्षा २०२६ साठी ऑनलाईन अर्ज करा!
