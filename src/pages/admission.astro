---
import Layout from "../layouts/Layout.astro";
import { HiOutlineCalendarDays, HiOutlineArrowTopRightOnSquare, HiOutlineBell, HiOutlineBuildingOffice } from "react-icons/hi2";

const admissions = [
  {
    title: "MHT CET B.E. / B.Tech Counselling 2026: अभियांत्रिकी प्रथम वर्ष प्रवेश प्रक्रिया",
    organisation: "State Common Entrance Test Cell, Maharashtra",
    category: "Engineering",
    releaseDate: "25 June 2026",
    examDate: "12 July 2026",
    status: "open",
    link: "/mht-cet-counselling-registration-documents-2026"
  },
  {
    title: "Maharashtra ITI Admission 2026: महाराष्ट्र आयटीआय प्रवेश प्रक्रिया",
    organisation: "Directorate of Vocational Education and Training (DVET)",
    category: "Vocational",
    releaseDate: "21 May 2026",
    examDate: "21 June 2026",
    status: "upcoming",
    link: "/iti-admission-2026-maharashtra"
  }
];


---

<Layout title="College Admission 2026 - University Entrance Form & Counseling Schedule | MahaSandhi" description="Apply for college and university admissions 2026. Find DU, IIT JEE, NEET, CLAT, IIM, BITSAT, AIIMS entrance exam forms, counseling dates, and direct registration portals at mahasandhi.in.">
  <section class="pt-4 pb-16 not-prose">
    <h1 class="sr-only">Admissions</h1>

    <!-- Admissions List -->
    <div class="max-w-[1000px] mx-auto px-2 md:px-0">
      <div id="admissions-grid" class="flex flex-col gap-3 md:gap-4 transition-all duration-300">
        {admissions.map((card, index) => (
          <div
            data-title={card.title}
            data-org={card.organisation}
            data-category={card.category}
            class="group admission-item flex flex-col p-5 md:p-6 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-cyan-500 opacity-0 animate-[fadeInUp_0.6s_ease_forwards] gap-4"
            style={`animation-delay: ${index * 0.08}s`}
          >
            <!-- Top Section: Info Block (Full Width) -->
            <div class="w-full min-w-0">
              <div class="flex items-center gap-2 mb-2.5 flex-wrap">
                <span class="text-[0.65rem] bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-cyan-500/20 whitespace-nowrap">
                  {card.category}
                </span>

                {card.status === "open" && (
                  <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                    Apply Now
                  </span>
                )}

                {card.status === "upcoming" && (
                  <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                    Upcoming
                  </span>
                )}

                {card.status === "closed" && (
                  <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                    Closed
                  </span>
                )}
              </div>

              <a href={card.link} class="no-underline hover:no-underline block group-hover:text-primary">
                <h3 class="text-base sm:text-lg text-text-main font-bold leading-snug mb-2 group-hover:text-primary transition-colors">{card.title}</h3>
              </a>
              <div class="flex items-center gap-1.5 text-xs text-text-muted">
                <HiOutlineBuildingOffice className="shrink-0 text-xs text-cyan-500/70" />
                <span>{card.organisation}</span>
              </div>
            </div>

            <!-- Bottom Section: Dates & Action Buttons -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-3.5 border-t border-border-card/30 dark:border-border-card/10">
              <!-- Left side: Dates styled as non-clickable buttons -->
              <div class="flex flex-wrap gap-2.5 shrink-0">
                <div class="flex items-center gap-2 px-3.5 py-2 bg-emerald-500/5 border border-emerald-500/20 dark:border-emerald-500/30 rounded-xl text-[0.68rem] font-bold text-emerald-600 dark:text-emerald-400 cursor-default select-none">
                  <span class="text-[0.55rem] text-text-muted uppercase tracking-wider font-extrabold">Start:</span>
                  <HiOutlineCalendarDays className="text-emerald-500 text-base shrink-0" />
                  <span>{card.releaseDate}</span>
                </div>
                <div class="flex items-center gap-2 px-3.5 py-2 bg-rose-500/5 border border-rose-500/20 dark:border-rose-500/30 rounded-xl text-[0.68rem] font-bold text-rose-600 dark:text-rose-400 cursor-default select-none">
                  <span class="text-[0.55rem] text-text-muted uppercase tracking-wider font-extrabold">Last Date:</span>
                  <HiOutlineCalendarDays className="text-rose-500 text-base shrink-0" />
                  {card.extendedDate ? (
                    <span class="flex items-center gap-1">
                      <span class="line-through text-text-muted/70 font-medium">{card.examDate}</span>
                      <span class="text-rose-600 dark:text-rose-400 font-extrabold">{card.extendedDate}</span>
                    </span>
                  ) : (
                    <span class={card.status === "closed" ? "line-through text-text-muted/70 font-medium" : ""}>{card.examDate}</span>
                  )}
                </div>
              </div>

              <!-- Right side: CTA Buttons -->
              <div class="shrink-0 w-full sm:w-auto sm:min-w-[180px]">
                {card.status === "open" && (
                  <a
                    href={card.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full sm:w-auto btn-primary !bg-gradient-to-r !from-cyan-600 !to-teal-600 hover:!from-cyan-500 hover:!to-teal-500 !border-transparent !rounded-xl !py-2.5 flex items-center justify-center gap-2 group/btn text-[0.65rem] font-bold uppercase tracking-wider px-5 shadow-sm shadow-cyan-500/20"
                  >
                    <span>Register Online</span>
                    <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                  </a>
                )}

                {card.status === "upcoming" && (
                  <a
                    href={card.link}
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-amber-500/10 hover:bg-amber-500/20 border border-solid border-amber-500/30 text-amber-600 dark:text-amber-400 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl text-center no-underline transition-colors"
                  >
                    <HiOutlineBell className="text-xs text-amber-500 shrink-0 animate-bounce" />
                    <span>Read Details</span>
                  </a>
                )}

                {card.status === "closed" && (
                  <button
                    type="button"
                    disabled
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-rose-500/5 border border-solid border-rose-500/15 text-rose-500/60 dark:text-rose-400/60 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center"
                  >
                    <span>Admission Closed</span>
                  </button>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
