---
import Layout from "../layouts/Layout.astro";
import { HiOutlineMagnifyingGlass, HiOutlineAcademicCap, HiOutlineCalendarDays, HiOutlineArrowTopRightOnSquare, HiOutlineBell, HiOutlineBuildingOffice } from "react-icons/hi2";

const admissions = [
  {
    title: "Delhi University UG Admissions 2026",
    organisation: "University of Delhi",
    category: "University",
    releaseDate: "May 15, 2026",
    examDate: "June 30, 2026",
    status: "open",
    link: "https://du.ac.in"
  },
  {
    title: "IIT JEE Advanced Online Registration",
    organisation: "Indian Institute of Technology",
    category: "Engineering",
    releaseDate: "May 20, 2026",
    examDate: "June 07, 2026",
    status: "open",
    link: "https://jeeadv.ac.in"
  },
  {
    title: "JNU PG Admission Entrance Test",
    organisation: "Jawaharlal Nehru University",
    category: "University",
    releaseDate: "May 28, 2026",
    examDate: "June 15, 2026",
    status: "upcoming",
    link: "https://jnu.ac.in"
  },
  {
    title: "NEET UG Medical Entrance Counselling",
    organisation: "National Testing Agency",
    category: "Medical",
    releaseDate: "June 10, 2026",
    examDate: "June 28, 2026",
    status: "upcoming",
    link: "https://neet.nta.nic.in"
  },
  {
    title: "CLAT National Law Entrance Online Form",
    organisation: "Consortium of National Law Universities",
    category: "Law",
    releaseDate: "May 02, 2026",
    examDate: "May 25, 2026",
    status: "open",
    link: "https://consortiumofnlus.ac.in"
  },
  {
    title: "IIM Ahmedabad PGP Admission Round 1",
    organisation: "Indian Institute of Management",
    category: "Management",
    releaseDate: "April 28, 2026",
    examDate: "May 18, 2026",
    status: "closed",
    link: "https://iima.ac.in"
  },
  {
    title: "BITSAT Engineering Entrance Exam Form",
    organisation: "Birla Institute of Technology and Science",
    category: "Engineering",
    releaseDate: "May 12, 2026",
    examDate: "May 24, 2026",
    status: "open",
    link: "https://bitsadmission.com"
  },
  {
    title: "AIIMS B.Sc Nursing Admission Form",
    organisation: "All India Institute of Medical Sciences",
    category: "Medical",
    releaseDate: "May 18, 2026",
    examDate: "June 05, 2026",
    status: "open",
    link: "https://aiimsexams.ac.in"
  }
];

const categories = ["All", "University", "Engineering", "Medical", "Law", "Management"];
---

<Layout title="College Admission 2026 - University Entrance Form & Counseling Schedule | TechFixSteps" description="Apply for college and university admissions 2026. Find DU, IIT JEE, NEET, CLAT, IIM, BITSAT, AIIMS entrance exam forms, counseling dates, and direct registration portals at techfixsteps.com.">
  <section class="pt-4 pb-16 not-prose">
    <!-- Header Section -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 text-xs font-bold uppercase tracking-wider mb-2">
        <HiOutlineAcademicCap className="text-sm" /> Live Admissions & Counseling
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-2 tracking-tight text-text-main m-0">
        Admissions
      </h1>
      <p class="text-text-secondary text-[1.1rem] m-0 max-w-[600px] mx-auto">
        Stay updated with university entrances, live academic counseling, admission guidelines, and direct registration portals.
      </p>
    </div>

    <!-- Search & Filter Controls Panel (Sticky on scroll) -->
    <div id="sticky-search-wrapper" class="sticky top-[var(--navbar-height,124px)] z-30 transition-all duration-300 w-full mb-12 max-w-[1000px] mx-auto px-4 md:px-0">
      <div id="search-controls-panel" class="bg-bg-surface/95 backdrop-blur-md border border-border-card rounded-3xl p-6 md:p-8 shadow-sm transition-all duration-300">
        <!-- Search Input Container -->
        <div id="search-input-container" class="flex items-center w-full bg-cyan-500/5 border border-solid border-cyan-500/20 px-4 py-3 rounded-full transition-all duration-300 focus-within:border-cyan-500 focus-within:bg-cyan-500/10 focus-within:shadow-md focus-within:shadow-cyan-500/5 mb-6">
          <HiOutlineMagnifyingGlass className="text-cyan-600/70 mr-3 text-lg shrink-0" />
          <input 
            type="text" 
            id="admission-search" 
            placeholder="Search by college name, entrance exam, or course..." 
            class="w-full bg-transparent border-none text-text-main font-sans text-sm outline-none placeholder-cyan-600/50"
          />
        </div>

        <!-- Categories Pills -->
        <div id="categories-pills-container" class="flex flex-wrap justify-center gap-2">
          {categories.map((cat) => (
            <button
              type="button"
              data-target={cat === "All" ? "all" : cat}
              class={`filter-tab px-4 py-2 text-xs font-bold tracking-wide uppercase border border-solid rounded-full cursor-pointer transition-all duration-300 outline-none ${
                cat === "All"
                  ? "bg-gradient-to-r from-cyan-600 to-teal-600 text-white border-transparent active-tab shadow-sm shadow-cyan-500/20"
                  : "bg-cyan-500/5 text-cyan-600 dark:text-cyan-400 border-cyan-500/20 hover:bg-cyan-500/10 hover:text-cyan-700"
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Admissions List -->
    <div class="max-w-[1000px] mx-auto px-4 md:px-0">
      <div id="admissions-grid" class="flex flex-col gap-4 transition-all duration-300">
        {admissions.map((card, index) => (
          <div
            data-title={card.title}
            data-org={card.organisation}
            data-category={card.category}
            class="admission-item flex flex-col md:flex-row md:items-center justify-between p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-cyan-500 opacity-0 animate-[fadeInUp_0.6s_ease_forwards] gap-4"
            style={`animation-delay: ${index * 0.08}s`}
          >
            <!-- Left: Info Block -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class="text-[0.65rem] bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-cyan-500/20 whitespace-nowrap">
                  {card.category}
                </span>

                {card.status === "open" && (
                  <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                    Apply Now
                  </span>
                )}

                {card.status === "upcoming" && (
                  <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-amber-500 animate-pulse inline-block"></span>
                    Upcoming
                  </span>
                )}

                {card.status === "closed" && (
                  <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                    Closed
                  </span>
                )}
              </div>

              <h3 class="text-base text-text-main font-bold leading-tight mb-1 truncate">{card.title}</h3>
              <div class="flex items-center gap-1.5 text-xs text-text-muted">
                <HiOutlineBuildingOffice className="shrink-0 text-xs" />
                <span class="truncate">{card.organisation}</span>
              </div>
            </div>

            <!-- Middle: Dates (Counseling & Admission Deadline) -->
            <div class="flex flex-row gap-6 md:gap-8 shrink-0 py-2 md:py-0 border-y md:border-y-0 border-border-card dark:border-border-card/20 my-1 md:my-0">
              <div>
                <span class="block text-[0.6rem] text-text-muted uppercase tracking-wider mb-0.5">Start Date</span>
                <span class="flex items-center gap-1 text-xs font-bold text-text-main">
                  <HiOutlineCalendarDays className="text-cyan-500 text-xs shrink-0" /> {card.releaseDate}
                </span>
              </div>
              <div>
                <span class="block text-[0.6rem] text-text-muted uppercase tracking-wider mb-0.5">Last Date</span>
                <span class="flex items-center gap-1 text-xs font-bold text-text-main">
                  <HiOutlineCalendarDays className="text-cyan-500 text-xs shrink-0" /> {card.examDate}
                </span>
              </div>
            </div>

            <!-- Right: CTA Buttons -->
            <div class="shrink-0 w-full md:w-auto md:min-w-[180px]">
              {card.status === "open" && (
                <a
                  href={card.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full md:w-auto btn-primary !bg-gradient-to-r !from-cyan-600 !to-teal-600 hover:!from-cyan-500 hover:!to-teal-500 !border-transparent !rounded-xl !py-2 flex items-center justify-center gap-2 group/btn text-[0.65rem] font-bold uppercase tracking-wider px-5 shadow-sm shadow-cyan-500/20"
                >
                  <span>Register Online</span>
                  <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                </a>
              )}

              {card.status === "upcoming" && (
                <button
                  type="button"
                  disabled
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 bg-amber-500/10 border border-solid border-amber-500/20 text-amber-600 dark:text-amber-400 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center animate-pulse"
                >
                  <HiOutlineBell className="text-xs shrink-0" />
                  <span>Expected Soon</span>
                </button>
              )}

              {card.status === "closed" && (
                <button
                  type="button"
                  disabled
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 bg-rose-500/5 border border-solid border-rose-500/15 text-rose-500/60 dark:text-rose-400/60 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center"
                >
                  <span>Admission Closed</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Empty State -->
    <div id="no-results-message" class="hidden text-center py-16 px-4 bg-bg-surface border border-border-card rounded-2xl max-w-[500px] mx-auto mt-6">
      <HiOutlineAcademicCap className="text-4xl text-text-muted mx-auto mb-3" />
      <h3 class="text-lg font-bold text-text-main mb-1">No Admissions Found</h3>
      <p class="text-sm text-text-muted">
        We couldn't find any admission counseling matching your search query. Try another keyword or clear the search.
      </p>
    </div>

  </section>
</Layout>

<style is:global>
  /* Sticky Search Container Styles */
  #search-controls-panel.sticky-active {
    padding: 0.75rem 1rem !important;
    border-radius: 1.5rem !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
    border-color: rgba(6, 182, 212, 0.3) !important; /* cyan-500 border glow */
    background-color: var(--bg-surface-sticky, rgba(15, 23, 42, 0.95)) !important;
    backdrop-filter: blur(16px) !important;
  }

  #search-controls-panel.sticky-active #search-input-container {
    margin-bottom: 0.5rem !important;
    padding-top: 0.5rem !important;
    padding-bottom: 0.5rem !important;
  }

  /* Mobile Specific Search Div Customizations (Hide tags on mobile) */
  @media (max-width: 768px) {
    #search-controls-panel {
      padding: 1rem !important;
      border-radius: 1.5rem !important;
    }
    #categories-pills-container {
      display: none !important;
    }
    #search-controls-panel #search-input-container {
      margin-bottom: 0 !important;
    }
    #search-controls-panel.sticky-active #search-input-container {
      margin-bottom: 0 !important;
    }
  }
</style>

<script>
  let currentCategory = 'all';
  let searchQuery = '';
  let scrollListener: (() => void) | null = null;

  function initFilters() {
    const searchInput = document.getElementById('admission-search') as HTMLInputElement;
    const tabButtons = document.querySelectorAll('.filter-tab');
    const cardItems = document.querySelectorAll('.admission-item') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results-message');

    // Remove previous scroll listener to prevent double registration on Astro navigation
    if (scrollListener) {
      window.removeEventListener('scroll', scrollListener);
    }

    // Sticky Scroll Handler
    const searchWrapper = document.getElementById('sticky-search-wrapper');
    const searchPanel = document.getElementById('search-controls-panel');

    if (searchWrapper && searchPanel) {
      scrollListener = () => {
        const rect = searchWrapper.getBoundingClientRect();
        const computedNavbarHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--navbar-height')) || (window.innerWidth < 1024 ? 124 : 154);
        
        if (rect.top <= computedNavbarHeight + 2) {
          searchPanel.classList.add('sticky-active');
        } else {
          searchPanel.classList.remove('sticky-active');
        }
      };

      window.addEventListener('scroll', scrollListener);
      scrollListener(); // Run initially
    }

    function filterCards() {
      let visibleCount = 0;
      cardItems.forEach((card) => {
        const title = card.getAttribute('data-title')?.toLowerCase() || '';
        const org = card.getAttribute('data-org')?.toLowerCase() || '';
        const category = card.getAttribute('data-category')?.toLowerCase() || '';

        const matchesSearch = title.includes(searchQuery) || org.includes(searchQuery);
        const matchesCategory = currentCategory === 'all' || category === currentCategory;

        if (matchesSearch && matchesCategory) {
          card.style.display = '';
          // Trigger smooth fade-in
          setTimeout(() => {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          }, 20);
          visibleCount++;
        } else {
          card.style.opacity = '0';
          card.style.transform = 'translateY(10px)';
          card.style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterCards();
    });

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => {
          b.classList.remove('bg-gradient-to-r', 'from-cyan-600', 'to-teal-600', 'text-white', 'border-transparent', 'active-tab', 'shadow-sm', 'shadow-cyan-500/20');
          b.classList.add('bg-cyan-500/5', 'text-cyan-600', 'dark:text-cyan-400', 'border-cyan-500/20');
        });

        btn.classList.add('bg-gradient-to-r', 'from-cyan-600', 'to-teal-600', 'text-white', 'border-transparent', 'active-tab', 'shadow-sm', 'shadow-cyan-500/20');
        btn.classList.remove('bg-cyan-500/5', 'text-cyan-600', 'dark:text-cyan-400', 'border-cyan-500/20');

        currentCategory = btn.getAttribute('data-target')?.toLowerCase() || 'all';
        filterCards();
      });
    });

    filterCards();
  }

  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
