---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineCheckCircle,
  HiOutlineArrowDownTray,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineIdentification,
  HiOutlineBell,
  HiOutlineUserCircle,
  HiOutlineMegaphone,
  HiOutlineCalculator,
} from "react-icons/hi2";

const title =
  "बॉम्बे उच्च न्यायालय लिपिक हॉल तिकीट २०२६: टंकलेखक चाचणी प्रवेशपत्र  उपलब्ध (BHC Clerk Admit Card)";
const description =
  "Bombay High Court BHC Clerk Admit Card 2026: बॉम्बे उच्च न्यायालय (Bombay High Court) लिपिक टंकलेखक (Clerk / Typing Test) चाचणी परीक्षेचे प्रवेशपत्र / हॉल तिकीट ऑनलाईन प्रसिद्ध करण्यात आले आहे. 👉 लिपिक हॉल तिकीट डाउनलोड करण्यासाठी खालील लिंकवर क्लिक करा 👇👇👇";
const canonicalURL = "https://mahasandhi.in/bhc-clerk-admit-card-2026";
const date = "August 15, 2026";
const category = "Admit Card";
const imageUrl =
  "https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&q=80&w=1200";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  image={imageUrl}
  article={true}
  customBreadcrumbs={[
    { name: "Admit Card", url: "/admit-card" },
    { name: "BHC Clerk Admit Card 2026" },
  ]}
>
  <article class="py-8">
    <!-- Header Banner & Category -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span
          class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-emerald-500/20 flex items-center gap-1.5"
        >
          <HiOutlineBell className="text-sm shrink-0 animate-pulse" />
          {category}
        </span>
        <span class="text-text-muted text-xs font-semibold">• {date}</span>
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20"
        >
          हॉल तिकीट उपलब्ध (Hall Ticket Out)
        </span>
      </div>

      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>

      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-emerald-500 pl-6 py-2 italic bg-emerald-500/5 rounded-r-xl"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी माहिती (Marathi)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2
          id="main-keyword-mr"
          class="text-xl md:text-2xl font-black text-text-main mt-2"
        >
          बॉम्बे उच्च न्यायालय (BHC) लिपिक टंकलेखक चाचणी परीक्षा २०२६ -
          प्रवेशपत्र ऑनलाईन जाहीर!
        </h2>

        <!-- Introduction -->
        <div class="mb-6 space-y-4">
          <p>
            <strong>Bombay High Court BHC Clerk Admit Card 2026:</strong> बॉम्बे उच्च
            न्यायालय (Bombay High Court, Mumbai) द्वारे आयोजित करण्यात आलेल्या <strong
              >लिपिक (Clerk / Typing Test)</strong
            > परीक्षेचे अधिकृत प्रवेशपत्र / हॉल तिकीट प्रसिद्ध करण्यात आले आहे.
          </p>
          <p
            class="font-bold text-primary text-base sm:text-lg bg-primary/5 p-4 rounded-2xl border border-primary/20"
