            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >उच्च न्यायालय / संस्था</span
              >
              <span class="text-text-main font-bold text-sm"
                >बॉम्बे उच्च न्यायालय (BHC)</span
