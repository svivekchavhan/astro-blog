---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import {
  HiOutlineHome,
  HiOutlineExclamationTriangle,
  HiOutlineAcademicCap,
  HiOutlineDocumentMagnifyingGlass,
} from "react-icons/hi2";

Astro.response.status = 404;
Astro.response.statusText = "Not Found";

const title = "404 - Page or Article Not Found | MahaSandhi";
const description =
  "४०४ - तुम्ही शोधत असलेले पान किंवा लेख सापडला नाही. The page or article you are looking for could not be found on MahaSandhi.";
---

<Layout title={title} description={description}>
  <section
    class="min-h-[65vh] py-12 sm:py-16 flex items-center justify-center not-prose"
  >
    <div class="max-w-[600px] w-full text-center px-4 sm:px-6">
      <!-- Icon & Error Code Flex Column -->
      <div class="flex flex-col items-center justify-center gap-4 mb-6">
        <div
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-rose-500/10 text-rose-500 border border-rose-500/20 shadow-sm animate-pulse flex items-center justify-center"
        >
          <HiOutlineExclamationTriangle className="text-4xl sm:text-5xl" />
        </div>

        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 bg-rose-500/10 text-rose-600 dark:text-rose-400 font-extrabold text-xs uppercase tracking-wider rounded-full border border-rose-500/20"
        >
          <span>404 ERROR</span>
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500/50"></span>
          <span>पान किंवा लेख सापडला नाही</span>
        </div>
      </div>

      <h1
        class="text-6xl sm:text-7xl md:text-8xl font-black tracking-tight text-text-main m-0 leading-none"
      >
        <span class="gradient-text">404</span>
      </h1>

      <h2 class="text-xl sm:text-2xl font-bold text-text-main mt-4 mb-2">
        Page or Article Not Found
      </h2>

      <p
        class="text-text-muted text-xs sm:text-sm font-semibold mb-4 text-primary"
      >
        ४०४ - तुम्ही शोधत असलेले पान किंवा लेख उपलब्ध नाही.
      </p>

      <p
        class="text-text-secondary text-sm md:text-base leading-relaxed m-0 mb-8 max-w-lg mx-auto"
      >
        The article or page you followed may have been removed, renamed, or is
        temporarily unavailable. Please check the URL or return to the main
        pages below.
      </p>

      <!-- Action Buttons Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 max-w-md mx-auto">
        <a
          href="/"
          class="btn-primary flex items-center justify-center gap-2 text-sm py-3 px-5 no-underline font-bold rounded-xl shadow-xs"
        >
          <HiOutlineHome className="text-lg shrink-0" />
          <span>मुख्यपृष्ठ (Home)</span>
        </a>

        <a
          href="/mpsc"
          class="flex items-center justify-center gap-2 py-3 px-5 border border-border-card text-text-main hover:text-primary hover:border-primary rounded-xl text-sm font-bold transition-all duration-300 bg-bg-surface hover:bg-primary/5 no-underline shadow-xs"
        >
          <HiOutlineAcademicCap className="text-lg shrink-0 text-primary" />
          <span>MPSC परीक्षा</span>
        </a>

        <a
          href="/blog"
          class="flex items-center justify-center gap-2 py-3 px-5 border border-border-card text-text-main hover:text-primary hover:border-primary rounded-xl text-sm font-bold transition-all duration-300 bg-bg-surface hover:bg-primary/5 no-underline shadow-xs"
        >
          <HiOutlineDocumentMagnifyingGlass
            className="text-lg shrink-0 text-primary"
          />
          <span>सर्व लेख (All Articles)</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
