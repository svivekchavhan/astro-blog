---
import Layout from "../../layouts/Layout.astro";
import { 
  QUALIFICATION_OPTIONS, 
  SECTOR_OPTIONS, 
  getPostsForSlug, 
  getFilterOptionBySlug 
} from "../../constants/jobFilterData";
import { 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineBell, 
  HiOutlineXCircle, 
  HiOutlineBuildingOffice, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase,
  HiOutlineMagnifyingGlass
} from "react-icons/hi2";

export function getStaticPaths() {
  const allSlugs = [...QUALIFICATION_OPTIONS, ...SECTOR_OPTIONS]
    .map((opt) => opt.slug)
    .filter((slug) => slug !== "all");

  return allSlugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const optionMeta = getFilterOptionBySlug(slug || "") || {
  slug: slug || "",
  nameMr: `${slug} भरती नोकरी जाहिराती`,
  nameEn: `${slug?.toUpperCase()} Jobs 2026`,
  type: "qualification" as const,
  icon: "💼"
};

const categoryJobs = getPostsForSlug(slug || "");

function getCountdownInfo(lastDateStr: string, extendedDateStr?: string) {
  const dateStr = extendedDateStr || lastDateStr;
  if (!dateStr || dateStr.toLowerCase().includes("soon") || dateStr.includes("365")) {
    return { days: 30, text: "Active", isExpired: false };
  }
  const parsedDate = new Date(dateStr);
  if (isNaN(parsedDate.getTime())) {
    return { days: 30, text: "Active", isExpired: false };
  }
  const today = new Date(2026, 7, 29);
  parsedDate.setHours(23, 59, 59, 999);
  today.setHours(0, 0, 0, 0);
  const diffTime = parsedDate.getTime() - today.getTime();
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  if (diffDays < 0) return { days: 0, text: "0", isExpired: true };
  if (diffDays === 0) return { days: 0, text: "Today", isExpired: false };
  return { days: diffDays, text: `${diffDays}`, isExpired: false };
}

const pageTitle = `${optionMeta.nameEn} (सरकारी नोकऱ्या २०२६) - MahaSandhi`;
const pageDesc = `Find all active ${optionMeta.nameEn} government recruitment notifications, eligibility, last date & online application links at mahasandhi.in.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <section class="pt-4 pb-16 not-prose">
    <!-- Category Header Section -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-2">
        <span class="text-base">{optionMeta.icon}</span> Category / Qualification Hub
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-2 tracking-tight text-text-main m-0">
        {optionMeta.nameMr}
      </h1>
      <p class="text-text-secondary text-sm md:text-base m-0 max-w-[650px] mx-auto">
        Showing all current Sarkari Naukri job notifications matching <strong class="text-primary">{optionMeta.nameEn}</strong>.
      </p>
    </div>

    <!-- Live Search Input & Jobs Counter Row -->
    <div class="max-w-[1000px] mx-auto mb-6 px-2 md:px-0">
      <div class="bg-bg-surface border border-border-card rounded-2xl p-4 sm:p-5 shadow-xs">
        <div class="flex flex-col sm:flex-row items-center gap-3">
          <div class="relative flex-1 w-full flex items-center bg-bg-base/60 dark:bg-black/20 border border-border-card rounded-xl px-3.5 py-2.5 focus-within:border-primary transition-colors">
            <HiOutlineMagnifyingGlass className="text-primary text-lg mr-2.5 shrink-0" />
            <input
              type="text"
              id="category-search-input"
              placeholder={`Search within ${optionMeta.nameEn} jobs...`}
              class="bg-transparent border-none text-text-main text-xs sm:text-sm font-medium outline-none w-full placeholder-text-muted/70"
            />
          </div>

          <div class="shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-primary/10 border border-primary/20 text-primary text-xs font-bold whitespace-nowrap">
            <span id="cat-filtered-count">{categoryJobs.length}</span> Jobs Found
          </div>
        </div>
      </div>
    </div>

    <!-- Jobs Grid -->
    <div class="max-w-[1000px] mx-auto px-2 md:px-0">
      <div id="category-jobs-grid" class="flex flex-col gap-3 md:gap-4 transition-all duration-300">
        {categoryJobs.length === 0 ? (
          <div class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl">
            <p class="text-text-muted text-sm m-0">No active job announcements found for this qualification/category. Please check back later!</p>
          </div>
        ) : (
          categoryJobs.map((job) => {
            const countdown = getCountdownInfo(job.lastDate, job.extendedDate);
            return (
              <div
                data-title={job.title.toLowerCase()}
                data-org={job.organisation.toLowerCase()}
                data-qual={job.qualification.toLowerCase()}
                data-category={job.category.toLowerCase()}
                class="group category-job-item flex flex-row items-center justify-between p-3.5 md:p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-primary gap-3 md:gap-5"
              >
                <!-- Left: Info Block -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2 flex-wrap">
                    <span class="text-[0.65rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                      {job.category}
                    </span>

                    {job.status === "apply-now" && !countdown.isExpired && (
                      <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                        <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                        Apply Now
                      </span>
                    )}

                    {(job.status === "closed" || countdown.isExpired) && (
                      <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                        <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                        Closed
                      </span>
                    )}
                  </div>

                  <a href={job.link} class="no-underline hover:no-underline block">
                    <h3 class="text-base text-text-main font-bold leading-tight mb-1.5 group-hover:text-primary transition-colors">{job.title}</h3>
                  </a>
                  
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-text-muted mb-3">
                    <div class="flex items-center gap-1.5 min-w-0">
                      <HiOutlineBuildingOffice className="shrink-0 text-xs text-primary/70" />
                      <span class="truncate">{job.organisation}</span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <HiOutlineAcademicCap className="text-xs text-primary/70" />
                      <span>{job.qualification}</span>
                    </div>
                  </div>

                  <div class="flex flex-wrap items-center gap-2 pt-1">
                    <span class="text-[0.65rem] font-bold bg-primary/5 text-primary border border-solid border-primary/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                      Total Posts: <strong class="text-primary font-extrabold">{job.vacancies}</strong>
                    </span>
                    
                    <span class="text-border-card dark:text-border-card/30 hidden sm:inline">|</span>
                    
                    <span class="flex items-center gap-1 text-[0.65rem] font-bold bg-rose-500/5 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                      <HiOutlineCalendarDays className="text-rose-500 text-xs shrink-0" /> Last Date: 
                      {job.extendedDate ? (
                        <strong class="flex items-center gap-1.5 font-bold">
                          <span class="line-through text-text-muted/70 font-medium">{job.lastDate}</span>
                          <span class="text-rose-600 dark:text-rose-400 font-extrabold">{job.extendedDate}</span>
                        </strong>
                      ) : (
                        <strong class={`font-extrabold ${(job.status === "closed" || countdown.isExpired) ? "line-through text-text-muted/70" : ""}`}>{job.lastDate}</strong>
                      )}
                    </span>

                    {job.status === "apply-now" && !countdown.isExpired && (
                      <a
                        href={job.link}
                        class="inline-flex items-center gap-1 px-3 py-1 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-[0.68rem] font-extrabold uppercase tracking-wider transition-all shadow-2xs hover:shadow-xs group/btn no-underline shrink-0"
                      >
                        <span>Apply Online</span>
                        <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                      </a>
                    )}
                  </div>
                </div>

                <!-- Right: Countdown Badge -->
                <div class="shrink-0 flex items-center justify-center p-1">
                  <div
                    class:list={[
                      "w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex flex-col items-center justify-center p-1.5 text-center shadow-2xs border transition-all shrink-0 select-none group-hover:scale-105",
                      countdown.isExpired
                        ? "bg-rose-500/10 border-rose-500/30 text-rose-500"
                        : countdown.days <= 5
                        ? "bg-amber-500/10 border-amber-500/40 text-amber-500 animate-pulse"
                        : "bg-violet-500/10 border-violet-500/30 text-violet-600 dark:text-violet-400"
                    ]}
                  >
                    {countdown.isExpired ? (
                      <>
                        <span class="text-xs sm:text-sm font-black uppercase tracking-tight leading-none text-rose-500">0</span>
                        <span class="text-[0.5rem] font-black uppercase tracking-wider text-rose-500/80 leading-tight mt-1">Days Left</span>
                      </>
                    ) : (
                      <>
                        <span class="text-base sm:text-lg font-black tracking-tight leading-none">{countdown.text}</span>
                        <span class="text-[0.52rem] font-extrabold uppercase tracking-wider text-text-muted leading-tight mt-1">Days Left</span>
                      </>
                    )}
                  </div>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  function initCategorySearch() {
    const searchInput = document.getElementById("category-search-input") as HTMLInputElement;
    const items = document.querySelectorAll(".category-job-item") as NodeListOf<HTMLDivElement>;
    const countBadge = document.getElementById("cat-filtered-count");

    if (!searchInput || items.length === 0) return;

    searchInput.addEventListener("input", (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visible = 0;

      items.forEach((item) => {
        const title = item.getAttribute("data-title") || "";
        const org = item.getAttribute("data-org") || "";
        const qual = item.getAttribute("data-qual") || "";
        const category = item.getAttribute("data-category") || "";

        if (!q || title.includes(q) || org.includes(q) || qual.includes(q) || category.includes(q)) {
          item.classList.remove("hidden");
          item.classList.add("flex");
          visible++;
        } else {
          item.classList.add("hidden");
          item.classList.remove("flex");
        }
      });

      if (countBadge) countBadge.textContent = visible.toString();
    });
  }

  document.addEventListener("astro:page-load", initCategorySearch);
</script>
