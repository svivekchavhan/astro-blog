---
import Layout from "../../layouts/Layout.astro";
import { 
  QUALIFICATION_OPTIONS, 
  SECTOR_OPTIONS, 
  getPostsForSlug, 
  getFilterOptionBySlug 
} from "../../constants/jobFilterData";
import { 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineBell, 
  HiOutlineXCircle, 
  HiOutlineBuildingOffice, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase,
  HiOutlineMagnifyingGlass
} from "react-icons/hi2";
import { getCountdownInfo } from "../../utils/dateUtils";

export function getStaticPaths() {
  const allSlugs = [...QUALIFICATION_OPTIONS, ...SECTOR_OPTIONS]
    .map((opt) => opt.slug)
    .filter((slug) => slug !== "all");

  return allSlugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const optionMeta = getFilterOptionBySlug(slug || "") || {
  slug: slug || "",
  nameMr: `${slug} भरती नोकरी जाहिराती`,
  nameEn: `${slug?.toUpperCase()} Jobs 2026`,
  type: "qualification" as const,
  icon: "💼"
};

const categoryJobs = getPostsForSlug(slug || "");

const pageTitle = `${optionMeta.nameEn} (सरकारी नोकऱ्या २०२६) - MahaSandhi`;
const pageDesc = `Find all active ${optionMeta.nameEn} government recruitment notifications, eligibility, last date & online application links at mahasandhi.in.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <section class="pt-4 pb-16 not-prose">
    <!-- Category Header Section -->
    <div class="text-center mb-6 sm:mb-8 px-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-2.5 shadow-2xs">
        <span class="text-base">{optionMeta.icon}</span> Category / Qualification Hub
      </div>
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold mb-2 tracking-tight text-text-main m-0 leading-tight">
        {optionMeta.nameMr}
      </h1>
      <p class="text-text-secondary text-xs sm:text-base m-0 max-w-[650px] mx-auto font-medium leading-relaxed">
        Showing all current Sarkari Naukri job notifications matching <strong class="text-primary">{optionMeta.nameEn}</strong>.
      </p>
    </div>

    <!-- Live Search Input & Jobs Counter Row -->
    <div class="max-w-[1000px] mx-auto mb-6 px-4 md:px-0">
      <div class="bg-bg-surface border border-border-card rounded-2xl p-3.5 sm:p-5 shadow-xs">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <div class="relative flex-1 w-full flex items-center bg-bg-base/60 dark:bg-black/20 border border-border-card rounded-xl px-3.5 py-2.5 focus-within:border-primary transition-colors">
            <HiOutlineMagnifyingGlass className="text-primary text-base sm:text-lg mr-2.5 shrink-0" />
            <input
              type="text"
              id="category-search-input"
              placeholder={`Search within ${optionMeta.nameEn} jobs...`}
              class="bg-transparent border-none text-text-main text-xs sm:text-sm font-medium outline-none w-full placeholder-text-muted/70"
            />
          </div>

          <div class="shrink-0 flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-primary/10 border border-primary/20 text-primary text-xs font-bold whitespace-nowrap">
            <span id="cat-filtered-count">{categoryJobs.length}</span> Jobs Found
          </div>
        </div>
      </div>
    </div>

    <!-- Jobs Grid -->
    <div class="max-w-[1000px] mx-auto px-4 md:px-0">
      <div id="category-jobs-grid" class="flex flex-col gap-3.5 md:gap-4 transition-all duration-300">
        {categoryJobs.length === 0 ? (
          <div class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl">
            <p class="text-text-muted text-sm m-0">No active job announcements found for this qualification/category. Please check back later!</p>
          </div>
        ) : (
          categoryJobs.map((job) => {
            const countdown = getCountdownInfo(job.lastDate, job.extendedDate);
            return (
              <div
                data-title={job.title.toLowerCase()}
                data-org={job.organisation.toLowerCase()}
                data-qual={job.qualification.toLowerCase()}
                data-category={job.category.toLowerCase()}
                class="group category-job-item flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 sm:p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-primary gap-3.5 sm:gap-5"
              >
                <!-- Left: Info Block -->
                <div class="flex-1 min-w-0 w-full space-y-2.5">
                  <!-- Badges Top Row (Mobile & Desktop) -->
                  <div class="flex items-start justify-between gap-2 w-full">
                    <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                      <span class="text-[0.65rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                        {job.category}
                      </span>

                      {!countdown.isExpired && countdown.status === "apply-now" && (
                        <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                          Apply Now
                        </span>
                      )}

                      {countdown.status === "upcoming" && (
                        <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                          <span class="w-1.5 h-1.5 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                          Notice
                        </span>
                      )}

                      {countdown.isExpired && (
                        <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                          <span class="w-1.5 h-1.5 bg-rose-500 rounded-full inline-block"></span>
                          Closed
                        </span>
                      )}
                    </div>

                    <!-- Mobile Countdown Badge (top right for screens < 640px) -->
                    <div class="sm:hidden shrink-0">
                      <div
                        class:list={[
                          "px-2 py-0.5 rounded-lg flex items-center gap-1 text-[0.62rem] font-extrabold border select-none whitespace-nowrap",
                          countdown.isExpired
                            ? "bg-rose-500/10 border-rose-500/30 text-rose-500"
                            : countdown.days <= 5
                            ? "bg-amber-500/10 border-amber-500/40 text-amber-500 animate-pulse"
                            : "bg-violet-500/10 border-violet-500/30 text-violet-600 dark:text-violet-400"
                        ]}
                      >
                        {countdown.isExpired ? (
                          <span>Closed</span>
                        ) : (
                          <span>{countdown.text} {typeof countdown.days === "number" && countdown.days < 300 ? "d Left" : "Active"}</span>
                        )}
                      </div>
                    </div>
                  </div>

                  <!-- Title Link -->
                  <a href={job.link} class="no-underline hover:no-underline block">
                    <h3 class="text-base sm:text-lg text-text-main font-bold leading-snug m-0 group-hover:text-primary transition-colors break-words">{job.title}</h3>
                  </a>
                  
                  <!-- Metadata Icons Row -->
                  <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4 text-xs text-text-muted">
                    <div class="flex items-start sm:items-center gap-1.5 min-w-0">
                      <HiOutlineBuildingOffice className="shrink-0 text-xs text-primary/70 mt-0.5 sm:mt-0" />
                      <span class="font-semibold text-text-main/90 break-words">{job.organisation}</span>
                    </div>
                    <div class="flex items-start sm:items-center gap-1.5 shrink-0">
                      <HiOutlineAcademicCap className="shrink-0 text-xs text-primary/70 mt-0.5 sm:mt-0" />
                      <span class="break-words">{job.qualification}</span>
                    </div>
                  </div>

                  <!-- Bottom Meta & Actions Row -->
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-border-card/40 sm:border-t-0 sm:pt-1 w-full">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="inline-flex items-center text-[0.68rem] font-bold bg-primary/5 text-primary border border-solid border-primary/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                        Total Posts: <strong class="ml-1 text-primary font-extrabold">{job.vacancies}</strong>
                      </span>
                      
                      <span class="inline-flex items-center gap-1 text-[0.68rem] font-bold bg-rose-500/5 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                        <HiOutlineCalendarDays className="text-rose-500 text-xs shrink-0" /> Last Date: 
                        {job.extendedDate ? (
                          <strong class="flex items-center gap-1 font-bold ml-1">
                            <span class="line-through text-text-muted/70 font-medium">{job.lastDate}</span>
                            <span class="text-rose-600 dark:text-rose-400 font-extrabold">{job.extendedDate}</span>
                          </strong>
                        ) : (
                          <strong class={`ml-1 font-extrabold ${countdown.isExpired ? "line-through text-text-muted/70" : ""}`}>{job.lastDate}</strong>
                        )}
                      </span>
                    </div>

                    {!countdown.isExpired && countdown.status === "apply-now" && (
                      <a
                        href={job.link}
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2.5 sm:py-1.5 bg-violet-600 hover:bg-violet-700 active:bg-violet-800 text-white rounded-xl text-xs font-extrabold uppercase tracking-wider transition-all shadow-2xs hover:shadow-xs group/btn no-underline shrink-0"
                      >
                        <span>Apply Online</span>
                        <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                      </a>
                    )}
                  </div>
                </div>

                <!-- Right: Desktop Countdown Badge (hidden on mobile) -->
                <div class="hidden sm:flex shrink-0 items-center justify-center p-1">
                  <div
                    class:list={[
                      "w-16 h-16 rounded-2xl flex flex-col items-center justify-center p-1.5 text-center shadow-2xs border transition-all shrink-0 select-none group-hover:scale-105",
                      countdown.isExpired
                        ? "bg-rose-500/10 border-rose-500/30 text-rose-500"
                        : countdown.days <= 5
                        ? "bg-amber-500/10 border-amber-500/40 text-amber-500 animate-pulse"
                        : "bg-violet-500/10 border-violet-500/30 text-violet-600 dark:text-violet-400"
                    ]}
                    title={countdown.isExpired ? "Application Closed" : `${countdown.days} Days Remaining`}
                  >
                    {countdown.isExpired ? (
                      <>
                        <HiOutlineXCircle className="text-2xl text-rose-500 shrink-0" />
                        <span class="text-[0.6rem] font-black uppercase tracking-wider text-rose-500 leading-tight mt-0.5">Closed</span>
                      </>
                    ) : (
                      <>
                        <span class="text-lg font-black tracking-tight leading-none">{countdown.text}</span>
                        <span class="text-[0.52rem] font-extrabold uppercase tracking-wider text-text-muted leading-tight mt-1">
                          {typeof countdown.days === "number" && countdown.days < 300 ? "Days Left" : "Active"}
                        </span>
                      </>
                    )}
                  </div>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  function initCategorySearch() {
    const searchInput = document.getElementById("category-search-input") as HTMLInputElement;
    const items = document.querySelectorAll(".category-job-item") as NodeListOf<HTMLDivElement>;
    const countBadge = document.getElementById("cat-filtered-count");

    if (!searchInput || items.length === 0) return;

    searchInput.addEventListener("input", (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visible = 0;

      items.forEach((item) => {
        const title = item.getAttribute("data-title") || "";
        const org = item.getAttribute("data-org") || "";
        const qual = item.getAttribute("data-qual") || "";
        const category = item.getAttribute("data-category") || "";

        if (!q || title.includes(q) || org.includes(q) || qual.includes(q) || category.includes(q)) {
          item.classList.remove("hidden");
          item.classList.add("flex");
          visible++;
        } else {
          item.classList.add("hidden");
          item.classList.remove("flex");
        }
      });

      if (countBadge) countBadge.textContent = visible.toString();
    });
  }

  document.addEventListener("astro:page-load", initCategorySearch);
</script>
