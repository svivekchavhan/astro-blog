---
import Layout from "../../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineBell, 
  HiOutlineXCircle, 
  HiOutlineBuildingOffice, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase 
} from "react-icons/hi2";

const bankJobs: any[] = [
  {
    category: "Bank Job",
    status: "apply-now",
    title: "बँक ऑफ बडोदा मध्ये 'लोकल बँक ऑफिसर' २५०० जागांसाठी भरती २०२५: ऑनलाईन अर्ज सुरू (BOB LBO Bharti)",
    link: "/bank-of-baroda-lbo-recruitment-2025",
    organisation: "Bank of Baroda (BOB)",
    qualification: "Degree in any discipline + 1 Year Officer Experience",
    vacancies: "2,500",
    lastDate: "07 Sep 2026"
  },
  {
    category: "Bank Job",
    status: "apply-now",
    title: "सांगली जिल्हा मध्यवर्ती बँक शिपाई पदभरती २०२६: ७९ जागांसाठी जाहिरात प्रसिद्ध",
    link: "/sangli-dcc-bank-peon-bharti-2026",
    organisation: "Sangli District Central Cooperative Bank Ltd (Sangli DCCB)",
    qualification: "12th Pass (HSC)",
    vacancies: "79",
    lastDate: "21 Aug 2026"
  },
  {
    category: "Bank Job",
    status: "apply-now",
    title: "भारतीय स्टेट बँकेत (SBI) लिपिक (Junior Associate) १५३८ जागांसाठी भरती २०२६",
    link: "/sbi-clerk-recruitment-2026",
    organisation: "State Bank of India (SBI)",
    qualification: "Degree in any discipline",
    vacancies: "1,538",
    lastDate: "27 Aug 2026"
  },
  {
    category: "Bank Job",
    status: "apply-now",
    title: "पुणे जिल्हा मध्यवर्ती सहकारी बँक भरती २०२६: शिपाई २८९ पदांची सरळसेवा भरती जाहिरात प्रसिद्ध",
    link: "/pdcc-bank-peon-bharti-2026",
    organisation: "Pune District Central Cooperative Bank Ltd (PDCC)",
    qualification: "12th Pass (HSC) / Diploma",
    vacancies: "289",
    lastDate: "10 Aug 2026"
  },
  {
    category: "Bank Job",
    status: "apply-now",
    title: "लातूर जिल्हा मध्यवर्ती बँक भरती २०२६: ३७५ पदांची सुधारीत प्रतीक्षा यादी प्रसिद्ध",
    link: "/latur-dcc-bank-revised-waiting-list-2026",
    organisation: "Latur District Central Cooperative Bank Ltd. (Latur DCCB)",
    qualification: "Graduate / 10th / 12th / Driver",
    vacancies: "375 (20% Waiting List)",
    lastDate: "Valid for 365 Days"
  }
];
---

<Layout title="Bank Recruitment 2026 - Latest Bank Jobs & Exam Notifications | MahaSandhi" description="Explore the latest bank recruitment notifications 2026. Find active job openings in SBI, IBPS, RBI, HDFC, ICICI, and other public & private sector banks with qualifications, vacancies, and direct apply links at mahasandhi.in.">
  <section class="pt-4 pb-16 not-prose">
    <!-- Header Section -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-2">
        <HiOutlineBriefcase className="text-sm" /> Bank Careers
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-2 tracking-tight text-text-main m-0">
        Bank Recruitment
      </h1>
      <p class="text-text-secondary text-[1.1rem] m-0 max-w-[600px] mx-auto mb-4">
        Find job notifications, exam schedules, eligibility criteria, and direct application links for major public & private banks in India.
      </p>
      <a 
        href="/sbi-recruitment"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-600 dark:text-sky-400 text-xs font-bold uppercase tracking-wider hover:bg-sky-500/20 transition-all no-underline"
      >
        <HiOutlineBuildingOffice className="text-sm shrink-0" /> SBI Recruitment Hub (SBI जाहिराती व सर्व अपडेट्स) →
      </a>
    </div>

    <!-- Bank Jobs List -->
    <div class="max-w-[1000px] mx-auto px-2 md:px-0">
      <div id="jobs-grid" class="flex flex-col gap-3 md:gap-4 transition-all duration-300">
        {bankJobs.length === 0 ? (
          <div class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl">
            <p class="text-text-muted text-sm m-0">No active bank job announcements at the moment. Please check back later!</p>
          </div>
        ) : (
          bankJobs.map((job, index) => (
            <div
              class="group job-card-item flex flex-col md:flex-row md:items-center justify-between p-3.5 md:p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-primary gap-3 md:gap-4"
            >
              <!-- Left: Info Block -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <span class="text-[0.65rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                    {job.category}
                  </span>

                  {job.status === "apply-now" && (
                    <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Apply Now
                    </span>
                  )}

                  {job.status === "upcoming" && (
                    <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Upcoming
                    </span>
                  )}

                  {job.status === "closed" && (
                    <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                      Closed
                    </span>
                  )}
                </div>

                <a href={job.link} class="no-underline hover:no-underline block">
                  <h3 class="text-base text-text-main font-bold leading-tight mb-1.5 group-hover:text-primary transition-colors">{job.title}</h3>
                </a>
                
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-text-muted mb-3">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <HiOutlineBuildingOffice className="shrink-0 text-xs text-primary/70" />
                    <span class="truncate">{job.organisation}</span>
                  </div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <HiOutlineAcademicCap className="text-xs text-primary/70" />
                    <span>{job.qualification}</span>
                  </div>
                </div>

                <!-- Bottom Meta Row: Last Date & Total Posts -->
                <div class="flex flex-wrap items-center gap-3">
                  <span class="text-[0.65rem] font-bold bg-primary/5 text-primary border border-solid border-primary/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                    Total Posts: <strong class="text-primary font-extrabold">{job.vacancies}</strong>
                  </span>
                  <span class="text-border-card dark:text-border-card/30 hidden sm:inline">|</span>
                  <span class="flex items-center gap-1 text-[0.65rem] font-bold bg-rose-500/5 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                  <HiOutlineCalendarDays className="text-rose-500 text-xs shrink-0" /> Last Date: 
                  <strong>{job.lastDate}</strong>
                </span>
                </div>
              </div>

              <!-- Right: CTA Buttons -->
              <div class="shrink-0 w-full md:w-auto md:min-w-[180px]">
                {job.status === "apply-now" && (
                  <a
                    href={job.link}
                    class="w-full md:w-auto btn-primary !rounded-xl !py-2.5 flex items-center justify-center gap-2 group/btn text-[0.65rem] font-bold uppercase tracking-wider px-5"
                  >
                    <span>Apply Online</span>
                    <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                  </a>
                )}

                {job.status === "upcoming" && (
                  <a
                    href={job.link}
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-amber-500/10 hover:bg-amber-500/20 border border-solid border-amber-500/30 text-amber-600 dark:text-amber-400 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl text-center no-underline transition-colors"
                  >
                    <HiOutlineBell className="text-xs text-amber-500 shrink-0 animate-bounce" />
                    <span>Read Details</span>
                  </a>
                )}

                {job.status === "closed" && (
                  <button
                    type="button"
                    disabled
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-rose-500/5 border border-solid border-rose-500/15 text-rose-500/60 dark:text-rose-400/60 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center"
                  >
                    <HiOutlineXCircle className="text-xs shrink-0" />
                    <span>Apply Closed</span>
                  </button>
                )}
              </div>
            </div>
          ))
        )}</div>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
