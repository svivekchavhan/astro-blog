                    <HiOutlineCalculator className="text-base shrink-0" /> वय कॅल्क्युलेटर (Calculate Age)
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2 id="faq" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">वारंवार विचारले जाणारे प्रश्न (FAQ)</h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न १: [भरतीचे नाव] ऑनलाईन अर्ज कधी सुरू होणार आणि शेवटची तारीख काय आहे?</h3>
            <p class="text-text-muted m-0">उत्तर: [भरतीचे नाव] साठी ऑनलाईन अर्ज [सुरुवातीची तारीख] पासून सुरू होतील आणि अर्ज करण्याची शेवटची तारीख [शेवटची तारीख] आहे.</p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न २: [भरतीचे नाव] परीक्षा कधी होणार आहे?</h3>
            <p class="text-text-muted m-0">उत्तर: [भरतीचे नाव] परीक्षा [परीक्षेची तारीख] रोजी आयोजित केली जाईल (अथवा परीक्षा तारीख अद्याप जाहीर झालेली नाही).</p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न ३: येथे प्रश्न टाका?</h3>
            <p class="text-text-muted m-0">उत्तर: येथे उत्तर द्या.</p>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="bg-primary/5 border border-primary/20 p-8 rounded-3xl text-center my-8">
