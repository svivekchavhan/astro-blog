---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineClock,
  HiOutlineClipboardDocumentList,
} from "react-icons/hi2";

const title =
  "सांगली जिल्हा मध्यवर्ती बँक शिपाई भरती २०२६: ७९ जागांसाठी जाहिरात प्रसिद्ध";
const description =
  "Sangli DCC Bank Bharti 2026: Sangli District Central Cooperative Bank Ltd invites online applications for 79 Peon (शिपाई) posts. 12th Pass eligible, 70 Marks OMR Offline Exam, last date to apply is 21 August 2026. Read salary, age limit, exam pattern and official apply link.";
const canonicalURL = "https://mahasandhi.in/sangli-dcc-bank-peon-bharti-2026";
const date = "August 12, 2026";
const category = "Bank Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Sangli DCC Bank Peon Bharti 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          सांगली जिल्हा मध्यवर्ती सहकारी बँक लि., सांगली (Sangli DCC Bank) शिपाई
          पदभरती २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Sangli DCC Bank Bharti 2026:</strong> सांगली जिल्हा मध्यवर्ती
            सहकारी बँक लि., सांगली द्वारे <strong>शिपाई (Peon)</strong> या पदांच्या
            एकूण <strong>७९ रिक्त जागा</strong> ऑफलाईन OMR परीक्षेद्वारे
            भरण्यासाठी अधिकृत भरती जाहिरात प्रसिद्ध करण्यात आली आहे. सांगली
            जिल्ह्यातील मूळ रहिवासी असलेल्या पात्र उमेदवारांकडून ऑनलाईन पद्धतीने
            अर्ज मागविण्यात येत आहेत.
          </p>
          <p>
            इयत्ता १२ वी उत्तीर्ण असलेले उमेदवार या भरतीसाठी पात्र आहेत. Onilne
            अर्ज भरण्याची प्रक्रिया <strong>१३ ऑगस्ट २०२६ ते २१ ऑगस्ट २०२६ (सायंकाळी ५.०० वाजेपर्यंत)</strong> सुरू राहील.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >संस्थेचे नाव</span
              >
              <span class="text-text-main font-semibold text-sm"
                >सांगली जिल्हा मध्यवर्ती सहकारी बँक लि., सांगली</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण</span
              >
              <span class="text-text-main font-semibold text-sm"
                >सांगली जिल्हा कार्यक्षेत्र (बँकेच्या शाखा/कार्यालये)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCurrencyRupee
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >प्रोबेशन वेतन</span
              >
              <span class="text-text-main font-semibold text-sm"
                >रु. १२,०००/- प्रतिमहिना (१ वर्ष परिविक्षाधीन कालावधी)</span
              >
            </div>
          </div>
        </div>

        <!-- Vacancy Details Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          पदसंख्या, पात्रता व वयोमर्यादा विवरण (Post Details & Eligibility)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >एकूण पदे</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक अर्हता</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा (दि. २१.०८.२०२६ रोजी)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-primary text-base"
                  >शिपाई (Peon)</td
                >
                <td
                  class="p-3 border border-border-card font-black text-rose-500 text-center text-lg"
                  >७९</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • किमान <strong>१२ वी उत्तीर्ण</strong>.<br />
                  • सांगली जिल्ह्यातील मूळ रहिवासी असलेल्या विवाहित महिला उमेदवारांसाठी Domicile Certificate व विवाह नोंदणी प्रमाणपत्र आवश्यक.
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  • किमान <strong>१८ वर्षे</strong> ते कमाल <strong>३५ वर्षे</strong> (२१ ऑगस्ट २०२६ रोजी).
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Exam Scheme & Pattern Table -->
        <h2
          id="syllabus"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          परीक्षेचे स्वरूप व तपशील (Exam Pattern & Scheme)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm mb-6"
        >
          <p class="m-0 text-text-main font-semibold mb-2">
            📌 <strong>परीक्षेचे मुख्य तपशील:</strong>
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-text-muted">
            <li>
              <strong>परीक्षा पद्धत:</strong> ऑफलाईन OMR आधारित परीक्षा.
            </li>
            <li>
              <strong>प्रश्न संख्या:</strong> ७० वस्तुनिष्ठ / बहुपर्यायी प्रश्न (MCQ).
            </li>
            <li>
              <strong>परीक्षा कालावधी:</strong> ७५ मिनिटे (१ तास १५ मिनिटे).
            </li>
            <li>
              <strong>पात्रता cut-off दिनांक:</strong> २१ ऑगस्ट २०२६ रोजी सर्व पात्रता ग्राह्य धरली जाईल.
            </li>
          </ul>
        </div>

        <!-- Examination Fee & Probation Details -->
        <h2
          id="fee-salary"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          परीक्षा शुल्क व वेतन तपशील (Application Fee & Salary)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3"
        >
          <p class="m-0 text-text-main">
            💳 <strong>परीक्षा शुल्क:</strong>
            <strong>रु. ४५९/-</strong> (रु. ४०० + १५% GST).
          </p>
          <p class="m-0 text-text-main">
            💰 <strong>प्रोबेशन काळातील वेतन:</strong> निवड झालेल्या उमेदवारांना १ वर्षाच्या परिविक्षाधीन कालावधीसाठी (Probation Period) दरमहा <strong>रु. १२,०००/- एकत्रित वेतन</strong> (Consolidated Salary) दिले जाईल.
          </p>
        </div>

        <!-- Important Dates & Links Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          {
            translateMarathi(
              "महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)",
            )
          }
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तारीख / दुवा (Date / Action)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज भरण्याची सुरूवात दिनांक</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >१३ ऑगस्ट २०२६</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज करण्याची अंतिम तारीख (Last Date to Apply)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-rose-500 text-lg shrink-0"
                    /> २१ ऑगस्ट २०२६ (सायंकाळी ५:०० वाजेपर्यंत)</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अधिकृत भरती जाहिरात PDF (Official Notification PDF)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://sanglidccb.bank.in/resources/assets/upload/file/256_20260811204743.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-rose-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> डाउनलोड अधिकृत जाहिरात (PDF)
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज करण्याची अधिकृत लिंक (Official Apply Link)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://www.sanglidccb.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto"
                  >
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> Sangli DCCB Online Apply Link
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अधिकृत संकेतस्थळ (Official Website)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://sanglidccb.bank.in/career"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> sanglidccb.bank.in/career
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2
          id="faq"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न १: सांगली DCC बँक शिपाई भरती २०२६ साठी ऑनलाईन अर्ज करण्याची शेवटची तारीख कोणती आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: ऑनलाईन अर्ज करण्याची शेवटची तारीख २१ ऑगस्ट २०२६ (सायंकाळी ५:०० वाजेपर्यंत) आहे.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न २: सांगली जिल्हा मध्यवर्ती बँकेत शिपाई पदासाठी एकूण किती जागा आहेत?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: शिपाई (Peon) पदासाठी एकूण ७९ जागांची भरती केली जात आहे.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न ३: या भरतीसाठी शैक्षणिक पात्रता काय आवश्यक आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: उमेदवार किमान १२ वी (HSC) उत्तीर्ण असावा.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न ४: परीक्षा शुल्क किती आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: परीक्षा शुल्क रु. ४५९/- (रु. ४०० + १५% GST) आहे.
            </p>
          </div>
        </div>

        <!-- Call to Action -->
        <div
          class="bg-primary/5 border border-primary/20 p-8 rounded-3xl text-center my-8"
        >
          <h2
            class="text-xl font-black text-text-main mb-4 border-none p-0 mt-0"
          >
            बँक भरती अपडेट्ससाठी जॉईन करा!
          </h2>
          <p class="text-text-muted mb-6 text-sm">
            बँकिंग व जिल्हा मध्यवर्ती बँक भरती अपडेट्स थेट मोबाईलवर मिळवण्यासाठी
            सामील व्हा.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://chat.whatsapp.com"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              WhatsApp Group
            </a>
            <a
              href="https://t.me"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              Telegram Channel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div
      class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative"
    >
      <span
        class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md"
      >
        English Version
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-en" class="text-2xl font-bold mt-2">
          Sangli District Central Cooperative Bank Ltd (Sangli DCC Bank) Peon
          Recruitment 2026
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Sangli DCC Bank Peon Bharti 2026:</strong> Sangli District Central Cooperative
            Bank Ltd., Sangli (Sangli DCCB) has officially published a recruitment advertisement
            to fill <strong>79 vacant posts of Peon (शिपाई)</strong> through an offline OMR written examination.
            Online applications are invited from eligible candidates residing in Sangli District.
          </p>
          <p>
            Candidates who have passed 12th Standard (HSC) are eligible to apply.
            Online application submission starts on <strong
              >13 August 2026</strong
            > and closes on <strong>21 August 2026 (up to 5:00 PM)</strong>.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineDocumentText
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Bank Name</span
              >
              <span class="text-text-main font-semibold text-sm"
                >Sangli District Central Cooperative Bank Ltd</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Job Location</span
              >
              <span class="text-text-main font-semibold text-sm"
                >Sangli District, Maharashtra</span
              >
            </div>
          </div>
          <div
