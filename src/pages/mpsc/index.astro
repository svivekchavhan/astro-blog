---
import Layout from "../../layouts/Layout.astro";
import MpscUpdatesBox from "../../components/MpscUpdatesBox.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineAcademicCap,
  HiOutlineQueueList,
  HiOutlineIdentification,
  HiOutlineDocumentText,
  HiOutlineArrowRight,
  HiOutlineSparkles,
  HiOutlineBookOpen
} from "react-icons/hi2";

const title = "Maharashtra Public Service Commission (MPSC)";
const description =
  "Access all MPSC (Maharashtra Public Service Commission) exam updates. Find direct links to detailed syllabus, eligibility criteria, admit cards, exam patterns, and results.";
---

<Layout title={title} description={description} hideSidebar={true}>
  <section class="pt-4 pb-16 not-prose">
    <!-- Main Content Layout -->
    <div class="max-w-[1100px] mx-auto px-2 md:px-0">
      <!-- Premium Hero Page Header -->
      <div
        class="relative bg-gradient-to-br from-primary/15 via-secondary/10 to-primary/5 border border-primary/25 p-6 md:p-10 rounded-3xl mb-10 overflow-hidden shadow-xs"
      >
        <div
          class="absolute -right-20 -top-20 w-72 h-72 bg-primary/10 rounded-full blur-3xl -z-10"
        >
        </div>
        <div
          class="absolute -left-20 -bottom-20 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl -z-10"
        >
        </div>

        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span
              class="text-[0.65rem] bg-primary text-white px-3 py-1 rounded-full font-extrabold uppercase tracking-wider inline-flex items-center gap-1 shadow-xs"
            >
              <HiOutlineSparkles className="text-xs" /> MPSC Hub 2026
            </span>
            <span
              class="text-[0.65rem] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full font-bold uppercase tracking-wider"
            >
              Official Exam Guidance & Syllabus Portal
            </span>
          </div>

          <h1
            class="text-3xl md:text-5xl font-black text-text-main leading-tight mb-3 tracking-tight"
          >
            Maharashtra Public Service Commission (MPSC)
          </h1>
          <p
            class="text-xs md:text-base text-text-secondary leading-relaxed m-0 font-medium"
          >
            महाराष्ट्र लोकसेवा आयोग (एमपीएससी) परीक्षा माहिती, राजपत्रित नागरी सेवा, संयुक्त गट ब व संयुक्त गट क सविस्तर अभ्यासक्रम, पदे व अधिकृत अपडेट्स दालन.
          </p>
        </div>
      </div>

      <!-- MPSC Latest Updates Box (Table Format) -->
      <MpscUpdatesBox />

      <!-- Section 1: MPSC Exam Details Heading -->
      <div
        class="mb-8 pt-4 pb-4 px-5 bg-bg-surface border-l-4 border-primary border-y border-r border-border-card/60 rounded-r-2xl shadow-xs flex items-center justify-between gap-4"
      >
        <div class="flex items-center gap-3">
          <div class="p-2.5 bg-primary/10 text-primary rounded-xl shrink-0">
            <HiOutlineAcademicCap className="text-2xl" />
          </div>
          <div>
            <h2
              class="text-xl sm:text-2xl font-black text-text-main m-0 tracking-tight"
            >
              एमपीएससी परीक्षा माहिती (<span class="text-primary">MPSC Exam Details</span>)
            </h2>
            <p class="text-xs text-text-muted m-0 mt-0.5 font-medium">
              एमपीएससी राजपत्रित नागरी सेवा, संयुक्त गट ब व संयुक्त गट क परीक्षा पद्धती, पदे व पात्रता
            </p>
          </div>
        </div>
      </div>

      <!-- Exam Details Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-14">
        <!-- Card 1: MPSC Gazetted Exam Details -->
        <a
          href="/mpsc/mpsc-gazetted-exam-details"
          class="group relative bg-bg-surface border border-border-card hover:border-primary rounded-3xl p-6 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 flex flex-col justify-between min-h-[340px] overflow-hidden no-underline"
        >
          <!-- Ambient Glow background effect -->
          <div
            class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors duration-500 -z-10"
          >
          </div>

          <div class="space-y-4">
            <!-- Icon & Badges -->
            <div class="flex justify-between items-start gap-3.5">
              <div
                class="p-3.5 bg-primary/10 text-primary rounded-2xl group-hover:bg-primary group-hover:text-white transition-all duration-300 shrink-0"
              >
                <HiOutlineAcademicCap className="text-xl" />
              </div>
              <div class="flex items-center justify-end gap-1.5 flex-wrap">
                <span
                  class="text-[0.6rem] bg-primary/10 text-primary px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap"
                >
                  Gazetted (Class 1 & 2)
                </span>
              </div>
            </div>

            <!-- Title & Description -->
            <div class="space-y-2">
              <h3
                class="text-base md:text-lg text-text-main font-extrabold leading-tight m-0 group-hover:text-primary transition-colors"
              >
                MPSC Gazetted Exam Details
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                राजपत्रित नागरी सेवा (State Services): पदे (Deputy Collector, DySP, तहसीलदार), पात्रता व परीक्षा पद्धत.
              </p>
            </div>

            <!-- Features list -->
            <div
              class="flex flex-col gap-2 text-xs text-text-muted font-medium pt-3.5 border-t border-border-card/30"
            >
              <span class="flex items-center gap-1.5"
                ><HiOutlineAcademicCap
                  className="text-primary text-sm shrink-0"
                /> पदवीधर उमेदवार पात्र</span
              >
              <span class="flex items-center gap-1.5"
                ><HiOutlineDocumentText
                  className="text-primary text-sm shrink-0"
                /> वर्णनात्मक मुख्य परीक्षा</span
              >
            </div>
          </div>

          <!-- Action link footer -->
          <div
            class="mt-6 pt-3.5 border-t border-border-card/30 flex items-center justify-between text-xs text-primary font-bold uppercase tracking-wider"
          >
            <span>Read Details</span>
            <HiOutlineArrowRight
              className="text-sm transition-transform duration-300 group-hover:translate-x-1"
            />
          </div>
        </a>

        <!-- Card 1b: MPSC Group B Exam Details -->
        <a
          href="/mpsc/mpsc-group-b-exam-details"
          class="group relative bg-bg-surface border border-border-card hover:border-emerald-500 rounded-3xl p-6 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-emerald-500/5 flex flex-col justify-between min-h-[340px] overflow-hidden no-underline"
        >
          <!-- Ambient Glow background effect -->
          <div
            class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl group-hover:bg-emerald-500/10 transition-colors duration-500 -z-10"
          >
          </div>

          <div class="space-y-4">
            <!-- Icon & Badges -->
            <div class="flex justify-between items-start gap-3.5">
              <div
                class="p-3.5 bg-emerald-500/10 text-emerald-500 rounded-2xl group-hover:bg-emerald-500 group-hover:text-white transition-all duration-300 shrink-0"
              >
                <HiOutlineAcademicCap className="text-xl" />
              </div>
              <div class="flex items-center justify-end gap-1.5 flex-wrap">
                <span
                  class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-emerald-500/20 whitespace-nowrap"
                >
                  Group B Combined
                </span>
              </div>
            </div>

            <!-- Title & Description -->
            <div class="space-y-2">
              <h3
                class="text-base md:text-lg text-text-main font-extrabold leading-tight m-0 group-hover:text-emerald-500 transition-colors"
              >
                MPSC Group B Exam Details
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                संयुक्त गट ब परीक्षा: पदे (PSI, STI, ASO, दुय्यम निबंधक), वयोमर्यादा व निकष.
              </p>
            </div>

            <!-- Features list -->
            <div
              class="flex flex-col gap-2 text-xs text-text-muted font-medium pt-3.5 border-t border-border-card/30"
            >
              <span class="flex items-center gap-1.5"
                ><HiOutlineAcademicCap
                  className="text-emerald-500 text-sm shrink-0"
                /> PSI, STI, ASO पदे</span
              >
              <span class="flex items-center gap-1.5"
                ><HiOutlineDocumentText
                  className="text-emerald-500 text-sm shrink-0"
                /> पूर्व + मुख्य परीक्षा (MCQ)</span
              >
            </div>
          </div>

          <!-- Action link footer -->
          <div
            class="mt-6 pt-3.5 border-t border-border-card/30 flex items-center justify-between text-xs text-emerald-500 font-bold uppercase tracking-wider"
          >
            <span>Read Details</span>
            <HiOutlineArrowRight
              className="text-sm transition-transform duration-300 group-hover:translate-x-1"
            />
          </div>
        </a>

        <!-- Card 1c: MPSC Group C Exam Details -->
        <a
          href="/mpsc/mpsc-group-c-exam-details"
          class="group relative bg-bg-surface border border-border-card hover:border-amber-500 rounded-3xl p-6 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/5 flex flex-col justify-between min-h-[340px] overflow-hidden no-underline"
        >
          <!-- Ambient Glow background effect -->
          <div
            class="absolute -right-20 -top-20 w-64 h-64 bg-amber-500/5 rounded-full blur-3xl group-hover:bg-amber-500/10 transition-colors duration-500 -z-10"
          >
          </div>

          <div class="space-y-4">
            <!-- Icon & Badges -->
            <div class="flex justify-between items-start gap-3.5">
              <div
                class="p-3.5 bg-amber-500/10 text-amber-600 rounded-2xl group-hover:bg-amber-500 group-hover:text-white transition-all duration-300 shrink-0"
              >
                <HiOutlineAcademicCap className="text-xl" />
              </div>
              <div class="flex items-center justify-end gap-1.5 flex-wrap">
                <span
                  class="text-[0.6rem] bg-amber-500/10 text-amber-600 px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-amber-500/20 whitespace-nowrap"
                >
                  Group C Combined
                </span>
              </div>
            </div>

            <!-- Title & Description -->
            <div class="space-y-2">
              <h3
                class="text-base md:text-lg text-text-main font-extrabold leading-tight m-0 group-hover:text-amber-500 transition-colors"
              >
                MPSC Group C Exam Details
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                संयुक्त गट क (Class 3) परीक्षा: पदे (Tax Assistant, लिपिक, Excise SI), पात्रता व टायपिंग निकष.
              </p>
            </div>

            <!-- Features list -->
            <div
              class="flex flex-col gap-2 text-xs text-text-muted font-medium pt-3.5 border-t border-border-card/30"
            >
              <span class="flex items-center gap-1.5"
                ><HiOutlineAcademicCap
                  className="text-amber-500 text-sm shrink-0"
                /> लिपिक-टंकलेखक व कर सहाय्यक</span
              >
              <span class="flex items-center gap-1.5"
                ><HiOutlineDocumentText
                  className="text-amber-500 text-sm shrink-0"
                /> टायपिंग कौशल्य चाचणी</span
              >
            </div>
          </div>

          <!-- Action link footer -->
          <div
            class="mt-6 pt-3.5 border-t border-border-card/30 flex items-center justify-between text-xs text-amber-600 font-bold uppercase tracking-wider"
          >
            <span>Read Details</span>
            <HiOutlineArrowRight
              className="text-sm transition-transform duration-300 group-hover:translate-x-1"
            />
          </div>
        </a>

        <!-- Card 1d: MPSC Group C Syllabus 2026 -->
        <a
          href="/mpsc/mpsc-group-c-syllabus-2026"
          class="group relative bg-bg-surface border border-amber-500/30 hover:border-amber-500 rounded-3xl p-6 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/10 flex flex-col justify-between min-h-[340px] overflow-hidden no-underline"
        >
          <!-- Ambient Glow background effect -->
          <div
            class="absolute -right-20 -top-20 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl group-hover:bg-amber-500/20 transition-colors duration-500 -z-10"
          >
          </div>

          <div class="space-y-4">
            <!-- Icon & Badges -->
            <div class="flex justify-between items-start gap-3.5">
              <div
                class="p-3.5 bg-amber-500 text-white rounded-2xl shadow-xs group-hover:scale-105 transition-all duration-300 shrink-0"
              >
                <HiOutlineDocumentText className="text-xl" />
              </div>
              <div class="flex items-center justify-end gap-1.5 flex-wrap">
                <span
                  class="text-[0.6rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-amber-500/20 whitespace-nowrap"
                >
                  Group C Syllabus
                </span>
                <span
                  class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 whitespace-nowrap"
                >
                  PDF Available
                </span>
              </div>
            </div>

            <!-- Title & Description -->
            <div class="space-y-2">
              <h3
                class="text-base md:text-lg text-text-main font-extrabold leading-tight m-0 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors"
              >
                MPSC Group C Syllabus 2026
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                संयुक्त गट क पूर्व (१०० गुण) व मुख्य (४०० गुण) सविस्तर विषयनिहाय अभ्यासक्रम व अधिकृत PDF.
              </p>
            </div>

            <!-- Features list -->
            <div
              class="flex flex-col gap-2 text-xs text-text-muted font-medium pt-3.5 border-t border-border-card/30"
            >
              <span class="flex items-center gap-1.5"
                ><HiOutlineAcademicCap
                  className="text-amber-500 text-sm shrink-0"
                /> पूर्व (१०० गुण) व मुख्य (४०० गुण)</span
              >
              <span class="flex items-center gap-1.5"
                ><HiOutlineDocumentText
                  className="text-amber-500 text-sm shrink-0"
                /> अधिकृत अभ्यासक्रम PDF डाऊनलोड</span
              >
            </div>
          </div>

          <!-- Action link footer -->
          <div
            class="mt-6 pt-3.5 border-t border-border-card/30 flex items-center justify-between text-xs text-amber-600 font-bold uppercase tracking-wider"
          >
            <span>View Syllabus & PDF</span>
            <HiOutlineArrowRight
              className="text-sm transition-transform duration-300 group-hover:translate-x-1"
            />
          </div>
        </a>
      </div>

      <!-- Section 2: MPSC Study Material Heading -->
      <div
        class="mb-8 pt-4 pb-4 px-5 bg-bg-surface border-l-4 border-emerald-500 border-y border-r border-border-card/60 rounded-r-2xl shadow-xs flex items-center justify-between gap-4"
      >
        <div class="flex items-center gap-3">
          <div class="p-2.5 bg-emerald-500/10 text-emerald-500 rounded-xl shrink-0">
            <HiOutlineBookOpen className="text-2xl" />
          </div>
          <div>
            <h2
              class="text-xl sm:text-2xl font-black text-text-main m-0 tracking-tight"
            >
              एमपीएससी अभ्यास साहित्य (<span class="text-emerald-500">MPSC Study Material</span>)
            </h2>
            <p class="text-xs text-text-muted m-0 mt-0.5 font-medium">
              राज्यशास्त्र, भारतीय संविधान, उद्देशिका व परीक्षाभिमुख विषयांच्या नोट्स व सराव प्रश्न
            </p>
          </div>
        </div>
      </div>

      <!-- Study Material Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1: MPSC State Polity (राज्यशास्त्र) -->
        <a
          href="/mpsc/mpsc-polity"
          class="group relative bg-bg-surface border border-border-card hover:border-emerald-500 rounded-3xl p-6 md:p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-emerald-500/5 flex flex-col justify-between min-h-[340px] overflow-hidden no-underline"
        >
          <!-- Ambient Glow background effect -->
          <div
            class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl group-hover:bg-emerald-500/10 transition-colors duration-500 -z-10"
          >
          </div>

          <div class="space-y-4">
            <!-- Icon & Badges -->
            <div class="flex justify-between items-start gap-3.5">
              <div
                class="p-3.5 bg-emerald-500/10 text-emerald-500 rounded-2xl group-hover:bg-emerald-500 group-hover:text-white transition-all duration-300 shrink-0"
              >
                <HiOutlineAcademicCap className="text-xl" />
              </div>
              <div class="flex items-center justify-end gap-1.5 flex-wrap">
                <span
                  class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-emerald-500/20 whitespace-nowrap"
                >
                  Study Material
                </span>
                <span
                  class="text-[0.6rem] bg-primary/10 text-primary px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-primary/20 whitespace-nowrap"
                >
                  Polity Notes
                </span>
              </div>
            </div>

            <!-- Title & Description -->
            <div class="space-y-2">
              <h3
                class="text-lg md:text-xl text-text-main font-extrabold leading-tight m-0 group-hover:text-emerald-500 transition-colors"
              >
                MPSC State Polity: एमपीएससी राज्यशास्त्र अभ्यास साहित्य
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                भारतीय संविधान, उद्देशिका, मूलभूत हक्क, मार्गदर्शक तत्वे,
                राष्ट्रपती, संसद आणि महाराष्ट्राचे शासन प्रशासन याविषयी सविस्तर
                परीक्षाभिमुख नोट्स आणि सराव चाचणी.
              </p>
            </div>

            <!-- Features list -->
            <div
              class="flex flex-col gap-2 text-xs text-text-muted font-medium pt-3.5 border-t border-border-card/30"
            >
              <span class="flex items-center gap-1.5"
                ><HiOutlineDocumentText
                  className="text-emerald-500 text-sm shrink-0"
                /> प्रकरणनिहाय नोट्स आणि विश्लेषण</span
              >
              <span class="flex items-center gap-1.5"
                ><HiOutlineQueueList
                  className="text-emerald-500 text-sm shrink-0"
                /> मागील वर्षांचे प्रश्न (PYQs)</span
              >
              <span class="flex items-center gap-1.5"
                ><HiOutlineIdentification
                  className="text-emerald-500 text-sm shrink-0"
                /> ऑनलाईन सराव मॉक टेस्ट</span
              >
            </div>
          </div>

          <!-- Action link footer -->
          <div
            class="mt-6 pt-3.5 border-t border-border-card/30 flex items-center justify-between text-xs text-emerald-500 font-bold uppercase tracking-wider"
          >
            <span>Start Learning</span>
            <HiOutlineArrowRight
              className="text-sm transition-transform duration-300 group-hover:translate-x-1"
            />
          </div>
        </a>
        <!-- Card 2: MPSC Current Affairs (चालू घडामोडी) -->
        <a
          href="/mpsc/mpsc-current-affairs"
          class="group relative bg-bg-surface border border-border-card hover:border-primary rounded-3xl p-6 md:p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 flex flex-col justify-between min-h-[340px] overflow-hidden no-underline"
        >
          <!-- Ambient Glow background effect -->
          <div
            class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors duration-500 -z-10"
          >
          </div>

          <div class="space-y-4">
            <!-- Icon & Badges -->
            <div class="flex justify-between items-start gap-3.5">
              <div
                class="p-3.5 bg-primary/10 text-primary rounded-2xl group-hover:bg-primary group-hover:text-white transition-all duration-300 shrink-0"
              >
                <HiOutlineDocumentText className="text-xl" />
              </div>
              <div class="flex items-center justify-end gap-1.5 flex-wrap">
                <span
                  class="text-[0.6rem] bg-primary/10 text-primary px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap"
                >
                  Current Affairs
                </span>
                <span
                  class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 whitespace-nowrap"
                >
                  Daily Updates
                </span>
              </div>
            </div>

            <!-- Title & Description -->
            <div class="space-y-2">
              <h3
                class="text-lg md:text-xl text-text-main font-extrabold leading-tight m-0 group-hover:text-primary transition-colors"
              >
                MPSC Current Affairs: एमपीएससी चालू घडामोडी २०२६
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                महाराष्ट्र विशेष घडामोडी, राष्ट्रीय व आंतरराष्ट्रीय घडामोडी, योजना, पुरस्कार, अर्थसंकल्प आणि दैनिक सराव मॉक चाचणी.
              </p>
            </div>

            <!-- Features list -->
            <div
              class="flex flex-col gap-2 text-xs text-text-muted font-medium pt-3.5 border-t border-border-card/30"
            >
              <span class="flex items-center gap-1.5"
                ><HiOutlineDocumentText
