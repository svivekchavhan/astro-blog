---
import Layout from "../../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineAcademicCap,
  HiOutlineQueueList,
  HiOutlineIdentification,
  HiOutlineDocumentText,
  HiOutlineArrowRight,
  HiOutlineBookOpen,
  HiOutlineTrophy,
  HiOutlineGlobeAlt,
  HiOutlineSparkles,
  HiOutlineFire,
  HiOutlineCheckCircle,
  HiOutlineLightBulb,
  HiOutlineBuildingLibrary,
  HiOutlineChartBar
} from "react-icons/hi2";

const title = "MPSC Current Affairs 2026: चालू घडामोडी नोट्स, सराव प्रश्न व MCQs | MahaSandhi";
const description = "MPSC राज्यसेवा, संयुक्त पूर्व व मुख्य परीक्षेसाठी चालू घडामोडी (Current Affairs 2026). दैनिक व मासिक घडामोडी, महाराष्ट्र विशेष, राष्ट्रीय, आंतरराष्ट्रीय, पुरस्कार आणि सराव प्रश्नसंच.";
const canonicalURL = "https://mahasandhi.in/mpsc/mpsc-current-affairs";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  hideSidebar={true}
  customBreadcrumbs={[
    { name: "MPSC", url: "/mpsc" },
    { name: "MPSC Current Affairs" }
  ]}
>
  <section class="pt-2 pb-16 not-prose">
    <div class="max-w-[1100px] mx-auto px-2 md:px-0">
      
      <!-- Main Header Hero Banner -->
      <div class="relative bg-gradient-to-br from-primary/15 via-secondary/10 to-primary/5 border border-primary/25 p-6 md:p-10 rounded-3xl mb-10 overflow-hidden shadow-xs">
        <div class="absolute -right-20 -top-20 w-72 h-72 bg-primary/10 rounded-full blur-3xl -z-10"></div>
        <div class="absolute -left-20 -bottom-20 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl -z-10"></div>

        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="text-[0.65rem] bg-primary text-white px-3 py-1 rounded-full font-extrabold uppercase tracking-wider inline-flex items-center gap-1 shadow-xs">
              <HiOutlineSparkles className="text-xs" /> MPSC & UPSC 2026 Study Series
            </span>
            <span class="text-[0.65rem] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full font-bold uppercase tracking-wider">
              Updated Daily & Monthly
            </span>
          </div>

          <h1 class="text-3xl md:text-5xl font-black text-text-main leading-tight mb-4 tracking-tight">
            MPSC चालू घडामोडी (Current Affairs) २०२६
          </h1>
          <p class="text-xs md:text-base text-text-secondary leading-relaxed mb-6">
            एमपीएससी राज्यसेवा (Rajyaseva), संयुक्त गट ब (Group B), संयुक्त गट क (Group C) आणि इतर स्पर्धा परीक्षांसाठी अत्यंत महत्त्वाच्या चालू घडामोडींचा परिपूर्ण संग्रह.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-semibold">
            <div class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5">
              <div class="p-2 bg-primary/10 text-primary rounded-xl shrink-0">
                <HiOutlineGlobeAlt className="text-lg" />
              </div>
              <div>
                <span class="block text-[0.65rem] text-text-muted font-bold uppercase">घटक</span>
                <span class="text-text-main font-extrabold">महाराष्ट्र व राष्ट्रीय</span>
              </div>
            </div>
            <div class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5">
              <div class="p-2 bg-emerald-500/10 text-emerald-500 rounded-xl shrink-0">
                <HiOutlineTrophy className="text-lg" />
              </div>
              <div>
                <span class="block text-[0.65rem] text-text-muted font-bold uppercase">विशेष</span>
                <span class="text-text-main font-extrabold">पुरस्कार व क्रीडा</span>
              </div>
            </div>
            <div class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5">
              <div class="p-2 bg-amber-500/10 text-amber-600 rounded-xl shrink-0">
                <HiOutlineBuildingLibrary className="text-lg" />
              </div>
              <div>
                <span class="block text-[0.65rem] text-text-muted font-bold uppercase">योजना</span>
                <span class="text-text-main font-extrabold">आर्थिक व शासन निर्णय</span>
              </div>
            </div>
            <div class="bg-bg-surface/80 border border-border-card/60 backdrop-blur-xs p-3 rounded-2xl flex items-center gap-2.5">
              <div class="p-2 bg-rose-500/10 text-rose-500 rounded-xl shrink-0">
                <HiOutlineIdentification className="text-lg" />
              </div>
              <div>
                <span class="block text-[0.65rem] text-text-muted font-bold uppercase">सराव</span>
                <span class="text-text-main font-extrabold">PYQs व चाचणी</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab Navigation Grid (Mobile, Tablet & Desktop) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5 mb-8 border-b border-border-card/40 pb-6">
        <button 
          class="ca-tab-btn active p-3 sm:p-3.5 bg-primary text-white rounded-2xl text-xs sm:text-sm font-extrabold transition-all duration-300 shadow-xs flex flex-col sm:flex-row items-center justify-center gap-2 border border-primary text-center group"
          data-tab="category-tab"
        >
          <HiOutlineBookOpen className="text-base sm:text-lg shrink-0" />
          <span>📚 घटकनिहाय घडामोडी</span>
        </button>
        <button 
          class="ca-tab-btn p-3 sm:p-3.5 bg-bg-surface text-text-muted hover:text-text-main border border-border-card hover:border-primary/40 rounded-2xl text-xs sm:text-sm font-extrabold transition-all duration-300 flex flex-col sm:flex-row items-center justify-center gap-2 text-center group"
          data-tab="monthly-tab"
        >
          <HiOutlineCalendarDays className="text-base sm:text-lg text-primary shrink-0" />
          <span>🗓️ मासिक हायलाइट्स</span>
        </button>
        <button 
          class="ca-tab-btn p-3 sm:p-3.5 bg-bg-surface text-text-muted hover:text-text-main border border-border-card hover:border-primary/40 rounded-2xl text-xs sm:text-sm font-extrabold transition-all duration-300 flex flex-col sm:flex-row items-center justify-center gap-2 text-center group"
          data-tab="flashcard-tab"
        >
          <HiOutlineLightBulb className="text-base sm:text-lg text-amber-500 shrink-0" />
          <span>🔄 Active Recall फ्लॅशकार्ड्स</span>
        </button>
        <button 
          class="ca-tab-btn p-3 sm:p-3.5 bg-bg-surface text-text-muted hover:text-text-main border border-border-card hover:border-primary/40 rounded-2xl text-xs sm:text-sm font-extrabold transition-all duration-300 flex flex-col sm:flex-row items-center justify-center gap-2 text-center group"
          data-tab="pyq-tab"
        >
          <HiOutlineQueueList className="text-base sm:text-lg text-emerald-500 shrink-0" />
          <span>🎯 MPSC PYQ विश्लेषण</span>
        </button>
        <button 
          class="ca-tab-btn col-span-2 sm:col-span-1 p-3 sm:p-3.5 bg-bg-surface text-text-muted hover:text-text-main border border-border-card hover:border-primary/40 rounded-2xl text-xs sm:text-sm font-extrabold transition-all duration-300 flex flex-col sm:flex-row items-center justify-center gap-2 text-center group"
          data-tab="quiz-tab"
        >
          <HiOutlineIdentification className="text-base sm:text-lg text-rose-500 shrink-0" />
          <span>📝 सराव मॉक टेस्ट</span>
        </button>
      </div>

      <!-- TAB 1: घटकनिहाय चालू घडामोडी (Category Notes) -->
      <div id="category-tab" class="ca-tab-content block space-y-8 animate-[fadeIn_0.3s_ease]">
        
        <!-- Category Grid Template -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Category 1: Maharashtra Special -->
          <div class="bg-bg-surface border border-border-card hover:border-primary rounded-3xl p-6 shadow-xs transition-all duration-300 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="p-3 bg-primary/10 text-primary rounded-2xl font-bold">
                  <HiOutlineGlobeAlt className="text-xl" />
                </span>
                <span class="text-[0.6rem] bg-primary/10 text-primary px-2.5 py-1 rounded-full font-bold uppercase tracking-wider">
                  महाराष्ट्र घडामोडी
                </span>
              </div>
              <h2 class="text-xl font-bold text-text-main leading-snug m-0">
                १. महाराष्ट्र चालू घडामोडी (Maharashtra Special)
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                महाराष्ट्रातील महत्त्वाच्या घडामोडी, नवीन निर्णय, प्रकल्प व शासकीय अपडेट्स.
              </p>
            </div>
            
            <div class="pt-4 border-t border-border-card/40 space-y-2 text-xs">
              <div class="text-[0.75rem] text-amber-600 dark:text-amber-400 font-bold bg-amber-500/10 border border-amber-500/20 p-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                <span>⏳ नवीन माहिती लवकरच येत आहे</span>
              </div>
            </div>
          </div>

          <!-- Category 2: Polity & Governance -->
          <div class="bg-bg-surface border border-border-card hover:border-emerald-500 rounded-3xl p-6 shadow-xs transition-all duration-300 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="p-3 bg-emerald-500/10 text-emerald-500 rounded-2xl font-bold">
                  <HiOutlineBuildingLibrary className="text-xl" />
                </span>
                <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-600 px-2.5 py-1 rounded-full font-bold uppercase tracking-wider">
                  राज्यशास्त्र विशेष
                </span>
              </div>
              <h2 class="text-xl font-bold text-text-main leading-snug m-0">
                २. राज्यशास्त्र व राजकीय घडामोडी (Polity & Governance)
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                नवीन कायदे, निकाल, आयोग, समित्या आणि राजकीय घडामोडी.
              </p>
            </div>

            <div class="pt-4 border-t border-border-card/40 space-y-2 text-xs">
              <div class="text-[0.75rem] text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10 border border-emerald-500/20 p-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                <span>⏳ नवीन माहिती लवकरच येत आहे</span>
              </div>
            </div>
          </div>

          <!-- Category 3: Economy & Schemes -->
          <div class="bg-bg-surface border border-border-card hover:border-amber-500 rounded-3xl p-6 shadow-xs transition-all duration-300 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="p-3 bg-amber-500/10 text-amber-600 rounded-2xl font-bold">
                  <HiOutlineChartBar className="text-xl" />
                </span>
                <span class="text-[0.6rem] bg-amber-500/10 text-amber-600 px-2.5 py-1 rounded-full font-bold uppercase tracking-wider">
                  अर्थव्यवस्था व योजना
                </span>
              </div>
              <h2 class="text-xl font-bold text-text-main leading-snug m-0">
                ३. आर्थिक घडामोडी व शासकीय योजना (Economy & Schemes)
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                अर्थसंकल्प, अहवाल, बँक धोरणे आणि सरकारी योजना.
              </p>
            </div>

            <div class="pt-4 border-t border-border-card/40 space-y-2 text-xs">
              <div class="text-[0.75rem] text-amber-600 dark:text-amber-400 font-bold bg-amber-500/10 border border-amber-500/20 p-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                <span>⏳ नवीन माहिती लवकरच येत आहे</span>
              </div>
            </div>
          </div>

          <!-- Category 4: Science, Tech & Environment -->
          <div class="bg-bg-surface border border-border-card hover:border-sky-500 rounded-3xl p-6 shadow-xs transition-all duration-300 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="p-3 bg-sky-500/10 text-sky-500 rounded-2xl font-bold">
                  <HiOutlineLightBulb className="text-xl" />
                </span>
                <span class="text-[0.6rem] bg-sky-500/10 text-sky-600 px-2.5 py-1 rounded-full font-bold uppercase tracking-wider">
                  विज्ञान व पर्यावरण
                </span>
              </div>
              <h2 class="text-xl font-bold text-text-main leading-snug m-0">
                ४. विज्ञान, तंत्रज्ञान व पर्यावरण (Sci, Tech & Environment)
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                अंतराळ मोहिमा, नवीन शोध, हवामान बदल आणि पर्यावरण घडामोडी.
              </p>
            </div>

            <div class="pt-4 border-t border-border-card/40 space-y-2 text-xs">
              <div class="text-[0.75rem] text-sky-600 dark:text-sky-400 font-bold bg-sky-500/10 border border-sky-500/20 p-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                <span>⏳ नवीन माहिती लवकरच येत आहे</span>
              </div>
            </div>
          </div>

          <!-- Category 5: Awards & Persons -->
          <div class="bg-bg-surface border border-border-card hover:border-rose-500 rounded-3xl p-6 shadow-xs transition-all duration-300 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="p-3 bg-rose-500/10 text-rose-500 rounded-2xl font-bold">
                  <HiOutlineTrophy className="text-xl" />
                </span>
                <span class="text-[0.6rem] bg-rose-500/10 text-rose-600 px-2.5 py-1 rounded-full font-bold uppercase tracking-wider">
                  पुरस्कार व व्यक्ती
                </span>
              </div>
              <h2 class="text-xl font-bold text-text-main leading-snug m-0">
                ५. पुरस्कार, नियुक्ती व महत्त्वाच्या व्यक्ती (Awards & Person)
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                महत्त्वाचे पुरस्कार, सन्मान, नवीन नेमणुका आणि विशेष व्यक्ती.
              </p>
            </div>

            <div class="pt-4 border-t border-border-card/40 space-y-2 text-xs">
              <div class="text-[0.75rem] text-rose-600 dark:text-rose-400 font-bold bg-rose-500/10 border border-rose-500/20 p-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                <span>⏳ नवीन माहिती लवकरच येत आहे</span>
              </div>
            </div>
          </div>

          <!-- Category 6: Sports & World -->
          <div class="bg-bg-surface border border-border-card hover:border-purple-500 rounded-3xl p-6 shadow-xs transition-all duration-300 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="p-3 bg-purple-500/10 text-purple-500 rounded-2xl font-bold">
                  <HiOutlineFire className="text-xl" />
                </span>
                <span class="text-[0.6rem] bg-purple-500/10 text-purple-600 px-2.5 py-1 rounded-full font-bold uppercase tracking-wider">
                  क्रीडा व आंतरराष्ट्रीय
                </span>
              </div>
              <h2 class="text-xl font-bold text-text-main leading-snug m-0">
                ६. क्रीडा व आंतरराष्ट्रीय घडामोडी (Sports & World)
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                क्रीडा स्पर्धा, विजेते, आंतरराष्ट्रीय करार आणि जागतिक घडामोडी.
              </p>
            </div>

            <div class="pt-4 border-t border-border-card/40 space-y-2 text-xs">
              <div class="text-[0.75rem] text-purple-600 dark:text-purple-400 font-bold bg-purple-500/10 border border-purple-500/20 p-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                <span>⏳ नवीन माहिती लवकरच येत आहे</span>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- TAB 2: मासिक हायलाइट्स (Monthly Digest Container) -->
      <div id="monthly-tab" class="ca-tab-content hidden space-y-6 animate-[fadeIn_0.3s_ease]">
        <div class="bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-8 space-y-6 shadow-xs">
          <div class="flex items-center justify-between border-b border-border-card/40 pb-4 flex-wrap gap-2">
            <div>
              <h2 class="text-xl font-black text-text-main m-0 flex items-center gap-2">
                <HiOutlineCalendarDays className="text-primary text-2xl" />
                मासिक चालू घडामोडी डॅशबोर्ड
              </h2>
              <p class="text-xs text-text-muted m-0 mt-0.5">
                महिनानिहाय महत्त्वाच्या घडामोडींचे संकलन
              </p>
            </div>
          </div>

          <!-- Monthly Content Container Placeholder -->
          <div class="border border-dashed border-border-card/80 p-8 rounded-2xl text-center space-y-2">
            <div class="text-base font-bold text-text-main">
              📅 मासिक चालू घडामोडी अपडेट्स
            </div>
            <p class="text-xs text-text-muted m-0">
              नवीन माहिती लवकरच येत आहे.
            </p>
          </div>
        </div>
      </div>

      <!-- TAB 3: Active Recall फ्लॅशकार्ड्स Container -->
      <div id="flashcard-tab" class="ca-tab-content hidden space-y-6 animate-[fadeIn_0.3s_ease]">
        <div class="bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-8 space-y-6 shadow-xs">
          <div>
            <h2 class="text-xl font-black text-text-main m-0 flex items-center gap-2">
              <HiOutlineLightBulb className="text-amber-500 text-2xl" />
              चालू घडामोडी Fast Revision - Active Recall फ्लॅशकार्ड्स
            </h2>
            <p class="text-xs text-text-muted m-0 mt-1">
              👇 फ्लॅशकार्ड्स सराव विभाग:
            </p>
          </div>

          <div class="border border-dashed border-border-card/80 p-8 rounded-2xl text-center space-y-2">
            <div class="text-base font-bold text-text-main">
              🔄 Active Recall फ्लॅशकार्ड्स
            </div>
            <p class="text-xs text-text-muted m-0">
              नवीन माहिती लवकरच येत आहे.
            </p>
          </div>
        </div>
      </div>

      <!-- TAB 4: MPSC PYQ विश्लेषण Container -->
      <div id="pyq-tab" class="ca-tab-content hidden space-y-6 animate-[fadeIn_0.3s_ease]">
        <div class="bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-8 space-y-6 shadow-xs">
          <div>
            <h2 class="text-xl font-black text-text-main m-0 flex items-center gap-2">
              <HiOutlineQueueList className="text-emerald-500 text-2xl" />
              MPSC मागील वर्षांतील चालू घडामोडी प्रश्न विश्लेषण (PYQ Analysis)
            </h2>
            <p class="text-xs text-text-muted m-0 mt-1">
              MPSC परीक्षांमध्ये विचारलेले प्रश्न व सविस्तर स्पष्टीकरण
            </p>
          </div>

          <div class="border border-dashed border-border-card/80 p-8 rounded-2xl text-center space-y-2">
            <div class="text-base font-bold text-text-main">
              🎯 मागील वर्षांचे MPSC PYQs
            </div>
            <p class="text-xs text-text-muted m-0">
              नवीन माहिती लवकरच येत आहे.
            </p>
          </div>
        </div>
      </div>

      <!-- TAB 5: सराव मॉक क्विझ Container -->
      <div id="quiz-tab" class="ca-tab-content hidden space-y-6 animate-[fadeIn_0.3s_ease]">
        <div class="bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-8 space-y-6 shadow-xs">
          <div class="flex items-center justify-between border-b border-border-card/40 pb-4 flex-wrap gap-2">
            <div>
              <h2 class="text-xl font-black text-text-main m-0 flex items-center gap-2">
                <HiOutlineIdentification className="text-rose-500 text-2xl" />
                MPSC चालू घडामोडी सराव मॉक चाचणी
