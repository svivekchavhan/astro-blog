<script is:inline>
  // Tab Switching Logic
  const tabBtns = document.querySelectorAll(".ca-tab-btn");
  const tabContents = document.querySelectorAll(".ca-tab-content");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetTab = btn.getAttribute("data-tab");

      tabBtns.forEach((b) => {
        b.classList.remove("active", "bg-primary", "text-white", "border-primary");
        b.classList.add("bg-bg-surface", "text-text-muted", "border-border-card");
      });

      btn.classList.add("active", "bg-primary", "text-white", "border-primary");
      btn.classList.remove("bg-bg-surface", "text-text-muted", "border-border-card");

      tabContents.forEach((content) => {
        if (content.id === targetTab) {
          content.classList.remove("hidden");
          content.classList.add("block");
        } else {
          content.classList.remove("block");
          content.classList.add("hidden");
        }
      });
    });
  });
</script>
