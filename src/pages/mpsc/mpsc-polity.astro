---
import Layout from "../../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineAcademicCap,
  HiOutlineQueueList,
  HiOutlineIdentification,
  HiOutlineDocumentText,
  HiOutlineInformationCircle,
  HiOutlineArrowRight,
  HiOutlineBookOpen,
} from "react-icons/hi2";

const title = "MPSC Polity Study Guide 2026: भारतीय राज्यशास्त्र घटकनिहाय नोट्स आणि टेस्ट | MahaSandhi";
const description = "MPSC राज्यशास्त्र (Indian Polity) संपूर्ण अभ्यासक्रम मार्गदर्शन. उद्देशिका, मूलभूत हक्क, संसद, आणि इतर सर्व प्रकरणांच्या हस्तलिखित नोट्स व सराव मॉक टेस्ट.";
const canonicalURL = "https://mahasandhi.in/mpsc/mpsc-polity";
---

<Layout 
  title={title} 
  description={description} 
  canonicalURL={canonicalURL} 
  hideSidebar={true}
  customBreadcrumbs={[
    { name: "MPSC", url: "/mpsc" },
    { name: "MPSC Polity" }
  ]}
>
  <section class="pt-4 pb-16 not-prose">
    <div class="max-w-[1100px] mx-auto px-2 md:px-0">
      
      <!-- Header Banner -->
      <div class="bg-gradient-to-br from-primary/10 via-secondary/5 to-primary/5 border border-primary/20 p-8 rounded-3xl mb-12 relative overflow-hidden">
        <div class="absolute -right-24 -top-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl -z-10"></div>
        <div class="max-w-3xl">
          <span class="text-[0.65rem] bg-primary text-white px-3 py-1 rounded-full font-bold uppercase tracking-wider mb-4 inline-block">
            MPSC & UPSC Study Material
          </span>
          <h1 class="text-3xl md:text-4xl font-extrabold text-text-main leading-tight mb-4">
            भारतीय राज्यशास्त्र (Indian Polity)
          </h1>
          <p class="text-sm md:text-base text-text-secondary leading-relaxed mb-0">
            एमपीएससी राज्यसेवा, संयुक्त पूर्व व मुख्य परीक्षा, आणि इतर सर्व स्पर्धा परीक्षांसाठी राज्यशास्त्र या अत्यंत महत्त्वाच्या विषयाची घटकनिहाय परिपूर्ण तयारी. येथे तुम्हाला परीक्षाभिमुख नोट्स, संकल्पना स्पष्टीकरण, ऐतिहासिक संदर्भ आणि सराव मॉक टेस्ट मिळतील.
          </p>
        </div>
      </div>

      <!-- Grid of Topics -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Chapter 1: Preamble (Active) -->
        <a 
          href="/mpsc/mpsc-polity-preamble" 
          class="group relative bg-bg-surface border border-border-card hover:border-primary rounded-3xl p-6 md:p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 flex flex-col justify-between min-h-[300px] overflow-hidden no-underline"
        >
          <div class="absolute -right-20 -top-20 w-56 h-56 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors duration-500 -z-10"></div>
          
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-primary/10 text-primary rounded-2xl group-hover:bg-primary group-hover:text-white transition-all duration-300">
                <HiOutlineBookOpen className="text-xl" />
              </div>
              <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 whitespace-nowrap">
                Active Notes
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg md:text-xl text-text-main font-bold leading-tight m-0 group-hover:text-primary transition-colors">
                १. भारतीय संविधानाची उद्देशिका (Preamble): MPSC राज्यशास्त्र नोट्स
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed m-0">
                सरनामा किंवा प्रस्तावना (Preamble) ची पार्श्वभूमी, मूळ तत्त्वे, घटनात्मक खटले (बेरुबारी, केशवानंद भारती), घटनादुरुस्ती आणि परीक्षाभिमुख सराव प्रश्नसंच.
              </p>
            </div>
            
            <div class="flex flex-col gap-1.5 text-xs text-text-muted pt-3 border-t border-border-card/30">
              <span class="flex items-center gap-1.5"><HiOutlineDocumentText className="text-primary text-sm shrink-0" /> सविस्तर हस्तलिखित क्लास नोट्स</span>
              <span class="flex items-center gap-1.5"><HiOutlineQueueList className="text-primary text-sm shrink-0" /> MPSC/UPSC चे मागील वर्षांचे प्रश्न (PYQs)</span>
              <span class="flex items-center gap-1.5"><HiOutlineIdentification className="text-primary text-sm shrink-0" /> ५ गुणांची सराव मॉक क्विझ</span>
            </div>
          </div>

          <div class="mt-6 pt-3 border-t border-border-card/30 flex items-center justify-between text-xs text-primary font-bold uppercase tracking-wider">
            <span>अभ्यास सुरू करा</span>
            <HiOutlineArrowRight className="text-sm transition-transform duration-300 group-hover:translate-x-1" />
          </div>
        </a>

        <!-- Chapter 2: Making of Constitution (Upcoming) -->
        <div 
          class="relative bg-bg-surface/50 border border-border-card/50 rounded-3xl p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[300px] overflow-hidden"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-text-muted/10 text-text-muted rounded-2xl">
                <HiOutlineBookOpen className="text-xl" />
              </div>
              <span class="text-[0.6rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 whitespace-nowrap">
                Coming Soon
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg md:text-xl text-text-main/70 font-bold leading-tight m-0">
                २. संविधानाची निर्मिती व पार्श्वभूमी
              </h2>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                संविधान सभा (Constituent Assembly), विविध समित्या, मसुदा समिती, संविधानाची स्वीकृती आणि ब्रिटीश काळातील ऐतिहासिक कायदे (१७७३ ते १९४७).
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-border-card/30 text-xs text-text-muted font-bold uppercase tracking-wider">
            लवकरच उपलब्ध होईल
          </div>
        </div>

        <!-- Chapter 3: Fundamental Rights (Upcoming) -->
        <div 
          class="relative bg-bg-surface/50 border border-border-card/50 rounded-3xl p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[300px] overflow-hidden"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-text-muted/10 text-text-muted rounded-2xl">
                <HiOutlineBookOpen className="text-xl" />
              </div>
              <span class="text-[0.6rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 whitespace-nowrap">
                Coming Soon
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg md:text-xl text-text-main/70 font-bold leading-tight m-0">
                ३. मूलभूत हक्क (Fundamental Rights)
              </h2>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                कलम १२ ते ३५ पर्यंतचे मूलभूत हक्क, समतेचा, स्वातंत्र्याचा, शोषणाविरुद्धचा हक्क, धार्मिक स्वातंत्र्य, घटनात्मक उपाययोजनांचा हक्क आणि अपवाद.
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-border-card/30 text-xs text-text-muted font-bold uppercase tracking-wider">
            लवकरच उपलब्ध होईल
          </div>
        </div>

        <!-- Chapter 4: DPSP (Upcoming) -->
        <div 
          class="relative bg-bg-surface/50 border border-border-card/50 rounded-3xl p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[300px] overflow-hidden"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-text-muted/10 text-text-muted rounded-2xl">
                <HiOutlineBookOpen className="text-xl" />
              </div>
              <span class="text-[0.6rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 whitespace-nowrap">
                Coming Soon
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg md:text-xl text-text-main/70 font-bold leading-tight m-0">
                ४. राज्य धोरणाची मार्गदर्शक तत्वे
              </h2>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                भाग ४ मधील मार्गदर्शक तत्वे (DPSP) कलम ३६ ते ५१, समाजवादी, गांधीवादी आणि उदारमतवादी बुद्धिवादी तत्वांचे वर्गीकरण व अंमलबजावणी.
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-border-card/30 text-xs text-text-muted font-bold uppercase tracking-wider">
            लवकरच उपलब्ध होईल
          </div>
        </div>

        <!-- Chapter 5: Fundamental Duties (Upcoming) -->
        <div 
          class="relative bg-bg-surface/50 border border-border-card/50 rounded-3xl p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[300px] overflow-hidden"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-text-muted/10 text-text-muted rounded-2xl">
                <HiOutlineBookOpen className="text-xl" />
              </div>
              <span class="text-[0.6rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 whitespace-nowrap">
                Coming Soon
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg md:text-xl text-text-main/70 font-bold leading-tight m-0">
                ५. मूलभूत कर्तव्ये (Fundamental Duties)
              </h2>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                कलम ५१ (ए) मधील ११ मूलभूत कर्तव्ये, सुवर्णसिंग समितीच्या शिफारशी, ८६ वी घटनादुरुस्ती आणि कर्तव्यांचे महत्त्व.
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-border-card/30 text-xs text-text-muted font-bold uppercase tracking-wider">
            लवकरच उपलब्ध होईल
          </div>
        </div>

        <!-- Chapter 6: Parliament (Upcoming) -->
        <div 
          class="relative bg-bg-surface/50 border border-border-card/50 rounded-3xl p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[300px] overflow-hidden"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-text-muted/10 text-text-muted rounded-2xl">
                <HiOutlineBookOpen className="text-xl" />
              </div>
              <span class="text-[0.6rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 whitespace-nowrap">
                Coming Soon
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg md:text-xl text-text-main/70 font-bold leading-tight m-0">
                ६. केंद्र शासन - राष्ट्रपती आणि संसद
              </h2>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                राष्ट्रपतींची निवडणूक, अधिकार व अधिकार कक्षा, राज्यसभा आणि लोकसभा रचना, कायदेनिर्मिती प्रक्रिया आणि विविध संसदीय समित्या.
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-border-card/30 text-xs text-text-muted font-bold uppercase tracking-wider">
            लवकरच उपलब्ध होईल
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
