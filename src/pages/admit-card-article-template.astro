---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineBell,
  HiOutlineArrowDownTray
} from "react-icons/hi2";

const title = "Exam Name Admit Card 2026: Download Hall Ticket Direct Link";
const description = "Download Exam Name Admit Card 2026 / Hall Ticket. Get direct links for candidate login, official notifications, exam date instructions, and website links here.";
const canonicalURL = "https://mahasandhi.in/exam-name-admit-card-2026";
const date = "Month DD, YYYY";
const category = "Admit Card";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents (Marathi) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          या लेखातील मुख्य मुद्दे (मराठी)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li>
            <a
              href="#admit-card-overview-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Admit Card सविस्तर माहिती</a
            >
          </li>
          <li>
            <a
              href="#how-to-download-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >हॉल तिकीट कसे डाउनलोड करावे? (पायऱ्या)</a
            >
          </li>
          <li>
            <a
              href="#admit-card-links-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >महत्वाच्या लिंक्स आणि डाउनलोड टेबल</a
            >
          </li>
          <li>
            <a
              href="#faq-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >वारंवार विचारले जाणारे प्रश्न (FAQ)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <p>
          <strong>Exam Conducting Authority Name</strong> द्वारे आयोजित करण्यात आलेल्या <strong>Exam/Post Name 2026</strong> परीक्षेचे हॉल तिकीट / प्रवेश पत्र जाहीर करण्यात आले आहे. सर्व पात्र उमेदवारांनी आपले प्रवेश पत्र त्वरित डाउनलोड करावे. परीक्षा दिनांक आणि हॉल तिकीट डाउनलोड करण्याची डायरेक्ट लिंक खालील तक्त्यामध्ये उपलब्ध करून दिली आहे.
        </p>

        <h2 id="admit-card-overview-mr">Admit Card 2026 सविस्तर माहिती</h2>
        
        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBuildingOffice className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">परीक्षा मंडळ (Authority)</span>
              <span class="text-text-main font-semibold text-sm">Authority Name Here</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineCalendarDays className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">परीक्षा दिनांक (Exam Date)</span>
              <span class="text-text-main font-semibold text-sm">DD Month YYYY</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBell className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">प्रवेश पत्र स्थिती (Status)</span>
              <span class="text-emerald-500 font-bold text-sm flex items-center gap-1">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> उपलब्ध (Available Now)
              </span>
            </div>
          </div>
        </div>

        <h2 id="how-to-download-mr">हॉल तिकीट डाउनलोड कसे करावे? (Steps)</h2>
        <p>आपले प्रवेश पत्र डाउनलोड करण्यासाठी खालील सोप्या पायऱ्यांचे अनुसरण करा:</p>
        
        <div class="space-y-6 pl-2 border-l-2 border-primary/30 my-6">
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">1</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 1: प्रवेश पत्र डाउनलोड लिंक वर जा</h4>
            <p class="text-sm text-text-muted m-0">खालील तक्त्यामध्ये दिलेल्या <strong>'Admit Card Download'</strong> डायरेक्ट लिंकवर क्लिक करा.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">2</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 2: लॉगिन तपशील प्रविष्ट करा</h4>
            <p class="text-sm text-text-muted m-0">उघडलेल्या लॉगिन पानावर आपला <strong>नोंदणी क्रमांक (Registration No. / Roll No.)</strong> आणि <strong>पासवर्ड / जन्मतारीख</strong> प्रविष्ट करा.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">3</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 3: प्रवेश पत्र पहा आणि तपासा</h4>
            <p class="text-sm text-text-muted m-0">माहिती अचूक भरल्यानंतर 'Submit' बटणावर क्लिक करा, त्यानंतर तुमचे हॉल तिकीट स्क्रीनवर दिसेल.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">4</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 4: प्रिंट काढा</h4>
            <p class="text-sm text-text-muted m-0">भविष्यातील संदर्भासाठी आणि परीक्षेसाठी हॉल तिकीट <strong>PDF स्वरूपात डाउनलोड करा</strong> आणि त्याची प्रिंट काढा.</p>
          </div>
        </div>

        <!-- Admit Card Links Table (Marathi) -->
        <h2 id="admit-card-links-mr" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">प्रवेश पत्र आणि महत्वाच्या लिंक्स (Important Links Table)</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Event / Resource)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">लिंक / कृती (Direct Link / Action)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">प्रवेश पत्र डाउनलोड करा (Direct Admit Card Link)</td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold uppercase tracking-wider rounded-lg transition-all shadow-sm w-full sm:w-auto">
                    <HiOutlineArrowDownTray className="text-base shrink-0 animate-bounce" /> डाउनलोड करा (Click Here)
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">परीक्षा तारीख जाहिरात (Exam Date Notice PDF)</td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto">
                    <HiOutlineDocumentText className="text-base shrink-0" /> नोटीस पहा (Download PDF)
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">अधिकृत संकेतस्थळ (Official Website)</td>
                <td class="p-3 border border-border-card">
                  <a href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto">
                    <HiOutlineArrowTopRightOnSquare className="text-base shrink-0" /> अधिकृत वेबसाईट
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section (Marathi) -->
        <h2 id="faq-mr" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">वारंवार विचारले जाणारे प्रश्न (FAQ)</h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न १: प्रवेश पत्र कधी जाहीर होईल?</h3>
            <p class="text-text-muted m-0">उत्तर १: प्रवेश पत्र अधिकृत वेबसाइटवर जाहीर करण्यात आले आहे, आपण वरील डायरेक्ट लिंकद्वारे डाउनलोड करू शकता.</p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न २: हॉल तिकीट डाऊनलोड करण्यासाठी कोणत्या गोष्टी आवश्यक आहेत?</h3>
            <p class="text-text-muted m-0">उत्तर २: प्रवेश पत्र डाउनलोड करण्यासाठी उमेदवारांकडे अर्ज नोंदणी क्रमांक (Registration Number) आणि पासवर्ड किंवा जन्मतारीख असणे आवश्यक आहे.</p>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="bg-primary/5 border border-primary/20 p-8 rounded-3xl text-center my-8">
          <h2 class="text-2xl font-black text-text-main mb-4 border-none p-0 mt-0">ताज्या अपडेट्ससाठी जॉईन करा!</h2>
          <p class="text-text-muted mb-6">परीक्षा, निकाल आणि प्रवेश पत्राच्या ताज्या घडामोडी सर्वात आधी मिळवण्यासाठी आमच्या व्हॉट्सॲप आणि टेलिग्राम ग्रुपमध्ये सामील व्हा.</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="#" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm">
              WhatsApp Group
            </a>
            <a href="#" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm">
              Telegram Channel
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative">
      <span class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md">
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-text-main mb-4">
          Exam Name Admit Card 2026: Direct Link to Download Hall Ticket
        </h2>
        <p class="text-text-muted leading-relaxed italic">
          The official admit card for the Exam Name 2026 has been published. Candidates who have successfully registered for the recruitment test can access their hall ticket using the step-by-step instructions and official direct link table provided below.
        </p>
      </div>

      <!-- Table of Contents (English) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          Key Topics in this Article (English)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li>
            <a
              href="#admit-card-overview-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Admit Card 2026 Overview</a
            >
          </li>
          <li>
            <a
              href="#how-to-download-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >How to Download Admit Card (Steps)</a
            >
          </li>
          <li>
            <a
              href="#admit-card-links-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Direct Links Table</a
            >
          </li>
          <li>
            <a
              href="#faq-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Frequently Asked Questions (FAQ)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (English) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <h2 id="admit-card-overview-en">Admit Card 2026 Overview</h2>
        
        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBuildingOffice className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">Exam Conducting Board</span>
              <span class="text-text-main font-semibold text-sm">Authority Name Here</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineCalendarDays className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">Written Exam Date</span>
              <span class="text-text-main font-semibold text-sm">DD Month YYYY</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBell className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">Hall Ticket Release Status</span>
              <span class="text-emerald-500 font-bold text-sm flex items-center gap-1">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> Released / Available
              </span>
            </div>
          </div>
        </div>

        <h2 id="how-to-download-en">How to Download the Exam Admit Card?</h2>
        <p>Follow these quick steps to access and print your exam hall ticket:</p>
        
        <div class="space-y-6 pl-2 border-l-2 border-primary/30 my-6">
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">1</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 1: Open the Direct Link</h4>
            <p class="text-sm text-text-muted m-0">Click the <strong>'Download Admit Card'</strong> link in the direct links table below.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">2</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 2: Enter Login Credentials</h4>
            <p class="text-sm text-text-muted m-0">Fill in your <strong>Registration Number / Roll Number</strong> and <strong>Password / Date of Birth</strong> in the login fields.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">3</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 3: Review Hall Ticket Details</h4>
            <p class="text-sm text-text-muted m-0">Verify your name, exam timing, venue, and reporting instructions carefully.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">4</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 4: Download & Print PDF</h4>
            <p class="text-sm text-text-muted m-0">Click on <strong>Print/Save as PDF</strong> and take a clean printout to bring to the exam center.</p>
          </div>
        </div>

        <!-- Admit Card Links Table (English) -->
        <h2 id="admit-card-links-en" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">Important Links & Downloads</h2>
