---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineBell, 
  HiOutlineXCircle, 
  HiOutlineBuildingOffice, 
  HiOutlineAcademicCap, 
  HiOutlineBriefcase 
} from "react-icons/hi2";

const latestJobs = [
  {
    title: "UPSC Civil Services Examination 2026",
    organisation: "Union Public Service Commission",
    qualification: "Degree in any discipline",
    vacancies: "1,056 Posts",
    startDate: "May 20, 2026",
    lastDate: "June 18, 2026",
    category: "UPSC",
    status: "apply-now",
    link: "https://upsc.gov.in"
  },
  {
    title: "SSC CGL Recruitment 2026",
    organisation: "Staff Selection Commission",
    qualification: "Bachelor's Degree",
    vacancies: "8,412 Posts",
    startDate: "June 10, 2026",
    lastDate: "July 10, 2026",
    category: "SSC",
    status: "upcoming",
    link: "https://ssc.gov.in"
  },
  {
    title: "SBI Probationary Officers (PO) 2026",
    organisation: "State Bank of India",
    qualification: "Graduation",
    vacancies: "2,000 Posts",
    startDate: "April 15, 2026",
    lastDate: "May 15, 2026",
    category: "Banking",
    status: "closed",
    link: "https://sbi.co.in"
  },
  {
    title: "RRB Assistant Loco Pilot (ALP) Vacancies",
    organisation: "Railway Recruitment Board",
    qualification: "Matriculation / ITI",
    vacancies: "5,696 Posts",
    startDate: "May 01, 2026",
    lastDate: "June 02, 2026",
    category: "Railways",
    status: "apply-now",
    link: "https://rrbcdg.gov.in"
  },
  {
    title: "MPSC State Services Examination 2026",
    organisation: "Maharashtra Public Service Commission",
    qualification: "Graduate Degree",
    vacancies: "500+ Posts",
    startDate: "June 15, 2026",
    lastDate: "July 15, 2026",
    category: "State Exams",
    status: "upcoming",
    link: "https://mpsc.gov.in"
  },
  {
    title: "IBPS Clerk CWE XII Recruitment",
    organisation: "Institute of Banking Personnel Selection",
    qualification: "Any Graduation Degree",
    vacancies: "6,000+ Posts",
    startDate: "May 25, 2026",
    lastDate: "June 20, 2026",
    category: "Banking",
    status: "upcoming",
    link: "https://ibps.in"
  },
  {
    title: "DRDO Scientist 'B' Recruitment",
    organisation: "Defence Research and Development Organisation",
    qualification: "First Class B.E / B.Tech",
    vacancies: "320 Posts",
    startDate: "June 02, 2026",
    lastDate: "June 25, 2026",
    category: "Direct Recruitment",
    status: "upcoming",
    link: "https://drdo.gov.in"
  }
];
---

<Layout title="Latest Government Jobs & Recruitments | AstroBlog" description="Explore the latest government job recruitments, official notification calendars, vacancies, eligibility, and direct apply-now portals.">
  <section class="pt-4 pb-16 not-prose">
    <!-- Header Section -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-2">
        <HiOutlineBriefcase className="text-sm" /> Live Openings
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-2 tracking-tight text-text-main m-0">
        Latest Jobs
      </h1>
      <p class="text-text-secondary text-[1.1rem] m-0 max-w-[600px] mx-auto">
        Stay updated with active vacancies, eligibility requirements, application dates, and direct recruitment portals.
      </p>
    </div>

    <!-- Latest Jobs List -->
    <div class="max-w-[1000px] mx-auto px-4 md:px-0">
      <div id="jobs-grid" class="flex flex-col gap-4 transition-all duration-300">
        {latestJobs.map((job, index) => (
          <div
            class="job-card-item flex flex-col md:flex-row md:items-center justify-between p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-primary opacity-0 animate-[fadeInUp_0.6s_ease_forwards] gap-4"
            style={`animation-delay: ${index * 0.08}s`}
          >
            <!-- Left: Info Block -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class="text-[0.65rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                  {job.category}
                </span>

                {job.status === "apply-now" && (
                  <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                    Apply Now
                  </span>
                )}

                {job.status === "upcoming" && (
                  <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-amber-500 animate-pulse inline-block"></span>
                    Upcoming
                  </span>
                )}

                {job.status === "closed" && (
                  <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                    Closed
                  </span>
                )}
              </div>

              <h3 class="text-base text-text-main font-bold leading-tight mb-1.5 truncate">{job.title}</h3>
              
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-text-muted mb-3">
                <div class="flex items-center gap-1.5 min-w-0">
                  <HiOutlineBuildingOffice className="shrink-0 text-xs text-primary/70" />
                  <span class="truncate">{job.organisation}</span>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <HiOutlineAcademicCap className="text-xs text-primary/70" />
                  <span>{job.qualification}</span>
                </div>
              </div>

              <!-- Bottom Meta Row: Last Date & Total Posts -->
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-[0.65rem] font-bold bg-primary/5 text-primary border border-solid border-primary/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                  Total Posts: <strong class="text-primary font-extrabold">{job.vacancies}</strong>
                </span>
                <span class="text-border-card/30 hidden sm:inline">|</span>
                <span class="flex items-center gap-1 text-[0.65rem] font-bold bg-rose-500/5 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                  <HiOutlineCalendarDays className="text-rose-500 text-xs shrink-0" /> Last Date: <strong class="font-extrabold">{job.lastDate}</strong>
                </span>
              </div>
            </div>

            <!-- Right: CTA Buttons -->
            <div class="shrink-0 w-full md:w-auto md:min-w-[180px]">
              {job.status === "apply-now" && (
                <a
                  href={job.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full md:w-auto btn-primary !rounded-xl !py-2.5 flex items-center justify-center gap-2 group/btn text-[0.65rem] font-bold uppercase tracking-wider px-5"
                >
                  <span>Apply Online</span>
                  <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                </a>
              )}

              {job.status === "upcoming" && (
                <button
                  type="button"
                  disabled
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-red-500/10 dark:bg-red-500/5 border border-solid border-red-500/20 text-red-500 dark:text-red-400 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center animate-pulse"
                >
                  <HiOutlineBell className="text-xs text-red-500 dark:text-red-400 shrink-0" />
                  <span>Upcoming Release</span>
                </button>
              )}

              {job.status === "closed" && (
                <button
                  type="button"
                  disabled
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-rose-500/5 border border-solid border-rose-500/15 text-rose-500/60 dark:text-rose-400/60 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center"
                >
                  <HiOutlineXCircle className="text-xs shrink-0" />
                  <span>Apply Closed</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
