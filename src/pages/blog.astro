---
import Layout from "../layouts/Layout.astro";
import BlogListItem from "../components/BlogListItem.astro";

const posts = [
  { title: "लातूर जिल्हा मध्यवर्ती सहकारी बँक निकाल २०२६: ३७५ पदांपैकी २६३ उमेदवारांची Phase 1 निवड यादी प्रसिद्ध", href: "/latur-dcc-bank-result-2026", date: "July 28, 2026" },
  { title: "MPSC गट-क संयुक्त परीक्षा २०२६: ३,०८८ जागांसाठी शुद्धिपत्रक व अर्ज मुदतवाढ जाहीर", href: "/mpsc-group-c-bharti-2026", date: "July 22, 2026" },
  { title: "MHT CET Counselling 2026: Registration & Document Verification Guide", href: "/admission/mht-cet-counselling-registration-documents-2026", date: "July 05, 2026" },
  { title: "Maharashtra ITI Admission 2026: Application Form, Dates, Merit List & Process", href: "/admission/iti-admission-2026-maharashtra", date: "May 20, 2026" },
  { title: "Post Office GDS Result 2026: State-wise Merit List & Cutoff Marks", href: "/result/post-office-gds-result-2026", date: "May 25, 2026" }
];
---

<Layout title="Blog Articles & Guides - How-To Tutorials & Tips | MahaSandhi" description="Browse all articles, how-to guides, and tutorials on MahaSandhi. Find step-by-step guides on banking, finance, Aadhar card, Google Gemini AI, mutual funds, and more at mahasandhi.in.">
  <section class="py-8 pb-24">
    <div class="mb-12 border-b border-border-card pb-8">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-text-main m-0">Article <span class="gradient-text">Archive</span></h1>
      <p class="text-text-muted text-lg m-0">Discover our full collection of articles organized by date.</p>
    </div>

    <div class="bg-bg-surface border border-border-card rounded-3xl transition-all duration-300 shadow-xl overflow-hidden px-3.5 sm:px-6 md:px-10">
      <div id="blog-list" class="flex flex-col">
        {
          posts.map((post, index) => (
            <div class="opacity-0 animate-[fadeInUp_0.6s_ease_forwards]" style={`animation-delay: ${index * 0.08}s`}>
              <BlogListItem {...post} number={index + 1} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
