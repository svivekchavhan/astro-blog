---
import Layout from "../layouts/Layout.astro";
import BlogListItem from "../components/BlogListItem.astro";

const posts = [
  { title: "The Ultimate Guide to Google Gemini AI: What It Is, How It Works, and How to Use It Every Day", href: "/blog/google-gemini-guide", date: "May 15, 2026" },
  { title: "How to Open a Savings Account in SBI: A Step-by-Step Guide", href: "/blog/how-to-open-sbi-account", date: "May 15, 2026" },
  { title: "What is Aadhar Card: Benefits, Features, and How to Get It", href: "/blog/what-is-aadhar-card", date: "May 14, 2026" },
  { title: "Which is the Best Mutual Fund Plan for 2026? A Complete Guide", href: "/blog/best-mutual-fund-plan", date: "May 13, 2026" }
];
---

<Layout title="Blog Articles & Guides - How-To Tutorials & Tips | TechFixSteps" description="Browse all articles, how-to guides, and tutorials on TechFixSteps. Find step-by-step guides on banking, finance, Aadhar card, Google Gemini AI, mutual funds, and more at techfixsteps.com.">
  <section class="py-8 pb-24">
    <div class="mb-12 border-b border-border-card pb-8">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-text-main m-0">Article <span class="gradient-text">Archive</span></h1>
      <p class="text-text-muted text-lg m-0">Discover our full collection of articles organized by date.</p>
    </div>

    <div class="bg-bg-surface border border-border-card rounded-3xl transition-all duration-300 shadow-xl overflow-hidden px-6 md:px-10">
      <div class="flex flex-col">
        {
          posts.map((post, index) => (
            <div class="opacity-0 animate-[fadeInUp_0.6s_ease_forwards]" style={`animation-delay: ${index * 0.08}s`}>
              <BlogListItem {...post} number={index + 1} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
