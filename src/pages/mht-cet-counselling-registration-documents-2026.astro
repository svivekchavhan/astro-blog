---
import Layout from "../layouts/Layout.astro";
import EventUpdateCard from "../components/EventUpdateCard.astro";

const title =
  "MHT CET Counselling 2026: Registration & Document Verification Guide";
const description =
  "Complete guide to MHT CET 2026 engineering counselling. Learn about E-Scrutiny vs Physical Scrutiny, required documents, Caste Validity, and important dates.";
const canonicalURL =
  "https://mahasandhi.in/mht-cet-counselling-registration-documents-2026";
const date = "July 05, 2026";
const category = "Admission";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-cyan-500/20"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic mb-8"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents (Marathi) -->
      <div
        class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12"
      >
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          या लेखातील मुख्य मुद्दे (मराठी)
        </h2>
        <ul
          class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2"
        >
          <li>
            <a
              href="#scrutiny-mode-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >१. पडताळणी पद्धत: Physical vs E-Scrutiny</a
            >
          </li>
          <li>
            <a
              href="#required-docs-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >२. प्रवेशासाठी आवश्यक कागदपत्रे</a
            >
          </li>
          <li>
            <a
              href="#tfws-oms-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >३. TFWS आणि OMS प्रवर्ग नियम</a
            >
          </li>
          <li>
            <a
              href="#important-dates-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >४. महत्त्वाच्या तारखा आणि वेळापत्रक</a
            >
          </li>
          <li>
            <a
              href="#common-issues-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >५. नावात चूक, पावती व इतर शंकांचे निरसन (FAQ)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <p>
          महाराष्ट्र राज्यातील अभियांत्रिकी (Engineering) आणि तंत्रज्ञान पदवी
          प्रवेशासाठीची <strong>MHT CET Counselling (CAP Rounds) २०२६</strong> ची
          प्रक्रिया सुरू झाली आहे. या संपूर्ण प्रवेश प्रक्रियेमध्ये सर्वात महत्त्वाचा
          आणि पहिला टप्पा म्हणजे <strong
            >कागदपत्रे पडताळणी (Document Verification)</strong
          > होय. जर कागदपत्रांमध्ये त्रुटी राहिली किंवा मुदतीपूर्वी पडताळणी झाली नाही,
          तर तुमचा अर्ज नाकारला जाऊ शकतो किंवा तुमची श्रेणी (Category) बदलून तुम्हाला
          प्रवेशासाठी खुल्या (Open) प्रवर्गात गृहीत धरले जाऊ शकते. त्यामुळे हा लेख
          काळजीपूर्वक वाचा.
        </p>

        <h2 id="scrutiny-mode-mr">
          १. पडताळणी पद्धत: Physical vs E-Scrutiny (कोणती निवडावी?)
        </h2>
        <p>
          सीईटी सेलने विद्यार्थ्यांसाठी दोन प्रकारचे पडताळणी पर्याय उपलब्ध करून
          दिले आहेत:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
            <h4
              class="text-text-main font-bold mt-0 mb-3 flex items-center gap-2"
            >
              <span class="text-emerald-500">🏢</span> भौतिक पडताळणी (Physical Scrutiny)
              - शिफारस
            </h4>
            <p class="text-sm text-text-muted leading-relaxed mb-0">
              • विद्यार्थ्यांना जवळच्या अधिकृत सुविधा केंद्रावर (FC Center)
              प्रत्यक्ष जावे लागते.<br />
              • तुमच्या समोरच मूळ कागदपत्रे तपासली जातात आणि त्वरित अर्ज कन्फर्म केला
              जातो.<br />
              • जर अर्जात काही चूक असेल, तर तिथेच लगेच दुरुस्त करता येते.<br />
              • <strong
                >महाराष्ट्रातील विद्यार्थ्यांनी या पद्धतीलाच प्राधान्य द्यावे.</strong
              >
            </p>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
            <h4
              class="text-text-main font-bold mt-0 mb-3 flex items-center gap-2"
            >
              <span class="text-amber-500">💻</span> ई-पडताळणी (E-Scrutiny)
            </h4>
            <p class="text-sm text-text-muted leading-relaxed mb-0">
              • कागदपत्रे ऑनलाईन स्कॅन करून अपलोड करावी लागतात.<br />
              • सीईटी सेलचे अधिकारी ऑनलाईन पडताळणी करतात.<br />
              • कागदपत्रांमध्ये चूक असल्यास अर्ज पुन्हा त्रुटीसह (Query) विद्यार्थ्याकडे
              पाठवला जातो.<br />
              • ही प्रक्रिया वेळ घेणारी असू शकते. महाराष्ट्र बाहेरील (OMS) विद्यार्थ्यांसाठी
              ही सोयीची आहे.
            </p>
          </div>
        </div>

        <h2 id="required-docs-mr">
          २. अभियांत्रिकी प्रवेशासाठी आवश्यक कागदपत्रे
        </h2>
        <p>पडताळणी पूर्ण करण्यासाठी खालील कागदपत्रे तयार ठेवावीत:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 my-8">
          {
            [
              {
                title: "MHT CET २०२६ / JEE Main गुणपत्रक",
                desc: "सीईटी किंवा जेईई परीक्षांचे स्कोअरकार्ड.",
              },
              {
                title: "दहावी व बारावीची गुणपत्रके",
                desc: "SSC आणि HSC मार्कशीट मूळ स्वरूपात.",
              },
              {
                title: "रहिवासी प्रमाणपत्र (Domicile)",
                desc: "महाराष्ट्र राज्याचा कोटा मिळवण्यासाठी आवश्यक.",
              },
              {
                title: "शाळा सोडल्याचा दाखला (LC/TC)",
                desc: "उमेदवाराचे राष्ट्रीयत्व आणि जन्मतारीख पडताळणीसाठी.",
              },
              {
                title: "जात प्रमाणपत्र (Caste Certificate)",
                desc: "राखीव प्रवर्गातील उमेदवारांसाठी (लागू असल्यास).",
              },
              {
                title: "जात वैधता प्रमाणपत्र (Validity)",
                desc: "अभियांत्रिकी प्रवेशासाठी वैध जात वैधता आवश्यक.",
              },
              {
                title: "नॉन-क्रिमी लेयर (NCL)",
                desc: "OBC, VJ/NT, SBC प्रवर्गासाठी (चालू आर्थिक वर्षाचे वैध).",
              },
              {
                title: "उत्पन्न प्रमाणपत्र (Income Certificate)",
                desc: "उत्पन्न ८ लाखांच्या आत असल्यास (TFWS/EWS साठी आवश्यक).",
              },
              {
                title: "जेईई स्कोर कार्ड (DigiLocker)",
                desc: "जेईई धारकांसाठी डिजीलॉकरद्वारे फेच केलेले स्कोरकार्ड.",
              },
            ].map((doc) => (
              <div class="bg-bg-card border border-border-card p-4 rounded-xl">
                <strong class="text-text-main block mb-1">
                  🗂️ {doc.title}
                </strong>
                <span class="text-xs text-text-muted">{doc.desc}</span>
              </div>
            ))
          }
        </div>

        <h2 id="tfws-oms-mr">३. TFWS आणि OMS प्रवर्ग नियम</h2>
        <div class="space-y-4">
          <p>
            <strong>Tuition Fee Waiver Scheme (TFWS):</strong> ज्या विद्यार्थ्यांच्या
            पालकांचे वार्षिक उत्पन्न ₹८ लाखांपेक्षा कमी आहे, ते या सवलतीसाठी पात्र
            आहेत. फॉर्ममध्ये यासाठी 'Yes' निवडावे. या जागेसाठी महाविद्यालयांचे स्वतंत्र
            कट-ऑफ लागतात आणि ते सहसा खूप जास्त असतात.
          </p>
          <p>
            <strong>Outside Maharashtra State (OMS):</strong> जे विद्यार्थी मूळचे
            महाराष्ट्रातील नाहीत किंवा ज्यांचे पालक बाहेरील राज्यातील असून डिफेन्समध्ये
            आहेत, ते OMS प्रवर्गात मोडतात. त्यांना सामान्यतः कोणतेही आरक्षण किंवा
            सरकारी सवलती मिळत नाहीत. त्यांना खुल्या (Open/General) प्रवर्गातूनच प्रवेश
            मिळतो.
          </p>
        </div>

        <h2 id="important-dates-mr">
          ४. महत्त्वाच्या तारखा आणि वेळापत्रक २०२६
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-cyan-500/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >शेवटची तारीख (Deadlines)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन नोंदणी आणि अर्ज सादर करणे</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >१२ जुलै २०२६ पर्यंत</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >कागदपत्रे पडताळणी व निश्चिती (E-Scrutiny / Physical)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold"
                  >१३ जुलै २०२६ (दुपारी ५:०० वाजेपर्यंत)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >तात्पुरती गुणवत्ता यादी जाहीर (Provisional Merit List)</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >१५ जुलै २०२६</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >हरकती नोंदवणे (Grievance Period)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold"
                  >१५ जुलै ते १८ जुलै २०२६ (१९ ते २२ जुलै पर्यंत मुदतवाढ)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अंतिम गुणवत्ता यादी प्रसिद्ध (Final Merit List)</td
                >
                <td
                  class="p-3 border border-border-card text-emerald-500 font-bold"
                  >२० जुलै २०२६</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Dynamic Event Update Card for Grievance Extension -->
        <div class="mb-8">
          <EventUpdateCard
            type="important"
            badgeText="मुदतवाढ (Extension)"
            title="Grievance Period (हरकती नोंदवणे) कालावधीत वाढ!"
            message="कॅप प्रवेश प्रक्रियेसाठी हरकती नोंदवण्याचा (Grievance Period) कालावधी अधिकृतपणे वाढवून आता १९ ते २२ जुलै २०२६ करण्यात आला आहे. उमेदवार त्यांच्या लॉगिनमध्ये जाऊन दुरुस्तीसाठी अर्ज करू शकतात."
            lastUpdated="July 16, 2026"
            links={[
              {
                text: "लॉगिन करा (Login Now)",
                href: "https://cetcell.mahacet.org/",
                isPrimary: true,
              },
            ]}
          />
        </div>

        <div class="bg-cyan-500/5 border border-cyan-500/20 p-6 rounded-2xl mb-8">
          <p class="m-0 text-sm font-semibold">
            📢 <strong>महत्त्वाची टीप:</strong> तुमचा अर्ज यशस्वीरीत्या पडताळणी झाल्यानंतर
            तुमच्या प्रोफाईलमध्ये <strong
              >"Your application form is verified and confirmed by the FC
              Center"</strong
            > असा स्टेटस दिसणे आवश्यक आहे. हा स्टेटस आल्यावरच तुमचा अर्ज कॅप राउंडसाठी
            पात्र ठरतो.
          </p>
        </div>

        <h2 id="common-issues-mr">
          ५. नावात चूक, पावती आणि इतर शंकांचे निरसन (FAQ)
        </h2>

        <div class="space-y-4 my-6">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mt-0 mb-2">
              प्रश्न: माझ्या मार्कशीट आणि आधार कार्डमधील नावाच्या स्पेलिंगमध्ये
              फरक आहे, अर्ज रिजेक्ट होईल का?
            </h3>
            <p class="text-sm text-text-muted m-0">
              <strong>उत्तर:</strong> यामुळे तुमचा अर्ज थेट रिजेक्ट होत नाही. नावामध्ये
              किरकोळ स्पेलिंगच्या चुका असतील तर तुम्ही <strong
                >₹५०० च्या नोटरी स्टॅम्प पेपरवर एक प्रतिज्ञापत्र (Affidavit)</strong
              > तयार करून घ्या आणि फिजिकल स्क्रूटनी दरम्यान ते सादर करा.
            </p>
          </div>

          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mt-0 mb-2">
              प्रश्न: माझ्याकडे मूळ जात वैधता प्रमाणपत्र (Caste Validity)
              नाहीये, मी काय करू?
            </h3>
            <p class="text-sm text-text-muted m-0">
              <strong>उत्तर:</strong> जर मूळ वैधता प्रमाणपत्र आले नसेल, तर तुम्ही
              अर्ज करताना मिळालेली **पावती (Receipt)** अपलोड करू शकता. परंतु, कॅप
              राउंडच्या प्रवेशावेळी तुम्हाला मूळ प्रमाणपत्र सादर करावे लागेल.
            </p>
          </div>

          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mt-0 mb-2">
              प्रश्न: जात वैधता प्रमाणपत्र पावती अपलोड करताना API किंवा तांत्रिक
              त्रुटी येत आहे.
            </h3>
            <p class="text-sm text-text-muted m-0">
              <strong>उत्तर:</strong> अशा वेळी तात्पुरते लॉग आऊट करा, इंटरनेट ब्राउझर
              बदलून पहा (उदा. Google Chrome चा वापर करा) किंवा इनकॉग्निटो विंडोमध्ये
              प्रयत्न करा. तरीही अडचण आल्यास फिजिकल स्क्रूटनी सेंटरला भेट द्या.
            </p>
          </div>

          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mt-0 mb-2">
              प्रश्न: कागदपत्रांमध्ये जात वैधता क्रमांक कोणता टाकावा?
            </h3>
            <p class="text-sm text-text-muted m-0">
              <strong>उत्तर:</strong> जात वैधता प्रमाणपत्राचा नंबर टाकताना बारकोडच्या
              खालचा क्रमांक टाकू नये. प्रमाणपत्रावर स्पष्टपणे दिलेला <strong
                >जावक क्रमांक (Outward Number)</strong
              > हाच नंबर फॉर्ममध्ये प्रविष्ट करावा.
            </p>
          </div>

          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mt-0 mb-2">
              प्रश्न: ई-पडताळणीत माझ्या अर्जाची वर्गवारी ओबीसीवरून खुल्या (Open)
              प्रवर्गात बदलली आहे, यावर काय उपाय?
            </h3>
            <p class="text-sm text-text-muted m-0">
              <strong>उत्तर:</strong> कागदपत्रांमध्ये त्रुटी असल्यामुळे अधिकारी प्रवर्ग
              बदलतात. तुम्ही तुमच्या लॉगिनमध्ये जाऊन काय अडचण आली आहे ते तपासा. योग्य
              कागदपत्रे पुन्हा अपलोड करा किंवा जवळच्या फिजिकल स्क्रूटनी केंद्रावर
              जाऊन दुरुस्ती करून घ्या.
            </p>
          </div>

          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
