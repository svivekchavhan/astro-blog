---
import Layout from "../../layouts/Layout.astro";
import { HiOutlineCalendarDays, HiOutlineArrowTopRightOnSquare, HiOutlineBell, HiOutlineBuildingOffice } from "react-icons/hi2";

const admitCards = [
  {
    title: "TMC Thane Hall Ticket 2026: ठाणे मनपा अग्निशमन व अभियांत्रिकी प्रवेशपत्र डाऊनलोड",
    organisation: "ठाणे महानगरपालिका (TMC)",
    category: "State Govt",
    releaseDate: "22 August 2026",
    examDate: "01 & 02 September 2026",
    status: "available",
    link: "/tmc-thane-hall-ticket-2026"
  },
  {
    title: "बॉम्बे उच्च न्यायालय लिपिक हॉल तिकीट २०२६: टंकलेखक चाचणी प्रवेशपत्र ऑनलाईन उपलब्ध",
    organisation: "बॉम्बे उच्च न्यायालय (BHC)",
    category: "State Govt / Court",
    releaseDate: "15 August 2026",
    examDate: "August / September 2026",
    status: "available",
    link: "/bhc-clerk-admit-card-2026"
  },
  {
    title: "वनार्टी (VANARTI) प्रवेशपत्र २०२६: हॉलतिकीट उपलब्ध झाले आहे.",
    organisation: "वनार्टी (VANARTI)",
    category: "Free Coaching",
    releaseDate: "10 August 2026",
    examDate: "August 2026",
    status: "available",
    link: "/vanarti-admit-card-2026"
  },
  {
    title: "MH SET Exam Date Postponed 2026: महाराष्ट्र सेट परीक्षा पुढे ढकलली, नवीन तारीख जाहीर",
    organisation: "सावित्रीबाई फुले पुणे विद्यापीठ (SPPU)",
    category: "Exam Date",
    releaseDate: "20 July 2026",
    examDate: "27 September 2026",
    status: "available",
    link: "/admit-card/maharashtra-set-exam-date-postponed"
  },
  {
    title: "NMMC Hall Ticket Download 2026: नवी मुंबई महानगरपालिका हॉलतिकीट उपलब्ध",
    organisation: "नवी मुंबई महानगरपालिका (NMMC)",
    category: "State Govt",
    releaseDate: "10 July 2026",
    examDate: "21 - 22 July 2026",
    status: "available",
    link: "/admit-card/nmmc-hall-ticket-download"
  },
  {
    title: "कामगार विभाग भरती हॉलतिकीट उपलब्ध..",
    organisation: "कामगार विभाग (Kamgar Vibhag)",
    category: "State Govt",
    releaseDate: "20 July 2026",
    examDate: "TBA",
    status: "available",
    link: "https://cdn.digialm.com/EForms/configuredHtml/33058/95164/login.html"
  },
  {
    title: "Indian Army Agniveer Admit Card 2026: भारतीय लष्कर अग्निवीर प्रवेश पत्र उपलब्ध",
    organisation: "Indian Army",
    category: "Agniveer",
    releaseDate: "02 June 2026",
    examDate: "June - July 2026",
    status: "available",
    link: "/admit-card/agniveer-admit-card-2026"
  }
];
---

<Layout title="Admit Card Download 2026 - Hall Ticket & Exam Date Schedule | MahaSandhi" description="Download official admit cards and hall tickets 2026. Get UPSC, SSC, SBI, IBPS, RRB, MPSC exam admit card release dates, exam schedules, and direct download links at mahasandhi.in.">
  <section class="pt-4 pb-16 not-prose">
    <h1 class="sr-only">Admit Cards</h1>

    <!-- Admit Cards List -->
    <div class="max-w-[1000px] mx-auto px-2 md:px-0">
      <div id="admit-cards-grid" class="flex flex-col gap-3 md:gap-4 transition-all duration-300">
        {admitCards.length === 0 ? (
          <div class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl">
            <p class="text-text-muted text-sm m-0">No active admit card releases at the moment. Please check back later!</p>
          </div>
        ) : (
          admitCards.map((card, index) => (
            <div
              data-title={card.title}
              data-org={card.organisation}
              data-category={card.category}
              class="group admit-card-item flex flex-col md:flex-row md:items-center justify-between p-3.5 md:p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-primary gap-3 md:gap-4"
            >
              <!-- Left: Info Block -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <span class="text-[0.65rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                    {card.category}
                  </span>

                  {card.status === "available" && (
                    <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Available Now
                    </span>
                  )}

                  {card.status === "expected" && (
                    <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1 h-1 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-amber-500 animate-pulse inline-block"></span>
                      Expected Soon
                    </span>
                  )}

                  {card.status === "closed" && (
                    <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                      Closed
                    </span>
                  )}
                </div>

                <a href={card.link} class="no-underline hover:no-underline block">
                  <h3 class="text-base text-text-main font-bold leading-tight mb-1 group-hover:text-primary transition-colors">{card.title}</h3>
                </a>
                <div class="flex flex-wrap items-center justify-between gap-2.5">
                  <div class="flex items-center gap-1.5 text-xs text-text-muted">
                    <HiOutlineBuildingOffice className="shrink-0 text-xs" />
                    <span class="truncate">{card.organisation}</span>
                  </div>

                  <!-- Date Pills below the title -->
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="flex items-center gap-1 text-[0.65rem] font-bold bg-primary/5 text-primary border border-solid border-primary/20 px-2.5 py-1 rounded-lg uppercase tracking-wider shadow-sm">
                      <HiOutlineCalendarDays className="text-primary text-xs shrink-0" /> Release: {card.releaseDate}
                    </span>
                    <span class="flex items-center gap-1 text-[0.65rem] font-bold bg-rose-500/5 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/20 px-2.5 py-1 rounded-lg uppercase tracking-wider shadow-sm">
                      <HiOutlineCalendarDays className="text-rose-500 text-xs shrink-0" /> Exam: {card.examDate}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Right: CTA Buttons -->
              <div class="shrink-0 w-full md:w-auto md:min-w-[180px]">
                {card.status === "available" && (
                  <a
                    href={card.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full md:w-auto btn-primary !rounded-xl !py-2 flex items-center justify-center gap-2 group/btn text-[0.65rem] font-bold uppercase tracking-wider px-5"
                  >
                    <span>Download Hall Ticket</span>
                    <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                  </a>
                )}

                {card.status === "expected" && (
                  <button
                    type="button"
                    disabled
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 bg-red-500/10 dark:bg-red-500/5 border border-solid border-red-500/20 text-red-500 dark:text-red-400 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center animate-pulse"
                  >
                    <HiOutlineBell className="text-xs text-red-500 dark:text-red-400 shrink-0" />
                    <span>Coming Soon</span>
                  </button>
                )}

                {card.status === "closed" && (
                  <button
                    type="button"
                    disabled
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 bg-rose-500/5 border border-solid border-rose-500/15 text-rose-500/60 dark:text-rose-400/60 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center"
                  >
                    <span>Download Closed</span>
                  </button>
                )}
              </div>
            </div>
          ))
        )}
      </div>
    </div>

  </section>
</Layout>
