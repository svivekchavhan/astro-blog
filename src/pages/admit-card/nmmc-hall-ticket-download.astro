---
import Layout from "../../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineBell,
  HiOutlineArrowDownTray
} from "react-icons/hi2";

const title = "NMMC Hall Ticket Download 2026: नवी मुंबई महानगरपालिका प्रवेश पत्र उपलब्ध";
const description = "Download Navi Mumbai Municipal Corporation (NMMC) Admit Card 2026. Get direct links for candidate login, mock test, official notification, and exam instructions here.";
const canonicalURL = "https://mahasandhi.in/admit-card/nmmc-hall-ticket-download";
const date = "July 10, 2026";
const category = "Admit Card";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents (Marathi) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
          ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          या लेखातील मुख्य मुद्दे (मराठी)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li>
            <a
              href="#admit-card-overview-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Admit Card सविस्तर माहिती</a
            >
          </li>
          <li>
            <a
              href="#official-notice-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >अधिकृत प्रसिद्धी पत्रक / सूचनापत्र</a
            >
          </li>
          <li>
            <a
              href="#how-to-download-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >हॉल तिकीट कसे डाउनलोड करावे? (पायऱ्या)</a
            >
          </li>
          <li>
            <a
              href="#admit-card-links-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >महत्वाच्या लिंक्स आणि डाउनलोड टेबल</a
            >
          </li>
          <li>
            <a
              href="#faq-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >वारंवार विचारले जाणारे प्रश्न (FAQ)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <p>
          <strong>नवी मुंबई महानगरपालिका (NMMC)</strong> द्वारे आयोजित करण्यात आलेल्या <strong>सरळसेवा भरती २०२५-२०२६</strong> परीक्षेचे हॉल तिकीट / प्रवेश पत्र जाहीर करण्यात आले आहे. परीक्षा दिनांक २१ आणि २२ जुलै २०२६ रोजी संपूर्ण राज्यातील विविध केंद्रांवर ऑनलाईन पद्धतीने घेतली जाणार आहे. पात्र उमेदवारांनी आपले प्रवेश पत्र आणि मॉक टेस्ट लिंक खालील तक्त्यामध्ये दिलेल्या डायरेक्ट लिंकद्वारे त्वरित तपासावे.
        </p>

        <h2 id="admit-card-overview-mr">Admit Card सविस्तर माहिती</h2>
        
        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBuildingOffice className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">परीक्षा मंडळ (Authority)</span>
              <span class="text-text-main font-semibold text-sm">नवी मुंबई महानगरपालिका (NMMC)</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineCalendarDays className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">परीक्षा दिनांक (Exam Date)</span>
              <span class="text-text-main font-semibold text-sm">२१ व २२ जुलै २०२६</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBell className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">प्रवेश पत्र स्थिती (Status)</span>
              <span class="text-emerald-500 font-bold text-sm flex items-center gap-1">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> उपलब्ध (Available Now)
              </span>
            </div>
          </div>
        </div>

        <!-- Official Notice Box -->
        <h2 id="official-notice-mr">अधिकृत प्रसिद्धी पत्रक / सूचनापत्र</h2>
        <div class="bg-bg-surface border-l-4 border-primary border-y border-r border-border-card rounded-r-2xl p-6 my-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-border-card dark:border-border-card/30 pb-3 mb-4 flex-wrap gap-2">
            <span class="text-xs font-bold text-primary uppercase tracking-wide flex items-center gap-1.5">
              <HiOutlineDocumentText className="text-lg" /> NMMC Official Notice Board
            </span>
            <span class="text-xs font-semibold text-text-muted">दिनांक: १०/०७/२०२६</span>
          </div>
          
          <div class="text-xs sm:text-sm text-text-secondary whitespace-pre-line leading-relaxed font-sans Marathi-notice-content">
            <strong>सरळसेवा भरती २०२५-२०२६ - सूचनापत्र</strong>

            <strong>विषय :-</strong> नवी मुंबई महानगरपालिका सरळसेवा भरती २०२५-२०२६ परीक्षेसाठी ऑनलाईन प्रवेशपत्राबाबत. (Admit Card)

            नवी मुंबई महानगरपालिकेच्या नियमीत आस्थापनेवरील "गट-अ", "गट-ब" व "गट-क" मधील सरळसेवेच्या रिक्त पदांवर पदभरती करणेबाबतची जाहिरात क्रमांक आस्था/०२/२०२५, जाहिरात क्रमांक आस्था/०३/२०२५ व जाहिरात क्रमांक आस्था/०४/२०२५, दिनांक १४/१२/२०२५ रोजी दैनिक वृत्तपत्रांमध्ये तसेच सविस्तर जाहिरात नवी मुंबई महानगरपालिकेच्या अधिकृत संकेतस्थळावर प्रसिध्द करण्यात आलेली आहे.

            २. प्रस्तुत जाहिरातीच्या अनुषंगाने नवी मुंबई महानगरपालिका सरळसेवा भरती २०२५-२०२६ अंतर्गत दि.२१ जुलै, २०२६ व दि.२२ जुलै, २०२६ रोजी होणा-या ऑनलाईन परीक्षेस पात्र असलेल्या उमेदवारांचे परीक्षेचे प्रवेश पत्र (Admit Card) दि.१०/०७/२०२६ पासून उपलब्ध करून देण्यात येणार आहेत याची उमेदवारांनी नोंद घ्यावी. 
            त्या अनुषंगाने उमेदवारांनी नवी मुंबई महानगरपालिकेच्या www.nmmc.gov.in या अधिकृत संकेतस्थळावरून त्यांचे परीक्षेचे प्रवेशपत्र (Admit Card) डाऊनलोड करून घ्यावीत.

            <strong>(सुनील पवार) 10/07/2026</strong>
            नवी मुंबई महानगरपालिका
            अतिरिक्त आयुक्त (१)
          </div>
        </div>

        <h2 id="how-to-download-mr">हॉल तिकीट डाउनलोड कसे करावे? (Steps)</h2>
        <p>आपले प्रवेश पत्र डाउनलोड करण्यासाठी खालील सोप्या पायऱ्यांचे अनुसरण करा:</p>
        
        <div class="space-y-6 pl-2 border-l-2 border-primary/30 my-6">
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">1</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 1: प्रवेश पत्र डाऊनलोड लिंकवर क्लिक करा</h4>
            <p class="text-sm text-text-muted m-0">खाली दिलेल्या तक्त्यामध्ये <strong>'Download Hall Ticket'</strong> लिंकवर क्लिक करा.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">2</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 2: लॉगिन क्रेडेन्शियल भरा</h4>
            <p class="text-sm text-text-muted m-0">तुमचा <strong>Registration ID / Application Number</strong> आणि <strong>Password (जन्मतारीख)</strong> टाकून लॉगिन करा.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">3</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 3: प्रवेश पत्र डाऊनलोड करा</h4>
            <p class="text-sm text-text-muted m-0">लॉगिन यशस्वी झाल्यावर <strong>Download Admit Card</strong> बटणावर क्लिक करा आणि PDF सेव्ह करा.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">4</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 4: प्रिंट काढा</h4>
            <p class="text-sm text-text-muted m-0">परीक्षेच्या दिवशी ओळखपत्रासोबत हॉल तिकीटची एक रंगीत किंवा स्वच्छ प्रिंट सोबत ठेवा.</p>
          </div>
        </div>

        <!-- Admit Card Links Table (Marathi) -->
        <h2 id="admit-card-links-mr" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">प्रवेश पत्र आणि महत्वाच्या लिंक्स (Important Links Table)</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Event / Resource)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">लिंक / कृती (Direct Link / Action)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">प्रवेश पत्र डाउनलोड करा (Direct Admit Card Link)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://cdn.digialm.com/EForms/configuredHtml/32963/97335/login.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold uppercase tracking-wider rounded-lg transition-all shadow-sm w-full sm:w-auto">
                    <HiOutlineArrowDownTray className="text-base shrink-0 animate-bounce" /> डाउनलोड करा (Click Here)
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">परीक्षा मॉक टेस्ट लिंक (Mock Test Link)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://cdn4.digialm.com/OnlineAssessment/index.html?32963@@M212" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto">
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> मॉक टेस्ट (Practice Link)
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">अधिकृत संकेतस्थळ (Official Website)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://www.nmmc.gov.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto">
                    <HiOutlineArrowTopRightOnSquare className="text-base shrink-0" /> nmmc.gov.in
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section (Marathi) -->
        <h2 id="faq-mr" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">वारंवार विचारले जाणारे प्रश्न (FAQ)</h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न १: नवी मुंबई महानगरपालिका भरतीची परीक्षा केव्हा आहे?</h3>
            <p class="text-text-muted m-0">उत्तर १: NMMC सरळसेवा परीक्षा दिनांक २१ जुलै आणि २२ जुलै २०२६ रोजी आयोजित करण्यात आलेली आहे.</p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न २: हॉल तिकीट डाउनलोड करण्यासाठी कोणती माहिती आवश्यक आहे?</h3>
            <p class="text-text-muted m-0">उत्तर २: उमेदवारांकडे अर्ज नोंदणी आयडी (User ID) आणि पासवर्ड असणे आवश्यक आहे.</p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">प्रश्न ३: परीक्षा देण्यापूर्वी मला सराव चाचणी देता येईल का?</h3>
            <p class="text-text-muted m-0">उत्तर ३: होय, महामंडळाने ऑनलाईन परीक्षेच्या तयारीसाठी अधिकृत मॉक टेस्ट लिंक उपलब्ध करून दिली आहे. आपण वर दिलेल्या तक्त्यातील 'मॉक टेस्ट' लिंकवरून सराव करू शकता.</p>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="bg-primary/5 border border-primary/20 p-8 rounded-3xl text-center my-8">
          <h2 class="text-2xl font-black text-text-main mb-4 border-none p-0 mt-0">ताज्या अपडेट्ससाठी जॉईन करा!</h2>
          <p class="text-text-muted mb-6">परीक्षा, निकाल आणि प्रवेश पत्राच्या ताज्या घडामोडी सर्वात आधी मिळवण्यासाठी आमच्या व्हॉट्सॲप आणि टेलिग्राम ग्रुपमध्ये सामील व्हा.</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="#" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm">
              WhatsApp Group
            </a>
            <a href="#" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm">
              Telegram Channel
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative">
      <span class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md">
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-text-main mb-4">
          NMMC Hall Ticket Download 2026: Direct Link to Download Admit Card & Mock Test
        </h2>
        <p class="text-text-muted leading-relaxed italic">
          Navi Mumbai Municipal Corporation (NMMC) has officially released the admit cards for Group A, B, and C recruitment exams 2026. The online computer-based exam is scheduled for July 21 and 22, 2026. Access direct links to download hall tickets and practice the mock tests below.
        </p>
      </div>

      <!-- Table of Contents (English) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
