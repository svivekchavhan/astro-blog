---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineUser,
  HiOutlineClipboard,
  HiOutlineTrash,
  HiOutlineArrowLeft,
  HiOutlineInformationCircle,
  HiOutlineClock,
} from "react-icons/hi2";

const title =
  "Age Calculator: Calculate Age Online in Years, Months & Days | MahaDisha";
const description =
  "Calculate your exact age in years, months, and days online. Get next birthday countdown, total days, weeks, and hours. Perfect for MPSC, Police Bharti, and other government job forms.";
---

<Layout title={title} description={description} hideSidebar={true}>
  <section class="pt-4 pb-16 not-prose">
    <!-- Back to Hub link -->
    <div class="max-w-[700px] mx-auto px-2 md:px-0 mb-6">
      <a
        href="/calculator"
        class="inline-flex items-center gap-1.5 text-xs text-primary hover:text-secondary font-bold uppercase tracking-wider transition-colors no-underline"
      >
        <HiOutlineArrowLeft className="text-sm" /> Back to Calculators
      </a>
    </div>

    <!-- Header Section -->
    <div class="text-center mb-8">
      <h1
        class="text-3xl md:text-5xl font-extrabold mb-3 tracking-tight text-text-main m-0"
      >
        Age Calculator
      </h1>
    </div>

    <!-- Main Container -->
    <div class="max-w-[700px] mx-auto px-2 md:px-0">
      <div
        class="bg-bg-surface border border-border-card rounded-3xl p-6 md:p-8 shadow-sm"
      >
        <!-- Form -->
        <form id="age-calc-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Date of Birth Input -->
            <div class="flex flex-col gap-2">
              <label
                for="dob"
                class="text-sm font-bold text-text-main flex items-center gap-1.5"
              >
                <HiOutlineUser className="text-primary text-base" /> Date of Birth
                (जन्म तारीख)
              </label>
              <input
                type="date"
                id="dob"
                name="dob"
                required
                class="w-full bg-bg-base border-2 border-border-card rounded-2xl px-4 py-3 text-text-main font-semibold focus:border-primary focus:outline-none transition-all duration-300 shadow-sm"
              />
            </div>

            <!-- Age at Date Input -->
            <div class="flex flex-col gap-2">
              <label
                for="ageAt"
                class="text-sm font-bold text-text-main flex items-center gap-1.5"
              >
                <HiOutlineCalendarDays className="text-primary text-base" /> Age at
                Date (या तारखेपर्यंत वय मोजा)
              </label>
              <input
                type="date"
                id="ageAt"
                name="ageAt"
                required
                class="w-full bg-bg-base border-2 border-border-card rounded-2xl px-4 py-3 text-text-main font-semibold focus:border-primary focus:outline-none transition-all duration-300 shadow-sm"
              />
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex gap-4 pt-2">
            <button
              type="submit"
              class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-primary to-secondary hover:shadow-[0_0_15px_rgba(56,189,248,0.4)] text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-all shadow-sm cursor-pointer border-none"
            >
              Calculate Age
            </button>
            <button
              type="button"
              id="btn-reset"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-3.5 bg-rose-500/5 hover:bg-rose-500/10 border border-solid border-rose-500/20 text-rose-500 font-bold uppercase tracking-wider text-xs rounded-xl cursor-pointer transition-colors"
              title="Reset Form"
            >
              <HiOutlineTrash className="text-base" />
            </button>
          </div>
        </form>

        <!-- Error Message Alert -->
        <div
          id="error-alert"
          class="hidden mt-6 p-4 bg-rose-500/10 border border-rose-500/20 rounded-2xl flex items-start gap-3 text-rose-500 text-sm"
        >
          <HiOutlineInformationCircle className="text-lg shrink-0 mt-0.5" />
          <div>
            <strong class="font-bold">Error:</strong> Date of Birth must be before
            the target Age-at Date.
          </div>
        </div>

        <!-- Results Section (Initially Hidden) -->
        <div
          id="results-section"
          class="hidden mt-8 space-y-6 pt-6 border-t border-border-card dark:border-border-card/30 animate-[fadeInUp_0.5s_ease_forwards]"
        >
          <!-- Large Quick Summary Card -->
          <div
            class="text-center bg-gradient-to-br from-primary/5 to-secondary/5 border border-primary/20 rounded-2xl p-6 relative overflow-hidden"
          >
            <span
              class="text-[0.65rem] bg-primary/10 text-primary border border-primary/20 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider"
              >Your Exact Age</span
            >
            <div
              id="main-result"
              class="text-2xl md:text-3xl font-black text-text-main mt-3 leading-tight"
            >
              <!-- Result string injected here -->
            </div>
            <div
              id="main-result-mr"
              class="text-sm md:text-base text-text-muted mt-2 font-medium"
            >
              <!-- Marathi translation string injected here -->
            </div>
          </div>

          <!-- Secondary Grid Details -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div
              class="bg-bg-base border border-border-card p-4 rounded-2xl text-center"
            >
              <span
                class="text-[0.6rem] text-text-muted block uppercase font-bold tracking-wider mb-1"
                >Total Months</span
              >
              <span
                id="stat-months"
                class="text-xl font-extrabold text-text-main">--</span
              >
            </div>

            <div
              class="bg-bg-base border border-border-card p-4 rounded-2xl text-center"
            >
              <span
                class="text-[0.6rem] text-text-muted block uppercase font-bold tracking-wider mb-1"
                >Total Weeks</span
              >
              <span
                id="stat-weeks"
                class="text-xl font-extrabold text-text-main">--</span
              >
            </div>

            <div
              class="bg-bg-base border border-border-card p-4 rounded-2xl text-center"
            >
              <span
                class="text-[0.6rem] text-text-muted block uppercase font-bold tracking-wider mb-1"
                >Total Days</span
              >
              <span id="stat-days" class="text-xl font-extrabold text-text-main"
                >--</span
              >
            </div>

            <div
              class="bg-bg-base border border-border-card p-4 rounded-2xl text-center col-span-2 md:col-span-3 flex flex-col md:flex-row items-center justify-center gap-2 py-3.5"
            >
              <HiOutlineClock className="text-primary text-lg" />
              <span class="text-xs text-text-muted font-semibold"
                >Next Birthday:</span
              >
              <span
                id="stat-next-birthday"
                class="text-xs font-bold text-text-main">--</span
              >
            </div>
          </div>

          <!-- Utility copy button -->
          <div class="flex justify-end pt-2">
            <button
              type="button"
              id="btn-copy"
              class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary border border-primary/20 text-xs font-bold uppercase tracking-wider rounded-xl transition-colors cursor-pointer"
            >
              <HiOutlineClipboard className="text-base" /> Copy Results
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupCalculator() {
    const form = document.getElementById(
      "age-calc-form",
    ) as HTMLFormElement | null;
    const dobInput = document.getElementById("dob") as HTMLInputElement | null;
    const ageAtInput = document.getElementById(
      "ageAt",
    ) as HTMLInputElement | null;
    const resetButton = document.getElementById(
      "btn-reset",
    ) as HTMLButtonElement | null;
    const copyButton = document.getElementById(
      "btn-copy",
    ) as HTMLButtonElement | null;

    const errorAlert = document.getElementById("error-alert");
    const resultsSection = document.getElementById("results-section");

    const mainResultEl = document.getElementById("main-result");
    const mainResultMrEl = document.getElementById("main-result-mr");
    const statMonthsEl = document.getElementById("stat-months");
    const statWeeksEl = document.getElementById("stat-weeks");
    const statDaysEl = document.getElementById("stat-days");
    const statNextBdayEl = document.getElementById("stat-next-birthday");

    if (!form || !dobInput || !ageAtInput) return;

    // Set Default target date to today
    const today = new Date().toISOString().split("T")[0];
    ageAtInput.value = today;

    // Reset handler
    resetButton?.addEventListener("click", () => {
      form.reset();
      ageAtInput.value = today;
      resultsSection?.classList.add("hidden");
      errorAlert?.classList.add("hidden");
    });

    // Form Submit Calculator logic
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const dobVal = dobInput.value;
      const ageAtVal = ageAtInput.value;

      if (!dobVal || !ageAtVal) return;

      const dob = new Date(dobVal);
      const ageAt = new Date(ageAtVal);

      if (dob >= ageAt) {
        errorAlert?.classList.remove("hidden");
        resultsSection?.classList.add("hidden");
        return;
      }

      errorAlert?.classList.add("hidden");

      // Calculate Age
      let years = ageAt.getFullYear() - dob.getFullYear();
      let months = ageAt.getMonth() - dob.getMonth();
      let days = ageAt.getDate() - dob.getDate();

      if (days < 0) {
        // Borrow days from previous month
        const prevMonth = new Date(ageAt.getFullYear(), ageAt.getMonth(), 0);
        days += prevMonth.getDate();
        months--;
      }

      if (months < 0) {
        months += 12;
        years--;
      }

      // Exact Age string
      const resultEn = `${years} Years, ${months} Months, ${days} Days`;
      const resultMr = `${years} वर्षे, ${months} महिने, ${days} दिवस`;

      // Statistics
      const diffMs = ageAt.getTime() - dob.getTime();
      const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const totalWeeks = Math.floor(totalDays / 7);
      const totalMonths = years * 12 + months;

      // Next Birthday Countdown
      const nextBdayYear =
        ageAt.getMonth() > dob.getMonth() ||
        (ageAt.getMonth() === dob.getMonth() &&
          ageAt.getDate() >= dob.getDate())
          ? ageAt.getFullYear() + 1
          : ageAt.getFullYear();

      const nextBday = new Date(nextBdayYear, dob.getMonth(), dob.getDate());
      let nextDiffMs = nextBday.getTime() - ageAt.getTime();
      const nextTotalDays = Math.ceil(nextDiffMs / (1000 * 60 * 60 * 24));

      // Express next birthday in months and days
      let nextMonths = nextBday.getMonth() - ageAt.getMonth();
      let nextDays = nextBday.getDate() - ageAt.getDate();

      if (nextDays < 0) {
        const prevMonth = new Date(
          nextBday.getFullYear(),
          nextBday.getMonth(),
          0,
        );
        nextDays += prevMonth.getDate();
        nextMonths--;
      }
      if (nextMonths < 0) {
        nextMonths += 12;
      }

      let nextBdayString = "";
      if (nextTotalDays === 365 || nextTotalDays === 0) {
        nextBdayString = "Happy Birthday! Today is your birthday! 🎂";
      } else {
        const nextBdayDayOfWeek = nextBday.toLocaleDateString("en-US", {
          weekday: "long",
        });
        nextBdayString = `${nextMonths} months and ${nextDays} days remaining (will fall on a ${nextBdayDayOfWeek})`;
      }

      // Inject results into UI
      if (mainResultEl) mainResultEl.textContent = resultEn;
      if (mainResultMrEl) mainResultMrEl.textContent = resultMr;
      if (statMonthsEl) statMonthsEl.textContent = totalMonths.toLocaleString();
      if (statWeeksEl) statWeeksEl.textContent = totalWeeks.toLocaleString();
      if (statDaysEl) statDaysEl.textContent = totalDays.toLocaleString();
      if (statNextBdayEl) statNextBdayEl.textContent = nextBdayString;

      // Show Results container
      resultsSection?.classList.remove("hidden");
    });

    // Copy Results trigger
    copyButton?.addEventListener("click", () => {
      if (
        !mainResultEl ||
        !mainResultMrEl ||
        !statMonthsEl ||
        !statWeeksEl ||
        !statDaysEl ||
        !statNextBdayEl
      )
        return;

      const textToCopy = `Age Calculation Results (MahaDisha):\n------------------------------------\nAge: ${mainResultEl.textContent} (${mainResultMrEl.textContent})\nTotal Months: ${statMonthsEl.textContent}\nTotal Weeks: ${statWeeksEl.textContent}\nTotal Days: ${statDaysEl.textContent}\nNext Birthday: ${statNextBdayEl.textContent}\nCalculated via: mahadisha.in/age-calculator`;

      navigator.clipboard
        .writeText(textToCopy)
        .then(() => {
          const originalText = copyButton.innerHTML;
          copyButton.innerHTML = "✓ Copied!";
          setTimeout(() => {
            copyButton.innerHTML = originalText;
          }, 2000);
        })
        .catch((err) => {
          console.error("Could not copy results: ", err);
        });
    });
  }

  // Setup on initial load and page navigations
  document.addEventListener("astro:page-load", setupCalculator);
</script>
