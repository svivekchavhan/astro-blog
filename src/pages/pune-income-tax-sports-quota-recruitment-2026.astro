---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineBriefcase,
  HiOutlineTrophy,
  HiOutlineEnvelope,
} from "react-icons/hi2";

const title =
  "आयकर विभाग पुणे भरती २०२६: खेळाडूंसाठी ८५ जागांवर ऑनलाईन अर्ज सुरू (Income Tax Pune Sports Quota Bharti)";
const description =
  "Income Tax Pune Sports Quota Recruitment 2026: Principal Chief Commissioner of Income Tax (Pr.CCIT), Pune invites online applications for 85 vacancies of Stenographer Grade-II (6), Tax Assistant (40), and Multi-Tasking Staff (39). 10th, 12th & Graduates eligible. Last date to apply is 15 September 2026. Check salary, age limit, eligibility, and official apply link.";
const canonicalURL =
  "https://mahasandhi.in/pune-income-tax-sports-quota-recruitment-2026";
const date = "August 15, 2026";
const category = "Central Govt";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Income Tax Pune Sports Quota Bharti 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-6 sm:mb-8">
      <h1
        class="text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-black tracking-tight text-text-main mb-4 sm:mb-6 leading-[1.25] sm:leading-[1.2]"
      >
        {title}
      </h1>
      <p
        class="text-sm sm:text-base md:text-lg text-text-muted leading-relaxed border-l-4 border-primary pl-4 sm:pl-6 py-1.5 sm:py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex flex-wrap gap-2 sm:gap-4 mb-6 sm:mb-8 text-xs sm:text-sm">
      <a href="#marathi-version" class="text-primary font-bold hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted hidden sm:inline">|</span>
      <a href="#english-version" class="text-primary font-bold hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-4 sm:space-y-6 text-text-main leading-relaxed">
        <h2
          id="main-keyword-mr"
          class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold mt-2 text-primary"
        >
          प्रधान मुख्य आयकर आयुक्त कार्यालय, पुणे (Income Tax Department Pune)
          क्रीडा कोटा पदभरती २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6 space-y-3 text-xs sm:text-sm md:text-base">
          <p>
            <strong>Income Tax Pune Sports Quota Bharti 2026:</strong> भारत सरकार,
            प्रधान मुख्य आयकर आयुक्त कार्यालय, पुणे (Pr.CCIT Pune) अंतर्गत गुणवंत
            खेळाडूंसाठी (Meritorious Sportspersons) <strong
              >स्टेनोग्राफर ग्रेड-II (Stenographer Grade-II)</strong
            >, <strong>टॅक्स असिस्टंट (Tax Assistant)</strong> आणि <strong
              >मल्टी-टास्किंग स्टाफ (MTS)</strong
            > या पदांच्या एकूण <strong>८५ रिक्त जागा</strong> भरण्यासाठी अधिकृत जाहिरात
            प्रसिद्ध करण्यात आली आहे (जाहीर क्र. F.No.- Pr.CCIT/Pune/SRC/Notification.2026-27).
          </p>
          <p>
            या भरतीसाठी १० वी, १२ वी उत्तीर्ण तसेच पदवीधर खेळाडू ऑनलाईन पद्धतीने
            अर्ज करू शकतात. अर्ज करण्याची प्रक्रिया <strong
              >१५ ऑगस्ट २०२६ पासून सुरू झाली असून ऑनलाईन अर्ज भरण्याची अंतिम
              तारीख १५ सप्टेंबर २०२६</strong
            > आहे.
          </p>
          <hr class="border-border-card my-4 sm:my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-3 sm:p-4 rounded-xl flex items-start gap-2.5 sm:gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-xl sm:text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-[0.65rem] sm:text-xs text-text-muted block uppercase font-bold tracking-wider"
                >विभाग / संस्था</span
              >
              <span class="text-text-main font-semibold text-xs sm:text-sm"
                >आयकर विभाग, पुणे (Income Tax Dept Pune)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-3 sm:p-4 rounded-xl flex items-start gap-2.5 sm:gap-3"
          >
            <HiOutlineTrophy
              className="text-primary text-xl sm:text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-[0.65rem] sm:text-xs text-text-muted block uppercase font-bold tracking-wider"
                >भरती प्रकार</span
              >
              <span class="text-text-main font-semibold text-xs sm:text-sm"
                >क्रीडा कोटा भरती (Sports Quota)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-3 sm:p-4 rounded-xl flex items-start gap-2.5 sm:gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-xl sm:text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-[0.65rem] sm:text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण जागा</span
              >
              <span
                class="text-text-main font-bold text-rose-500 text-xs sm:text-sm"
                >८५ जागा (Steno, TA, MTS)</span
              >
            </div>
          </div>
        </div>

        <!-- Vacancy Details Table -->
        <h2
          id="details"
          class="text-base sm:text-lg md:text-xl lg:text-2xl font-black text-primary mb-2 mt-6 sm:mt-8 border-l-4 border-primary pl-2.5 sm:pl-3"
        >
          पदसंख्या, वेतन आणि पात्रता विवरण (Vacancy Details & Salary)
        </h2>
        <div class="overflow-x-auto mt-3 mb-6 sm:mb-8 -mx-2 sm:mx-0">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-2 sm:p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >अ.क्र.</th
                >
                <th
                  class="p-2 sm:p-3 border border-border-card font-bold text-text-main min-w-[140px]"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-2 sm:p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >पदसंख्या</th
                >
                <th
                  class="p-2 sm:p-3 border border-border-card font-bold text-text-main min-w-[150px]"
                  >७ व्या वेतन आयोगानुसार वेतनश्रेणी</th
                >
                <th
                  class="p-2 sm:p-3 border border-border-card font-bold text-text-main min-w-[160px]"
                  >शैक्षणिक पात्रता (Qualification)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-2 sm:p-3 border border-border-card font-medium text-center"
                  >१</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card font-bold text-primary text-xs sm:text-sm md:text-base"
                  >स्टेनोग्राफर ग्रेड-II (Stenographer Grade-II)</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card font-black text-rose-500 text-center text-sm sm:text-base md:text-lg"
                  >०६</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card text-text-muted"
                >
                  पे लेव्हल ४ (रु. २५,५००/- ते रु. ८१,१००/-)
                </td>
                <td
                  class="p-2 sm:p-3 border border-border-card text-text-muted"
                >
                  किमान <strong>१२ वी उत्तीर्ण (12th Pass)</strong> किंवा समकक्षा
                  मान्यताप्राप्त मंडळ/विद्यापीठ.
                </td>
              </tr>
              <tr>
                <td
                  class="p-2 sm:p-3 border border-border-card font-medium text-center"
                  >२</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card font-bold text-primary text-xs sm:text-sm md:text-base"
                  >टॅक्स असिस्टंट (Tax Assistant - TA)</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card font-black text-rose-500 text-center text-sm sm:text-base md:text-lg"
                  >४०</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card text-text-muted"
                >
                  पे लेव्हल ४ (रु. २५,५००/- ते रु. ८१,१००/-)
                </td>
                <td
                  class="p-2 sm:p-3 border border-border-card text-text-muted"
                >
                  मान्यताप्राप्त विद्यापीठाची <strong
                    >पदवी (Graduation Degree)</strong
                  > किंवा समकक्षा.
                </td>
              </tr>
              <tr>
                <td
                  class="p-2 sm:p-3 border border-border-card font-medium text-center"
                  >३</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card font-bold text-primary text-xs sm:text-sm md:text-base"
                  >मल्टी-टास्किंग स्टाफ (Multi-Tasking Staff - MTS)</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card font-black text-rose-500 text-center text-sm sm:text-base md:text-lg"
                  >३९</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card text-text-muted"
                >
                  पे लेव्हल १ (रु. १८,०००/- ते रु. ५६,९००/-)
                </td>
                <td
                  class="p-2 sm:p-3 border border-border-card text-text-muted"
                >
                  किमान <strong>१० वी उत्तीर्ण (Matriculation/10th Pass)</strong
                  > किंवा समकक्षा.
                </td>
              </tr>
              <tr class="bg-primary/5 font-bold">
                <td
                  colspan="2"
                  class="p-2 sm:p-3 border border-border-card text-right"
                  >एकूण पदसंख्या:</td
                >
                <td
                  class="p-2 sm:p-3 border border-border-card text-center text-rose-600 font-extrabold text-base sm:text-lg md:text-xl"
                  >८५</td
                >
                <td
                  colspan="2"
                  class="p-2 sm:p-3 border border-border-card text-[0.7rem] sm:text-xs text-text-muted"
                  >उमेदवार एकापेक्षा जास्त पदांसाठी एकाच अर्जाद्वारे अर्ज करू
                  शकतात.</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit & Sports Criteria -->
        <h2
          id="eligibility"
          class="text-base sm:text-lg md:text-xl lg:text-2xl font-black text-primary mb-2 mt-6 sm:mt-8 border-l-4 border-primary pl-2.5 sm:pl-3"
        >
          वयोमर्यादा व क्रीडा पात्रता (Age Limit & Eligibility Criteria)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-4 sm:p-5 rounded-2xl text-xs sm:text-sm space-y-4 mb-6"
        >
          <div>
            <h3
              class="font-bold text-text-main text-xs sm:text-sm md:text-base mb-2"
            >
              📌 वयोमर्यादा (दि. ०१.०१.२०२६ रोजी):
            </h3>
            <ul class="list-disc pl-5 sm:pl-6 space-y-1 text-text-muted">
              <li><strong>स्टेनोग्राफर ग्रेड-II:</strong> १८ ते २७ वर्षे</li>
              <li><strong>टॅक्स असिस्टंट (TA):</strong> १८ ते २७ वर्षे</li>
              <li>
                <strong>मल्टी-टास्किंग स्टाफ (MTS):</strong> १८ ते २५ वर्षे
              </li>
              <li>
                <strong>वय सवलत:</strong> गुणवंत खेळाडूंसाठी कमाल वयोमर्याधेत ५ वर्षांपर्यंत
                सवलत (SC/ST उमेदवारांसाठी १० वर्षांपर्यंत सवलत).
              </li>
            </ul>
          </div>

          <hr class="border-border-card" />

          <div>
            <h3
              class="font-bold text-text-main text-xs sm:text-sm md:text-base mb-2"
            >
              🏆 क्रीडा कामगिरी पात्रता:
            </h3>
            <ul class="list-disc pl-5 sm:pl-6 space-y-1 text-text-muted">
              <li>
                क्रीडा कामगिरी/प्रमाणपत्रे दि. <strong>१०.०८.२०२६</strong> पर्यंतचीच
                ग्राह्य धरली जातील.
              </li>
              <li>
                खेळो इंडिया युनिव्हर्सिटी गेम्स / युवा गेम्स / विंटर गेम्स /
                पॅरा गेम्स किंवा राष्ट्रीय/आंतरराष्ट्रीय स्तरावरील स्पर्धांमधील
                कामगिरी प्रमाणपत्र (Form 1, 2, 3, 4, 5) आवश्यक.
              </li>
            </ul>
          </div>
        </div>

        <!-- Application Fee -->
        <h2
          id="fee"
          class="text-base sm:text-lg md:text-xl lg:text-2xl font-black text-primary mb-2 mt-6 sm:mt-8 border-l-4 border-primary pl-2.5 sm:pl-3"
        >
          अर्ज शुल्क (Application Fee)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-4 sm:p-5 rounded-2xl text-xs sm:text-sm space-y-2 mb-6"
        >
          <p class="m-0 text-text-main font-semibold">
            💳 <strong>अर्ज शुल्क:</strong>
            <strong>रु. २००/- (Rupees Two Hundred Only)</strong>
          </p>
          <p
            class="m-0 text-text-muted text-[0.7rem] sm:text-xs leading-relaxed"
          >
            • परीक्षा शुल्क फक्त ऑनलाईन (Online Mode) द्वारे भरायचे आहे.<br />
            • भरलेले शुल्क नॉन-रिफंडेबल (Non-refundable) राहील.
          </p>
        </div>

        <!-- Important Dates & Links Table -->
        <h2
          id="important-dates"
          class="text-base sm:text-lg md:text-xl lg:text-2xl font-black text-primary mb-2 mt-6 sm:mt-8 border-l-4 border-primary pl-2.5 sm:pl-3"
        >
          {
            translateMarathi(
              "महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)",
            )
          }
        </h2>
        <div class="overflow-x-auto mt-3 mb-6 sm:mb-8 -mx-2 sm:mx-0">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-2.5 sm:p-3 border border-border-card font-bold text-text-main min-w-[140px]"
                  >तपशील (Event)</th
                >
                <th
                  class="p-2.5 sm:p-3 border border-border-card font-bold text-text-main min-w-[150px]"
                  >तारीख / दुवा (Date / Action)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-muted font-medium"
                  >जाहिरात प्रसिद्धी दिनांक (Notification Issue Date)</td
                >
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-main font-bold"
                  >१० ऑगस्ट २०२६</td
                >
              </tr>
              <tr>
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज सुरू होण्याचा दिनांक (Start Date)</td
                >
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-main font-bold"
                  >१५ ऑगस्ट २०२६</td
                >
              </tr>
              <tr>
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज करण्याची अंतिम तारीख (Last Date to Apply Online)</td
                >
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-rose-500 text-base sm:text-lg shrink-0"
                    /> १५ सप्टेंबर २०२६</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-muted font-medium"
                  >अधिकृत संकेतस्थळ (Official Website)</td
                >
                <td class="p-2.5 sm:p-3 border border-border-card">
                  <a
                    href="https://www.incometaxindia.gov.in/pune/home"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-[0.7rem] sm:text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText
                      className="text-sm sm:text-base shrink-0"
                    /> incometaxindia.gov.in
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज लिंक (Apply Online Link)</td
                >
                <td class="p-2.5 sm:p-3 border border-border-card">
                  <a
                    href="https://www.itsportsrecruitmentpune.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-primary/10 hover:bg-primary/20 text-primary text-[0.7rem] sm:text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto"
                  >
                    <HiOutlineCursorArrowRays
                      className="text-sm sm:text-base shrink-0"
                    /> Income Tax Pune Apply Portal
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-muted font-medium"
                  >मदत व ईमेल संपर्क (Query Helpline Email)</td
                >
                <td
                  class="p-2.5 sm:p-3 border border-border-card text-text-main font-semibold"
                >
                  <span
                    class="flex items-center gap-1.5 text-[0.7rem] sm:text-xs text-primary break-all"
                  >
                    <HiOutlineEnvelope
                      className="text-sm sm:text-base shrink-0 text-primary"
                    />
                    itsportsrecruitmentpune2026@gmail.com
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2
          id="faq"
          class="text-base sm:text-lg md:text-xl lg:text-2xl font-black text-primary mb-2 mt-6 sm:mt-8 border-l-4 border-primary pl-2.5 sm:pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-3 sm:space-y-4 mt-3 mb-6 sm:mb-8">
          <div
            class="bg-bg-surface border border-border-card p-4 sm:p-5 rounded-2xl"
          >
            <h3
              class="text-xs sm:text-sm md:text-base font-bold text-text-main mb-1.5"
            >
              प्रश्न १: आयकर विभाग पुणे स्पोर्ट्स कोटा भरती २०२६ साठी ऑनलाईन
