---
import Layout from "../layouts/Layout.astro";
import { articlesRegistry } from "../constants/articles";

const pages = [
  { name: "Home", href: "/" },
  { name: "Current Recruitment", href: "/current-recruitment" },
  { name: "10th Pass Govt Jobs", href: "/10th-pass-government-jobs-maharashtra" },
  { name: "Walk-In Jobs", href: "/walk-in-jobs" },
  { name: "Bank Recruitment", href: "/bank-recruitment" },
  { name: "SBI Recruitment", href: "/sbi-recruitment" },
  { name: "Naukri Updates", href: "/naukri-updates" },
  { name: "Mega Recruitment", href: "/mega-recruitment" },
  { name: "Result", href: "/result" },
  { name: "Admit Card", href: "/admit-card" },
  { name: "Answer Key", href: "/answer-key" },
  { name: "Admission", href: "/admission" },
  { name: "About Us", href: "/about-us" },
  { name: "Contact Us", href: "/contact-us" },
  { name: "MPSC", href: "/mpsc" },
  { name: "Calculators", href: "/calculator" },
  { name: "MPSC Age Calculator (Marathi)", href: "/mpsc-age-calculator-marathi" },
  { name: "SGPA & CGPA Calculator", href: "/sgpa-cgpa-calculator" },
  { name: "Maharashtra 10th (SSC) Board", href: "/maharashtra-10th-ssc-board" },
  { name: "Maharashtra 12th (HSC) Board", href: "/maharashtra-12th-hsc-board" },
];

const legalPages = [
  { name: "Privacy Policy", href: "/privacy-policy" },
  { name: "Terms of Service", href: "/terms-of-service" },
  { name: "Disclaimer", href: "/disclaimer" },
];

// Dynamically sync all articles from articlesRegistry
const articles = articlesRegistry.map((art) => ({
  name: art.titleMr || art.titleEn,
  href: art.slug,
}));
---

<Layout
  title="Sitemap - All Pages & Navigation Index | MahaSandhi"
  description="Complete sitemap of MahaSandhi website. Find all pages including government jobs, exam results, admit cards, answer keys, admissions, blog articles, and legal pages at mahasandhi.in."
>
  <article class="max-w-4xl mx-auto py-12 px-4">
    <h1
      class="text-4xl md:text-5xl font-extrabold mb-8 tracking-tight text-text-main"
    >
      Sitemap
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mt-12">
      <div>
        <h2
          class="text-xl font-bold text-text-main mb-6 border-b border-border-card pb-2 flex items-center gap-2"
        >
          <span class="w-2 h-6 bg-primary rounded-full"></span>
          Main Pages
        </h2>
        <ul class="space-y-4">
          {
            pages.map((page) => (
              <li>
                <a
                  href={page.href}
                  class="text-base text-text-muted hover:text-primary transition-colors flex items-center gap-3 group"
                >
                  <span class="w-1.5 h-1.5 bg-border-card rounded-full group-hover:bg-primary transition-colors" />
                  {page.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class="text-xl font-bold text-text-main mb-6 border-b border-border-card pb-2 flex items-center gap-2"
        >
          <span class="w-2 h-6 bg-secondary rounded-full"></span>
          Articles & Recruitment Guides ({articles.length})
        </h2>
        <ul class="space-y-4 max-h-[600px] overflow-y-auto pr-2">
          {
            articles.map((art) => (
              <li>
                <a
                  href={art.href}
                  class="text-sm text-text-muted hover:text-primary transition-colors flex items-center gap-3 group"
                >
                  <span class="w-1.5 h-1.5 bg-border-card rounded-full group-hover:bg-secondary transition-colors shrink-0" />
                  <span class="font-medium line-clamp-2">{art.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class="text-xl font-bold text-text-main mb-6 border-b border-border-card pb-2 flex items-center gap-2"
        >
          <span class="w-2 h-6 bg-text-muted rounded-full"></span>
          Legal & Info
        </h2>
        <ul class="space-y-4">
          {
            legalPages.map((page) => (
              <li>
                <a
                  href={page.href}
                  class="text-base text-text-muted hover:text-primary transition-colors flex items-center gap-3 group"
                >
                  <span class="w-1.5 h-1.5 bg-border-card rounded-full group-hover:bg-text-muted transition-colors" />
                  {page.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-20 p-8 bg-bg-surface border border-border-card rounded-3xl">
      <h3 class="text-xl font-bold text-text-main mb-4">Technical XML Sitemap</h3>
      <p class="text-text-muted mb-6">
        Search engine crawlers and bots can access the real-time XML sitemap below:
      </p>
      <a href="/sitemap.xml" target="_blank" class="btn-primary inline-flex text-amber-50"
        >View XML Sitemap (/sitemap.xml)</a
      >
    </div>
  </article>
</Layout>
