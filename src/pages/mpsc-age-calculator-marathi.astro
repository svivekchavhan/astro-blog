                />
              </div>

              <!-- Quick Select Helper (Desktop Only) -->
              <div class="hidden md:block p-2.5 bg-emerald-500/5 border border-emerald-500/15 rounded-xl space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-[0.68rem] text-emerald-600 dark:text-emerald-400 font-bold uppercase tracking-wider block">
                    ⚡ सोपी निवड (DD / MM / YYYY):
                  </span>
                  <button
                    type="button"
                    id="reset-cutoff-quick"
                    title="तारीख रीसेट करा (Reset to Today)"
                    class="inline-flex items-center gap-1 text-[0.65rem] text-emerald-600 hover:text-emerald-700 bg-emerald-500/10 hover:bg-emerald-500/20 px-2 py-0.5 rounded-md font-semibold transition-colors cursor-pointer border-none"
                  >
                    <HiOutlineArrowPath className="text-xs" /> रीसेट
                  </button>
                </div>
                <div class="grid grid-cols-3 gap-1.5">
                  <!-- 1. Day -->
                  <select
                    id="quick-cutoff-day"
                    class="w-full bg-bg-surface border border-border-card text-text-main text-xs font-bold rounded-lg px-2 py-1.5 focus:border-emerald-500 focus:outline-none cursor-pointer"
                  >
                    <option value="" disabled selected>दिवस (DD)</option>
                    {Array.from({ length: 31 }, (_, i) => (
                      <option value={String(i + 1).padStart(2, "0")}>
                        {String(i + 1).padStart(2, "0")}
                      </option>
                    ))}
