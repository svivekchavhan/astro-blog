                    class="w-full bg-bg-surface border border-border-card text-text-main text-xs font-bold rounded-lg px-2 py-1.5 focus:border-emerald-500 focus:outline-none cursor-pointer"
                  >
                    <option value="" disabled selected>महिना (MM)</option>
                    <option value="01">01-जानेवारी</option>
                    <option value="02">02-फेब्रुवारी</option>
                    <option value="03">03-मार्च</option>
                    <option value="04">04-एप्रिल</option>
                    <option value="05">05-मे</option>
                    <option value="06">06-जून</option>
                    <option value="07">07-जुलै</option>
                    <option value="08">08-ऑगस्ट</option>
                    <option value="09">09-सप्टेंबर</option>
                    <option value="10">10-ऑक्टोबर</option>
                    <option value="11">11-नोव्हेंबर</option>
                    <option value="12">12-डिसेंबर</option>
                  </select>

                  <!-- 3. Year -->
                  <select
                    id="quick-cutoff-year"
                    class="w-full bg-bg-surface border border-border-card text-text-main text-xs font-bold rounded-lg px-2 py-1.5 focus:border-emerald-500 focus:outline-none cursor-pointer"
                  >
                    <option value="" disabled selected>वर्ष (YYYY)</option>
