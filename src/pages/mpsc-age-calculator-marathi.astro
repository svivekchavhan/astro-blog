                    {Array.from({ length: 80 }, (_, i) => 2026 - i).map(year => (
                      <option value={String(year)}>{year}</option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            <!-- 2. Till This Date Container -->
            <div class="flex flex-col justify-between h-full bg-bg-base/40 border border-border-card/60 p-4 sm:p-5 rounded-2xl space-y-3">
              <div class="space-y-2">
                <label for="ageAt" class="text-sm font-extrabold text-text-main flex items-center justify-between flex-wrap gap-1">
