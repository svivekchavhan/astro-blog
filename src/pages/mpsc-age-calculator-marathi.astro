              <span class="text-xs text-text-muted font-semibold">पुढील वाढदिवस (Next Birthday):</span>
              <span id="stat-next-birthday" class="text-xs font-bold text-text-main">--</span>
            </div>
          </div>

          <!-- Copy Button -->
          <div class="flex justify-end pt-2">
            <button
              type="button"
              id="btn-copy"
              class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary border border-primary/20 text-xs font-bold uppercase tracking-wider rounded-xl transition-colors cursor-pointer"
            >
              <HiOutlineClipboard className="text-base" /> कॉपी करा (Copy Result)
            </button>
          </div>
        </div>

      </div>

      <!-- MPSC Upper Age Limit Rules Guide Box for Students -->
      <div class="mt-10 bg-bg-surface border border-border-card rounded-3xl p-6 md:p-8">
        <h2 class="text-lg md:text-xl font-bold text-text-main mb-4 flex items-center gap-2">
          🏛️ MPSC परीक्षा वयोमर्यादा नियम आणि सवलत (Age Limits)
        </h2>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="bg-primary/10 text-primary font-bold text-left border-b border-border-card">
                <th class="p-3">प्रवर्ग (Category)</th>
                <th class="p-3">किमान वय (Min Age)</th>
                <th class="p-3">कमाल वय (Max Age)</th>
                <th class="p-3">वयोमर्यादा सूट</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card text-text-muted font-medium">
              <tr>
                <td class="p-3 font-bold text-text-main">अमागास (Open / General)</td>
                <td class="p-3">19 / 21 वर्षे</td>
                <td class="p-3">38 वर्षे</td>
                <td class="p-3">नियम लागू</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-main">मागासवर्गीय (OBC / SC / ST / EWS)</td>
                <td class="p-3">19 / 21 वर्षे</td>
                <td class="p-3">43 वर्षे</td>
                <td class="p-3">+5 वर्षे सूट</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-main">प्राविण्यप्राप्त खेळाडू (Sportsman)</td>
                <td class="p-3">19 / 21 वर्षे</td>
                <td class="p-3">43 वर्षे</td>
                <td class="p-3">+5 वर्षे सूट</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-main">दिव्यांग उमेदवार (PwD)</td>
                <td class="p-3">19 / 21 वर्षे</td>
                <td class="p-3">45 वर्षे</td>
                <td class="p-3">+7 वर्षे सूट</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-main">माजी सैनिक (Ex-Servicemen)</td>
                <td class="p-3">19 वर्षे</td>
                <td class="p-3">सेवा कालावधी + 3 वर्षे</td>
                <td class="p-3">निकाली नियम</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-text-muted">
          * टीप: प्रत्येक जाहिरातीतील पदनिहाय वयोमर्यादेचा नियम वेगळा असू शकतो. कृपया MPSC च्या अधिकृत जाहिरातीतील कट-ऑफ तारीख तपासून घ्या.
        </p>
      </div>

    </div>
  </section>
</Layout>

<script>
  function setupMpscAgeCalculator() {
    const form = document.getElementById("age-calc-form") as HTMLFormElement | null;
    const dobInput = document.getElementById("dob") as HTMLInputElement | null;
    const ageAtInput = document.getElementById("ageAt") as HTMLInputElement | null;
    const resetButton = document.getElementById("btn-reset") as HTMLButtonElement | null;
    const copyButton = document.getElementById("btn-copy") as HTMLButtonElement | null;
    const presetBtns = document.querySelectorAll(".preset-date-btn") as NodeListOf<HTMLButtonElement>;

    const errorAlert = document.getElementById("error-alert");
    const resultsSection = document.getElementById("results-section");

    const mainResultEl = document.getElementById("main-result");
    const mainResultMrEl = document.getElementById("main-result-mr");
    const statMonthsEl = document.getElementById("stat-months");
    const statWeeksEl = document.getElementById("stat-weeks");
    const statDaysEl = document.getElementById("stat-days");
    const statNextBdayEl = document.getElementById("stat-next-birthday");

    if (!form || !dobInput || !ageAtInput) return;

    // Helper: Auto-slash formatting DD/MM/YYYY
    function formatAutoSlash(input: HTMLInputElement) {
      let val = input.value.replace(/\D/g, ""); // digits only
      if (val.length > 8) val = val.substring(0, 8);

      let formatted = "";
      if (val.length > 4) {
        formatted = `${val.substring(0, 2)}/${val.substring(2, 4)}/${val.substring(4)}`;
      } else if (val.length > 2) {
        formatted = `${val.substring(0, 2)}/${val.substring(2)}`;
      } else {
        formatted = val;
      }

      input.value = formatted;
    }

    // Helper: Parse DD/MM/YYYY string to Date object
    function parseDDMMYYYY(str: string): Date | null {
      if (!str) return null;
      const parts = str.split("/");
      if (parts.length !== 3) return null;

      const day = parseInt(parts[0], 10);
      const month = parseInt(parts[1], 10);
      const year = parseInt(parts[2], 10);

      if (isNaN(day) || isNaN(month) || isNaN(year)) return null;
      if (month < 1 || month > 12) return null;
      if (day < 1 || day > 31) return null;
      if (year < 1900 || year > 2099) return null;

      const dateObj = new Date(year, month - 1, day);
      if (dateObj.getFullYear() !== year || dateObj.getMonth() !== month - 1 || dateObj.getDate() !== day) {
        return null;
      }
      return dateObj;
    }

    // Helper: Today's date in DD/MM/YYYY
    function getTodayDDMMYYYY() {
      const now = new Date();
      const d = String(now.getDate()).padStart(2, '0');
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const y = String(now.getFullYear());
      return `${d}/${m}/${y}`;
    }

    // Helper: Convert YYYY-MM-DD to DD/MM/YYYY
    function isoToDDMMYYYY(isoStr: string): string {
      if (!isoStr) return "";
      const parts = isoStr.split("-");
      if (parts.length !== 3) return isoStr;
      return `${parts[2].padStart(2, "0")}/${parts[1].padStart(2, "0")}/${parts[0]}`;
    }

    // Set default Cut-off Date to Today
    const todayStr = getTodayDDMMYYYY();
    ageAtInput.value = todayStr;

    // Quick Select elements for DOB
    const qDobYear = document.getElementById("quick-dob-year") as HTMLSelectElement | null;
    const qDobMonth = document.getElementById("quick-dob-month") as HTMLSelectElement | null;
    const qDobDay = document.getElementById("quick-dob-day") as HTMLSelectElement | null;

    // Quick Select elements for Cutoff
    const qCutoffYear = document.getElementById("quick-cutoff-year") as HTMLSelectElement | null;
    const qCutoffMonth = document.getElementById("quick-cutoff-month") as HTMLSelectElement | null;
    const qCutoffDay = document.getElementById("quick-cutoff-day") as HTMLSelectElement | null;

    function syncInputFromQuickSelect(input: HTMLInputElement, daySel: HTMLSelectElement | null, monthSel: HTMLSelectElement | null, yearSel: HTMLSelectElement | null) {
      const currentParts = input.value ? input.value.split("/") : [];
      const currentDay = currentParts[0] || "";
      const currentMonth = currentParts[1] || "";
      const currentYear = currentParts[2] || "";

      const d = daySel?.value || currentDay || "01";
      const m = monthSel?.value || currentMonth || "01";
      const y = yearSel?.value || currentYear;
      if (y) {
        input.value = `${d}/${m}/${y}`;
      }
    }

    function syncQuickSelectFromInput(input: HTMLInputElement, daySel: HTMLSelectElement | null, monthSel: HTMLSelectElement | null, yearSel: HTMLSelectElement | null) {
      if (!input.value) return;
      const parts = input.value.split("/");
      if (parts.length >= 1 && parts[0].length === 2 && daySel) {
        const optionExists = Array.from(daySel.options).some(opt => opt.value === parts[0]);
        if (optionExists) daySel.value = parts[0];
      }
      if (parts.length >= 2 && parts[1].length === 2 && monthSel) {
        const optionExists = Array.from(monthSel.options).some(opt => opt.value === parts[1]);
        if (optionExists) monthSel.value = parts[1];
      }
      if (parts.length === 3 && parts[2].length === 4 && yearSel) {
        const optionExists = Array.from(yearSel.options).some(opt => opt.value === parts[2]);
        if (optionExists) yearSel.value = parts[2];
      }
    }

    function hideResults() {
      resultsSection?.classList.add("hidden");
    }

    // Auto-slash event listeners
    dobInput.addEventListener("input", () => {
      formatAutoSlash(dobInput);
      syncQuickSelectFromInput(dobInput, qDobDay, qDobMonth, qDobYear);
      errorAlert?.classList.add("hidden");
    });

    ageAtInput.addEventListener("input", () => {
      formatAutoSlash(ageAtInput);
      syncQuickSelectFromInput(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
      errorAlert?.classList.add("hidden");
    });

    qDobDay?.addEventListener("change", () => {
      syncInputFromQuickSelect(dobInput, qDobDay, qDobMonth, qDobYear);
    });
    qDobMonth?.addEventListener("change", () => {
      syncInputFromQuickSelect(dobInput, qDobDay, qDobMonth, qDobYear);
    });
    qDobYear?.addEventListener("change", () => {
      syncInputFromQuickSelect(dobInput, qDobDay, qDobMonth, qDobYear);
    });

    qCutoffDay?.addEventListener("change", () => {
      syncInputFromQuickSelect(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
    });
    qCutoffMonth?.addEventListener("change", () => {
      syncInputFromQuickSelect(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
    });
    qCutoffYear?.addEventListener("change", () => {
      syncInputFromQuickSelect(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
    });

    // Preset buttons handler
    presetBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const val = btn.dataset.date;
        if (val === "today") {
          ageAtInput.value = todayStr;
          syncQuickSelectFromInput(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
        } else if (val) {
          ageAtInput.value = isoToDDMMYYYY(val);
          syncQuickSelectFromInput(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
        }
      });
    });

    // Reset DOB Quick Button
    const resetDobQuickBtn = document.getElementById("reset-dob-quick") as HTMLButtonElement | null;
    const resetCutoffQuickBtn = document.getElementById("reset-cutoff-quick") as HTMLButtonElement | null;

    resetDobQuickBtn?.addEventListener("click", () => {
      dobInput.value = "";
      if (qDobDay) qDobDay.selectedIndex = 0;
      if (qDobMonth) qDobMonth.selectedIndex = 0;
      if (qDobYear) qDobYear.selectedIndex = 0;
      hideResults();
      errorAlert?.classList.add("hidden");
    });

    resetCutoffQuickBtn?.addEventListener("click", () => {
      ageAtInput.value = todayStr;
      syncQuickSelectFromInput(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
      hideResults();
      errorAlert?.classList.add("hidden");
    });

    syncQuickSelectFromInput(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);

    // Reset main handler
    resetButton?.addEventListener("click", () => {
      form.reset();
      ageAtInput.value = todayStr;
      syncQuickSelectFromInput(ageAtInput, qCutoffDay, qCutoffMonth, qCutoffYear);
      if (qDobDay) qDobDay.selectedIndex = 0;
      if (qDobMonth) qDobMonth.selectedIndex = 0;
      if (qDobYear) qDobYear.selectedIndex = 0;
      hideResults();
      errorAlert?.classList.add("hidden");
    });

    // Form Submit logic
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const dobVal = dobInput.value;
      const ageAtVal = ageAtInput.value;

      const dob = parseDDMMYYYY(dobVal);
      const ageAt = parseDDMMYYYY(ageAtVal);

      if (!dob || !ageAt) {
        if (errorAlert) {
          const alertBox = errorAlert.querySelector("div");
          if (alertBox) {
            alertBox.innerHTML = `<strong class="font-bold">त्रुटी (Error):</strong> कृपया योग्य स्वरूपात तारीख (DD/MM/YYYY) प्रविष्ट करा.`;
          }
        }
        errorAlert?.classList.remove("hidden");
        resultsSection?.classList.add("hidden");
        return;
      }

      if (dob >= ageAt) {
        if (errorAlert) {
          const alertBox = errorAlert.querySelector("div");
          if (alertBox) {
            alertBox.innerHTML = `<strong class="font-bold">त्रुटी (Error):</strong> जन्म तारीख ही जाहिरातीतील कट-ऑफ तारखेपेक्षा आधीची असणे आवश्यक आहे.`;
          }
        }
        errorAlert?.classList.remove("hidden");
        resultsSection?.classList.add("hidden");
        return;
      }

      errorAlert?.classList.add("hidden");

      let years = ageAt.getFullYear() - dob.getFullYear();
      let months = ageAt.getMonth() - dob.getMonth();
      let days = ageAt.getDate() - dob.getDate();

      if (days < 0) {
        const prevMonth = new Date(ageAt.getFullYear(), ageAt.getMonth(), 0);
        days += prevMonth.getDate();
        months--;
      }

      if (months < 0) {
        months += 12;
        years--;
      }

      const resultMr = `${years} वर्षे, ${months} महिने, ${days} दिवस`;
      const resultEn = `${years} Years, ${months} Months, ${days} Days`;

      const diffMs = ageAt.getTime() - dob.getTime();
      const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const totalWeeks = Math.floor(totalDays / 7);
      const totalMonths = years * 12 + months;

      const nextBdayYear =
        ageAt.getMonth() > dob.getMonth() ||
        (ageAt.getMonth() === dob.getMonth() && ageAt.getDate() >= dob.getDate())
          ? ageAt.getFullYear() + 1
          : ageAt.getFullYear();

      const nextBday = new Date(nextBdayYear, dob.getMonth(), dob.getDate());
      let nextDiffMs = nextBday.getTime() - ageAt.getTime();
      const nextTotalDays = Math.ceil(nextDiffMs / (1000 * 60 * 60 * 24));

      let nextMonths = nextBday.getMonth() - ageAt.getMonth();
      let nextDays = nextBday.getDate() - ageAt.getDate();

      if (nextDays < 0) {
        const prevMonth = new Date(nextBday.getFullYear(), nextBday.getMonth(), 0);
        nextDays += prevMonth.getDate();
        nextMonths--;
      }
      if (nextMonths < 0) {
        nextMonths += 12;
      }

      let nextBdayString = "";
      if (nextTotalDays === 365 || nextTotalDays === 0) {
        nextBdayString = "आज आपला वाढदिवस आहे! (Happy Birthday! 🎂)";
      } else {
        nextBdayString = `${nextMonths} महिने आणि ${nextDays} दिवस शिल्लक`;
      }

      if (mainResultEl) mainResultEl.textContent = resultEn;
      if (mainResultMrEl) mainResultMrEl.textContent = resultMr;
      if (statMonthsEl) statMonthsEl.textContent = totalMonths.toLocaleString();
      if (statWeeksEl) statWeeksEl.textContent = totalWeeks.toLocaleString();
      if (statDaysEl) statDaysEl.textContent = totalDays.toLocaleString();
      if (statNextBdayEl) statNextBdayEl.textContent = nextBdayString;

      resultsSection?.classList.remove("hidden");
    });

    // Copy Results Helper with Fallback for Mobile & Desktop
    function fallbackCopyText(text: string, onSuccess: () => void) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      textArea.style.top = "-9999px";
      textArea.style.left = "-9999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand("copy");
        onSuccess();
      } catch (err) {
        console.error("Fallback copy failed", err);
      }
      document.body.removeChild(textArea);
    }

    copyButton?.addEventListener("click", () => {
      if (!mainResultEl || !mainResultMrEl || !statMonthsEl || !statWeeksEl || !statDaysEl || !statNextBdayEl) return;

      const textToCopy = `MPSC Age Calculation Results (MahaSandhi):\n------------------------------------\nवय (Age): ${mainResultMrEl.textContent} (${mainResultEl.textContent})\nएकूण महिने: ${statMonthsEl.textContent}\nएकूण हप्ते: ${statWeeksEl.textContent}\nएकूण दिवस: ${statDaysEl.textContent}\nपुढील वाढदिवस: ${statNextBdayEl.textContent}\nCalculated via: mahasandhi.in/mpsc-age-calculator-marathi`;

      const originalText = copyButton.innerHTML;
      const onSuccess = () => {
        copyButton.innerHTML = "✓ कॉपी झाले! (Copied)";
        setTimeout(() => {
          copyButton.innerHTML = originalText;
        }, 2000);
      };

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(textToCopy).then(onSuccess).catch(() => {
          fallbackCopyText(textToCopy, onSuccess);
        });
      } else {
        fallbackCopyText(textToCopy, onSuccess);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", setupMpscAgeCalculator);
  document.addEventListener("astro:page-load", setupMpscAgeCalculator);
</script>
