---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCreditCard,
} from "react-icons/hi2";

const title =
  "सिंधुदुर्ग जिल्हा मध्यवर्ती सहकारी बँक भरती २०२६: लिपिक ६७ पदांची सरळसेवा भरती जाहिरात प्रसिद्ध";
const description =
  "Sindhudurg DCC Bank Clerk Recruitment 2026: The Sindhudurg District Central Co-operative Bank Ltd invites online applications for 67 Clerk (लिपिक) vacancies. Graduate eligible, ₹18,000 stipend during probation, last date to apply is September 17, 2026. Read syllabus, NEFT fee details, age limit, and official apply link.";
const canonicalURL =
  "https://mahasandhi.in/sindhudurg-dcc-bank-clerk-recruitment-2026";
const date = "September 03, 2026";
const category = "Bank Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "Sindhudurg DCC Bank Clerk Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          दि सिंधुदुर्ग जिल्हा मध्यवर्ती सहकारी बँक लि. (Sindhudurg DCC Bank)
          लिपिक पदभरती २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Sindhudurg DCC Bank Clerk Recruitment 2026:</strong> दि सिंधुदुर्ग
            जिल्हा मध्यवर्ती सहकारी बँक मर्यादित (Sindhudurg DCCB) कडून सिंधुदुर्ग
            जिल्ह्यातील मूळ रहिवासी असलेल्या पात्र उमेदवारांकडून <strong
              >लिपिक (Clerk)</strong
            > या पदांच्या एकूण <strong>६७ रिक्त जागा</strong> भरण्यासाठी अधिकृत भरती
            जाहिरात प्रसिद्ध करण्यात आली आहे.
          </p>
          <p>
            या भरतीसाठी कोणत्याही शाखेतील पदवीधरांना ऑनलाईन अर्ज सादर करता येईल.
            ऑनलाईन अर्ज प्रक्रिया <strong
              >०३ सप्टेंबर २०२६ ते १७ सप्टेंबर २०२६ (रात्री ११:५९ वाजेपर्यंत)</strong
            > अधिकृत पोर्टलवर उपलब्ध राहील.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >बँकेचे नाव</span
              >
              <span class="text-text-main font-semibold text-sm"
                >सिंधुदुर्ग जिल्हा मध्यवर्ती सहकारी बँक</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण व पात्रता</span
              >
              <span class="text-text-main font-semibold text-sm"
                >सिंधुदुर्ग जिल्हा (फक्त मूळ रहिवासी)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCurrencyRupee
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >मानधन (Probation Stipend)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >रु. १८,०००/- दरमहा (१८ महिने परिविक्षाधीन)</span
              >
            </div>
          </div>
        </div>

        <!-- Vacancy Details Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          पदसंख्या, पात्रता व वयोमर्यादा विवरण (Post Details & Eligibility)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >एकूण पदे</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक अर्हता</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा (दि. ३१/०८/२०२६ रोजी)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-primary text-base"
                  >लिपिक (Clerk)</td
                >
                <td
                  class="p-3 border border-border-card font-black text-rose-500 text-center text-lg"
                  >६७</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • मान्यताप्राप्त विद्यापीठातून कोणत्याही शाखेतील पदवी
                  (Graduate) किंवा पदव्युत्तर पदवी (Post Graduate) किमान <strong
                    >४०% गुणांसह</strong
                  > उत्तीर्ण.<br />
                  • १०वी (Matriculation) मध्ये <strong>मराठी विषय</strong> उत्तीर्ण
                  असणे आवश्यक.<br />
                  • <strong>रहिवासी अट:</strong> उमेदवार सिंधुदुर्ग जिल्ह्याचा मूळ
                  रहिवासी असणे अनिवार्य आहे.<br />
                  • <i>प्राधान्य:</i> B.Com, B.A., B.Sc (IT/Agri/Maths/Statistics),
                  B.E., B.C.A. किंवा संगणक/IT पदवीधरांना प्राधान्य.
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  • किमान <strong>२१ वर्षे</strong> ते कमाल <strong
                    >४० वर्षे</strong
                  >.<br />
                  • (जन्म ०१ सप्टेंबर १९८६ ते ३१ ऑगस्ट २००५ दरम्यान असावा).
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Salary and Probation Info -->
        <h2
          id="probation-salary"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          मानधन व परिविक्षाधीन कालावधी (Stipend & Probation Period)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3"
        >
          <p class="m-0 text-text-main">
            ⏳ <strong>परिविक्षाधीन कालावधी (Probation):</strong> निवड झालेल्या उमेदवारांचा
            परिविक्षाधीन कालावधी <strong>१८ महिने (18 Months)</strong> असेल.
          </p>
          <p class="m-0 text-text-main">
            💰 <strong>मासिक मानधन (Stipend):</strong> परिविक्षाधीन कालावधीत दरमहा
            <strong>रु. १८,०००/- (₹18,000/ month)</strong> ठोक मानधन दिले जाईल.
          </p>
          <p class="m-0 text-text-main">
            ✅ <strong>नियमित सेवा समावेश:</strong> १८ महिन्यांच्या समाधानकारक कामगिरी
            मूल्यमापनानंतर उमेदवारांना बँकेच्या नियमित लिपिक श्रेणीत नियमानुसार वेतनश्रेणीसह
            सामावून घेतले जाईल.
          </p>
        </div>

        <!-- Syllabus & Exam Pattern Table -->
        <h2
          id="syllabus"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          परीक्षेचे स्वरूप व अभ्यासक्रम गुणांची विभागणी (90 Marks Exam Pattern)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm mb-4"
        >
          <p class="m-0 text-text-main font-semibold mb-2">
            📌 <strong>निवड प्रक्रिया व परीक्षेचे नियम:</strong>
          </p>
          <ul class="list-disc pl-6 space-y-1 text-text-muted">
            <li>
              निवड प्रक्रिया <strong>ऑनलाईन परीक्षा (Online Exam)</strong> व <strong
                >वैयक्तिक मुलाखत (Personal Interview)</strong
              > द्वारे केली जाईल.
            </li>
            <li>
              एकूण <strong>९० प्रश्न / ९० गुण</strong> असणार आहेत.
            </li>
            <li>
              परीक्षेचा कालावधी: <strong>७५ मिनिटे (75 Minutes)</strong>.
            </li>
            <li>
              परीक्षेचे माध्यम: <strong
                >इंग्रजी व मराठी (English & Marathi)</strong
              >.
            </li>
            <li>
              <strong>मुलाखतीसाठी पात्रता गुण:</strong> ऑनलाईन परीक्षेत किमान <strong
                >५०% गुण (४५ गुण)</strong
              > मिळवणारे उमेदवारच मुलाखतीसाठी पात्र ठरतील. मुलाखत सिंधुदुर्ग येथे
              घेतली जाईल.
            </li>
          </ul>
        </div>

        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center w-16"
                  >अ.क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >विषयाचे नाव (Syllabus Subject)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >प्रश्न / गुण</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >१</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >शेती पतपुरवठा व त्रिस्तरीय रचना (Agriculture Credit Supply &
                  Three-Tier Structure)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >३५ प्रश्न / ३५ गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >२</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >बँकिंग व सहकार (Banking & Co-operation)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >३० प्रश्न / ३० गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >३</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >कृषी व ग्रामीण अर्थव्यवस्था (Agriculture & Rural Economy)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >१० प्रश्न / १० गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >४</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >सामान्य ज्ञान व चालू घडामोडी (General Knowledge & Current
                  Affairs)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०५ प्रश्न / ०५ गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >५</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >संगणक व माहिती तंत्रज्ञान (Computer & IT)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०५ प्रश्न / ०५ गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >६</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >बुद्धिमत्ता चाचणी (Intelligence Test)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >०५ प्रश्न / ०५ गुण</td
                >
              </tr>
              <tr class="bg-primary/10">
                <td
                  colspan="2"
                  class="p-3 border border-border-card font-bold text-text-main text-right"
                  >एकूण (Total Written Exam Marks)</td
                >
                <td
                  class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-base"
                  >९० प्रश्न / ९० गुण (७५ मिनिटे)</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Fee and NEFT Details -->
        <h2
          id="fee-payment"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          परीक्षा शुल्क व बँक पेमेंट तपशील (Fee & Payment Details)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-4"
        >
          <p class="m-0 text-text-main">
            💳 <strong>परीक्षा शुल्क:</strong>
            <strong>रु. ९००/-</strong> (रु. ७६३/- परीक्षा शुल्क + १८% जीएसटी रु. १३७/-)
            सर्व प्रवर्गासाठी (ना-परतावा / Non-Refundable).
          </p>
          <div
            class="bg-primary/5 border border-primary/20 p-4 rounded-xl space-y-2"
          >
            <h3
              class="font-bold text-primary text-base m-0 flex items-center gap-2"
            >
              <HiOutlineCreditCard className="text-lg" /> बँक भरणा (NEFT / IMPS /
              Account Transfer) तपशील:
            </h3>
            <ul class="list-none p-0 m-0 space-y-1.5 text-text-main">
              <li>
                • <strong>खात्याचे नाव (Account Name):</strong> SINDHUDURG DCC BANK
                EXAM FEE
              </li>
              <li>
                • <strong>खाता क्रमांक (Account Number):</strong> 999410040000001
              </li>
              <li>• <strong>IFSC कोड (IFSC Code):</strong> SIDC0001999</li>
              <li>
                • <strong>बँक व शाखा:</strong> दि सिंधुदुर्ग जिल्हा मध्यवर्ती सहकारी
                बँक लि., मुख्य कार्यालय – सिंधुदुर्गनगरी
              </li>
            </ul>
            <p class="text-xs text-rose-500 font-bold m-0 mt-2">
              ⚠️ महत्त्वाची टीप: शुल्क भरल्यानंतर मिळणारा Transaction ID / UTR
              क्रमांक ऑनलाईन अर्जात नमूद करणे आणि पेमेंट पावती (Receipt) ऑनलाईन
              अपलोड करणे अनिवार्य आहे.
            </p>
          </div>
        </div>

        <!-- Important Dates & Links Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          {
            translateMarathi(
              "महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)",
            )
          }
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event / Detail)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तारीख / दुवा (Information / Link)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज भरण्याची सुरूवात दिनांक</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >०३ सप्टेंबर २०२६ (सकाळी १२:०० वाजता)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज करण्याची अंतिम तारीख (Last Date)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-rose-500 text-lg shrink-0"
                    /> १७ सप्टेंबर २०२६ (रात्री ११:५९ वाजेपर्यंत)</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >हॉल तिकीट उपलब्ध (Hall Ticket Availability)</td
