---
import Layout from "../layouts/Layout.astro";
import { HiOutlineCalendarDays, HiOutlineArrowTopRightOnSquare, HiOutlineBell, HiOutlineBuildingOffice } from "react-icons/hi2";

const admitCards = [
  {
    title: "UPSC Civil Services Prelims 2026",
    organisation: "Union Public Service Commission",
    category: "UPSC",
    releaseDate: "May 15, 2026",
    examDate: "May 24, 2026",
    status: "available",
    link: "https://upsc.gov.in"
  },
  {
    title: "SSC CGL Tier 1 Hall Ticket",
    organisation: "Staff Selection Commission",
    category: "SSC",
    releaseDate: "May 18, 2026",
    examDate: "June 05, 2026",
    status: "expected",
    link: "https://ssc.gov.in"
  },
  {
    title: "SBI PO Mains Admit Card",
    organisation: "State Bank of India",
    category: "Banking",
    releaseDate: "May 12, 2026",
    examDate: "May 22, 2026",
    status: "available",
    link: "https://sbi.co.in"
  },
  {
    title: "RRB NTPC CBT Stage 1",
    organisation: "Railway Recruitment Board",
    category: "Railways",
    releaseDate: "May 28, 2026",
    examDate: "June 15, 2026",
    status: "expected",
    link: "https://rrcb.gov.in"
  },
  {
    title: "IBPS Clerk Prelims Hall Ticket",
    organisation: "Institute of Banking Personnel Selection",
    category: "Banking",
    releaseDate: "May 16, 2026",
    examDate: "June 02, 2026",
    status: "available",
    link: "https://ibps.in"
  },
  {
    title: "MPSC State Services Prelims",
    organisation: "Maharashtra Public Service Commission",
    category: "State Exams",
    releaseDate: "April 20, 2026",
    examDate: "April 28, 2026",
    status: "closed",
    link: "https://mpsc.gov.in"
  },
  {
    title: "LIC ADO Interview Call Letter",
    organisation: "Life Insurance Corporation of India",
    category: "Banking",
    releaseDate: "May 20, 2026",
    examDate: "June 08, 2026",
    status: "expected",
    link: "https://licindia.in"
  },
  {
    title: "SSC CHSL Tier 1 Admit Card",
    organisation: "Staff Selection Commission",
    category: "SSC",
    releaseDate: "May 14, 2026",
    examDate: "May 25, 2026",
    status: "available",
    link: "https://ssc.gov.in"
  },
  {
    title: "ISRO Scientist/Engineer Direct Recruitment",
    organisation: "Indian Space Research Organisation",
    category: "Direct Recruitment",
    releaseDate: "May 20, 2026",
    examDate: "June 07, 2026",
    status: "available",
    link: "https://isro.gov.in"
  },
  {
    title: "DRDO Scientist B Hall Ticket",
    organisation: "Defence Research and Development Organisation",
    category: "Direct Recruitment",
    releaseDate: "June 02, 2026",
    examDate: "June 18, 2026",
    status: "expected",
    link: "https://drdo.gov.in"
  }
];


---

<Layout title="Admit Card Download 2026 - Hall Ticket & Exam Date Schedule | TechFixSteps" description="Download official admit cards and hall tickets 2026. Get UPSC, SSC, SBI, IBPS, RRB, MPSC exam admit card release dates, exam schedules, and direct download links at techfixsteps.com.">
  <section class="pt-12 pb-16 not-prose">
    <h1 class="sr-only">Admit Cards</h1>

    <!-- Admit Cards List -->
    <div class="max-w-[1000px] mx-auto px-2 md:px-0">
      <div id="admit-cards-grid" class="flex flex-col gap-3 md:gap-4 transition-all duration-300">
        {admitCards.map((card, index) => (
          <div
            data-title={card.title}
            data-org={card.organisation}
            data-category={card.category}
            class="admit-card-item flex flex-col md:flex-row md:items-center justify-between p-3.5 md:p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-primary opacity-0 animate-[fadeInUp_0.6s_ease_forwards] gap-3 md:gap-4"
            style={`animation-delay: ${index * 0.08}s`}
          >
            <!-- Left: Info Block -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class="text-[0.65rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                  {card.category}
                </span>

                {card.status === "available" && (
                  <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                    Available Now
                  </span>
                )}

                {card.status === "expected" && (
                  <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-amber-500 animate-pulse inline-block"></span>
                    Expected Soon
                  </span>
                )}

                {card.status === "closed" && (
                  <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                    Closed
                  </span>
                )}
              </div>

              <h3 class="text-base text-text-main font-bold leading-tight mb-1 truncate">{card.title}</h3>
              <div class="flex items-center gap-1.5 text-xs text-text-muted">
                <HiOutlineBuildingOffice className="shrink-0 text-xs" />
                <span class="truncate">{card.organisation}</span>
              </div>
            </div>

            <!-- Middle: Dates (Release & Exam) -->
            <div class="flex flex-row gap-6 md:gap-8 shrink-0 py-2 md:py-0 border-y md:border-y-0 border-border-card dark:border-border-card/20 my-1 md:my-0">
              <div>
                <span class="block text-[0.6rem] text-text-muted uppercase tracking-wider mb-0.5">Release Date</span>
                <span class="flex items-center gap-1 text-xs font-bold text-text-main">
                  <HiOutlineCalendarDays className="text-primary text-xs shrink-0" /> {card.releaseDate}
                </span>
              </div>
              <div>
                <span class="block text-[0.6rem] text-text-muted uppercase tracking-wider mb-0.5">Exam Date</span>
                <span class="flex items-center gap-1 text-xs font-bold text-text-main">
                  <HiOutlineCalendarDays className="text-primary text-xs shrink-0" /> {card.examDate}
                </span>
              </div>
            </div>

            <!-- Right: CTA Buttons -->
            <div class="shrink-0 w-full md:w-auto md:min-w-[180px]">
              {card.status === "available" && (
                <a
                  href={card.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full md:w-auto btn-primary !rounded-xl !py-2 flex items-center justify-center gap-2 group/btn text-[0.65rem] font-bold uppercase tracking-wider px-5"
                >
                  <span>Download Hall Ticket</span>
                  <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                </a>
              )}

              {card.status === "expected" && (
                <button
                  type="button"
                  disabled
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 bg-red-500/10 dark:bg-red-500/5 border border-solid border-red-500/20 text-red-500 dark:text-red-400 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center animate-pulse"
                >
                  <HiOutlineBell className="text-xs text-red-500 dark:text-red-400 shrink-0" />
                  <span>Coming Soon</span>
                </button>
              )}

              {card.status === "closed" && (
                <button
                  type="button"
                  disabled
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 bg-rose-500/5 border border-solid border-rose-500/15 text-rose-500/60 dark:text-rose-400/60 font-bold uppercase tracking-wider text-[0.65rem] rounded-xl cursor-not-allowed text-center"
                >
                  <span>Download Closed</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

  </section>
</Layout>
