---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineArrowDownTray,
  HiOutlineQueueList,
  HiOutlineIdentification,
  HiOutlineUserGroup,
  HiOutlineBellAlert,
  HiOutlineCheckBadge,
  HiOutlineMegaphone,
  HiOutlineClock
} from "react-icons/hi2";

const title = "MPSC गट-क सेवा संयुक्त पूर्व परीक्षा २०२६: ५,७०७ जागांसाठी शुद्धिपत्रक प्रसिद्ध, अर्ज मुदतवाढ व पदसंख्या वाढ!";
const description = "महाराष्ट्र लोकसेवा आयोग (MPSC) गट-क सेवा संयुक्त पूर्व परीक्षा २०२६ चे नवीन शुद्धिपत्रक (Corrigendum) जाहीर. एकूण ५,७०७ पदे (२,६१९ + ३,०८८ = ५,७०७ पदे). ऑनलाईन अर्ज करण्याची मुदत १० ऑगस्ट २०२६ पर्यंत वाढवली असून परीक्षा २५ ऑक्टोबर २०२६ रोजी होणार आहे.";
const canonicalURL = "https://mahasandhi.in/mpsc-group-c-bharti-2026";
const date = "August 05, 2026";
const category = "MPSC Bharti";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6 flex-wrap">
        <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20 flex items-center gap-1.5">
          <HiOutlineMegaphone className="text-sm" /> {category}
        </span>
        <span class="bg-rose-500/10 text-rose-600 dark:text-rose-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-rose-500/20">
          शुद्धिपत्रक (Corrigendum)
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]">
        {title}
      </h1>
      <p class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic">
        {description}
      </p>
    </div>

    <!-- Quick Highlights Banner -->
    <div class="bg-gradient-to-br from-primary/10 via-primary/5 to-transparent border border-primary/20 rounded-3xl p-6 md:p-8 mb-12 shadow-sm">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div class="p-3 bg-bg-surface/80 backdrop-blur-sm rounded-2xl border border-border-card">
          <span class="text-xs text-text-muted block uppercase font-bold tracking-wider mb-1">एकूण पदे (Total Vacancies)</span>
          <span class="text-2xl md:text-3xl font-black text-primary">5,707</span>
          <span class="text-[0.65rem] text-text-muted font-semibold block mt-0.5">(2619 + 3088 = 5707)</span>
        </div>
        <div class="p-3 bg-bg-surface/80 backdrop-blur-sm rounded-2xl border border-border-card">
          <span class="text-xs text-text-muted block uppercase font-bold tracking-wider mb-1">नवीन अंतिम तारीख (Last Date)</span>
          <span class="text-lg md:text-xl font-extrabold text-rose-600 dark:text-rose-400"><span class="line-through text-text-muted/70 font-normal text-sm sm:text-base mr-1.5">05 ऑगस्ट 2026</span>10 ऑगस्ट 2026</span>
        </div>
        <div class="p-3 bg-bg-surface/80 backdrop-blur-sm rounded-2xl border border-border-card">
          <span class="text-xs text-text-muted block uppercase font-bold tracking-wider mb-1">परीक्षा तारीख (Exam Date)</span>
          <span class="text-lg md:text-xl font-extrabold text-emerald-600 dark:text-emerald-400">25 ऑक्टोबर 2026</span>
        </div>
        <div class="p-3 bg-bg-surface/80 backdrop-blur-sm rounded-2xl border border-border-card">
          <span class="text-xs text-text-muted block uppercase font-bold tracking-wider mb-1">परीक्षेचे स्वरूप (Exam Mode)</span>
          <span class="text-lg md:text-xl font-bold text-text-main">Offline (OMR)</span>
        </div>
      </div>
    </div>

    <!-- Quick Resource Links Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 not-prose">
      <a 
        href="https://mpsconline.gov.in" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-gradient-to-br from-emerald-500/5 to-teal-500/5 hover:from-emerald-500/10 hover:to-teal-500/10 border border-emerald-500/20 hover:border-emerald-500/50 rounded-2xl transition-all duration-300 shadow-sm hover:shadow-emerald-500/10 flex flex-col justify-between min-h-[130px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-3 bg-emerald-500/10 text-emerald-500 rounded-xl group-hover:bg-emerald-500 group-hover:text-white transition-all duration-300">
            <HiOutlineCursorArrowRays className="text-xl" />
          </div>
          <HiOutlineArrowTopRightOnSquare className="text-emerald-500/40 group-hover:text-emerald-500 transition-colors duration-300" />
        </div>
        <div>
          <h4 class="text-sm font-bold text-text-main group-hover:text-emerald-500 transition-colors mb-0.5">ऑनलाईन अर्ज (Apply Online)</h4>
          <span class="text-[0.7rem] text-text-muted">mpsconline.gov.in वर अर्ज करा</span>
        </div>
      </a>

      <a 
        href="https://mpsc.gov.in" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-gradient-to-br from-primary/5 to-primary-light/5 hover:from-primary/10 hover:to-primary-light/10 border border-primary/20 hover:border-primary/50 rounded-2xl transition-all duration-300 shadow-sm hover:shadow-primary/10 flex flex-col justify-between min-h-[130px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-3 bg-primary/10 text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-all duration-300">
            <HiOutlineDocumentText className="text-xl" />
          </div>
          <HiOutlineArrowTopRightOnSquare className="text-primary/40 group-hover:text-primary transition-colors duration-300" />
        </div>
        <div>
          <h4 class="text-sm font-bold text-text-main group-hover:text-primary transition-colors mb-0.5">शुद्धिपत्रक PDF (Notice PDF)</h4>
          <span class="text-[0.7rem] text-text-muted">अधिकृत जाहिरात व शुद्धिपत्रक</span>
        </div>
      </a>

      <a 
        href="/mpsc/mpsc-group-c-exam-details" 
        class="group p-5 bg-gradient-to-br from-amber-500/5 to-orange-500/5 hover:from-amber-500/10 hover:to-orange-500/10 border border-amber-500/20 hover:border-amber-500/50 rounded-2xl transition-all duration-300 shadow-sm hover:shadow-amber-500/10 flex flex-col justify-between min-h-[130px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-3 bg-amber-500/10 text-amber-500 rounded-xl group-hover:bg-amber-500 group-hover:text-white transition-all duration-300">
            <HiOutlineAcademicCap className="text-xl" />
          </div>
          <HiOutlineArrowTopRightOnSquare className="text-amber-500/40 group-hover:text-amber-500 transition-colors duration-300" />
        </div>
        <div>
          <h4 class="text-sm font-bold text-text-main group-hover:text-amber-500 transition-colors mb-0.5">गट क अभ्यासक्रम (Syllabus)</h4>
          <span class="text-[0.7rem] text-text-muted">परीक्षा पद्धत व टायपिंग निकष</span>
        </div>
      </a>

      <a 
        href="/result" 
        class="group p-5 bg-gradient-to-br from-rose-500/5 to-pink-500/5 hover:from-rose-500/10 hover:to-pink-500/10 border border-rose-500/20 hover:border-rose-500/50 rounded-2xl transition-all duration-300 shadow-sm hover:shadow-rose-500/10 flex flex-col justify-between min-h-[130px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-3 bg-rose-500/10 text-rose-500 rounded-xl group-hover:bg-rose-500 group-hover:text-white transition-all duration-300">
            <HiOutlineQueueList className="text-xl" />
          </div>
          <HiOutlineArrowTopRightOnSquare className="text-rose-500/40 group-hover:text-rose-500 transition-colors duration-300" />
        </div>
        <div>
          <h4 class="text-sm font-bold text-text-main group-hover:text-rose-500 transition-colors mb-0.5">निकाल व अपडेट्स (Results)</h4>
          <span class="text-[0.7rem] text-text-muted">MPSC निकाल व गुणवत्ता यादी</span>
        </div>
      </a>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-6 md:p-8 mb-12">
        <h2 class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none">
          <HiOutlineDocumentText className="text-primary" />
          या लेखातील मुख्य मुद्दे (Table of Contents)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li><a href="#overview-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">१. MPSC गट-क शुद्धिपत्रक २०२६ महत्त्वाचे अपडेट्स</a></li>
          <li><a href="#vacancies-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">२. विभागनिहाय व पदनिहाय ५,७०७ जागांचा सविस्तर तक्ता</a></li>
          <li><a href="#eligibility-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">३. पदनिहाय शैक्षणिक पात्रता (Educational Qualification)</a></li>
          <li><a href="#age-limit-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">४. वयाची अट व सवलत (Age Limit Criteria)</a></li>
          <li><a href="#dates-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">५. महत्त्वाच्या तारखा (Important Dates & Deadline Extension)</a></li>
          <li><a href="#links-mr" class="text-text-muted hover:text-primary transition-colors text-sm font-medium">६. अधिकृत लिंक्स व अर्ज प्रक्रिया</a></li>
        </ul>
      </div>

      <!-- Main Article Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <h2 id="overview-mr">MPSC गट-क सेवा संयुक्त पूर्व परीक्षा २०२६: नवीन शुद्धिपत्रक व मुदतवाढ</h2>
        <p>
          <strong>महाराष्ट्र लोकसेवा आयोग (MPSC)</strong> मार्फत <strong>महाराष्ट्र गट-क सेवा संयुक्त पूर्व परीक्षा - २०२६ (जाहिरात क्रमांक: ०१७/२०२६)</strong> अंतर्गत नवीन शुद्धिपत्रक प्रसिद्ध करण्यात आले आहे. या शुद्धिपत्रकानुसार विविध शासकीय विभागांकडून प्राप्त झालेल्या अतिरिक्त मागणीपत्रांचा समावेश करण्यात आला असून, एकूण पदसंख्या वाढवून <strong>५,७०७ पदे (२६१९ + ३०८८ = ५७०७ पदे)</strong> करण्यात आली आहे.
        </p>
        <p>
          ऑनलाईन अर्ज करण्यासाठी उमेदवारांना मुदतवाढ देण्यात आली असून <span class="line-through text-text-muted/70 font-normal">०५ ऑगस्ट २०२६</span> <strong>१० ऑगस्ट २०२६</strong> पर्यंत सुधारित ऑनलाईन अर्ज करता येतील. संयुक्त पूर्व परीक्षा <strong>२५ ऑक्टोबर २०२६</strong> रोजी आयोजित केली जाणार आहे.
        </p>

        <!-- Departmental Vacancy Table (Marathi) -->
        <h2 id="vacancies-mr" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">
          विभागनिहाय व पदनिहाय ५,७०७ रिक्त पदांचा सविस्तर तक्ता
        </h2>
        <p>गट-क भरती २०२६ अंतर्गत समाविष्ट सर्व ११ पदप्रकार व विभागांची माहिती खालीलप्रमाणे आहे:</p>

        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse border border-border-card rounded-2xl overflow-hidden shadow-sm">
            <thead>
              <tr class="bg-primary/10 text-text-main">
                <th class="p-3.5 border border-border-card font-extrabold text-sm text-center">पद क्र.</th>
                <th class="p-3.5 border border-border-card font-extrabold text-sm">पदनाम (Post Name)</th>
                <th class="p-3.5 border border-border-card font-extrabold text-sm">विभाग (Department)</th>
                <th class="p-3.5 border border-border-card font-extrabold text-sm text-center">एकूण पदे</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">1</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">उद्योग निरीक्षक</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">उद्योग ऊर्जा व कामगार विभाग</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">09</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">2</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">तांत्रिक सहायक</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">वित्त विभाग</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">03</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">3</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">कर सहायक</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">वित्त विभाग</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">282</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">4</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">सहायक मोटार वाहन निरीक्षक, गट-क (AMVI)</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">गृह विभाग</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">461</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">5</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">लिपिक-टंकलेखक</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">मंत्रालयीन प्रशासकीय विभाग तसेच राज्य शासनाची महाराष्ट्रातील विविध कार्यालये</td>
                <td class="p-3.5 border border-border-card font-black text-center text-primary text-base">1,864</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">6</td>
                <td class="p-3.5 border border-border-card font-bold text-primary">ग्राम महसूल अधिकारी (तलाठी), गट-क (विविध नियुक्ती प्राधिकारी)</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">महसूल व वन विभाग</td>
                <td class="p-3.5 border border-border-card font-black text-center text-primary text-base">1,539</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">7</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">वरिष्ठ अभिलेखापाल / वरिष्ठ लिपिक / अभिलेखापाल, गट-क</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">राज्य ग्राहक तक्रार निवारण आयोग, मुंबई</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">11</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">8</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">सहायक अधीक्षक, गट-क</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">राज्य ग्राहक तक्रार निवारण आयोग, मुंबई</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">11</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">9</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">सहाय्यक मत्स्यव्यवसाय विकास अधिकारी (तांत्रिक), गट-क</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">कृषी व प. दु. म. विभाग</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">254</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center" rowspan="4">10</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main" rowspan="4">लिपिक-टंकलेखक (विविध नियुक्ती प्राधिकारी)</td>
                <td class="p-3.5 border border-border-card text-xs">नियंत्रक शिधावाटप व संचालक नागरी पुरवठा कार्यालय (230 पदे)</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary" rowspan="4">944 <br/><span class="text-[0.65rem] text-text-muted font-normal">(230+155+69+490)</span></td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card text-xs">अन्न नागरी पुरवठा व ग्राहक संरक्षण विभाग (155 पदे)</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card text-xs">आदिवासी विकास विभाग (69 पदे)</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card text-xs">महसूल व वन विभाग (490 पदे)</td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td class="p-3.5 border border-border-card font-bold text-center">11</td>
                <td class="p-3.5 border border-border-card font-bold text-text-main">लिपिक-टंकलेखक नोंदणी व मुद्रांक विभाग</td>
                <td class="p-3.5 border border-border-card font-semibold text-text-muted">महसूल व वन विभाग</td>
                <td class="p-3.5 border border-border-card font-extrabold text-center text-primary">339</td>
