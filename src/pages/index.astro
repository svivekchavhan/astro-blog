---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineBuildingOffice, 
  HiOutlineAcademicCap 
} from "react-icons/hi2";
const latestJobs = [
  {
    title: "UPSC Civil Services Examination 2026",
    organisation: "Union Public Service Commission",
    qualification: "Degree in any discipline",
    vacancies: "1,056",
    startDate: "May 20, 2026",
    lastDate: "June 18, 2026",
    category: "UPSC",
    status: "apply-now",
    link: "https://upsc.gov.in",
    description: "Apply for prestigious IAS, IPS, IFS, and Group A central service administrative officer vacancies through the official UPSC Civil Services recruitment notification guidelines."
  },
  {
    title: "SSC CGL Recruitment 2026",
    organisation: "Staff Selection Commission",
    qualification: "Bachelor's Degree",
    vacancies: "8,412",
    startDate: "June 10, 2026",
    lastDate: "July 10, 2026",
    category: "SSC",
    status: "upcoming",
    link: "https://ssc.gov.in",
    description: "Staff Selection Commission Combined Graduate Level examination for inspector, assistant section officer, sub-inspector, and auditor vacancies across central government ministries."
  },
  {
    title: "SBI Probationary Officers (PO) 2026",
    organisation: "State Bank of India",
    qualification: "Graduation",
    vacancies: "2,000",
    startDate: "April 15, 2026",
    lastDate: "May 15, 2026",
    category: "Banking",
    status: "closed",
    link: "https://sbi.co.in",
    description: "National public-sector recruitment program for Probationary Officer vacancies within State Bank of India's corporate, retail, and international banking operational zones."
  },
  {
    title: "RRB Assistant Loco Pilot (ALP) Vacancies",
    organisation: "Railway Recruitment Board",
    qualification: "Matriculation / ITI",
    vacancies: "5,696",
    startDate: "May 01, 2026",
    lastDate: "June 02, 2026",
    category: "Railways",
    status: "apply-now",
    link: "https://rrbcdg.gov.in",
    description: "Indian Railways technical recruitment for Assistant Loco Pilot posts across multiple railway zones, covering standard qualification benchmarks and CBT guidelines."
  },
  {
    title: "MPSC State Services Examination 2026",
    organisation: "Maharashtra Public Service Commission",
    qualification: "Graduate Degree",
    vacancies: "500+",
    startDate: "June 15, 2026",
    lastDate: "July 15, 2026",
    category: "State Exams",
    status: "upcoming",
    link: "https://mpsc.gov.in",
    description: "Maharashtra state administration services recruitment for Deputy Collector, Deputy Superintendent of Police (DySP), and Block Development Officer (BDO) vacancies."
  },
  {
    title: "IBPS Clerk CWE XII Recruitment",
    organisation: "Institute of Banking Personnel Selection",
    qualification: "Any Graduation Degree",
    vacancies: "6,000+",
    startDate: "May 25, 2026",
    lastDate: "June 20, 2026",
    category: "Banking",
    status: "upcoming",
    link: "https://ibps.in",
    description: "Common recruitment process for clerical cadre vacancies in participating public sector banks across India, including exam patterns and reservation policies."
  },
  {
    title: "DRDO Scientist 'B' Recruitment",
    organisation: "Defence Research and Development Organisation",
    qualification: "First Class B.E / B.Tech",
    vacancies: "320",
    startDate: "June 02, 2026",
    lastDate: "June 25, 2026",
    category: "Direct Recruitment",
    status: "upcoming",
    link: "https://drdo.gov.in",
    description: "Direct entry level scientist vacancies at the Defence Research and Development Organisation for outstanding engineering graduates with valid GATE score metrics."
  }
];
---

<Layout title="Latest Government Jobs & Vacancies 2026 | Sarkari Naukri Updates - TechFixSteps" description="Explore latest government job notifications 2026. Find UPSC, SSC, Banking, Railways, State PSC recruitment updates with vacancies, eligibility criteria, application dates, and direct apply links at techfixsteps.com.">
  <section class="py-8 pb-20 not-prose">
    <!-- Header Section -->
    <div class="mb-8 border-b border-border-card dark:border-border-card/30 pb-4">
      <h2 class="text-2xl md:text-3xl font-black tracking-tight text-text-main m-0 uppercase italic flex items-center gap-2">
        Latest <span class="gradient-text">Jobs & Vacancies</span>
      </h2>
    </div>

    <!-- Jobs List Container (All items wrapped in one unified dashboard container with proper borders) -->
    <div class="max-w-[1000px] mx-auto px-0 md:px-0">
      <div class="bg-bg-surface border border-border-card rounded-xl md:rounded-3xl p-6 md:p-8 shadow-sm">
        <div id="jobs-list" class="flex flex-col">
        {latestJobs.map((job, index) => (
          <div 
            class="py-6 first:pt-0 border-b border-border-card dark:border-border-card/30 last:border-b-0 last:pb-0 opacity-0 animate-[fadeInUp_0.5s_ease_forwards]"
            style={`animation-delay: ${index * 0.06}s`}
          >
            <!-- Category and Status badges -->
            <div class="flex items-center gap-2 mb-2.5 flex-wrap">
              <span class="text-[0.55rem] sm:text-[0.6rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                {job.category}
              </span>

              {job.status === "apply-now" && (
                <span class="text-[0.5rem] sm:text-[0.55rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                  <span class="w-1.2 h-1.2 sm:w-1.5 sm:h-1.5 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                  Apply Now
                </span>
              )}

              {job.status === "upcoming" && (
                <span class="text-[0.5rem] sm:text-[0.55rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                  <span class="w-1.2 h-1.2 sm:w-1.5 sm:h-1.5 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-amber-500 animate-pulse inline-block"></span>
                  Upcoming
                </span>
              )}

              {job.status === "closed" && (
                <span class="text-[0.5rem] sm:text-[0.55rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                  <span class="w-1.2 h-1.2 sm:w-1.5 sm:h-1.5 bg-rose-500 rounded-full inline-block"></span>
                  Closed
                </span>
              )}
            </div>

            <!-- Job Title (Responsive Text size) -->
            <h3 class="text-base sm:text-lg md:text-xl text-text-main font-bold leading-tight mb-2 hover:text-primary transition-colors cursor-pointer">
              {job.title}
            </h3>

            <!-- Description (Responsive Text size) -->
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed mb-3.5 max-w-[850px]">
              {job.description}
            </p>
            
            <!-- Prominent Row: Total Posts & Last Date (Responsive Sizes) -->
            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
              <span class="text-[0.65rem] sm:text-[0.75rem] md:text-xs font-black bg-primary/10 text-primary border border-solid border-primary/30 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-lg uppercase tracking-wider shadow-sm">
                Total Posts: <span class="text-primary font-black underline decoration-2 decoration-primary/30">{job.vacancies}</span>
              </span>

              <span class="flex items-center gap-1.5 text-[0.65rem] sm:text-[0.75rem] md:text-xs font-black bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/30 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-lg uppercase tracking-wider shadow-sm">
                <HiOutlineCalendarDays className="text-rose-500 text-xs sm:text-sm shrink-0" /> Last Date: <span class="font-black">{job.lastDate}</span>
              </span>
            </div>
          </div>
        ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
