---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";

const posts = [
  { 
    title: "The Ultimate Guide to Google Gemini AI: What It Is, How It Works, and How to Use It Every Day", 
    href: "/blog/google-gemini-guide", 
    date: "May 15, 2026", 
    category: "AI",
    image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=800&q=80"
  },
  { 
    title: "How to Open a Savings Account in SBI: A Step-by-Step Guide", 
    href: "/blog/how-to-open-sbi-account", 
    date: "May 15, 2026", 
    category: "Banking",
    image: "https://images.unsplash.com/photo-1501167786227-4cba60f6d58f?auto=format&fit=crop&w=800&q=80"
  },
  { 
    title: "What is Aadhar Card: Benefits, Features, and How to Get It", 
    href: "/blog/what-is-aadhar-card", 
    date: "May 14, 2026", 
    category: "Government",
    image: "https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=800&q=80"
  },
  { 
    title: "Which is the Best Mutual Fund Plan for 2026? A Complete Guide", 
    href: "/blog/best-mutual-fund-plan", 
    date: "May 13, 2026", 
    category: "Finance",
    image: "https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?auto=format&fit=crop&w=800&q=80"
  }
];

const latestPosts = posts;
---

<Layout title="AstroBlog | Home of Technical Insights">
  <!-- Latest Articles Section -->
  <section id="posts" class="py-12 pb-24">
    <div class="mb-12 flex justify-between items-end border-b border-border-card pb-6">
      <h2 class="text-3xl font-black tracking-tight text-text-main m-0 uppercase italic">Latest <span class="gradient-text">Articles</span></h2>
      <a href="/blog" class="text-primary hover:underline font-medium">Browse Archive →</a>
    </div>

    <div class="mt-8">
      <div id="posts-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          latestPosts.map((post, index) => (
            <div
              class={`post-item-wrapper h-full ${index >= 6 ? "hidden" : ""}`}
              data-index={index}
            >
              <BlogCard {...post} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex justify-center">
      <button id="load-more-btn" class="btn-primary !px-12 !py-4 shadow-lg hover:shadow-primary/30 flex items-center gap-3">
        <span class="btn-text">Load More Stories</span>
        <div class="loader hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin" id="loader"></div>
      </button>
    </div>
  </section>
</Layout>

<script>
  function initLoadMore() {
    const loadMoreBtn = document.getElementById("load-more-btn") as HTMLButtonElement;
    const loader = document.getElementById("loader");
    const btnText = loadMoreBtn?.querySelector(".btn-text");

    let currentVisible = 6;
    const increment = 4;

    loadMoreBtn?.addEventListener("click", () => {
      loader?.classList.remove("hidden");
      if (btnText) btnText.textContent = "Fetching...";
      loadMoreBtn.disabled = true;
      loadMoreBtn.classList.add('opacity-80', 'cursor-not-allowed');

      setTimeout(() => {
        const hiddenItems = document.querySelectorAll(".post-item-wrapper.hidden");
        let revealedCount = 0;

        hiddenItems.forEach((item, index) => {
          if (index < increment) {
            item.classList.remove("hidden");
            item.classList.add("animate-[fadeInUp_0.6s_ease_forwards]");
            revealedCount++;
          }
        });

        currentVisible += revealedCount;

        loader?.classList.add("hidden");
        if (btnText) btnText.textContent = "Load More Stories";
        loadMoreBtn.disabled = false;
        loadMoreBtn.classList.remove('opacity-80', 'cursor-not-allowed');

        if (document.querySelectorAll(".post-item-wrapper.hidden").length === 0) {
          loadMoreBtn.style.display = "none";
        }
      }, 800);
    });
  }

  // Initialize on first load
  initLoadMore();

  // Re-initialize after view transitions
  document.addEventListener('astro:page-load', initLoadMore);
</script>
