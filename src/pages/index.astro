        class="group flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5 md:p-6 bg-gradient-to-r from-violet-500/10 via-primary/10 to-rose-500/10 hover:from-violet-500/20 hover:to-rose-500/20 border-2 border-violet-500/30 hover:border-violet-500 rounded-2xl md:rounded-3xl no-underline shadow-xs transition-all duration-300"
      >
        <div class="space-y-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2.5 py-0.5 bg-violet-600 text-white rounded-md text-[0.65rem] font-black uppercase tracking-wider shadow-xs">
              🔥 Featured Hub
            </span>
            <span class="px-2.5 py-0.5 bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 rounded-md text-[0.65rem] font-bold uppercase tracking-wider">
              ५,७०७ जागा 
            </span>
          </div>
          <h3 class="text-base sm:text-lg md:text-xl font-extrabold text-text-main group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors m-0 leading-snug">
            MPSC Combine Group C Exam 2026: गट-क संयुक्त परीक्षा सर्व माहिती
          </h3>
          <p class="text-xs text-text-secondary m-0 line-clamp-1">
            तलाठी १५३९ पदे, लिपिक ३१९७ पदे, सविस्तर जाहिरात, मुदतवाढ शुद्धिपत्रक व अभ्यासक्रम एकत्रित पहा →
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-violet-600 text-white text-xs font-bold uppercase tracking-wider rounded-xl group-hover:bg-violet-700 transition-colors shrink-0 shadow-xs">
          <span>पहा</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </span>
      </a>
    </div>

    <!-- Jobs List Container (All items wrapped in one unified dashboard container with proper borders) -->
    <div class="max-w-[1000px] mx-auto px-0 md:px-0">
      <div class="bg-bg-surface border border-border-card rounded-xl md:rounded-3xl p-6 md:p-8 shadow-sm">
        <div id="jobs-list" class="flex flex-col">
        {latestJobs.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-text-muted text-sm m-0">No active jobs or vacancies at the moment. Please check back later!</p>
          </div>
        ) : (
          latestJobs.map((job, index) => (
            <div 
              class="group py-6 first:pt-0 border-b border-border-card dark:border-border-card/30 last:border-b-0 last:pb-0"
            >
              <!-- Category and Status badges -->
              <div class="flex items-center gap-2 mb-2.5 flex-wrap">
                <span class="text-[0.55rem] sm:text-[0.6rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                  {job.category}
                </span>

                {job.status === "apply-now" && (
                  <span class="text-[0.5rem] sm:text-[0.55rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1.2 h-1.2 sm:w-1.5 sm:h-1.5 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                    Apply Now
                  </span>
                )}

                {job.status === "upcoming" && (
                  <span class="text-[0.5rem] sm:text-[0.55rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1.2 h-1.2 sm:w-1.5 sm:h-1.5 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                    Upcoming
                  </span>
                )}

                {job.status === "closed" && (
                  <span class="text-[0.5rem] sm:text-[0.55rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                    <span class="w-1.2 h-1.2 sm:w-1.5 sm:h-1.5 bg-rose-500 rounded-full inline-block"></span>
                    Closed
                  </span>
                )}
              </div>

              <!-- Job Title (Responsive Text size) -->
              <a href={job.link} class="no-underline hover:no-underline block">
                <h3 class="text-base sm:text-lg md:text-xl text-text-main font-bold leading-tight mb-2 group-hover:text-primary transition-colors cursor-pointer">
                  {job.title}
                </h3>
              </a>

              <!-- Description (Responsive Text size - Truncated to 15 words) -->
              <p class="text-xs sm:text-sm text-text-secondary leading-relaxed mb-3.5 max-w-[850px]">
                {truncateWords(job.description, 15)}
              </p>
              
              <!-- Prominent Row: Total Posts & Last Date (Responsive Sizes) -->
              <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                <span class="text-[0.65rem] sm:text-[0.75rem] md:text-xs font-black bg-primary/10 text-primary border border-solid border-primary/30 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-lg uppercase tracking-wider shadow-sm">
                  Total Posts: <span class="text-primary font-black underline decoration-2 decoration-primary/30">{job.vacancies}</span>
                </span>

                <span class="flex items-center gap-1.5 text-[0.65rem] sm:text-[0.75rem] md:text-xs font-black bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/30 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-lg uppercase tracking-wider shadow-sm">
                <HiOutlineCalendarDays className="text-rose-500 text-xs sm:text-sm shrink-0" /> Last Date: 
                {job.extendedDate ? (
                  <span class="flex items-center gap-1.5 font-bold">
                    <span class="line-through text-text-muted/70 font-medium">{job.lastDate}</span>
                    <span class="text-rose-600 dark:text-rose-400 font-extrabold">{job.extendedDate}</span>
                  </span>
                ) : (
                  <span class={`font-black ${job.status === "closed" ? "line-through text-text-muted/70" : ""}`}>{job.lastDate}</span>
                )}
              </span>
              </div>
            </div>
          ))
        )}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
