---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineBell,
  HiOutlineArrowDownTray,
} from "react-icons/hi2";

const title = "Indian Army Agniveer Admit Card 2026: Download CEE Hall Ticket";
const description = "Indian Army Agniveer CEE Admit Card 2026 is released. Check exam schedules and download hall tickets for GD, Technical, Clerk, and Tradesmen.";
const canonicalURL = "https://mahasandhi.in/agniveer-admit-card-2026";
const date = "June 02, 2026";
const category = "Admit Card";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1590233649088-e8898b5b4e31?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents (Marathi) -->
      <div
        class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12"
      >
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          या लेखातील मुख्य मुद्दे (मराठी)
        </h2>
        <ul
          class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2"
        >
          <li>
            <a
              href="#overview-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >अग्निवीर भरती प्रवेश पत्र सविस्तर माहिती</a
            >
          </li>
          <li>
            <a
              href="#how-to-download-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >प्रवेश पत्र कसे डाउनलोड करावे? (पायऱ्या)</a
            >
          </li>
          <li>
            <a
              href="#links-table-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >अग्निवीर प्रवेश पत्र डायरेक्ट डाउनलोड लिंक्स</a
            >
          </li>
          <li>
            <a
              href="#faq-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >वारंवार विचारले जाणारे प्रश्न (FAQs)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <p>
          भारतीय लष्कराने (Indian Army) अग्निवीर (Agniveer Recruitment 2026)
          भरती परीक्षेचे प्रवेश पत्र (Admit Card / Hall Ticket) अधिकृत वेबसाईटवर
          प्रसिद्ध केले आहे. ज्या उमेदवारांनी भारतीय सैन्यात अग्निवीर जनरल
          ड्युटी (GD), टेक्निकल, क्लर्क आणि ट्रेड्समन पदांसाठी अर्ज केले आहेत,
          ते आपले प्रवेश पत्र खाली दिलेल्या डायरेक्ट लिंकद्वारे डाऊनलोड करू
          शकतात.
        </p>

        <h2 id="overview-mr">लष्कर अग्निवीर प्रवेश पत्र २०२६ सविस्तर माहिती</h2>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >परीक्षा संस्था (Organiser)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >भारतीय लष्कर (Indian Army)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCalendarDays
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >परीक्षा दिनांक (Exam Date)</span
              >
              <span class="text-text-main font-semibold text-sm"
                >जून - जुलै २०२६</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBell className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >हॉल तिकीट स्थिती (Status)</span
              >
              <span
                class="text-emerald-500 font-bold text-sm flex items-center gap-1"
              >
                <span
                  class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"
                ></span> उपलब्ध (Available Now)
              </span>
            </div>
          </div>
        </div>

        <h2 id="how-to-download-mr">
          अग्निवीर हॉल तिकीट डाऊनलोड कसे करावे? (Steps)
        </h2>
        <p>आपले हॉल तिकीट सहज डाऊनलोड करण्यासाठी खालील टप्प्यांचे पालन करा:</p>

        <div class="space-y-6 pl-2 border-l-2 border-primary/30 my-6">
          <div class="relative pl-8">
            <span
              class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold"
              >1</span
            >
            <h4 class="text-text-main font-bold m-0 mb-1">
              Step 1: अधिकृत लॉगिन पोर्टल उघडा
            </h4>
            <p class="text-sm text-text-muted m-0">
              सर्वप्रथम भारतीय लष्कराच्या अधिकृत लॉगिन पोर्टलला भेट द्या किंवा
              खालील तक्त्यातील डायरेक्ट डाउनलोड लिंकवर क्लिक करा.
            </p>
          </div>
          <div class="relative pl-8">
            <span
              class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold"
              >2</span
            >
            <h4 class="text-text-main font-bold m-0 mb-1">
              Step 2: युझरनेम आणि पासवर्ड प्रविष्ट करा
            </h4>
            <p class="text-sm text-text-muted m-0">
              तुमचा नोंदणीकृत <strong>Username (Email ID)</strong> आणि <strong
                >Password</strong
              > टाकून लॉगिन करा.
            </p>
          </div>
          <div class="relative pl-8">
            <span
              class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold"
              >3</span
            >
            <h4 class="text-text-main font-bold m-0 mb-1">
              Step 3: 'Admit Card' वर क्लिक करा
            </h4>
            <p class="text-sm text-text-muted m-0">
              उमेदवार डॅशबोर्डवरील 'Online CEE Admit Card' या पर्यायावर क्लिक
              करा.
            </p>
          </div>
          <div class="relative pl-8">
            <span
              class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold"
              >4</span
            >
            <h4 class="text-text-main font-bold m-0 mb-1">
              Step 4: PDF डाऊनलोड करा
            </h4>
            <p class="text-sm text-text-muted m-0">
              तुमचे हॉल तिकीट डाऊनलोड होईल. परीक्षेच्या दिवशी सोबत नेण्यासाठी
              त्याची एक स्वच्छ प्रिंट काढून घ्या.
            </p>
          </div>
        </div>

        <!-- Admit Card Links Table (Marathi) -->
        <h2
          id="links-table-mr"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          अग्निवीर हॉल तिकीट महत्वाच्या लिंक्स (Important Links Table)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event / Resource)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >लिंक / कृती (Direct Link / Action)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अग्निवीर हॉल तिकीट डाउनलोड (Direct Download Link)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://joinindianarmy.nic.in"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold uppercase tracking-wider rounded-lg transition-all shadow-sm w-full sm:w-auto"
                  >
                    <HiOutlineArrowDownTray
                      className="text-base shrink-0 animate-bounce"
                    /> येथे डाउनलोड करा (Apply Login)
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >परीक्षा दिशा-निर्देश (Exam Instructions Notification)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://joinindianarmy.nic.in"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> डाउनलोड
                    नोटीस (PDF)
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अधिकृत संकेतस्थळ (Official Website)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://joinindianarmy.nic.in"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto"
                  >
                    <HiOutlineArrowTopRightOnSquare
                      className="text-base shrink-0"
                    /> Join Indian Army
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section (Marathi) -->
        <h2
          id="faq-mr"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">
              प्रश्न १: अग्निवीर भरतीची परीक्षा केव्हा आहे?
            </h3>
            <p class="text-text-muted m-0">
              उत्तर १: भारतीय सैन्यदल अग्निवीर भरती २०२६ ची लेखी परीक्षा जून आणि
              जुलै २०२६ या कालावधीत संपूर्ण देशात ऑनलाईन पद्धतीने घेतली जाईल.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-lg font-bold text-text-main mb-2">
              प्रश्न २: हॉल तिकीट डाऊनलोड करण्यासाठी पासवर्ड विसरल्यास काय
              करावे?
            </h3>
            <p class="text-text-muted m-0">
              उत्तर २: जर तुम्ही पासवर्ड विसरला असाल, तर जॉइन इंडियन आर्मीच्या
              लॉगिन पेजवर 'Forgot Password' या पर्यायावर क्लिक करून ईमेल
              आयडीच्या मदतीने रिसेट करू शकता.
            </p>
          </div>
        </div>

        <!-- Call to Action -->
        <div
          class="bg-primary/5 border border-primary/20 p-8 rounded-3xl text-center my-8"
        >
          <h2
            class="text-2xl font-black text-text-main mb-4 border-none p-0 mt-0"
          >
            ताज्या अपडेट्ससाठी जॉईन करा!
          </h2>
          <p class="text-text-muted mb-6">
            लष्कर भरती, प्रवेश पत्र आणि इतर निकालांच्या ताज्या घडामोडी थेट
            तुमच्या मोबाईलवर मिळवण्यासाठी आमच्या ग्रुप्समध्ये सामील व्हा.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="#"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              WhatsApp Group
            </a>
            <a
              href="#"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              Telegram Channel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div
      class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative"
    >
      <span
        class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md"
      >
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-text-main mb-4">
          Indian Army Agniveer Admit Card 2026: Direct Link to Download CEE Hall
          Ticket
        </h2>
        <p class="text-text-muted leading-relaxed italic">
          Indian Army has released the online Common Entrance Exam (CEE) admit
          card for Agniveer recruitment 2026. Registered candidates can check
          their exam date, center information, and download the call letters
          using the official link table.
        </p>
      </div>

      <!-- Table of Contents (English) -->
      <div
        class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12"
      >
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          Key Topics in this Article (English)
        </h2>
        <ul
          class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2"
        >
          <li>
            <a
              href="#overview-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Army Agniveer Admit Card 2026 Overview</a
            >
          </li>
          <li>
            <a
              href="#how-to-download-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Steps to Download Hall Ticket</a
            >
          </li>
          <li>
            <a
              href="#links-table-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Direct Links Table</a
            >
          </li>
          <li>
            <a
              href="#faq-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Frequently Asked Questions (FAQ)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (English) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <h2 id="overview-en">Agniveer Admit Card 2026 Overview</h2>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Exam Conducting Board</span
              >
              <span class="text-text-main font-semibold text-sm"
                >Indian Army</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCalendarDays
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Online CEE Exam Date</span
              >
              <span class="text-text-main font-semibold text-sm"
                >June - July 2026</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBell className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Hall Ticket Release Status</span
              >
              <span
                class="text-emerald-500 font-bold text-sm flex items-center gap-1"
              >
                <span
                  class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"
                ></span> Available to Download
              </span>
            </div>
          </div>
        </div>

        <h2 id="how-to-download-en">
          How to Download Indian Army Agniveer Admit Card?
        </h2>
        <p>
