---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";

const title = "Maharashtra ITI Admission 2026: Application Form, Dates, Merit List & Process";
const description = "Complete guide to Maharashtra ITI Admission 2026: Online registration steps, eligibility criteria, required documents, key dates, and seat allotment process.";
const canonicalURL = "https://techfixsteps.com/blog/iti-admission-2026-maharashtra";
const date = "May 20, 2026";
const category = "Admission";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-4xl md:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.2]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Table of Contents -->
    <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
      <h2
        class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary"
          ><line x1="8" y1="6" x2="21" y2="6"></line><line
            x1="8"
            y1="12"
            x2="21"
            y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
            x1="3"
            y1="6"
            x2="3.01"
            y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
            x1="3"
            y1="18"
            x2="3.01"
            y2="18"></line>
        </svg>
        In this article
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
        <li>
          <a
            href="#eligibility"
            class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
            >Eligibility Criteria</a
          >
        </li>
        <li>
          <a
            href="#dates"
            class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
            >Important Dates</a
          >
        </li>
        <li>
          <a
            href="#documents"
            class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
            >Documents Required</a
          >
        </li>
        <li>
          <a
            href="#online-process"
            class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
            >How to Apply Online</a
          >
        </li>
        <li>
          <a
            href="#faq"
            class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
            >Frequently Asked Questions</a
          >
        </li>
      </ul>
    </div>

    <!-- Content -->
    <div class="space-y-8 text-text-main leading-relaxed">
      <h2>Introduction</h2>
      <p>
        The Directorate of Vocational Education and Training (DVET), Maharashtra, coordinates the admissions for Industrial Training Institutes (ITI) across the state. In 2026, Maharashtra ITI admission is a gateway to diverse engineering and non-engineering vocational trades. This step-by-step guide walks you through the entire registration and seat allotment process.
      </p>

      <h2 id="eligibility">Eligibility Criteria</h2>
      <div class="bg-bg-surface/50 border-l-4 border-secondary p-6 rounded-r-2xl my-8">
        <ul class="m-0 space-y-2">
          <li><strong>Educational Qualification:</strong> Candidates must have passed Class 10th (SSC) or its equivalent from a recognized board. Some specific trades require passing Class 8th.</li>
          <li><strong>Age Limit:</strong> The candidate must be at least 14 years old as of August 1, 2026. There is no upper age limit.</li>
          <li><strong>Nationality:</strong> The candidate must be a citizen of India and reside in Maharashtra state to claim local domicile quota benefits.</li>
        </ul>
      </div>

      <h2 id="dates">Important Dates (Tentative Schedule)</h2>
      <div class="overflow-x-auto my-6 border border-border-card rounded-2xl">
        <table class="w-full text-left border-collapse m-0">
          <thead>
            <tr class="bg-bg-base border-b border-border-card">
              <th class="p-4 font-bold text-sm text-text-main">Event</th>
              <th class="p-4 font-bold text-sm text-text-main">Dates</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border-card hover:bg-bg-surface transition-colors">
              <td class="p-4 text-sm font-medium">Online Registration Starts</td>
              <td class="p-4 text-sm text-text-muted">June 2026</td>
            </tr>
            <tr class="border-b border-border-card hover:bg-bg-surface transition-colors">
              <td class="p-4 text-sm font-medium">Last Date to Submit Form & Choice Filling</td>
              <td class="p-4 text-sm text-text-muted">July 2026</td>
            </tr>
            <tr class="border-b border-border-card hover:bg-bg-surface transition-colors">
              <td class="p-4 text-sm font-medium">Release of Provisional Merit List</td>
              <td class="p-4 text-sm text-text-muted">July 2026</td>
            </tr>
            <tr class="hover:bg-bg-surface transition-colors">
              <td class="p-4 text-sm font-medium">First Seat Allotment Round</td>
              <td class="p-4 text-sm text-text-muted">August 2026</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 id="documents">Documents Required</h2>
      <p>Ensure you scan and upload the following documents during the online form submission:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8">
        <div class="bg-bg-card border border-border-card p-4 rounded-xl">
          <strong class="text-text-main block mb-1">Academic Certificates</strong>
          <span class="text-sm">Class 8th/10th Marksheets & Passing Certificate.</span>
        </div>
        <div class="bg-bg-card border border-border-card p-4 rounded-xl">
          <strong class="text-text-main block mb-1">Identity & Domicile</strong>
          <span class="text-sm">Aadhar Card, School Leaving Certificate, and Maharashtra Domicile Certificate.</span>
        </div>
      </div>

      <h2 id="online-process">How to Fill Maharashtra ITI Admission Form Online</h2>
      <p>Candidates can apply directly through the official DVET Maharashtra admission portal:</p>
      <ol class="space-y-2 pl-6 list-decimal">
        <li>Visit the official portal at <strong>admission.dvet.gov.in</strong>.</li>
        <li>Click on 'New Candidate Registration' and fill in basic details.</li>
        <li>Login using the credentials sent to your registered Mobile Number and Email.</li>
        <li>Fill the comprehensive application form, providing academic marks and selecting domiciliary categories.</li>
        <li>Pay the application fee online (General category: ₹150, Reserved categories: ₹100).</li>
        <li>Fill in your trade preferences (choice filling) based on preferred colleges and vocational courses.</li>
        <li>Verify all inputs and submit. Keep a copy of your application receipt.</li>
      </ol>
    </div>

    <!-- FAQ Section -->
    <div class="mt-20" id="faq">
      <h2
        class="text-2xl font-black text-text-main mb-8 flex items-center gap-3"
      >
        <span class="w-10 h-1 bg-primary rounded-full"></span>
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {
          [
            {
              q: "What is the official website for Maharashtra ITI Admission?",
              a: "The official web portal is admission.dvet.gov.in.",
            },
            {
              q: "Can I edit my choices after final submission?",
              a: "Choices can be edited only within the designated registration correction windows before the final merit list is released.",
            },
            {
              q: "Is there any entrance exam for ITI admission?",
              a: "No, admissions are based entirely on merit, computed from candidates' Class 10th or Class 8th exam scores.",
            },
          ].map((item) => (
            <div class="bg-bg-surface border border-border-card rounded-2xl p-6">
              <h4 class="text-text-main font-bold mb-2 m-0">{item.q}</h4>
              <p class="text-text-muted text-sm m-0 leading-relaxed">
                {item.a}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Related Articles -->
    <section class="mt-12 sm:mt-20 pt-8 sm:pt-12 border-t border-border-card">
      <h3 class="text-xl font-bold text-text-main mb-4 sm:mb-8">Related Articles</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">
        <BlogCard
          title="SSC GD Constable Application Form 2026: Last Date & Apply Link"
          href="/blog/ssc-gd-application-form-2026-last-date"
          date="May 18, 2026"
        />
        <BlogCard
          title="Yes Bank Credit Card Apply Online 2026: Process & Eligibility"
          href="/blog/yes-bank-credit-card-apply-online"
          date="May 19, 2026"
        />
      </div>
    </section>
  </article>
</Layout>
