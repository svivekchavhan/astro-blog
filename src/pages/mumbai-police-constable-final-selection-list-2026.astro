---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCheckCircle,
  HiOutlineBuildingOffice,
  HiOutlineMapPin,
  HiOutlineBriefcase,
  HiOutlineArrowDownTray,
} from "react-icons/hi2";

const title =
  "मुंबई पोलीस शिपाई भरती २०२४-२५: ३,५२१ पदांची अंतिम निवड यादी व प्रतीक्षा यादी (Cut-Off सह) जाहीर";
const description =
  "Mumbai Police Constable Bharti 2024-25 Final Selection List: Brihanmumbai Police Commissionerate releases final selection and waiting list for 3,521 Police Constable posts with category-wise Cut-Off marks. Download official notification PDF at mahapolice.gov.in.";
const canonicalURL =
  "https://mahasandhi.in/mumbai-police-constable-final-selection-list-2026";
const date = "August 07, 2026";
const category = "Result";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Exam Results", url: "/result" },
    { name: "Mumbai Police Final Selection List" },
  ]}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-emerald-500/20"
          >{category} • Police Bharti
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-emerald-500 pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          मुंबई पोलीस शिपाई भरती २०२४-२५ अंतिम निवड व प्रतीक्षा यादी प्रसिद्ध
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Mumbai Police Shipai Bharti Result 2026:</strong> पोलीस आयुक्त,
            बृहन्मुंबई कार्यालय (कक्ष-९, भरती कक्ष) द्वारे <strong
              >मुंबई पोलीस शिपाई भरती २०२४-२५</strong
            > प्रक्रियेतील <strong
              >३,५२१ रिक्त पदांसाठी अंतिम निवड यादी (Final Selection List) आणि
              प्रतीक्षा यादी (Waiting List)</strong
            > वर्गनिहाय <strong>कट-ऑफ (Cut-Off) गुणांसह</strong> अधिकृत संकेतस्थळावर
            प्रसिद्ध करण्यात आली आहे.
          </p>
          <p>
            पूर्वी प्रसिद्ध करण्यात आलेल्या तात्पुरत्या निवड यादीनंतर
            (Provisional Merit List) घेण्यात आलेल्या कागदपत्र पडताळणी (Document
            Verification) दरम्यान जे उमेदवार अपात्र ठरले होते, त्यांची निवड
            तात्पुरत्या निवड यादीतून रद्द करण्यात आली आहे. उर्वरित पात्र
            उमेदवारांची अंतिम निवड यादी प्रस्थापित शासकीय नियम व
            न्यायतत्त्वांच्या आधारे जाहीर करण्यात आली आहे.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Highlights Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-emerald-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >विभाग</span
              >
              <span class="text-text-main font-semibold text-sm"
                >पोलीस आयुक्त, बृहन्मुंबई</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-emerald-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण पदे</span
              >
              <span
                class="text-emerald-600 dark:text-emerald-400 font-extrabold text-sm"
                >३,५२१ पदे (Police Constable)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCalendarDays
              className="text-emerald-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >जाहीर तारीख</span
              >
              <span class="text-text-main font-semibold text-sm"
                >०७ ऑगस्ट २०२६ (07/08/2026)</span
              >
            </div>
          </div>
        </div>

        <!-- Official Notification Details Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          अधिकृत परिपत्रक व भरती संदर्भ (Official Notice Overview)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Details)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >माहिती (Information)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted"
                  >भरतीचे नाव</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >मुंबई पोलीस शिपाई भरती २०२४-२५</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted"
                  >कार्यालय / पत्ता</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >कक्ष-९ (भरती कक्ष), नवी प्रशासकीय इमारत, २ रा मजला, डॉ. दा.
                  नो. मार्ग, बृहन्मुंबई - ४००००१</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted"
                  >जाहिरात / परिपत्रक क्रमांक</td
                >
                <td class="p-3 border border-border-card font-bold text-primary"
                  >जा.क्र.पोआ/कक्ष-९(पोभ)/९(१)/१६१२/२०२६ (दि. ०७/०८/२०२६)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted"
                  >भरती पदे</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-rose-500"
                  >३,५२१ पदे (पोलीस शिपाई / Police Constable)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted"
                  >शासन निर्णय संदर्भ</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >• GAD GR No. BCC 2024/CR 75/16-K (दि. २७/०२/२०२४)<br />
                  • अपोमसं परिपत्रक (दि. १९/०१/२०२६)<br />
                  • गृह विभाग शासन निर्णय (दि. १०/१२/२०२०)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-medium text-text-muted"
                  >निवड यादी स्वरूप</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-emerald-600 dark:text-emerald-400"
                  >अंतिम निवड यादी (Final Selection List) + प्रतीक्षा यादी
                  (Waiting List) + कट-ऑफ</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Download & Official Links Table -->
        <h2
          id="download-links"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          निवड यादी PDF डाऊनलोड लिंक्स (Download Links)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >दस्तऐवज (Document Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >डाऊनलोड लिंक (Action Link)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >मुंबई पोलीस शिपाई अंतिम निवड व प्रतीक्षा यादी परिपत्रक
                  (Official Notification Notice PDF)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://policerecruitment2025.mahait.org/Forms/Home.aspx"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border-none shadow-xs"
                  >
                    <HiOutlineArrowDownTray className="text-base shrink-0" /> डाउनलोड
                    करा (Notice PDF)
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >महाराष्ट्र पोलीस अधिकृत वेबसाईट (Official Website)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://mahapolice.gov.in"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/30"
                  >
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> mahapolice.gov.in
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section (Marathi) -->
        <h2
          id="faq"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न १: मुंबई पोलीस शिपाई भरती २०२४-२५ ची अंतिम निवड यादी कधी
              जाहीर झाली?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: बृहन्मुंबई पोलीस आयुक्त कार्यालयाद्वारे अंतिम निवड यादी व
              प्रतीक्षा यादी ०७ ऑगस्ट २०२६ रोजी प्रसिद्ध करण्यात आली.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न २: या भरती प्रक्रियेत एकूण किती पदे भरली जाणार आहेत?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: मुंबई पोलीस शिपाई भरती २०२४-२५ प्रक्रियेअंतर्गत एकूण ३,५२१
              रिक्त पदे भरण्यात येत आहेत.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न ३: तात्पुरत्या निवड यादीतील काही उमेदवारांची निवड का रद्द
              झाली?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: कागदपत्र पडताळणी (Document Verification) दरम्यान अपात्र
              ठरलेल्या उमेदवारांची निवड रद्द करून केवळ पात्र उमेदवारांची अंतिम
              निवड यादी तयार करण्यात आली आहे.
            </p>
          </div>
        </div>

        <!-- Call to Action -->
        <div
          class="bg-emerald-500/5 border border-emerald-500/20 p-8 rounded-3xl text-center my-8"
        >
          <h2
            class="text-xl font-black text-text-main mb-4 border-none p-0 mt-0"
          >
            पोलीस भरती निकालाचे सर्व अपडेट्स मोबाईलवर मिळवा!
          </h2>
          <p class="text-text-muted mb-6 text-sm">
            महाराष्ट्र पोलीस शिपाई, चालक व राज्यराखीव पोलीस बल (SRPF) सर्व
            निकालांचे अपडेट्स तात्काळ मिळवण्यासाठी जॉईन करा.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://chat.whatsapp.com"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              WhatsApp Group
            </a>
            <a
              href="https://t.me"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-sky-500 hover:bg-sky-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm"
            >
              Telegram Channel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div
      class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative"
    >
      <span
        class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md"
      >
        English Version
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-en" class="text-2xl font-bold mt-2">
          Mumbai Police Constable Recruitment 2024-25 Final Selection List
          Released
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Mumbai Police Constable Bharti Result 2026:</strong> Office of
            the Commissioner of Police, Brihanmumbai (Desk-9, Recruitment Cell) has
            published the official <strong
              >Final Selection List & Waiting List along with Category-wise
              Cut-Off marks</strong
            > for <strong>3,521 Police Constable vacancies</strong>.
          </p>
          <p>
            Following the document verification process conducted for
            provisionally shortlisted candidates, ineligible candidates have
            been disqualified, and the final merit list has been published under
            government recruitment guidelines.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Highlights Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Authority</span
              >
              <span class="text-text-main font-semibold text-sm"
                >CP Brihanmumbai</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Vacancies</span
              >
              <span
                class="text-emerald-600 dark:text-emerald-400 font-bold text-sm"
                >3,521 Posts</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCalendarDays
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >Release Date</span
              >
              <span class="text-text-main font-semibold text-sm"
                >07th August 2026</span
              >
            </div>
          </div>
        </div>

        <!-- FAQ Section (English) -->
        <h2
          id="en-faq"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          Frequently Asked Questions (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              Question 1: When was the Mumbai Police Constable 2024-25 Final
              Selection List released?
            </h3>
            <p class="text-text-muted text-xs m-0">
              Answer: The final selection list and waiting list were officially
              released on 07th August 2026 by Brihanmumbai Police
              Commissionerate.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              Question 2: How many total posts are being filled under this
              recruitment drive?
            </h3>
            <p class="text-text-muted text-xs m-0">
              Answer: A total of 3,521 Police Constable vacancies are being
              filled.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              Question 3: Why were some candidates excluded from the final
              selection list?
            </h3>
            <p class="text-text-muted text-xs m-0">
              Answer: Candidates who were found ineligible during the Document
              Verification stage were removed from the provisional list, and the
              final merit list was generated.
            </p>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>
