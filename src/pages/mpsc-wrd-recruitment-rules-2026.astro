---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineAcademicCap,
  HiOutlineChevronRight,
  HiOutlineInformationCircle,
  HiOutlineHome,
  HiOutlineWrench,
  HiOutlineHomeModern,
  HiOutlineLightBulb
} from "react-icons/hi2";

const title = "MPSC WRD Recruitment Rules 2026: जलसंपदा विभाग सेवाप्रवेश नियम २०२६";
const description = "MPSC Water Resources Department (WRD) Junior Engineer Group B (Non-Gazetted) Recruitment Rules for Mechanical, Civil, and Electrical engineering branches.";
const canonicalURL = "https://mahasandhi.in/mpsc-wrd-recruitment-rules-2026";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  hideSidebar={true}
>
  <section class="py-8 not-prose">
    <div class="max-w-[1100px] mx-auto px-2 md:px-0">
      
      <!-- Back button -->
      <div class="mb-6">
        <a 
          href="/mpsc" 
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-text-muted hover:text-primary bg-bg-surface border border-border-card rounded-xl transition-all duration-300 no-underline"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          MPSC Portal / मुख्य पेजवर जा
        </a>
      </div>

      <!-- Header -->
      <div class="mb-12 border-b border-border-card/30 pb-8">
        <div class="flex items-center gap-3 mb-6">
          <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20">
            Recruitment Rules
          </span>
          <span class="text-text-muted text-sm">Update: 2026</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-tight">
          MPSC WRD Recruitment Rules 2026
          <span class="block text-xl md:text-2xl text-text-muted font-bold mt-2">जलसंपदा विभाग कनिष्ठ अभियंता सेवाप्रवेश नियम २०२६</span>
        </h1>
        <p class="text-text-secondary text-base md:text-lg leading-relaxed max-w-3xl">
          महाराष्ट्र शासनाच्या जलसंपदा विभागांतर्गत कनिष्ठ अभियंता (गट-ब) पदांसाठीचे सुधारित सेवाप्रवेश नियम खालील शाखांनुसार वर्गवारी करून उपलब्ध करून देण्यात आले आहेत.
        </p>
      </div>

      <!-- Branch Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Mechanical Branch Card -->
        <a 
          href="/mpsc-wrd-recruitment-rules-2026-mechanical" 
          class="group relative bg-bg-surface border border-border-card hover:border-primary rounded-3xl p-6 md:p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 flex flex-col justify-between min-h-[260px] overflow-hidden no-underline"
        >
          <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors duration-500 -z-10"></div>
          
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-primary/10 text-primary rounded-2xl group-hover:bg-primary group-hover:text-white transition-all duration-300">
                <HiOutlineWrench className="text-2xl" />
              </div>
              <span class="text-[0.65rem] bg-rose-500/10 text-rose-600 dark:text-rose-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20">
                Available / उपलब्ध
              </span>
            </div>
            
            <div class="space-y-2">
              <h3 class="text-lg md:text-xl text-text-main font-extrabold group-hover:text-primary transition-colors m-0 leading-snug">
                Junior Engineer (Mechanical)
              </h3>
              <p class="text-sm font-bold text-text-secondary m-0">कनिष्ठ अभियंता (यांत्रिकी)</p>
              <p class="text-xs text-text-muted leading-relaxed m-0">
                यांत्रिकी, स्वयंचल व उत्पादन शाखा सेवाप्रवेश नियम, वयोमर्यादा, शैक्षणिक पात्रता आणि META विभागीय परीक्षा नियम.
              </p>
            </div>
          </div>

          <div class="mt-6 pt-3.5 border-t border-border-card/30 flex items-center justify-between text-xs text-primary font-bold uppercase tracking-wider">
            <span>Read Rules / नियम पहा</span>
            <HiOutlineChevronRight className="text-sm transition-transform duration-300 group-hover:translate-x-1" />
          </div>
        </a>

        <!-- Civil Branch Card (Coming Soon) -->
        <div class="relative bg-bg-surface/50 border border-border-card rounded-3xl p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[260px] opacity-80">
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-text-muted/10 text-text-muted rounded-2xl">
                <HiOutlineHomeModern className="text-2xl" />
              </div>
              <span class="text-[0.65rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20">
                Coming Soon / लवकरच
              </span>
            </div>
            
            <div class="space-y-2">
              <h3 class="text-lg md:text-xl text-text-main/70 font-extrabold m-0 leading-snug">
                Junior Engineer (Civil)
              </h3>
              <p class="text-sm font-bold text-text-secondary/70 m-0">कनिष्ठ अभियंता (स्थापत्य)</p>
              <p class="text-xs text-text-muted/70 leading-relaxed m-0">
                स्थापत्य (Civil) शाखेसाठीचे कनिष्ठ अभियंता पदाचे सुधारित नियम लवकरच येथे जोडले जातील.
              </p>
            </div>
          </div>

          <div class="mt-6 pt-3.5 border-t border-border-card/30 text-xs text-text-muted font-bold uppercase tracking-wider">
            <span>Not Yet Released</span>
          </div>
        </div>

        <!-- Electrical Branch Card (Coming Soon) -->
        <div class="relative bg-bg-surface/50 border border-border-card rounded-3xl p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[260px] opacity-80">
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div class="p-3 bg-text-muted/10 text-text-muted rounded-2xl">
                <HiOutlineLightBulb className="text-2xl" />
              </div>
              <span class="text-[0.65rem] bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20">
                Coming Soon / लवकरच
              </span>
            </div>
            
            <div class="space-y-2">
              <h3 class="text-lg md:text-xl text-text-main/70 font-extrabold m-0 leading-snug">
                Junior Engineer (Electrical)
              </h3>
              <p class="text-sm font-bold text-text-secondary/70 m-0">कनिष्ठ अभियंता (विद्युत)</p>
              <p class="text-xs text-text-muted/70 leading-relaxed m-0">
                विद्युत (Electrical) शाखेसाठीचे कनिष्ठ अभियंता पदाचे सुधारित नियम लवकरच येथे जोडले जातील.
              </p>
            </div>
          </div>

          <div class="mt-6 pt-3.5 border-t border-border-card/30 text-xs text-text-muted font-bold uppercase tracking-wider">
            <span>Not Yet Released</span>
          </div>
        </div>
      </div>

      <!-- Information Warning Notice -->
      <div class="mt-12 bg-primary/5 border border-primary/20 p-6 rounded-3xl flex gap-4 items-start">
        <HiOutlineInformationCircle className="text-primary text-2xl shrink-0 mt-0.5" />
        <div class="space-y-1">
          <h4 class="text-sm font-bold text-text-main m-0">महत्त्वाची सूचना (Important Note):</h4>
          <p class="text-xs md:text-sm text-text-muted m-0 leading-relaxed">
            वरील सेवाप्रवेश नियम जलसंपदा विभागाने प्रसिद्ध केलेल्या अधिकृत राजपत्रावर आधारित आहेत. कोणत्याही शाखेच्या अर्जापूर्वी उमेदवारांनी मूळ राजपत्र पडताळणी आवर्जून करून घ्यावी.
          </p>
        </div>
      </div>
      
    </div>
  </section>
</Layout>
