---
import Layout from "../layouts/Layout.astro";
import { OFFICIAL_LINKS } from "../constants/links";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineClipboardDocumentCheck,
  HiOutlineCurrencyRupee,
} from "react-icons/hi2";

const title =
  "SSC CPO Sub-Inspector भरती २०२६: दिल्ली पोलीस व CAPF मध्ये १,८७१ उपनिरीक्षक (SI) पदांची मोठी भरती!";
const description =
  "SSC CPO SI Bharti 2026: Apply online for 1,871 Sub-Inspector (Executive) in Delhi Police, SI (GD) in CAPFs & SI (Fire) in CISF. Read post-wise vacancy, qualification, age limit, PST/PET, selection process, fee & official notification PDF link at mahasandhi.in.";
const canonicalURL =
  "https://mahasandhi.in/ssc-cpo-sub-inspector-recruitment-2026";
const date = "September 10, 2026";
const category = "Central Govt";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "SSC CPO Sub-Inspector Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Main Article Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Jump Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          SSC CPO उपनिरीक्षक (Sub-Inspector) १,८७१ जागा महाभरती जाहिरात २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>SSC CPO SI Bharti 2026:</strong> कर्मचारी निवड आयोग (SSC) मार्फत
            <strong>दिल्ली पोलीस (Delhi Police)</strong>, <strong
              >केंद्रीय सशस्त्र पोलीस दल (CAPFs - CRPF, BSF, ITBP, CISF, SSB)</strong
            > तसेच <strong>CISF Sub-Inspector (Fire)</strong> मध्ये <strong
              >१,८७१ उपनिरीक्षक (Sub-Inspector)</strong
            > पदांच्या महाभरतीची अधिकृत जाहिरात (Notice No. <code
              >E/37/2026-C-2 SECTION</code
            >) प्रसिद्ध करण्यात आली आहे.
          </p>
          <p>
            या भरती अंतर्गत पदवीधर उमेदवारांना पे लेव्हल-६ (₹३५,४०० ते
            ₹१,१२,४००) या वेतनश्रेणीत केंद्र सरकारच्या सुरक्षा दलांमध्ये
            उपनिरीक्षक म्हणून सेवा बजावण्याची सुवर्णसंधी उपलब्ध झाली आहे. ऑनलाईन
            अर्ज प्रक्रिया <strong>१० सप्टेंबर २०२६ ते ३० सप्टेंबर २०२६</strong> (रात्री
            २३:०० वाजेपर्यंत) ssc.gov.in वर सुरू आहे.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >आयोजक संस्था</span
              >
              <span class="text-text-main font-semibold text-sm"
                >कर्मचारी निवड आयोग (SSC)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण</span
              >
              <span class="text-text-main font-semibold text-sm"
                >दिल्ली व संपूर्ण भारतभर</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण रिक्त पदे</span
              >
              <span class="text-text-main font-semibold text-sm"
                >१,८७१ पदे (1,871 Posts)</span
              >
            </div>
          </div>
        </div>

        <!-- Post-wise Vacancy Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          १. पदांचे नाव व पदसंख्या (Post Name & Vacancy Breakdown)
        </h2>
        <p class="text-sm text-text-muted mb-4">
          SSC CPO भरती २०२६ अंतर्गत विविध उपनिरीक्षक (SI) पदांच्या रिक्त जागांचा
          तपशील खालीलप्रमाणे आहे:
        </p>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center w-16"
                  >अ.क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name & Category Breakdown)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap"
                  >रिक्त जागा (Vacancies)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td class="p-3 border border-border-card text-center font-bold"
                  >१</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                >
                  Sub-Inspector (Exe.) in Delhi Police – Male
                  <span class="block text-xs font-normal text-text-muted"
                    >UR: 87, OBC: 54, SC: 30, ST: 14, EWS: 20</span
                  >
                </td>
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >२०५</td
                >
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold"
                  >२</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                >
                  Sub-Inspector (Exe.) in Delhi Police – Female
                  <span class="block text-xs font-normal text-text-muted"
                    >UR: 47, OBC: 16, SC: 30, ST: 08, EWS: 11</span
                  >
                </td>
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >११२</td
                >
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold"
                  >३</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                >
                  Sub-Inspector (GD) in CAPFs – Male & Female
                  <span class="block text-xs font-normal text-text-muted"
                    >CRPF: 254, BSF: 457, ITBP: 187, CISF: 250, SSB: 172</span
                  >
                </td>
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >१,३२०</td
                >
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-center font-bold"
                  >४</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                >
                  Sub-Inspector (Fire) in CISF – Male
                  <span class="block text-xs font-normal text-text-muted"
                    >UR: 74, OBC: 75, SC: 52, ST: 16, EWS: 17</span
                  >
                </td>
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >२३४</td
                >
              </tr>
              <tr class="bg-primary/10">
                <td
                  colspan="2"
                  class="p-3 border border-border-card font-bold text-text-main text-right"
                >
                  🔢 एकूण रिक्त पदे (Grand Total Vacancies)
                </td>
                <td
                  class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-lg"
                >
                  १,८७१ पदे
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Educational Qualification Table -->
        <h2
          id="eligibility"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎓 २. पदनिहाय शैक्षणिक पात्रता (Educational Qualification &
          Requirements)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक पात्रता व अटी (अंतिम दिनांक: ३०.०९.२०२६)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >Sub-Inspector (Exe.) in Delhi Police (Male & Female)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  मान्यताप्राप्त विद्यापीठाची कोणत्याही शाखेतील पदवी (Bachelor's
                  Degree).<br />
                  <span class="text-rose-500 font-semibold"
                    >* पुरुष उमेदवारांसाठी:</span
                  > Physical (PE&MT) चाचणीच्या दिवशी LMV (Motorcycle and Car) चा वैध
                  ड्रायव्हिंग लायसन्स (Driving License) असणे आवश्यक.
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >Sub-Inspector (GD) in CAPFs (BSF, CRPF, CISF, ITBP, SSB)</td
                >
                <td class="p-3 border border-border-card text-text-muted"
                  >मान्यताप्राप्त विद्यापीठाची कोणत्याही शाखेतील पदवी
                  (Bachelor's Degree in any discipline).</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >Sub-Inspector (Fire) in CISF (केवळ पुरुष)</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  भौतिकशास्त्र, रसायनशास्त्र आणि गणित (PCM) सह विज्ञान शाखेतील
                  पदवी (B.Sc with Physics, Chemistry & Maths);<br />
                  <strong>किंवा</strong> १०वी उत्तीर्ण + मेकॅनिकल, सिव्हिल, इलेक्ट्रिकल,
                  ऑटोमोबाईल, केमिकल, मायनिंग, एरोनॉटिकल किंवा टेलिकम्युनिकेशन इंजिनिअरिंगमधील
                  ३ वर्षांचा डिप्लोमा.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit Table -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🎂 ३. वयोमर्यादा (दिनांक ०१/०८/२०२६ रोजी)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा व जन्मदिनांक अट</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >Sub-Inspector in Delhi Police & CAPFs</td
                >
                <td class="p-3 border border-border-card font-bold text-primary"
                  >२० ते २५ वर्षे (जन्म ०२/०८/२००१ ते ०१/०८/२००६)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >Sub-Inspector (Fire) in CISF</td
                >
                <td class="p-3 border border-border-card font-bold text-primary"
                  >१८ ते ३० वर्षे (जन्म ०२/०८/१९९६ ते ०१/०८/२००८)</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <div
          class="bg-bg-surface border border-border-card p-4 rounded-2xl text-xs text-text-muted mb-6"
        >
          📌 <strong>वयोमर्यादेमध्ये सूट (Age Relaxation):</strong> SC/ST उमेदवारांना
          ०५ वर्षे, OBC उमेदवारांना ०३ वर्षे, माजी सैनिक (ESM) उमेदवारांना ०३ वर्षे
          आणि दिल्ली पोलीस विभागीय उमेदवारांना ३० ते ३५ वर्षांपर्यंत सूट.
        </div>

        <!-- Age Calculator Button -->
        <div class="my-6">
          <a
            href="/mpsc-age-calculator-marathi"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-secondary hover:shadow-lg text-white font-bold text-sm rounded-xl transition-all no-underline border-none"
          >
            <HiOutlineCalculator className="text-lg shrink-0" />
            <span>तुमचे वय मोजा - SSC CPO Age Calculator Tool</span>
          </a>
        </div>

        <!-- Application Fees -->
        <h2
          id="fees"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          💳 ४. परीक्षा शुल्क (Application Fee)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >प्रवर्ग (Category)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >शुल्क (Fee Amount)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >General / OBC / EWS (पुरुष उमेदवार)</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-rose-500"
                  >₹ १००/- (रु. १०० मात्र)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >महिला उमेदवार (सर्व प्रवर्ग)</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-emerald-600 dark:text-emerald-400"
                  >मोफत (Nil)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >SC / ST / माजी सैनिक (ESM) उमेदवार</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-emerald-600 dark:text-emerald-400"
                  >मोफत (Nil)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-text-main"
                  >अर्ज दुरुस्ती शुल्क (Correction Charges)</td
                >
                <td
                  class="p-3 border border-border-card font-bold text-amber-600 dark:text-amber-400"
                  >पहिल्या दुरुस्तीसाठी ₹२००/- | दुसऱ्या दुरुस्तीसाठी ₹५००/-</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Selection Process -->
        <h2
          id="selection-process"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔍 ५. निवड प्रक्रिया (Selection Process)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3"
        >
          <ul class="list-disc pl-5 space-y-2 text-text-muted">
            <li>
              <strong>१. Paper-I (CBT Exam):</strong> १०० गुण, १०० बहुपर्यायी प्रश्न
              (Reasoning 25, GK 25, Maths 25, English 25). कालावधी १ तास (१५ मिनिटे
              सेक्शनल टायमर, ०.२५ नकारात्मक गुण).
            </li>
            <li>
              <strong>२. Physical Standard (PST) & Endurance Test (PET):</strong
              > शारीरिक पात्रता चाचणी (शर्यत, लांब उडी, उंच उडी, गोळाफेक - Qualifying
              in nature).
            </li>
            <li>
              <strong>३. Paper-II (CBT Exam):</strong> Reasoning (40m), GK (40m),
              Quant (40m) & English Comprehension (200m). ०.५० नकारात्मक गुण.
            </li>
            <li>
              <strong>४. वैद्यकीय तपासणी व कागदपत्र पडताळणी (DME/DV):</strong> शारीरिक
              वैद्यकीय तपासणी आणि कागदपत्र पडताळणी.
            </li>
          </ul>
        </div>

        <!-- Important Dates Schedule Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          📅 ६. महत्त्वाच्या तारखा व वेळापत्रक (Important Schedule)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तारीख (Date)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज नोंदणी कालावधी</td
                >
                <td
                  class="p-3 border border-border-card text-emerald-600 dark:text-emerald-400 font-bold"
                  >१० सप्टेंबर २०२६ ते ३० सप्टेंबर २०२६ (रात्री २३:००)</td
                >
              </tr>
              <tr>
                <td
