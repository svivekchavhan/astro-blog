---
import Layout from "../../layouts/Layout.astro";
import { MAHARASHTRA_DISTRICTS, getDistrictBySlug } from "../../constants/districts";
import { articlesRegistry } from "../../constants/articles";
import { 
  HiOutlineMapPin, 
  HiOutlineBuildingOffice, 
  HiOutlineAcademicCap, 
  HiOutlineCalendarDays, 
  HiOutlineArrowTopRightOnSquare, 
  HiOutlineBriefcase,
  HiOutlineChevronRight,
  HiOutlineMagnifyingGlass
} from "react-icons/hi2";

export async function getStaticPaths() {
  return MAHARASHTRA_DISTRICTS.map(dist => ({
    params: { district: dist.slug },
    props: { districtObj: dist }
  }));
}

const { district } = Astro.params;
const { districtObj } = Astro.props;

const currentDistrict = districtObj || (district ? getDistrictBySlug(district) : undefined);

if (!currentDistrict) {
  return Astro.redirect("/404");
}

// Match real articles from global registry that mention the district or region
const matchedArticles = articlesRegistry.filter(art => {
  const searchableText = `${art.titleEn} ${art.titleMr} ${art.slug} ${art.category}`.toLowerCase();
  return (
    searchableText.includes(currentDistrict.nameEn.toLowerCase()) ||
    searchableText.includes(currentDistrict.nameMr.toLowerCase()) ||
    searchableText.includes(currentDistrict.slug.toLowerCase())
  );
});

// Other districts list for bottom quick navigation
const otherDistricts = MAHARASHTRA_DISTRICTS.filter(d => d.slug !== currentDistrict.slug);

const pageTitle = `${currentDistrict.nameMr} जिल्हा भरती २०२६ - ${currentDistrict.nameEn} District Jobs & Vacancies | MahaSandhi`;
const pageDescription = `${currentDistrict.nameMr} जिल्ह्यातील सर्व सरकारी नोकरी आणि भरती जाहिराती २०२६ (${currentDistrict.nameEn} District Recruitment). जिल्हा परिषद, आरोग्य विभाग, मनपा आणि पोलीस भरती अपडेट्स.`;
const canonicalURL = `https://mahasandhi.in/district/${currentDistrict.slug}`;
---

<Layout title={pageTitle} description={pageDescription} canonicalURL={canonicalURL}>
  <section class="py-6 pb-20 not-prose">
    
    <!-- Hero Banner -->
    <div class="bg-gradient-to-r from-primary/10 via-secondary/10 to-primary/5 border border-primary/20 rounded-3xl p-6 sm:p-10 mb-10 text-center sm:text-left relative overflow-hidden">
      <!-- Glow decoration -->
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl -z-10"></div>
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary text-white font-extrabold text-xs uppercase tracking-wider mb-4 shadow-xs">
        <HiOutlineMapPin className="text-sm shrink-0" />
        <span>महाराष्ट्र जिल्हा भरती दालन</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-text-main tracking-tight m-0 mb-3">
        {currentDistrict.nameMr} जिल्हा भरती <span class="gradient-text">२०२६</span>
      </h1>
      <p class="text-text-muted text-sm sm:text-base max-w-2xl leading-relaxed m-0 font-medium">
        Explore active government jobs, Zilla Parishad recruitments, Walk-In interviews, and official notifications in <strong>{currentDistrict.nameEn} District</strong> ({currentDistrict.division} Division).
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-text-muted font-semibold">
        <span class="bg-bg-surface border border-border-card px-3 py-1.5 rounded-xl">📍 विभाग (Division): <strong>{currentDistrict.division}</strong></span>
        <span class="bg-bg-surface border border-border-card px-3 py-1.5 rounded-xl">💼 उपलब्ध नोकऱ्या: <strong>{matchedArticles.length} Active Notice{matchedArticles.length !== 1 ? 's' : ''}</strong></span>
      </div>
    </div>

    <!-- Main Content Container -->
    <div class="space-y-10">

      <!-- Section: Real Matched District Articles & Notifications -->
      <div>
        <div class="flex items-center justify-between gap-4 mb-6 pb-2 border-b border-border-card">
          <h2 class="text-xl sm:text-2xl font-extrabold text-text-main m-0 flex items-center gap-2">
            <span class="w-2.5 h-6 bg-primary rounded-full"></span>
            <span>{currentDistrict.nameMr} जिह्यातील नवीन भरती जाहिराती व निकाल</span>
          </h2>
          <span class="text-xs font-bold bg-primary/10 text-primary px-3 py-1 rounded-full uppercase tracking-wider border border-primary/20">
            {matchedArticles.length} Updated
          </span>
        </div>

        {matchedArticles.length > 0 ? (
          <div class="flex flex-col gap-3.5 sm:gap-4">
            {matchedArticles.map(art => (
              <div class="group bg-bg-surface border border-border-card hover:border-emerald-500 rounded-2xl p-4 sm:p-5 transition-all duration-300 hover:shadow-emerald-500/5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3.5 sm:gap-4">
                <!-- Left: Article Info -->
                <div class="flex-1 min-w-0 space-y-2">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="bg-primary/10 text-primary text-[0.65rem] font-bold px-2.5 py-0.5 rounded-md border border-primary/20 uppercase tracking-wider">
                      {art.category}
                    </span>
                    {art.postName && (
                      <span class="text-[0.7rem] font-extrabold text-emerald-600 dark:text-emerald-400">
                        📌 पदनाम: {art.postName}
                      </span>
                    )}
                  </div>

                  <h3 class="text-base sm:text-lg font-bold text-text-main m-0 leading-snug">
                    <a href={art.slug} class="hover:text-primary transition-colors no-underline">
                      {art.titleMr}
                    </a>
                  </h3>

                  {art.descriptionMr && (
                    <p class="text-xs text-text-muted m-0 leading-relaxed line-clamp-2">
                      {art.descriptionMr}
                    </p>
                  )}
                </div>

                <!-- Right: Action Button -->
                <div class="shrink-0 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-border-card/40">
                  <a 
                    href={art.slug}
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-xs no-underline"
                  >
                    <span>सविस्तर माहिती पाहा</span>
                    <HiOutlineChevronRight className="text-xs shrink-0" />
                  </a>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12 px-6 bg-bg-surface border border-border-card rounded-2xl">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-3">
              <HiOutlineMapPin className="text-2xl" />
            </div>
            <h3 class="text-base font-bold text-text-main mb-1">सध्या {currentDistrict.nameMr} जिल्ह्यासाठी नवीन विशेष जाहिरात उपलब्ध नाही</h3>
            <p class="text-xs text-text-muted max-w-md mx-auto m-0 leading-relaxed">
              नवीन भरती जाहिराती प्रसिद्ध होताच येथे अपडेट करण्यात येतील. ताज्या अपडेट्ससाठी आमच्या Social Groups मध्ये सहभागी व्हा.
            </p>
          </div>
        )}
      </div>

      <!-- Section: Browse Other Districts in Maharashtra -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-6 sm:p-8">
        <h3 class="text-lg font-bold text-text-main mb-4 flex items-center gap-2">
          🗺️ महाराष्ट्रातील इतर जिल्ह्यांनुसार भरती पाहा (Browse Other Districts)
        </h3>
        <p class="text-xs sm:text-sm text-text-muted mb-6 leading-relaxed">
          Select any district below to check local Zilla Parishad, Health Department, Municipal Corporation, and Police Bharti updates.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
          {otherDistricts.map(dist => (
            <a 
              href={`/district/${dist.slug}`} 
              class="px-3 py-2 bg-bg-base hover:bg-primary/10 border border-border-card hover:border-primary/30 rounded-xl text-xs font-bold text-text-main hover:text-primary transition-all flex items-center justify-between no-underline group"
            >
              <span class="truncate">{dist.nameMr}</span>
              <HiOutlineChevronRight className="text-xs text-text-muted group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0" />
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
