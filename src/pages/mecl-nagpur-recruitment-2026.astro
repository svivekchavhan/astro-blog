---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import { OFFICIAL_LINKS } from "../constants/links";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineArrowLeft,
  HiOutlineBell,
  HiOutlineShieldCheck,
  HiOutlineCamera,
  HiOutlineClipboardDocumentCheck,
} from "react-icons/hi2";

const title =
  "MECL नागपूर भरती २०२६: मिनिरत्न कंपनीत १६ संवर्गातील १२२ जागांसाठी भरती जाहीर! ऑनलाईन अर्ज सुरू";
const description =
  "MECL Nagpur Recruitment 2026: Mineral Exploration & Consultancy Limited (MECL), Nagpur invites online applications for 122 Non-Executive posts across 16 categories. 10th Pass, ITI, Diploma, Graduates eligible. Selection via Written Test at Nagpur. Last Date: 11 October 2026.";
const canonicalURL = "https://mahasandhi.in/mecl-nagpur-recruitment-2026";
const date = "September 16, 2026";
const category = "Central Govt";
const applyUrl = OFFICIAL_LINKS.meclApplyPortal;
const officialWebsiteUrl = OFFICIAL_LINKS.meclPortal;
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "MECL Nagpur Recruitment 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Back Button -->
    <div class="mb-6 not-prose">
      <a
        href="/current-recruitment"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-text-muted hover:text-primary bg-bg-surface border border-border-card rounded-xl transition-all duration-300 no-underline"
      >
        <HiOutlineArrowLeft className="text-sm" /> back to current recruitment / मागे जा
      </a>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span
          class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-emerald-500/20 flex items-center gap-1.5 shadow-xs"
        >
          <HiOutlineBell className="text-sm shrink-0 animate-pulse" />
          {category} (ऑनलाईन अर्ज सुरू)
        </span>
        <span
          class="bg-rose-500/10 text-rose-600 dark:text-rose-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-rose-500/20 flex items-center gap-1.5"
        >
          <HiOutlineCalendarDays className="text-sm" /> अंतिम तारीख: ११ ऑक्टोबर २०२६
        </span>
        <span class="text-text-muted text-xs font-semibold">• {date}</span>
      </div>

      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-primary pl-4 sm:pl-6 py-2 italic font-medium"
      >
        {description}
      </p>
    </div>

    <!-- Quick Action Apply Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 not-prose">
      <a
        href={applyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-5 bg-gradient-to-br from-primary to-indigo-700 text-white rounded-2xl transition-all duration-300 shadow-md hover:shadow-primary/20 flex items-center justify-between no-underline"
      >
        <div>
          <span
            class="text-[0.65rem] uppercase font-extrabold tracking-wider bg-white/20 px-2.5 py-0.5 rounded text-white block w-fit mb-1"
            >MECL Careers Apply Portal</span
          >
          <h3
            class="text-base sm:text-lg font-extrabold text-white m-0 flex items-center gap-1.5"
          >
            Apply Online Portal <HiOutlineArrowTopRightOnSquare
              className="text-xl shrink-0"
            />
          </h3>
          <p class="text-xs text-white/90 m-0 mt-1">
            १२ सप्टेंबर ते ११ ऑक्टोबर २०२६ पर्यंत ऑनलाईन अर्ज करा
          </p>
        </div>
        <div
          class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform"
        >
          <HiOutlineCursorArrowRays className="text-2xl" />
        </div>
      </a>

      <a
        href={officialWebsiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 bg-bg-surface border border-border-card hover:border-primary/50 rounded-2xl flex items-center justify-between transition-all duration-300 no-underline group shadow-xs"
      >
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform"
          >
            <HiOutlineBuildingOffice className="text-2xl" />
          </div>
          <div>
            <span
              class="text-xs text-text-muted font-bold uppercase tracking-wider block"
              >अधिकृत संकेतस्थळ</span
            >
            <h4
              class="text-sm font-bold text-text-main m-0 group-hover:text-primary transition-colors flex items-center gap-1"
            >
              mecl.co.in <HiOutlineArrowTopRightOnSquare className="text-xs" />
            </h4>
            <p class="text-xs text-text-muted m-0 mt-0.5">
              Mineral Exploration & Consultancy Limited (MECL)
            </p>
          </div>
        </div>
      </a>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex flex-wrap items-center gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Summary</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2
          id="main-keyword-mr"
          class="text-xl md:text-2xl font-black text-text-main mt-2"
        >
          🏢 मिनेरल्स एक्सप्लोरेशन अँड कन्सल्टन्सी लि. (MECL) नागपूर भरती जाहिरात २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6 space-y-4">
          <p>
            <strong>MECL Nagpur Recruitment 2026:</strong> केंद्रीय खान मंत्रालयाच्या नियंत्रणाखालील मिनिरत्न श्रेणी-१ मधील सार्वजनिक क्षेत्रातील उपक्रम <strong>Mineral Exploration & Consultancy Limited (MECL), नागपूर</strong> द्वारे Non-Executive संवर्गातील १६ विविध पदांच्या एकूण <strong>१२२ जागांसाठी</strong> ऑनलाईन भरती जाहिरात प्रसिद्ध झाली आहे.
          </p>
          <p>
            या भरतीमध्ये <strong>१०वी पास, ITI, डिप्लोमा, पदवीधर (B.Sc, B.Com, BA, BCA, BBA)</strong> उमेदवारांसाठी नोकरीची उत्तम संधी आहे. ऑनलाईन अर्ज प्रक्रिया <strong class="text-rose-600 dark:text-rose-400">१२ सप्टेंबर २०२६</strong> पासून सुरू झाली असून ऑनलाईन अर्ज करण्याची अंतिम तारीख <strong class="text-rose-600 dark:text-rose-400">११ ऑक्टोबर २०२६</strong> आहे. या भरतीसाठी लिखित परीक्षा <strong>नागपूर (Nagpur)</strong> येथे आयोजित केली जाईल.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >संस्थेचे नाव</span
              >
              <span class="text-text-main font-semibold text-sm"
                >MECL नागपूर (Miniratna-I CPSE)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >एकूण पदे व ठिकाण</span
              >
              <span class="text-text-main font-bold text-sm text-primary"
                >१२२ पदे (नागपूर - Nagpur)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3 shadow-xs"
          >
            <HiOutlineBriefcase
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >निवड पद्धत</span
              >
              <span class="text-text-main font-semibold text-sm"
                >लिखित परीक्षा + ट्रेड चाचणी (मुलाखत नाही)</span
              >
            </div>
          </div>
        </div>

        <!-- Vacancy & Qualifications Details Table -->
        <h2
          id="vacancy-details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 पदनिहाय रिक्त जागा व शैक्षणिक पात्रता (Post Wise Vacancy & Qualification)
        </h2>
        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">कोड</th>
                <th class="p-3 border border-border-card font-bold text-text-main">पदाचे नाव (Post Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main text-center whitespace-nowrap">जागा</th>
                <th class="p-3 border border-border-card font-bold text-text-main">शैक्षणिक पात्रता (Educational Qualification)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">1</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Accountant</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">06</td>
                <td class="p-2.5 border border-border-card text-text-muted">पदवी (Graduate) + Intermediate CA / ICWA</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">2</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Technician (Survey)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">12</td>
                <td class="p-2.5 border border-border-card text-text-muted">Surveying मध्ये ITI किंवा Surveying डिप्लोमा (Diploma in Survey)</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">3</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Technician (Sampling)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">07</td>
                <td class="p-2.5 border border-border-card text-text-muted">B.Sc. पदवी</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">4</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Technician (Laboratory)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">02</td>
                <td class="p-2.5 border border-border-card text-text-muted">B.Sc. (रसायनशास्त्र / भौतिकशास्त्र / भूशास्त्र - Chemistry / Physics / Geology)</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">5</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Assistant (Materials)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">16</td>
                <td class="p-2.5 border border-border-card text-text-muted">गणित विषयासह पदवी (Graduate with Maths) किंवा B.Com</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">6</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Assistant (Accounts)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">10</td>
                <td class="p-2.5 border border-border-card text-text-muted">वाणिज्य शाखेतील पदवी (B.Com)</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">7</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Stenographer (English)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">04</td>
                <td class="p-2.5 border border-border-card text-text-muted">पदवी (Graduate) + इंग्रजी लघुलेखन प्रमाणपत्र (English Shorthand 80 wpm)</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">8</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Assistant (Hindi)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">01</td>
                <td class="p-2.5 border border-border-card text-text-muted">हिंदी व इंग्रजी विषयासह पदवी किंवा इंग्रजी पदवी + अ‍ॅडव्हान्स हिंदी</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">9</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Electrician</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">07</td>
                <td class="p-2.5 border border-border-card text-text-muted">ITI / डिप्लोमा (Electrical) + वैध वायरमन प्रमाणपत्र (Wireman Certificate)</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">10</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Machinist</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">02</td>
                <td class="p-2.5 border border-border-card text-text-muted">ITI (Turner / Machinist / Grinder / Miller) किंवा Mechanical Diploma</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">11</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Technician (Drilling)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">12</td>
                <td class="p-2.5 border border-border-card text-text-muted">ITI (EMM / Diesel / Motor / Fitter) किंवा Diploma + HMV ड्रायव्हिंग लायसन्स</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">12</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Mechanic</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">01</td>
                <td class="p-2.5 border border-border-card text-text-muted">ITI (Diesel / Motor / Fitter) किंवा Diploma + HMV ड्रायव्हिंग लायसन्स</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">13</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Mechanic-cum-Operator (Drilling)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">30</td>
                <td class="p-2.5 border border-border-card text-text-muted">ITI (EMM / Diesel / Motor / Fitter) किंवा Diploma (Mechanical / Automobile / Drilling)</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">14</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Junior Driver</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">06</td>
                <td class="p-2.5 border border-border-card text-text-muted">१० वी पास (10th Pass) + वैध LMV & HMV ड्रायव्हिंग लायसन्स</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">15</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Assistant (IT)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">03</td>
                <td class="p-2.5 border border-border-card text-text-muted">BCA / BCS / BCCA / B.Sc. (CS / IT) किंवा पदवी + १ वर्षाचा IT PG डिप्लोमा</td>
              </tr>
              <tr>
                <td class="p-2.5 border border-border-card font-bold text-center">16</td>
                <td class="p-2.5 border border-border-card font-bold text-primary">Assistant (HR)</td>
                <td class="p-2.5 border border-border-card font-bold text-center text-emerald-600 dark:text-emerald-400">03</td>
                <td class="p-2.5 border border-border-card text-text-muted">BA / B.Com / B.Sc / BBA / BBM / BSW पदवी</td>
              </tr>
              <tr class="bg-primary/5 font-extrabold">
                <td colspan="2" class="p-3 border border-border-card text-text-main text-right">एकूण पदे (Total Vacancies)</td>
                <td class="p-3 border border-border-card text-rose-600 dark:text-rose-400 text-center text-lg">१२२</td>
                <td class="p-3 border border-border-card text-text-main">१६ विविध संवर्ग पदे</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit Details -->
        <h2
          id="age-limit"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 वयोमर्यादा (Age Limit - दि. ०१ सप्टेंबर २०२६ रोजी)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3 mb-6"
        >
          <p class="m-0 text-text-main font-bold">
            वय मोजण्याचा दिनांक (Cut-off Date): <span class="text-rose-600 dark:text-rose-400"
              >०१ सप्टेंबर २०२६</span
            >
          </p>
          <p class="m-0 text-text-main font-semibold">
            कमाल वयोमर्यादा (खुला / EWS): <strong>कमाल ३० वर्षे (Maximum 30 Years)</strong>
          </p>
          <hr class="border-border-card/60 my-2" />
          <h4 class="text-xs uppercase font-extrabold tracking-wider text-primary m-0">
            प्रवर्गनिहाय वयोमर्यादा सूट (Upper Age Relaxation):
          </h4>
          <ul class="list-disc pl-6 space-y-1 text-text-muted m-0">
            <li><strong>SC / ST प्रवर्ग:</strong> ०५ वर्षे सूट (कमाल ३५ वर्षे)</li>
            <li><strong>OBC-NCL प्रवर्ग:</strong> ०३ वर्षे सूट (कमाल ३३ वर्षे)</li>
            <li><strong>PwD (General / EWS):</strong> १० वर्षे सूट (कमाल ४० वर्षे)</li>
            <li><strong>PwD (OBC-NCL):</strong> १३ वर्षे सूट (कमाल ४३ वर्षे)</li>
            <li><strong>PwD (SC / ST):</strong> १५ वर्षे सूट (कमाल ४५ वर्षे)</li>
            <li><strong>माजी सैनिक (Ex-Servicemen):</strong> शासकीय नियमानुसार सूट</li>
