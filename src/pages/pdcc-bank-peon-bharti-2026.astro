---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
} from "react-icons/hi2";

const title =
  "पुणे जिल्हा मध्यवर्ती सहकारी बँक भरती २०२६: शिपाई २८९ पदांची सरळसेवा भरती जाहिरात प्रसिद्ध";
const description =
  "PDCC Bank Bharti 2026: Pune District Central Cooperative Bank Ltd invites online applications for 289 Peon (शिपाई) posts. 12th Pass eligible, 70 Marks OMR Offline Exam, last date to apply is August 10, 2026. Read exam syllabus, salary, age limit, and official apply link.";
const canonicalURL = "https://mahasandhi.in/pdcc-bank-peon-bharti-2026";
const date = "August 06, 2026";
const category = "Bank Job";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "PDCC Bank Peon Bharti 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          पुणे जिल्हा मध्यवर्ती सहकारी बँक मर्यादित, पुणे (PDCC Bank) शिपाई
          सरळसेवा भरती २०२६
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>PDCC Bank Bharti 2026:</strong> पुणे जिल्हा मध्यवर्ती सहकारी बँक
            मर्यादित, पुणे (PDCC Bank) द्वारे <strong>शिपाई (Peon)</strong> या पदांच्या
            एकूण <strong>२८९ रिक्त जागा</strong> ऑफलाईन सरळसेवा लेखी परीक्षेद्वारे
            भरण्यासाठी अधिकृत भरती जाहिरात प्रसिद्ध करण्यात आली आहे. फक्त पुणे जिल्ह्यातील
            मूळ रहिवासी असलेल्या पात्र उमेदवारांकडून ऑनलाईन पद्धतीने अर्ज मागविण्यात
            येत आहेत.
          </p>
          <p>
            इयत्ता १२ वी उत्तीर्ण किंवा १२ वी समकक्ष डिप्लोमा पूर्ण केलेले
            उमेदवार या भरतीसाठी पात्र आहेत. ऑनलाईन अर्ज भरण्याची प्रक्रिया <strong
              >०४ ऑगस्ट २०२६ ते १० ऑगस्ट २०२६ (रात्री २३.५९ वाजेपर्यंत)</strong
            > सुरू राहील.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >बँकेचे नाव</span
              >
              <span class="text-text-main font-semibold text-sm"
                >पुणे जिल्हा मध्यवर्ती सहकारी बँक (PDCC Bank)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineMapPin
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >नोकरीचे ठिकाण</span
              >
              <span class="text-text-main font-semibold text-sm"
                >पुणे जिल्हा (Pune District)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCurrencyRupee
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >मानधन / पगार</span
              >
              <span class="text-text-main font-semibold text-sm"
                >रु. १२,०००/- दरमहा (६ महिने परिविक्षाधीन)</span
              >
            </div>
          </div>
        </div>

        <!-- Vacancy Details Table -->
        <h2
          id="details"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          पदसंख्या, पात्रता व वयोमर्यादा विवरण (Post Details & Eligibility)
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >पदाचे नाव</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >एकूण पदे</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >आवश्यक शैक्षणिक अर्हता</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >वयोमर्यादा (दि. ०१.०८.२०२६ रोजी)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card font-bold text-primary text-base"
                  >शिपाई (Peon)</td
                >
                <td
                  class="p-3 border border-border-card font-black text-rose-500 text-center text-lg"
                  >२८९</td
                >
                <td class="p-3 border border-border-card text-text-muted">
                  • किमान उच्च माध्यमिक शालांत परीक्षा (HSC - १२ वी उत्तीर्ण)
                  किंवा १२ वी समकक्ष पदविका (Diploma) उत्तीर्ण.<br />
                  • उमेदवार पुणे जिल्ह्यातील किमान १५ वर्षांपासूनचा मूळ रहिवासी असावा.
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  • किमान <strong>१८ वर्षे</strong> ते कमाल <strong
                    >३८ वर्षे</strong
                  >.<br />
                  • (बँकेत कंत्राटी सलग ३ वर्षे अनुभव असल्यास कमाल ४३ वर्षांपर्यंत
                  शिथिल)
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Syllabus & Exam Pattern Table -->
        <h2
          id="syllabus"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          परीक्षेचे स्वरूप व अभ्यासक्रम गुणांची विभागणी (70 Marks Exam Pattern)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm mb-4"
        >
          <p class="m-0 text-text-main font-semibold mb-2">
            📌 <strong>परीक्षा पद्धत:</strong>
          </p>
          <ul class="list-disc pl-6 space-y-1 text-text-muted">
            <li>
              ऑफलाईन परीक्षा ७० गुणांची OMR (Optical Mark Recognition) पद्धतीने
              घेतली जाईल.
            </li>
            <li>
              प्रश्नपत्रिका मराठी माध्यमातून ७० गुणांची बहुपर्यायी वस्तुनिष्ठ
              (MCQ) स्वरूपाची असेल.
            </li>
            <li>एकूण वेळ: <strong>७५ मिनिटे</strong> (१ तास १५ मिनिटे).</li>
            <li>
              लेखी परीक्षेनंतर पात्र ठरणाऱ्या उमेदवारांची १:३ प्रमाणात ३०
              गुणांची मुलाखत घेतली जाईल.
            </li>
          </ul>
        </div>

        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center w-16"
                  >अ.क्र.</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >विषयाचे नाव (Syllabus Subject)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                  >गुण (Marks)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >१</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >शेती पतपुरवठा त्रिस्तरीय रचनेची प्राथमिक माहिती</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >२० गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >२</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >बँकिंग व सहकार (Banking & Cooperation)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >१५ गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >३</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >सामान्य ज्ञान व चालू घडामोडी (General Knowledge & Current
                  Affairs)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >१५ गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >४</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >कृषी व ग्रामीण अर्थव्यवस्था (Agriculture & Rural Economy)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >१० गुण</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-center text-text-muted font-bold"
                  >५</td
                >
                <td
                  class="p-3 border border-border-card font-medium text-text-main"
                  >बुद्धिमत्ता चाचणी (Reasoning Ability)</td
                >
                <td
                  class="p-3 border border-border-card text-center font-extrabold text-primary"
                  >१० गुण</td
                >
              </tr>
              <tr class="bg-primary/10">
                <td
                  colspan="2"
                  class="p-3 border border-border-card font-bold text-text-main text-right"
                  >एकूण लेखी परीक्षा गुण (Total Written Exam Marks)</td
                >
                <td
                  class="p-3 border border-border-card font-black text-rose-600 dark:text-rose-400 text-center text-base"
                  >७० गुण</td
                >
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Examination Fee & Salary -->
        <h2
          id="fee-salary"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          परीक्षा शुल्क व पगार तपशील (Application Fee & Salary)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm space-y-3"
        >
          <p class="m-0 text-text-main">
            💳 <strong>परीक्षा शुल्क:</strong>
            <strong>रु. १६५०/-</strong> (अधिक १८% जीएसटी व सर्व्हिस चार्ज). भरलेले
            शुल्क ना-परतावा (Non-Refundable) असेल.
          </p>
          <p class="m-0 text-text-main">
            💰 <strong>परिविक्षाधीन कालावधी व वेतन:</strong> निवड झालेल्या उमेदवारांना
            प्रथम ६ महिने परिविक्षाधीन कालावधीसाठी दरमहा <strong
              >रु. १२,०००/- एकवट पगार</strong
            > दिला जाईल. त्यानंतर बँकेच्या नियमानुसार नियमित वेतनश्रेणी लागू होईल.
          </p>
        </div>

        <!-- Important Dates & Links Table -->
        <h2
          id="important-dates"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          {
            translateMarathi(
              "महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)",
            )
          }
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तपशील (Event)</th
                >
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                  >तारीख / दुवा (Date / Action)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज भरण्याची सुरूवात दिनांक</td
                >
                <td
                  class="p-3 border border-border-card text-text-main font-bold"
                  >०४ ऑगस्ट २०२६ (सकाळी ११:०० वाजता)</td
                >
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज करण्याची अंतिम तारीख (Last Date to Apply)</td
                >
                <td
                  class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap"
                >
                  <span class="flex items-center gap-1.5"
                    ><HiOutlineCalendarDays
                      className="text-rose-500 text-lg shrink-0"
                    /> १० ऑगस्ट २०२६ (रात्री २३.५९ पर्यंत)</span
                  >
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अधिकृत भरती जाहिरात PDF (Official Notification PDF)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://www.pdcc.bank.in/uploads/career/%E0%A4%B6%E0%A4%BF%E0%A4%AA%E0%A4%BE%E0%A4%88%E0%A4%AD%E0%A4%B0%E0%A4%A4%E0%A5%80%E0%A4%9C%E0%A4%BE%E0%A4%B9%E0%A4%BF%E0%A4%B0%E0%A4%BE%E0%A4%A4.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-rose-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> डाउनलोड
                    अधिकृत जाहिरात (PDF)
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >ऑनलाईन अर्ज करण्याची लिंक (Online Application Portal)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://www.pdcc.bank.in/careers"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto"
                  >
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> PDCC
                    Bank Online Apply Link
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                  >अधिकृत संकेतस्थळ (Official Website)</td
                >
                <td class="p-3 border border-border-card">
                  <a
                    href="https://www.punedccbank.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> www.punedccbank.com
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2
          id="faq"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न १: PDCC बँक शिपाई भरती २०२६ साठी अर्ज करण्याची अंतिम तारीख
              कोणती आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: ऑनलाईन अर्ज करण्याची अंतिम तारीख १० ऑगस्ट २०२६ (रात्री
              २३.५९ पर्यंत) आहे.
            </p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न २: या भरतीसाठी शैक्षणिक पात्रता काय आहे?
            </h3>
            <p class="text-text-muted text-xs m-0">
              उत्तर: उमेदवार इयत्ता १२ वी (HSC) किंवा १२ वी समकक्ष डिप्लोमा
              उत्तीर्ण असावा आणि पुणे जिल्ह्याचा १५ वर्षांचा रहिवासी असावा.
            </p>
