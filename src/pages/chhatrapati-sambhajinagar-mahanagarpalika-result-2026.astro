---
import Layout from "../layouts/Layout.astro";
import { OFFICIAL_LINKS } from "../constants/links";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineQueueList,
  HiOutlineIdentification,
  HiOutlineUserGroup,
  HiOutlineCheckBadge,
  HiOutlineMegaphone,
  HiOutlineMapPin,
  HiOutlinePhone,
  HiOutlineEnvelope,
  HiOutlineBriefcase,
  HiOutlineCheckCircle,
  HiOutlineShieldCheck,
  HiOutlineExclamationTriangle,
} from "react-icons/hi2";

const title =
  "छत्रपती संभाजीनगर महानगरपालिका भरती निकाल २०२६: २२२ पदांच्या IBPS परीक्षेतील ५ पदांचा निकाल जाहीर (अधिकृत प्रेस नोट)";
const description =
  "Chhatrapati Sambhajinagar Municipal Corporation Result 2026: छत्रपती संभाजीनगर मनपा २२२ पदांच्या भरतीपैकी उपअग्निशमन केंद्र अधिकारी, सहाय्यक सुरक्षा अधिकारी, पशुधन पर्यवेक्षक, उद्यान सहाय्यक व अनुरेखक ५ पदांचा IBPS कडून निकाल जाहीर. chhsambhajinagarmc.org/recruitment-2026 वरून गुणवत्ता यादी डाऊनलोड करा.";
const canonicalURL =
  "https://mahasandhi.in/chhatrapati-sambhajinagar-mahanagarpalika-result-2026";
const date = "August 28, 2026";
const category = "Result";
const resultUrl = OFFICIAL_LINKS.csmcRecruitmentPortal;
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Exam Results", url: "/result" },
    { name: "छत्रपती संभाजीनगर मनपा निकाल" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-6 flex-wrap">
        <span
          class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-emerald-500/20 flex items-center gap-1.5 shadow-xs"
        >
          <HiOutlineCheckBadge className="text-sm" />
          {category} (प्रेस नोट प्रसिद्ध)
        </span>
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20 flex items-center gap-1.5"
        >
          <HiOutlineMapPin className="text-sm" /> छत्रपती संभाजीनगर (Chhatrapati Sambhajinagar)
        </span>
        <span class="text-text-muted text-sm font-semibold">• दिनांक: {date}</span>
      </div>

      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-emerald-500 pl-4 sm:pl-6 py-2 italic font-medium"
      >
        {description}
      </p>
    </div>

    <!-- Quick Highlights Banner -->
    <div
      class="bg-gradient-to-br from-emerald-500/10 via-teal-500/5 to-transparent border border-emerald-500/20 rounded-2xl sm:rounded-3xl p-4 sm:p-6 md:p-8 mb-8 shadow-xs"
    >
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 text-center">
        <div
          class="p-3.5 bg-bg-surface/80 backdrop-blur-xs rounded-xl sm:rounded-2xl border border-border-card flex flex-col justify-center items-center"
        >
          <span
            class="text-[0.65rem] sm:text-xs text-text-muted block uppercase font-bold tracking-wider mb-1"
            >भरती परीक्षा संस्था</span
          >
          <span class="text-sm sm:text-base font-black text-primary"
            >IBPS (ऑनलाइन CBT परीक्षा)</span
          >
        </div>
        <div
          class="p-3.5 bg-bg-surface/80 backdrop-blur-xs rounded-xl sm:rounded-2xl border border-border-card flex flex-col justify-center items-center"
        >
          <span
            class="text-[0.65rem] sm:text-xs text-text-muted block uppercase font-bold tracking-wider mb-1"
            >एकूण संवर्ग व पदे</span
          >
          <span
            class="text-sm sm:text-base font-black text-text-main"
            >११ संवर्ग (एकूण २२२ पदे)</span
          >
        </div>
        <div
          class="p-3.5 bg-bg-surface/80 backdrop-blur-xs rounded-xl sm:rounded-2xl border border-border-card flex flex-col justify-center items-center"
        >
          <span
            class="text-[0.65rem] sm:text-xs text-text-muted block uppercase font-bold tracking-wider mb-1"
            >निकाल घोषित पदे</span
          >
          <span
            class="text-base sm:text-xl font-black text-emerald-600 dark:text-emerald-400"
            >५ पदे (उर्वरित ६ पदे लवकरच)</span
          >
        </div>
      </div>
    </div>

    <!-- Direct Action Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 not-prose">
      <a
        href={resultUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-5 bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-2xl transition-all duration-300 shadow-md hover:shadow-emerald-500/20 flex items-center justify-between no-underline"
      >
        <div>
          <span
            class="text-[0.65rem] uppercase font-extrabold tracking-wider bg-white/20 px-2.5 py-0.5 rounded text-white block w-fit mb-1"
            >CSMC Official Result Portal</span
          >
          <h3
            class="text-base sm:text-lg font-extrabold text-white m-0 flex items-center gap-1.5"
          >
            CSMC निकाल PDF डाऊनलोड करा <HiOutlineArrowTopRightOnSquare
              className="text-xl shrink-0"
            />
          </h3>
          <p class="text-xs text-white/90 m-0 mt-1">
            chhsambhajinagarmc.org/recruitment-2026 वर निकाल प्रसिद्ध
          </p>
        </div>
        <div
          class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform"
        >
          <HiOutlineCursorArrowRays className="text-2xl" />
        </div>
      </a>

      <div
        class="p-5 bg-bg-surface border border-border-card rounded-2xl flex items-center gap-4 shadow-xs"
      >
        <div
          class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0"
        >
          <HiOutlineBuildingOffice className="text-2xl" />
        </div>
        <div>
          <span
            class="text-xs text-text-muted font-bold uppercase tracking-wider block"
            >प्राधिकरणाचे नाव</span
          >
          <h4 class="text-sm font-bold text-text-main m-0">
            छत्रपती संभाजीनगर महानगरपालिका
          </h4>
          <p class="text-xs text-text-muted m-0 mt-0.5">
            टाऊन हॉल, छत्रपती संभाजीनगर (प्रेस नोट दि. २८/०८/२०२६)
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex flex-wrap items-center gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी आवृत्ती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2
          id="overview-mr"
          class="text-xl md:text-2xl font-black text-text-main mt-2 border-l-4 border-primary pl-3"
        >
          📢 छत्रपती संभाजीनगर मनपा भरती: IBPS परीक्षेतील ५ पदांचा निकाल जाहीर (अधिकृत प्रेस नोट)
        </h2>

        <p>
          <strong>छत्रपती संभाजीनगर महानगरपालिका (Chhatrapati Sambhajinagar Municipal Corporation - CSMC):</strong> मनपाच्या आस्थापनेवरील गट-क मधील एकूण <strong>११ विविध संवर्गातील सरळसेवेच्या २२२ पदांची</strong> लेखी ऑनलाईन परीक्षा IBPS संस्थेमार्फत दिनांक <strong>०८ जुलै २०२६ ते ०९ जुलै २०२६</strong> या कालावधीत घेण्यात आली होती.
        </p>

        <p>
          त्यापैकी <strong>IBPS संस्थेने ०५ पदांचा निकाल</strong> महानगरपालिकेस सादर केला असून तो मनपाच्या अधिकृत संकेतस्थळावर प्रसिद्ध करण्यात आला आहे.
        </p>

        <!-- Official Press Note Card -->
        <div
          class="bg-bg-surface border-2 border-primary/30 rounded-2xl p-6 shadow-sm my-6"
        >
          <div class="flex items-center gap-2 mb-3 text-primary font-black text-base">
            <HiOutlineMegaphone className="text-xl shrink-0" />
            <span>अधिकृत प्रेस नोट सारांश (दिनांक: २८/०८/२०२६)</span>
          </div>
          <div class="space-y-3 text-sm text-text-main font-medium">
            <p>
              <strong>१. निकाल जाहीर झालेली ५ पदे:</strong> उपअग्निशमन केंद्र अधिकारी, सहाय्यक सुरक्षा अधिकारी, पशुधन पर्यवेक्षक, उद्यान सहाय्यक व अनुरेखक.
            </p>
            <p>
              <strong>२. उर्वरित ०६ पदांचा निकाल:</strong> IBPS कंपनीकडून निकाल प्राप्त झाल्यानंतर लगेच महानगरपालिकेच्या संकेतस्थळावर प्रसिद्ध केला जाईल.
            </p>
            <p>
              <strong>३. परीक्षा पारदर्शकता सूचना:</strong> सदर पदांची परीक्षा घेणे व निकाल तयार करून महानगरपालिकेस पाठवणे याबाबतची संपूर्ण प्रक्रिया ही IBPS संस्थेमार्फत केली जाते. IBPS कडून PDF स्वरूपात निकाल प्राप्त झाल्यानंतरच तो संकेतस्थळावर प्रसिद्ध केला जातो.
            </p>
            <div class="bg-amber-500/10 border border-amber-500/30 p-4 rounded-xl text-xs text-amber-700 dark:text-amber-300 font-semibold flex items-start gap-2 mt-4">
              <HiOutlineExclamationTriangle className="text-lg shrink-0 mt-0.5" />
              <span>
                <strong>महत्त्वाची सावधानता:</strong> सदर प्रक्रिया पूर्णपणे पारदर्शक पद्धतीने पार पाडली जाते. उमेदवारांनी कोणत्याही आमिषाला किंवा भूलथापांना बळी पडू नये. कोणी चुकीची माहिती किंवा आमिष दाखवत असल्यास त्याची माहिती मनपास कळवावी. <em>(- रणजीत आ. पाटील, अतिरिक्त आयुक्त-१)</em>
              </span>
            </div>
          </div>
        </div>

        <!-- Vacancy & Result Breakdown Table (Marathi) -->
        <h2
          id="vacancies-mr"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 निकाल जाहीर झालेल्या ५ पदांची यादी (Declared 5 Posts Result Table)
        </h2>

        <div class="overflow-x-auto my-6">
          <table
            class="w-full text-left border-collapse border border-border-card rounded-2xl overflow-hidden shadow-sm text-sm"
          >
            <thead>
              <tr class="bg-primary/10 text-text-main">
                <th
                  class="p-3.5 border border-border-card font-extrabold text-center w-14"
                  >अ.क्र.</th
                >
                <th class="p-3.5 border border-border-card font-extrabold"
                  >पदाचे नाव (Post Name)</th
                >
                <th
                  class="p-3.5 border border-border-card font-extrabold text-center"
                  >संवर्ग (Group)</th
                >
                <th
                  class="p-3.5 border border-border-card font-extrabold text-center"
                  >निकाल स्थिती (Result Status)</th
                >
                <th
                  class="p-3.5 border border-border-card font-extrabold text-center"
                  >पीडीएफ दुवा (Download PDF)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr class="hover:bg-bg-surface/50">
                <td
                  class="p-3.5 border border-border-card font-bold text-center"
                  >१</td
                >
                <td
                  class="p-3.5 border border-border-card font-bold text-primary"
                  >उपअग्निशमन केंद्र अधिकारी (Sub-Fire Station Officer)</td
                >
                <td
                  class="p-3.5 border border-border-card text-center font-bold"
                  >गट-क</td
                >
                <td
                  class="p-3.5 border border-border-card font-black text-center text-emerald-600 dark:text-emerald-400"
                  >गुणवत्ता यादी जाहीर (Declared)</td
                >
                <td class="p-3.5 border border-border-card text-center">
                  <a
                    href={resultUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1"
                  >
                    यादी पहा <HiOutlineArrowTopRightOnSquare />
                  </a>
                </td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td
                  class="p-3.5 border border-border-card font-bold text-center"
                  >२</td
                >
                <td
                  class="p-3.5 border border-border-card font-bold text-primary"
                  >सहाय्यक सुरक्षा अधिकारी (Assistant Security Officer)</td
                >
                <td
                  class="p-3.5 border border-border-card text-center font-bold"
                  >गट-क</td
                >
                <td
                  class="p-3.5 border border-border-card font-black text-center text-emerald-600 dark:text-emerald-400"
                  >गुणवत्ता यादी जाहीर (Declared)</td
                >
                <td class="p-3.5 border border-border-card text-center">
                  <a
                    href={resultUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1"
                  >
                    यादी पहा <HiOutlineArrowTopRightOnSquare />
                  </a>
                </td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td
                  class="p-3.5 border border-border-card font-bold text-center"
                  >३</td
                >
                <td
                  class="p-3.5 border border-border-card font-bold text-primary"
                  >पशुधन पर्यवेक्षक (Livestock Supervisor)</td
                >
                <td
                  class="p-3.5 border border-border-card text-center font-bold"
                  >गट-क</td
                >
                <td
                  class="p-3.5 border border-border-card font-black text-center text-emerald-600 dark:text-emerald-400"
                  >गुणवत्ता यादी जाहीर (Declared)</td
                >
                <td class="p-3.5 border border-border-card text-center">
                  <a
                    href={resultUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1"
                  >
                    यादी पहा <HiOutlineArrowTopRightOnSquare />
                  </a>
                </td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td
                  class="p-3.5 border border-border-card font-bold text-center"
                  >४</td
                >
                <td
                  class="p-3.5 border border-border-card font-bold text-primary"
                  >उद्यान सहाय्यक (Horticulture Assistant)</td
                >
                <td
                  class="p-3.5 border border-border-card text-center font-bold"
                  >गट-क</td
                >
                <td
                  class="p-3.5 border border-border-card font-black text-center text-emerald-600 dark:text-emerald-400"
                  >गुणवत्ता यादी जाहीर (Declared)</td
                >
                <td class="p-3.5 border border-border-card text-center">
                  <a
                    href={resultUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1"
                  >
                    यादी पहा <HiOutlineArrowTopRightOnSquare />
                  </a>
                </td>
              </tr>
              <tr class="hover:bg-bg-surface/50">
                <td
                  class="p-3.5 border border-border-card font-bold text-center"
                  >५</td
                >
                <td
                  class="p-3.5 border border-border-card font-bold text-primary"
                  >अनुरेखक (Tracer)</td
                >
                <td
                  class="p-3.5 border border-border-card text-center font-bold"
                  >गट-क</td
                >
                <td
                  class="p-3.5 border border-border-card font-black text-center text-emerald-600 dark:text-emerald-400"
                  >गुणवत्ता यादी जाहीर (Declared)</td
                >
                <td class="p-3.5 border border-border-card text-center">
                  <a
                    href={resultUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1"
                  >
                    यादी पहा <HiOutlineArrowTopRightOnSquare />
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- How to Check Result Section -->
        <h2
          id="how-to-check-mr"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          🔹 छत्रपती संभाजीनगर मनपा निकाल डाऊनलोड कसा करावा? (Step-by-Step Guide)
        </h2>
        <div
          class="bg-bg-surface border border-border-card p-6 rounded-2xl text-sm space-y-3 mb-6"
        >
          <ol class="list-decimal pl-5 space-y-2.5 text-text-main font-medium m-0">
            <li>
              सर्वप्रथम छत्रपती संभाजीनगर महानगरपालिकेच्या अधिकृत भरती पोर्टलला भेट द्या: <a
                href={resultUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary font-bold hover:underline"
                >chhsambhajinagarmc.org/recruitment-2026</a
              >
            </li>
            <li>
              होमपेजवरील <strong>"Recruitment 2026 / निकाल"</strong> टॅबवर जा.
            </li>
            <li>
              तुमच्या संबंधित पदाच्या (उदा. उपअग्निशमन केंद्र अधिकारी, सहाय्यक सुरक्षा अधिकारी, पशुधन पर्यवेक्षक, उद्यान सहाय्यक किंवा अनुरेखक) <strong>"Merit List PDF"</strong> वर क्लिक करा.
            </li>
            <li>स्क्रीनवर गुण व निवड यादीची PDF फाईल डाऊनलोड होईल.</li>
            <li>
              <code>Ctrl + F</code> दाबून तुमचा Roll Number किंवा तुमचे नाव सर्च करा.
            </li>
          </ol>
        </div>

        <!-- FAQ Section (Marathi) -->
        <h2
          id="faq-mr"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न १: २८ ऑगस्ट २०२६ च्या प्रेस नोटनुसार कोणत्या ५ पदांचा निकाल जाहीर झाला?
            </h3>
