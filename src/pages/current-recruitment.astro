---

<Layout 
  title="Current Recruitment 2026 | माझी नोकरी (Majhi Naukri) सरकारी नोकरी जाहिराती - MahaSandhi" 
  description="माझी नोकरी (Majhi Naukri 2026) सर्व नवीन सरकारी नोकरी जाहिराती, ऑनलाईन अर्ज व भरती अपडेट्स. Find current recruitment notifications, MPSC, Banking, Railway, Police Bharti, 10th/12th pass jobs & active vacancies at mahasandhi.in."
>
  <section class="pt-4 pb-16 not-prose">
    <!-- Header Section -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-2">
        <HiOutlineBriefcase className="text-sm" /> Live Openings
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-2 tracking-tight text-text-main m-0">
        Current Recruitment
      </h1>
      <p class="text-text-secondary text-[1.1rem] m-0 max-w-[600px] mx-auto">
        Stay updated with active vacancies, eligibility requirements, application dates, and direct recruitment portals.
      </p>
    </div>

    <!-- Latest Jobs List -->
    <div class="max-w-[1000px] mx-auto px-2 md:px-0">
      <div id="jobs-grid" class="flex flex-col gap-3 md:gap-4 transition-all duration-300">
        {latestJobs.length === 0 ? (
          <div class="text-center py-16 bg-bg-surface border border-border-card rounded-2xl">
            <p class="text-text-muted text-sm m-0">No active job announcements at the moment. Please check back later!</p>
          </div>
        ) : (
          latestJobs.map((job) => {
            const countdown = getCountdownInfo(job.lastDate, job.extendedDate);
            return (
              <div
                class="group job-card-item flex flex-row items-center justify-between p-3.5 md:p-5 bg-bg-surface border border-border-card rounded-2xl transition-all duration-300 hover:border-primary gap-3 md:gap-5"
              >
                <!-- Left: Info Block -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2 flex-wrap">
                    <span class="text-[0.65rem] bg-primary/10 text-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20 whitespace-nowrap">
                      {job.category}
                    </span>

                    {job.status === "apply-now" && !countdown.isExpired && (
                      <span class="text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                        <span class="w-1 h-1 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                        Apply Now
                      </span>
                    )}

                    {job.status === "upcoming" && (
                      <span class="text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                        <span class="w-1.5 h-1.5 bg-amber-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                        Upcoming
                      </span>
                    )}

                    {(job.status === "closed" || countdown.isExpired) && (
                      <span class="text-[0.6rem] bg-rose-500/10 text-rose-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide border border-rose-500/20 flex items-center gap-1 whitespace-nowrap">
                        <span class="w-1 h-1 bg-rose-500 rounded-full inline-block"></span>
                        Closed
                      </span>
                    )}
                  </div>

                  <a href={job.link} class="no-underline hover:no-underline block">
                    <h3 class="text-base text-text-main font-bold leading-tight mb-1.5 group-hover:text-primary transition-colors">{job.title}</h3>
                  </a>
                  
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-text-muted mb-3">
                    <div class="flex items-center gap-1.5 min-w-0">
                      <HiOutlineBuildingOffice className="shrink-0 text-xs text-primary/70" />
                      <span class="truncate">{job.organisation}</span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <HiOutlineAcademicCap className="text-xs text-primary/70" />
                      <span>{job.qualification}</span>
                    </div>
                  </div>

                  <!-- Bottom Meta Row: Last Date, Total Posts, and Shifted Apply Online Button -->
                  <div class="flex flex-wrap items-center gap-2 pt-1">
                    <span class="text-[0.65rem] font-bold bg-primary/5 text-primary border border-solid border-primary/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                      Total Posts: <strong class="text-primary font-extrabold">{job.vacancies}</strong>
                    </span>
                    
                    <span class="text-border-card dark:text-border-card/30 hidden sm:inline">|</span>
                    
                    <span class="flex items-center gap-1 text-[0.65rem] font-bold bg-rose-500/5 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-solid border-rose-500/20 px-2.5 py-1 rounded-lg uppercase tracking-wide">
                      <HiOutlineCalendarDays className="text-rose-500 text-xs shrink-0" /> Last Date: 
                      {job.extendedDate ? (
                        <strong class="flex items-center gap-1.5 font-bold">
                          <span class="line-through text-text-muted/70 font-medium">{job.lastDate}</span>
                          <span class="text-rose-600 dark:text-rose-400 font-extrabold">{job.extendedDate}</span>
                        </strong>
                      ) : (
                        <strong class={`font-extrabold ${(job.status === "closed" || countdown.isExpired) ? "line-through text-text-muted/70" : ""}`}>{job.lastDate}</strong>
                      )}
                    </span>

                    <!-- Apply Online CTA Button (Shifted Right of Last Date) -->
                    {job.status === "apply-now" && !countdown.isExpired && (
                      <a
                        href={job.link}
                        class="inline-flex items-center gap-1 px-3 py-1 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-[0.68rem] font-extrabold uppercase tracking-wider transition-all shadow-2xs hover:shadow-xs group/btn no-underline shrink-0"
                      >
                        <span>Apply Online</span>
                        <HiOutlineArrowTopRightOnSquare className="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0" />
                      </a>
                    )}

                    {job.status === "upcoming" && (
                      <a
                        href={job.link}
                        class="inline-flex items-center gap-1 px-3 py-1 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-600 dark:text-amber-400 rounded-lg text-[0.68rem] font-bold uppercase tracking-wider no-underline transition-colors shrink-0"
                      >
                        <HiOutlineBell className="text-xs text-amber-500" />
                        <span>Read Details</span>
                      </a>
                    )}

                    {(job.status === "closed" || countdown.isExpired) && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-rose-500/5 border border-rose-500/15 text-rose-500/60 font-bold uppercase tracking-wider text-[0.65rem] rounded-lg cursor-not-allowed">
                        <HiOutlineXCircle className="text-xs shrink-0" />
                        <span>Closed</span>
                      </span>
                    )}
                  </div>
                </div>

                <!-- Right: Days Remaining Square Countdown Badge (Old Apply Online Position) -->
                <div class="shrink-0 flex items-center justify-center p-1">
                  <div
                    class:list={[
                      "w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex flex-col items-center justify-center p-1.5 text-center shadow-2xs border transition-all shrink-0 select-none group-hover:scale-105",
                      countdown.isExpired
                        ? "bg-rose-500/10 border-rose-500/30 text-rose-500"
                        : countdown.days <= 5
                        ? "bg-amber-500/10 border-amber-500/40 text-amber-500 animate-pulse"
                        : "bg-violet-500/10 border-violet-500/30 text-violet-600 dark:text-violet-400"
                    ]}
                    title={countdown.isExpired ? "Application Closed" : `${countdown.days} Days Remaining`}
                  >
                    {countdown.isExpired ? (
                      <>
                        <span class="text-xs sm:text-sm font-black uppercase tracking-tight leading-none text-rose-500">0</span>
                        <span class="text-[0.5rem] font-black uppercase tracking-wider text-rose-500/80 leading-tight mt-1">Days Left</span>
                      </>
                    ) : (
                      <>
                        <span class="text-base sm:text-lg font-black tracking-tight leading-none">{countdown.text}</span>
                        <span class="text-[0.52rem] font-extrabold uppercase tracking-wider text-text-muted leading-tight mt-1">Days Left</span>
                      </>
                    )}
                  </div>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
