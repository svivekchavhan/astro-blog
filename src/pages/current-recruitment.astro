    title: "लातूर जिल्हा मध्यवर्ती बँक भरती २०२६: ३७५ पदांची सुधारीत प्रतीक्षा यादी (Revised Waiting List) प्रसिद्ध",
    link: "/latur-dcc-bank-revised-waiting-list-2026",
    organisation: "Latur District Central Cooperative Bank Ltd. (Latur DCCB)",
    qualification: "Graduate / 10th / 12th / Driver",
    vacancies: "375 (20% Waiting List)",
    lastDate: "Valid for 365 Days"
  },
  {
    category: "State Govt",
    status: "apply-now",
    title: "महानिर्मिती भरती २०२६: मुख्य अभियंता (तांत्रिक व स्थापत्य) ७ जागांसाठी जाहिरात प्रसिद्ध",
    link: "/mahagenco-recruitment-2026",
    organisation: "MAHAGENCO (Maharashtra State Power Generation Co. Ltd)",
    qualification: "B.E. / B.Tech (Electrical / Mechanical / Electronics / Instrumentation / Civil) + 15 Yrs Exp",
    vacancies: "07",
    lastDate: "20 Aug 2026"
  },
  {
    category: "Bank Job",
    status: "apply-now",
    title: "लातूर जिल्हा मध्यवर्ती सहकारी बँक निकाल २०२६: ३७५ पदांपैकी २६३ उमेदवारांची Phase 1 निवड यादी प्रसिद्ध",
    link: "/latur-dcc-bank-result-2026",
    organisation: "Latur District Central Cooperative Bank Ltd. (Latur DCCB)",
    qualification: "Graduate / 10th / 12th / Driver",
    vacancies: "375 (263 Selected)",
    lastDate: "14 Aug 2026"
  },
  {
    category: "State Govt",
    status: "apply-now",
    title: "MPSC गट-क सेवा संयुक्त पूर्व परीक्षा २०२६: ३,०८८ जागांसाठी शुद्धिपत्रक प्रसिद्ध, अर्ज मुदतवाढ",
    link: "/mpsc-group-c-bharti-2026",
    organisation: "MPSC (Maharashtra Public Service Commission)",
    qualification: "Degree in any discipline / B.F.Sc.",
    vacancies: "3,088",
    lastDate: "31 July 2026"
  },
  {
    category: "State Govt",
    status: "upcoming",
    title: "Arogya Bharti 2026: महाराष्ट्र आरोग्य विभाग ७,१९५ पदांची भरती जाहीर",
    link: "/arogya-bharti-2026",
    organisation: "Public Health Department, Maharashtra",
    qualification: "10th/12th/Diploma/Degree",
    vacancies: "7,195",
    lastDate: "TBA"
  },
  {
    category: "Central Govt",
    status: "apply-now",
    title: "HPCL Bharti 2026: हिंदुस्तान पेट्रोलियम मध्ये 116 जागांसाठी भरती",
    link: "/hpcl-recruitment-2026",
    organisation: "HPCL",
    qualification: "Diploma/Degree in Engg/MBA/Post Graduate",
    vacancies: "116",
    lastDate: "20 July 2026"
  },
  {
    category: "Central Govt",
    status: "apply-now",
    title: "Delhi Higher Judicial Service Exam 2026: दिल्ली उच्च न्यायालयात २७ जागांसाठी भरती",
    link: "/delhi-higher-judicial-service-exam-2026",
    organisation: "High Court of Delhi",
    qualification: "Advocate (7 Yrs Exp) / Judicial Officer",
    vacancies: "27",
    lastDate: "15 July 2026"
  },
  {
    category: "State Govt",
    status: "apply-now",
    title: "MH SET Exam 2026: महाराष्ट्र सेट परीक्षा अर्ज मुदतवाढ (विलंब शुल्कासह)",
    link: "/maharashtra-set-exam-2026",
    organisation: "SPPU Pune",
    qualification: "Post Graduate",
    vacancies: "Eligibility Test",
    lastDate: "23 July 2026"
  },
  {
    category: "Central Govt",
    status: "apply-now",
