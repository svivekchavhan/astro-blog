---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineCheckCircle,
  HiOutlineArrowDownTray,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineIdentification,
  HiOutlineBell,
  HiOutlineUserCircle,
  HiOutlineMegaphone,
  HiOutlineArrowLeft,
  HiOutlineShieldCheck,
  HiOutlineBriefcase,
} from "react-icons/hi2";

const title =
  "PDCC बँक हॉल तिकीट २०२६: शिपाई २८९ जागा भरती परीक्षा प्रवेशपत्र प्रसिद्ध! direct link डाऊनलोड करा";
const description =
  "PDCC Bank Peon Hall Ticket 2026: पुणे जिल्हा मध्यवर्ती सहकारी बँक शिपाई (२८९ जागा) ऑनलाईन भरती परीक्षेचे हॉल तिकीट (Admit Card / Call Letter) उपलब्ध झाले आहे. डायरेक्ट डाउनलोड करण्यासाठी खालील लिंकवर क्लिक करा.";
const canonicalURL = "https://mahasandhi.in/pdcc-bank-peon-hall-ticket-2026";
const date = "August 23, 2026";
const category = "Admit Card";

const loginUrl = "https://www.pdcc.bank.in/careers";
const pdfUrl = "https://www.pdcc.bank.in/uploads/career/%E0%A4%B6%E0%A4%BF%E0%A4%AA%E0%A4%BE%E0%A4%88%E0%A4%BD%E0%A4%B0%E0%A4%A4%E0%A5%88%E0%A4%9C%E0%A4%B0%E0%A4%BF%E0%A4%B0%E0%A4%BE%E0%A4%A4.pdf";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  pubDate={date}
  category={category}
  image="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Admit Card", url: "/admit-card" },
    { name: "PDCC Bank Peon Hall Ticket 2026" },
  ]}
>
  <article class="pt-2 pb-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 rounded-full text-xs font-black uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        Admit Card Released / प्रवेशपत्र प्रसिद्ध
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-emerald-500 pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Prominent Direct Download Banner -->
    <div class="mb-10 p-6 sm:p-8 bg-gradient-to-br from-emerald-600 to-teal-700 rounded-3xl text-white shadow-xl relative overflow-hidden not-prose">
      <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 text-white text-[0.65rem] font-black uppercase tracking-wider backdrop-blur-md">
            ⚡ PDCC Bank Official Portal
          </span>
          <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white m-0">
            शिपाई (Peon) भरती हॉल तिकीट २०२६ ऑनलाईन डाऊनलोड करा!
          </h2>
          <p class="text-xs sm:text-sm text-emerald-100 m-0">
            तुमचा रजिस्ट्रेशन नंबर / मोबाईल नंबर व पासवर्ड / जन्मदिनांक टाकून लगेच प्रवेशपत्र डाऊनलोड करा.
          </p>
        </div>

        <a
          href={loginUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-white hover:bg-emerald-50 text-emerald-900 rounded-2xl font-black text-sm uppercase tracking-wider shadow-lg transition-all transform hover:-translate-y-0.5 no-underline shrink-0 w-full md:w-auto"
        >
          <HiOutlineArrowDownTray className="text-xl shrink-0 text-emerald-600" />
          <span>हॉल तिकीट डाऊनलोड करा</span>
        </a>
      </div>
    </div>

    <!-- Quick Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-emerald-600 dark:text-emerald-400 font-bold text-sm hover:underline"
        >↓ मराठी माहिती (Marathi Version)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#download-steps"
        class="text-emerald-600 dark:text-emerald-400 font-bold text-sm hover:underline"
        >↓ डाऊनलोड पायऱ्या (Steps to Download)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#download-links"
        class="text-emerald-600 dark:text-emerald-400 font-bold text-sm hover:underline"
        >↓ डायरेक्ट लिंक (Direct Download Link)</a
      >
    </div>

    <!-- ================= MARATHI CONTENT ================= -->
    <div id="marathi-version" class="space-y-6 text-text-main leading-relaxed">
      <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
        पुणे जिल्हा मध्यवर्ती सहकारी बँक (PDCC Bank) शिपाई भरती परीक्षा हॉल तिकीट २०२६
      </h2>

      <!-- Introduction -->
      <div class="mb-6">
        <p>
          <strong>PDCC Bank Peon Hall Ticket 2026:</strong> पुणे जिल्हा मध्यवर्ती सहकारी बँक मर्यादित, पुणे (PDCC Bank) द्वारे <strong>शिपाई (Peon)</strong> पदांच्या <strong>२८९ रिक्त जागांसाठी</strong> घेण्याऱ्या ऑफलाईन सरळसेवा OMR लेखी परीक्षेचे अधिकृत <strong>हॉल तिकीट (Admit Card / Call Letter)</strong> प्रसिद्ध करण्यात आले आहे. 
        </p>
        <p>
          ज्या उमेदवारांनी या भरतीसाठी यशस्वीरित्या ऑनलाईन अर्ज भरला होता, ते आता बँकेच्या अधिकृत पोर्टलबद्दल आपला लॉगिन आयडी / नोंदणी क्रमांक आणि पासवर्ड / जन्मदिनांक प्रविष्ट करून हॉल तिकीट ऑनलाईन डाऊनलोड करू शकतात.
        </p>
        <hr class="border-border-card my-6" />
      </div>

      <!-- Quick Summary Table Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineBuildingOffice className="text-emerald-600 dark:text-emerald-400 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">बँकेचे नाव</span>
            <span class="text-text-main font-semibold text-sm">पुणे जिल्हा मध्यवर्ती सहकारी बँक (PDCC Bank)</span>
          </div>
        </div>
        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineBriefcase className="text-emerald-600 dark:text-emerald-400 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">पदाचे नाव & पदे</span>
            <span class="text-text-main font-semibold text-sm">शिपाई (Peon) - २८९ पदे</span>
          </div>
        </div>
        <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
          <HiOutlineIdentification className="text-emerald-600 dark:text-emerald-400 text-2xl shrink-0 mt-0.5" />
          <div>
            <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">परीक्षा स्वरूप</span>
            <span class="text-text-main font-semibold text-sm">७० गुण ऑफलाईन OMR लेखी परीक्षा</span>
          </div>
        </div>
      </div>

      <!-- Download Steps Section -->
      <h2
        id="download-steps"
        class="text-xl md:text-2xl font-black text-emerald-600 dark:text-emerald-400 mb-2 mt-8 border-l-4 border-emerald-500 pl-3"
      >
        PDCC बँक शिपाई हॉल तिकीट डाऊनलोड कसे करावे? (Steps to Download Hall Ticket)
      </h2>
      <div class="bg-bg-surface border border-border-card p-5 sm:p-6 rounded-2xl space-y-3 text-sm mb-6">
        <p class="m-0 text-text-main font-bold">
          उमेदवारांनी खालील सोप्या पायऱ्यांचे अनुसरण करून आपले हॉल तिकीट डाऊनलोड करावे:
        </p>
        <ol class="list-decimal pl-6 space-y-2 text-text-muted">
          <li>
            सर्वप्रथम खाली दिलेल्या <strong>"PDCC Bank Admit Card Direct Download Link"</strong> वर क्लिक करा.
          </li>
          <li>
            बँकेचे अधिकृत कॅरिअर/लॉगिन पोर्टल उघडेल.
          </li>
          <li>
            तुमचा <strong>रजिस्ट्रेशन नंबर / अर्ज क्रमांक (Application No.)</strong> प्रविष्ट करा.
          </li>
          <li>
            तुमचा <strong>पासवर्ड किंवा जन्मदिनांक (DD-MM-YYYY)</strong> प्रविष्ट करून लॉगिन करा.
          </li>
          <li>
            स्क्रीनवर तुमचे <strong>PDCC Bank Peon Admit Card 2026</strong> प्रदर्शित होईल.
          </li>
          <li>
            हॉल तिकीट डाऊनलोड करून त्याची A4 साईझ प्रिंटआऊट (Printout) काढून ठेवा.
          </li>
        </ol>
      </div>

      <!-- Syllabus & Exam Scheme Summary Table -->
      <h2
        id="exam-scheme"
        class="text-xl md:text-2xl font-black text-emerald-600 dark:text-emerald-400 mb-2 mt-8 border-l-4 border-emerald-500 pl-3"
      >
        परीक्षेचे स्वरूप (70 Marks OMR Written Exam Pattern)
      </h2>
      <div class="overflow-x-auto mt-3 mb-8">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-emerald-500/10">
              <th class="p-3 border border-border-card font-bold text-text-main text-center w-16">अ.क्र.</th>
              <th class="p-3 border border-border-card font-bold text-text-main">विषय (Subject)</th>
              <th class="p-3 border border-border-card font-bold text-text-main text-center">गुण (Marks)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-card/30">
            <tr>
              <td class="p-3 border border-border-card text-center text-text-muted font-bold">१</td>
              <td class="p-3 border border-border-card font-medium text-text-main">शेती पतपुरवठा त्रिस्तरीय रचना</td>
              <td class="p-3 border border-border-card text-center font-extrabold text-emerald-600 dark:text-emerald-400">२० गुण</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card text-center text-text-muted font-bold">२</td>
              <td class="p-3 border border-border-card font-medium text-text-main">बँकिंग व सहकार (Banking & Cooperation)</td>
              <td class="p-3 border border-border-card text-center font-extrabold text-emerald-600 dark:text-emerald-400">१५ गुण</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card text-center text-text-muted font-bold">३</td>
              <td class="p-3 border border-border-card font-medium text-text-main">सामान्य ज्ञान व चालू घडामोडी</td>
              <td class="p-3 border border-border-card text-center font-extrabold text-emerald-600 dark:text-emerald-400">१५ गुण</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card text-center text-text-muted font-bold">४</td>
              <td class="p-3 border border-border-card font-medium text-text-main">कृषी व ग्रामीण अर्थव्यवस्था</td>
              <td class="p-3 border border-border-card text-center font-extrabold text-emerald-600 dark:text-emerald-400">१० गुण</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card text-center text-text-muted font-bold">५</td>
              <td class="p-3 border border-border-card font-medium text-text-main">बुद्धिमत्ता चाचणी (Reasoning)</td>
              <td class="p-3 border border-border-card text-center font-extrabold text-emerald-600 dark:text-emerald-400">१० गुण</td>
            </tr>
            <tr class="bg-emerald-500/10">
              <td colspan="2" class="p-3 border border-border-card font-bold text-text-main text-right">एकूण परीक्षा गुण (Total Exam Marks)</td>
              <td class="p-3 border border-border-card font-black text-emerald-700 dark:text-emerald-300 text-center text-base">७० गुण (७५ मिनिटे)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- What to carry to exam center -->
      <h2
        id="documents"
        class="text-xl md:text-2xl font-black text-emerald-600 dark:text-emerald-400 mb-2 mt-8 border-l-4 border-emerald-500 pl-3"
      >
        परीक्षा केंद्रावर काय सोबत नेणे आवश्यक आहे? (Documents Required at Exam Center)
      </h2>
      <div class="bg-bg-surface border border-border-card p-5 sm:p-6 rounded-2xl text-sm mb-8">
        <ul class="list-disc pl-6 space-y-2 text-text-muted">
          <li><strong>हॉल तिकीट (Printed Hall Ticket):</strong> स्पष्ट प्रिंट काढलेले मूळ प्रवेशपत्र.</li>
          <li><strong>मूळ ओळखपत्र (Original Photo ID Proof):</strong> आधार कार्ड / पॅन कार्ड / मतदान ओळखपत्र / ड्रायव्हिंग लायसन्स किंवा पासपोर्ट.</li>
          <li><strong>ओळखपत्राची छायाप्रत (ID Proof Photocopy):</strong> ओळखपत्राची एक झेरॉक्स प्रत.</li>
          <li><strong>पासपोर्ट फोटो:</strong> २ ताजे रंगीत पासपोर्ट आकाराचे फोटो.</li>
          <li><strong>काळा / निळा बॉलपेन:</strong> OMR शीटवर उत्तरे वर्तुळ करण्यासाठी उत्तम दर्जाचा बॉल पॉईंट पेन.</li>
        </ul>
      </div>

      <!-- Official Links Table -->
      <h2
        id="download-links"
        class="text-xl md:text-2xl font-black text-emerald-600 dark:text-emerald-400 mb-2 mt-8 border-l-4 border-emerald-500 pl-3"
      >
        महत्त्वाच्या लिंक्स (Important Portal Links)
      </h2>
      <div class="overflow-x-auto mt-3 mb-8">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-emerald-500/10">
              <th class="p-3.5 border border-border-card font-bold text-text-main">
                तपशील (Event / Link)
              </th>
              <th class="p-3.5 border border-border-card font-bold text-text-main">
                डायरेक्ट लिंक (Direct Action Link)
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3.5 border border-border-card font-bold text-text-main">
                PDCC Bank Peon Hall Ticket 2026 Download Link
              </td>
              <td class="p-3.5 border border-border-card">
                <a
                  href={loginUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all no-underline"
                >
                  <HiOutlineArrowDownTray className="text-base shrink-0" />
                  <span>Download Hall Ticket</span>
                </a>
              </td>
            </tr>
            <tr>
              <td class="p-3.5 border border-border-card font-medium text-text-muted">
                PDCC Bank भर्ती मूळ जाहिरात (Peon Bharti Details Post)
              </td>
              <td class="p-3.5 border border-border-card">
                <a
                  href="/pdcc-bank-peon-bharti-2026"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-xl transition-all border border-primary/20 no-underline"
                >
                  <HiOutlineDocumentText className="text-base shrink-0" />
                  <span>पाहा मूळ भरती माहिती</span>
                </a>
              </td>
            </tr>
            <tr>
              <td class="p-3.5 border border-border-card font-medium text-text-muted">
                अधिकृत भरती जाहिरात PDF (Official Notification)
              </td>
              <td class="p-3.5 border border-border-card">
                <a
                  href={pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider rounded-xl transition-all border border-rose-500/30 no-underline"
                >
                  <HiOutlineDocumentText className="text-base shrink-0" />
                  <span>डाउनलोड जाहिरात (PDF)</span>
                </a>
              </td>
            </tr>
            <tr>
              <td class="p-3.5 border border-border-card font-medium text-text-muted">
                अधिकृत संकेतस्थळ (Official Website)
              </td>
              <td class="p-3.5 border border-border-card">
                <a
                  href="https://www.punedccbank.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-xl transition-all border border-amber-500/30 no-underline"
                >
                  <HiOutlineArrowTopRightOnSquare className="text-base shrink-0" />
                  <span>www.punedccbank.com</span>
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- FAQ Section -->
      <h2
        id="faq"
        class="text-xl md:text-2xl font-black text-emerald-600 dark:text-emerald-400 mb-2 mt-8 border-l-4 border-emerald-500 pl-3"
      >
        वारंवार विचारले जाणारे प्रश्न (FAQ)
      </h2>
      <div class="space-y-4 mt-3 mb-8">
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
          <h3 class="text-base font-bold text-text-main mb-2">
            प्रश्न १: PDCC बँक शिपाई भरतीचे हॉल तिकीट डाऊनलोड कसे करावे?
          </h3>
          <p class="text-text-muted text-xs m-0">
            उत्तर: बँकेच्या अधिकृत भरती पोर्टलवर जाऊन तुमचा रजिस्ट्रेशन नंबर आणि पासवर्ड/जन्मतारीख टाकून ऑनलाईन हॉल तिकीट डाऊनलोड करता येईल.
          </p>
        </div>
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
          <h3 class="text-base font-bold text-text-main mb-2">
            प्रश्न २: परीक्षेचे स्वरूप व एकूण गुण किती आहेत?
          </h3>
          <p class="text-text-muted text-xs m-0">
            उत्तर: ७० गुणांची बहुपर्यायी OMR लेखी परीक्षा ७५ मिनिटांत मराठी माध्यमातून घेतली जाईल.
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>
