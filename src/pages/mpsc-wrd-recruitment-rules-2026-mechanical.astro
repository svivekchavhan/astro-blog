---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineAcademicCap,
  HiOutlineBuildingOffice,
  HiOutlineIdentification,
  HiOutlineArrowDownTray,
  HiOutlineInformationCircle,
  HiOutlineArrowLeft
} from "react-icons/hi2";

const title = "MPSC WRD Junior Engineer (Mechanical) Recruitment Rules 2026";
const description = "Water Resources Department, Government of Maharashtra Junior Engineer (Mechanical) Group B (Non-Gazetted) Recruitment Rules, 2026.";
const canonicalURL = "https://mahasandhi.in/mpsc-wrd-recruitment-rules-2026-mechanical";
const date = "June 30, 2026";
const category = "Exam Info";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&q=80&w=1200"
  article={true}
  hideSidebar={true}
>
  <article class="py-8">
    <!-- Back Button -->
    <div class="mb-6 not-prose">
      <a 
        href="/mpsc-wrd-recruitment-rules-2026" 
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-text-muted hover:text-primary bg-bg-surface border border-border-card rounded-xl transition-all duration-300 no-underline"
      >
        <HiOutlineArrowLeft className="text-sm" /> back to wrd rules list / मागे जा
      </a>
    </div>

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Table of Contents (Marathi) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line>
          </svg>
          या लेखातील मुख्य मुद्दे (मराठी)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li>
            <a
              href="#overview-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >MPSC WRD JE सेवाप्रवेश नियम काय आहेत? (Overview)</a
            >
          </li>
          <li>
            <a
              href="#eligibility-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >पात्रता निकष आणि शैक्षणिक अर्हता (Eligibility)</a
            >
          </li>
          <li>
            <a
              href="#rules-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >महत्त्वाचे सेवाप्रवेश नियम (Key Rules)</a
            >
          </li>
          <li>
            <a
              href="#links-mr"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >अधिकृत राजपत्र आणि डाउनलोड लिंक (Downloads)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <h2 id="overview-mr">MPSC WRD कनिष्ठ अभियंता (यांत्रिकी) सेवाप्रवेश नियम २०२६ काय आहे?</h2>
        <p>
          महाराष्ट्र शासनाच्या <strong>जलसंपदा विभागांतर्गत</strong> कनिष्ठ अभियंता (यांत्रिकी), गट-ब (अराजपत्रित) या पदावर नियुक्तीसाठी सुधारित <strong>सेवाप्रवेश नियम, २०२६</strong> अधिकृत राजपत्रात प्रसिद्ध करण्यात आले आहेत. हे नियम २९ जून २०२६ रोजी अधिसूचित करण्यात आले असून ३० जून २०२६ रोजी राजपत्रात प्रसिद्ध करण्यात आले आहेत.
        </p>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineBuildingOffice className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">विभाग (Department)</span>
              <span class="text-text-main font-semibold text-sm">जलसंपदा विभाग, महाराष्ट्र शासन</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineCalendarDays className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">अधिसूचित / प्रसिद्ध</span>
              <span class="text-text-main font-semibold text-sm">२९ जून २०२६ / ३० जून २०२६</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineIdentification className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">संदर्भ व आधार</span>
              <span class="text-text-main font-semibold text-sm">RTR-1517/CR.250/EST(Tech)</span>
            </div>
          </div>
        </div>

        <h2 id="eligibility-mr">पात्रता आणि वयोमर्यादा निकष</h2>
        <table class="w-full text-left border-collapse my-6">
          <thead>
            <tr class="bg-primary/10">
              <th class="p-3 border border-border-card font-bold text-text-main">निकष (Criterion)</th>
              <th class="p-3 border border-border-card font-bold text-text-main">अट (Requirement)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3 border border-border-card font-semibold">किमान वय (Minimum Age)</td>
              <td class="p-3 border border-border-card">१८ वर्षे</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card font-semibold">कमाल वय (खुला प्रवर्ग)</td>
              <td class="p-3 border border-border-card">३८ वर्षे</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card font-semibold">कमाल वय (राखीव प्रवर्ग)</td>
              <td class="p-3 border border-border-card">४३ वर्षे</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card font-semibold">शैक्षणिक पात्रता (Qualification)</td>
              <td class="p-3 border border-border-card">यांत्रिकी (Mechanical), स्वयंचल (Automobile) किंवा उत्पादन (Production) अभियांत्रिकी/तंत्रज्ञान यामधील पदविका (Diploma) किंवा पदवी (Degree).</td>
            </tr>
            <tr>
              <td class="p-3 border border-border-card font-semibold">निवड पद्धत (Selection Method)</td>
              <td class="p-3 border border-border-card">स्पर्धा परीक्षेच्या आधारे महाराष्ट्र लोकसेवा आयोगाने (MPSC) शिफारस केलेल्या उमेदवारांमधून नामनिर्देशनाद्वारे नियुक्ती केली जाईल.</td>
            </tr>
          </tbody>
        </table>

        <h2 id="rules-mr">महत्त्वाचे सेवाप्रवेश नियम व तरतुदी</h2>
        
        <div class="space-y-6">
          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम १ — प्रारंभ (Commencement)</h4>
            <p class="text-sm text-text-secondary m-0">राजपत्र प्रसिद्धीच्या दिनांकापासून (३० जून २०२६) हे नियम अंमलात येतील व कनिष्ठ अभियंता (यांत्रिकी) या पदावरील भरतीचे पूर्वीचे सर्व नियम अधिक्रमित होतील.</p>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम ३ — नियुक्ती (Appointment)</h4>
            <p class="text-sm text-text-secondary m-0">स्पर्धा परीक्षेच्या निकालाच्या आधारे MPSC ने शिफारस केलेल्या उमेदवारांमधून नामनिर्देशनाद्वारे थेट नियुक्ती केली जाईल.</p>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl border-l-4 border-l-rose-500">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम ४ — विभागीय परीक्षा (Departmental Exam)</h4>
            <p class="text-sm text-text-secondary m-0">महाराष्ट्र अभियांत्रिकी प्रशिक्षण प्रबोधिनी (META), नाशिक यांच्यामार्फत घेतली जाणारी विभागीय परीक्षा विहित कालावधीत उत्तीर्ण करणे आवश्यक आहे.</p>
            <span class="inline-block mt-3 text-xs font-bold text-rose-500 bg-rose-500/10 px-3 py-1 rounded border border-rose-500/20">
              ⚠ अपूर्तता: परीक्षा उत्तीर्ण होईपर्यंत वार्षिक वेतनवाढ/पदोन्नती रोखली जाईल व सेवाज्येष्ठता (Seniority) गमवावी लागेल.
            </span>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl border-l-4 border-l-rose-500">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम ५ — मराठी व हिंदी भाषा परीक्षा</h4>
            <p class="text-sm text-text-secondary m-0">उमेदवारांनी नियुक्तीनंतर विहित कालमर्यादेत मराठी व हिंदी भाषा परीक्षा उत्तीर्ण करणे आवश्यक आहे.</p>
            <span class="inline-block mt-3 text-xs font-bold text-rose-500 bg-rose-500/10 px-3 py-1 rounded border border-rose-500/20">
              ⚠ अपूर्तता: परीक्षा उत्तीर्ण होईपर्यंत वार्षिक वेतनवाढ किंवा पदोन्नती मिळणार नाही.
            </span>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl border-l-4 border-l-rose-500">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम ६ — संगणक हाताळणी प्रमाणपत्र</h4>
            <p class="text-sm text-text-secondary m-0">नियुक्त उमेदवाराने शासनाने विहित केलेले संगणक हाताळणी प्रमाणपत्र विहित कालमर्यादेत धारण करणे आवश्यक आहे.</p>
            <span class="inline-block mt-3 text-xs font-bold text-rose-500 bg-rose-500/10 px-3 py-1 rounded border border-rose-500/20">
              ⚠ अपूर्तता: प्रमाणपत्र धारण करीपर्यंत वार्षिक वेतनवाढ किंवा पदोन्नती मिळणार नाही.
            </span>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम ७ — लहान कुटुंबाचे घोषणापत्र</h4>
            <p class="text-sm text-text-secondary m-0">अर्जासोबत आणि नियुक्तीच्या वेळी घोषणापत्र सादर करणे अनिवार्य आहे. दोनपेक्षा अधिक अपत्ये असल्यास (घोषणेवेळी, नियुक्तीवेळी किंवा सेवेदरम्यान आढळल्यास) संबंधित व्यक्ती शासकीय सेवेसाठी अपात्र ठरेल.</p>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम ८ — बदली (Transfer)</h4>
            <p class="text-sm text-text-secondary m-0">कनिष्ठ अभियंता (यांत्रिकी) या पदाची सेवाज्येष्ठता सूची राज्यस्तरावर ठेवली जात असल्याने, नियुक्त उमेदवार संपूर्ण महाराष्ट्र राज्यात कोठेही बदलीसाठी पात्र असतील.</p>
          </div>

          <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
            <h4 class="text-text-main font-bold mt-0 mb-2">नियम ९ — इतर लागू होणारे नियम/आदेश</h4>
            <p class="text-sm text-text-secondary m-0">शासनाने वेळोवेळी निर्गमित केलेले इतर सर्वसाधारण नियम, निर्णय किंवा आदेश देखील या पदावरील नियुक्तीस लागू राहतील.</p>
          </div>
        </div>

        <!-- Signature Authority -->
        <div class="my-8 p-6 bg-bg-surface border border-border-card rounded-2xl text-right">
          <p class="text-xs text-text-muted italic m-0">महाराष्ट्राचे राज्यपाल यांच्या आदेशानुसार व नावाने,</p>
          <h4 class="text-base font-bold text-text-main mt-2 mb-0">डॉ. संजय बेलसरे</h4>
          <span class="text-xs text-text-muted">शासनाचे सचिव (लाक्षेवि), जलसंपदा विभाग</span>
        </div>

        <!-- MPSC Links Table (Marathi) -->
        <h2 id="links-mr" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">अधिकृत ऑनलाईन मार्गदर्शक लिंक्स</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Resource Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">डायरेक्ट लिंक (Action)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">अधिकृत राजपत्र अधिसूचना वाचन</td>
                <td class="p-3 border border-border-card">
                  <span class="inline-flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400 font-bold bg-amber-500/10 px-3 py-1.5 rounded-lg border border-amber-500/20">
                    <HiOutlineInformationCircle className="text-base" /> अर्ज करण्यापूर्वी मूळ राजपत्र काळजीपूर्वक वाचावे.
                  </span>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">जलसंपदा विभाग राजपत्र अधिकृत PDF डाउनलोड</td>
                <td class="p-3 border border-border-card">
                  <a href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold uppercase tracking-wider rounded-lg transition-all shadow-sm w-full sm:w-auto">
                    <HiOutlineArrowDownTray className="text-base shrink-0" /> PDF डाउनलोड (लिंक लवकरच सक्रिय होईल)
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative">
      <span class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md">
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <!-- Table of Contents (English) -->
      <div class="bg-bg-surface border border-border-card rounded-3xl p-8 mb-12">
        <h2
          class="text-xl font-bold text-text-main mb-4 flex items-center gap-2 m-0 border-none animate-[none]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line
              x1="8"
              y1="12"
              x2="21"
              y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
              x1="3"
              y1="6"
              x2="3.01"
              y2="6"></line><line x1="3" y1="12" x2="3.01"
              y2="12"></line><line x1="3" y1="18" x2="3.01"
              y2="18"></line>
          </svg>
          Key Topics in this Article (English)
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0 m-0 mt-2">
          <li>
            <a
              href="#overview-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >MPSC WRD JE Rules (Overview)</a
            >
          </li>
          <li>
            <a
              href="#eligibility-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Eligibility Criteria & Educational Qualification (Eligibility)</a
            >
          </li>
          <li>
            <a
              href="#rules-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Important Recruitment Rules (Key Rules)</a
            >
          </li>
          <li>
            <a
              href="#links-en"
              class="text-text-muted hover:text-primary transition-colors text-sm font-medium"
              >Official Gazette PDF Download (Downloads)</a
            >
          </li>
        </ul>
      </div>

      <!-- Content (English) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <h2 id="overview-en">MPSC WRD Junior Engineer (Mechanical) Recruitment Rules, 2026 Overview</h2>
        <p>
