                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-xl transition-colors border border-primary/20 w-full sm:w-auto no-underline"
                  >
                    <HiOutlineArrowTopRightOnSquare
                      className="text-base shrink-0"
                    />
                    <span>vanarticbt.thinkexam.com</span>
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Exam Center Instructions -->
        <div
          class="bg-amber-500/10 border border-amber-500/30 p-6 rounded-2xl space-y-3 mb-8"
        >
          <h3
            class="text-base font-bold text-amber-700 dark:text-amber-300 m-0 flex items-center gap-2"
          >
            <HiOutlineMegaphone className="text-xl shrink-0" />
            <span
