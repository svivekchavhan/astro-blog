---
import Layout from "../layouts/Layout.astro";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineCheckCircle,
  HiOutlineArrowDownTray,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineIdentification,
  HiOutlineBell,
  HiOutlineUserCircle,
  HiOutlineMegaphone,
} from "react-icons/hi2";

const title =
  "वनार्टी प्रवेशपत्र २०२६: विद्यार्थ्यांच्या Login tab वर उपलब्ध झालेले आहे  ! (VANARTI Admit Card Download Link)";
const description =
  "VANARTI Admit Card 2026 Download: वनार्टी (VANARTI) द्वारे आयोजित स्पर्धा परीक्षा मोफत पूर्व प्रशिक्षण चाळणी परीक्षेचे प्रवेशपत्र / हॉल तिकीट विद्यार्थ्यांच्या ऑनलाईन लॉगिन खात्यावर उपलब्ध झाले आहे. डायरेक्ट डाऊनलोड लिंक आणि स्टेप-बाय-स्टेप माहिती पहा.";
const canonicalURL = "https://mahasandhi.in/vanarti-admit-card-2026";
const date = "August 10, 2026";
const category = "Admit Card";
const imageUrl =
  "https://drive.google.com/thumbnail?id=1fAUV_we5xCbx8IiAcaMn1zu2NyAFlZFj&sz=w1200";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  image={imageUrl}
  article={true}
  customBreadcrumbs={[
    { name: "Admit Card", url: "/admit-card" },
    { name: "VANARTI Admit Card 2026" },
  ]}
>
  <article class="py-8">
    <!-- Header Banner & Category -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span
          class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-emerald-500/20 flex items-center gap-1.5"
        >
          <HiOutlineBell className="text-sm shrink-0 animate-pulse" />
          {category}
        </span>
        <span class="text-text-muted text-xs font-semibold">• {date}</span>
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-primary/20"
        >
          लॉगिनवर उपलब्ध (Candidate Login Out)
        </span>
      </div>

      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>

      <p
        class="text-text-muted text-base sm:text-lg leading-relaxed border-l-4 border-emerald-500 pl-6 py-2 italic bg-emerald-500/5 rounded-r-xl"
      >
        {description}
      </p>
    </div>

    <!-- Featured Image Showcase Container -->
    <div
      class="mb-10 overflow-hidden rounded-3xl border border-border-card bg-bg-surface p-2 sm:p-3 shadow-sm space-y-2"
    >
      <div
        class="w-full overflow-hidden rounded-2xl bg-bg-surface flex items-center justify-center min-h-[220px]"
      >
        <img
          src={imageUrl}
          width="1200"
          height="675"
          alt="वनार्टी प्रवेशपत्र २०२६ विद्यार्थ्यांच्या ऑनलाईन लॉगिन वर प्रसिद्ध - VANARTI Admit Card 2026 Student Login"
          class="w-full h-auto max-h-[550px] object-cover sm:object-contain rounded-xl transition-all duration-300"
          loading="eager"
          onerror="this.onerror=null; this.src='https://lh3.googleusercontent.com/d/1fAUV_we5xCbx8IiAcaMn1zu2NyAFlZFj';"
        />
      </div>
      <!-- Caption Below Image Container (Solid Single Color) -->
      <div class="flex items-center justify-end px-1 pt-1">
        <span
          class="text-primary text-[0.7rem] sm:text-xs font-bold bg-primary/10 border border-primary/20 px-3 py-1.5 rounded-xl flex items-center gap-1.5 shadow-xs"
        >
          📌 VANARTI Candidate Login Dashboard • हॉलतिकीट डाऊनलोड
        </span>
      </div>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ मराठी माहिती (Marathi)</a
      >
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
        >↓ English Version</a
      >
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2
          id="main-keyword-mr"
          class="text-xl md:text-2xl font-black text-text-main mt-2"
        >
          वनार्टी (VANARTI) स्पर्धा परीक्षा मोफत प्रशिक्षण चाळणी परीक्षा २०२६ -
          प्रवेशपत्र विद्यार्थ्यांच्या लॉगिनवर उपलब्ध!
        </h2>

        <!-- Introduction -->
        <div class="mb-6 space-y-4">
          <p>
            <strong>VANARTI Admit Card 2026:</strong> वनार्टी (VANARTI) संस्थेद्वारे
            सन २०२६-२७ या सत्राकरिता विविध स्पर्धा परीक्षांच्या (MPSC, UPSC, Banking,
            SSC व इतर) मोफत पूर्व प्रशिक्षणासाठी अर्ज केलेल्या सर्व विद्यार्थ्यांसाठी
            अत्यंत महत्त्वाची बातमी समोर आली आहे.
          </p>
          <p>
            वनार्टी चाळणी परीक्षेचे <strong
              >प्रवेशपत्र (Hall Ticket / Admit Card)</strong
            > विद्यार्थ्यांच्या वैयक्तिक <strong
              >ऑनलाईन लॉगिन खात्यावर (Candidate Login)</strong
            > उपलब्ध करण्यात आले आहे. ज्या विद्यार्थ्यांनी या प्रशिक्षणासाठी यशस्वीरीत्या
            अर्ज भरले होते, ते आता आपला नोंदणी क्रमांक व पासवर्ड वापरून आपले हॉलतिकीट
            डाऊनलोड करू शकतात.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-2xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >संस्थेचे नाव</span
              >
              <span class="text-text-main font-bold text-sm"
                >वनार्टी (VANARTI)</span
              >
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineIdentification
              className="text-emerald-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >प्रवेशपत्र स्थिती</span
              >
              <span
                class="text-emerald-600 dark:text-emerald-400 font-extrabold text-sm flex items-center gap-1"
              >
                <span class="w-2 h-2 bg-emerald-500 rounded-full animate-ping"
                ></span> लॉगिनवर उपलब्ध
              </span>
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineAcademicCap
              className="text-amber-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
                >प्रशिक्षण प्रकार</span
              >
