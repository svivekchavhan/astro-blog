                    <li>As per post requirement (Please read official notification).</li>
                  </ul>
                </td>
                <td class="p-3 border border-border-card text-text-muted">
                  <span class="inline-block px-2 py-1 rounded text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">No Experience Required</span>
                </td>
              </tr>
            </tbody>
          </table>
