---
import Layout from "../layouts/Layout.astro";
import { 
  HiOutlineCalendarDays, 
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText
} from "react-icons/hi2";

const title = "BSNL Bharti 2026: भारत संचार निगम लिमिटेड मध्ये 100 जागांसाठी भरती";
const description = "BSNL (भारत संचार निगम लिमिटेड) ने विविध पदांसाठी १०० रिक्त जागांची भरती जाहीर केली आहे. पात्रता, अर्ज प्रक्रिया आणि शेवटची तारीख याबाबत संपूर्ण माहिती येथे वाचा.";
const canonicalURL = "https://techfixsteps.com/bsnl-bharti-2026";
const date = "June 1, 2026";
const category = "Latest Job";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&q=80&w=1200"
  article={true}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <!-- Content (Marathi) -->
      <div class="space-y-8 text-text-main leading-relaxed">
        <p>
          <strong>BSNL Bharti 2026:</strong> भारत संचार निगम लिमिटेड (BSNL) ने नुकतीच विविध तांत्रिक आणि प्रशासकीय पदांसाठी भरती जाहीर केली आहे. या भरतीअंतर्गत एकूण १०० रिक्त जागा भरण्यात येणार आहेत. इच्छुक आणि पात्र उमेदवार अधिकृत वेबसाइटवर जाऊन ऑनलाइन अर्ज करू शकतात.
        </p>

        <h2 id="overview">BSNL भरती 2026 सविस्तर माहिती</h2>
        <div class="bg-bg-surface border border-border-card p-6 rounded-2xl">
          <p class="m-0">
            ही भरती प्रक्रिया पूर्णपणे पारदर्शक असून निवड लेखी परीक्षा आणि मुलाखतीद्वारे केली जाईल. टेलिकॉम क्षेत्रात सरकारी नोकरी मिळवण्याची ही एक सुवर्णसंधी आहे.
          </p>
        </div>

        <h2 id="details">पदांचा तपशील आणि रिक्त जागा</h2>
        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap"><span class="flex items-center gap-1.5"><HiOutlineDocumentText className="text-primary" /> पदाचे नाव</span></th>
                <th class="p-3 border border-border-card font-bold text-text-main">रिक्त जागा</th>
                <th class="p-3 border border-border-card font-bold text-text-main">शैक्षणिक पात्रता</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted">कनिष्ठ अभियंता (Junior Engineer)</td>
                <td class="p-3 border border-border-card text-text-muted">६०</td>
                <td class="p-3 border border-border-card text-text-muted">डिप्लोमा/बी.ई./बी.टेक (Electronics/Telecom)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted">प्रशासकीय अधिकारी (Admin Officer)</td>
                <td class="p-3 border border-border-card text-text-muted">४०</td>
                <td class="p-3 border border-border-card text-text-muted">कोणतीही पदवी (Graduation)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="important-dates">महत्त्वाच्या तारखा आणि लिंक्स</h2>
        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Event)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">तारीख (Date)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">लिंक (Action)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">ऑनलाइन अर्ज सुरू होण्याची तारीख</td>
                <td class="p-3 border border-border-card text-text-main font-bold whitespace-nowrap">
                  <span class="flex items-center gap-1.5"><HiOutlineCalendarDays className="text-primary text-lg shrink-0" /> ५ जून २०२६</span>
                </td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto">
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> अर्ज करा (Apply Now)
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">ऑनलाइन अर्ज करण्याची शेवटची तारीख</td>
                <td class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap">
                  <span class="flex items-center gap-1.5"><HiOutlineCalendarDays className="text-rose-500 text-lg shrink-0" /> ३० जून २०२६</span>
                </td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary text-white hover:bg-primary/90 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors shadow-sm shadow-primary/30 w-full sm:w-auto">
                    <HiOutlineArrowTopRightOnSquare className="text-base shrink-0" /> Apply Online
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">अधिकृत जाहिरात (Notification PDF)</td>
                <td class="p-3 border border-border-card text-text-main font-bold text-center">-</td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto">
                    <HiOutlineDocumentText className="text-base shrink-0" /> PDF डाउनलोड
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="how-to-apply">अर्ज कसा करावा?</h2>
        <div class="space-y-6 pl-2 border-l-2 border-primary/30">
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">1</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 1: अधिकृत वेबसाइटला भेट द्या</h4>
            <p class="text-sm text-text-muted m-0">सर्वप्रथम BSNL च्या अधिकृत वेबसाइटवर (www.bsnl.co.in) जा किंवा वरील टेबलमधील 'Apply Online' बटनावर क्लिक करा.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">2</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 2: नोंदणी करा (Registration)</h4>
            <p class="text-sm text-text-muted m-0">नवीन नोंदणी लिंकवर क्लिक करा आणि आवश्यक माहिती भरा.</p>
          </div>
          <div class="relative pl-8">
            <span class="absolute left-[-1.05rem] top-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold">3</span>
            <h4 class="text-text-main font-bold m-0 mb-1">Step 3: अर्ज भरा आणि फी भरा</h4>
            <p class="text-sm text-text-muted m-0">संपूर्ण अर्ज काळजीपूर्वक भरा आणि ऑनलाइन फी भरा.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative">
      <span class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md">
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="mb-8">
        <h2 class="text-2xl md:text-3xl font-extrabold text-text-main mb-4">
          BSNL Recruitment 2026: 100 Vacancies Announced
        </h2>
        <p class="text-text-muted leading-relaxed italic">
          Bharat Sanchar Nigam Limited (BSNL) has published a notification for the recruitment of 100 vacancies across technical and administrative roles. Read all details regarding eligibility, important dates, and application steps below.
        </p>
      </div>

      <div class="space-y-8 text-text-main leading-relaxed">
        <h2 id="en-details">Vacancy Details & Eligibility</h2>
        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap"><span class="flex items-center gap-1.5"><HiOutlineDocumentText className="text-primary" /> Post Name</span></th>
                <th class="p-3 border border-border-card font-bold text-text-main">Vacancies</th>
                <th class="p-3 border border-border-card font-bold text-text-main">Qualification</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted">Junior Engineer</td>
                <td class="p-3 border border-border-card text-text-muted">60</td>
                <td class="p-3 border border-border-card text-text-muted">Diploma/B.E./B.Tech (Electronics/Telecom)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted">Admin Officer</td>
                <td class="p-3 border border-border-card text-text-muted">40</td>
                <td class="p-3 border border-border-card text-text-muted">Any Graduation</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="en-important-dates">Important Dates & Apply Links</h2>
        <div class="overflow-x-auto my-6">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">Event</th>
                <th class="p-3 border border-border-card font-bold text-text-main">Date</th>
                <th class="p-3 border border-border-card font-bold text-text-main">Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">Online Application Start Date</td>
                <td class="p-3 border border-border-card text-text-main font-bold whitespace-nowrap">
                  <span class="flex items-center gap-1.5"><HiOutlineCalendarDays className="text-primary text-lg shrink-0" /> 5 June 2026</span>
                </td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto">
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> Apply Now
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">Online Application Last Date</td>
                <td class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap">
                  <span class="flex items-center gap-1.5"><HiOutlineCalendarDays className="text-rose-500 text-lg shrink-0" /> 30 June 2026</span>
                </td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary text-white hover:bg-primary/90 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors shadow-sm shadow-primary/30 w-full sm:w-auto">
                    <HiOutlineArrowTopRightOnSquare className="text-base shrink-0" /> Apply Online
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">Official Notification (PDF)</td>
                <td class="p-3 border border-border-card text-text-main font-bold text-center">-</td>
                <td class="p-3 border border-border-card">
                  <a href="#" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto">
                    <HiOutlineDocumentText className="text-base shrink-0" /> Download PDF
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </article>
</Layout>
