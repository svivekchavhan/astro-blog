        <!-- Salary Table -->
        <h2 id="en-salary" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">Salary Details</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap">Post Name</th>
                <th class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap"><span class="flex items-center gap-1.5"><HiOutlineCurrencyRupee className="text-primary" /> Salary</span></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">Junior Telecom Officer (JTO)</td>
                <td class="p-3 border border-border-card text-text-muted">As per BSNL rules</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Important Dates & Links Table -->
        <h2 id="en-important-dates" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">Important Dates & Apply Links</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
