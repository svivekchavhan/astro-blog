        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap">Post Name</th>
                <th class="p-3 border border-border-card font-bold text-text-main">Total Vacancies</th>
                <th class="p-3 border border-border-card font-bold text-text-main">Age Limit</th>
              </tr>
            </thead>
            <tbody>
              <tr>
