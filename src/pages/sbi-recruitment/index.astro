---
import Layout from "../../layouts/Layout.astro";
import { articlesRegistry } from "../../constants/articles";
import { naukriUpdates } from "../../constants/naukriUpdates";
import {
  HiOutlineCalendarDays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineBell,
  HiOutlineXCircle,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineBriefcase,
  HiOutlineMagnifyingGlass,
  HiOutlineUser,
  HiOutlineCreditCard,
  HiOutlineBanknotes,
  HiOutlineDocumentText,
  HiOutlineChevronDown,
  HiOutlineCursorArrowRays,
  HiOutlineCheckCircle,
  HiOutlineCalculator,
  HiOutlineClock,
  HiOutlineNewspaper
} from "react-icons/hi2";

const title = "SBI Recruitment 2026 - State Bank of India Advertisements, Exam Updates & Apply Links";
const description = "Explore all State Bank of India (SBI) recruitment notifications 2026. Get latest SBI Clerk (Junior Associate), SBI PO, SBI SO, CBO, and Apprentice advertisements, eligibility, exam pattern, syllabus, admit card, results, and direct apply links at mahasandhi.in.";
const canonicalURL = "https://mahasandhi.in/sbi-recruitment";

// SBI Recruitment Stream Cards Data
const sbiRecruitments = [
  {
    id: "sbi-clerk-recruitment-2026",
    streamCategory: "clerk",
    title: "भारतीय स्टेट बँकेत (SBI) लिपिक (Junior Associate) १५३८ जागांसाठी भरती २०२६",
    organisation: "State Bank of India (SBI)",
    vacancies: "1,538 Posts",
    qualification: "Degree in any discipline (Graduate)",
    status: "apply-now",
    lastDate: "27 Aug 2026",
    startDate: "07 Aug 2026",
    ageLimit: "20 to 28 years (SC/ST: +5 yrs, OBC: +3 yrs, PWD: +10-15 yrs)",
    appFee: "General / OBC / EWS: ₹750 | SC / ST / PWD / ExSM: Free",
    salary: "Pay Scale Rs. 17,900 - 47,920 + Allowances (Initial ~Rs. 32,000/pm)",
    syllabus: "Prelims (100 Marks: English 30, Quant 35, Reasoning 35) & Mains Exam (200 Marks) + Local Language Test.",
    applyLink: "https://ibpsreg.ibps.in/sbijasrdjl26/",
    detailLink: "/sbi-clerk-recruitment-2026",
    summaryMr: "भारतीय स्टेट बँकेमध्ये (SBI) लिपिक (Junior Associate - Customer Support & Sales) पदांच्या एकूण १५३८ जागांसाठी ऑनलाईन अर्ज मागवण्यात येत आहेत. कोणत्याही शाखेतील पदवीधर उमेदवार पात्र असून अर्ज करण्याची अंतिम तारीख २७ ऑगस्ट २०२६ आहे.",
    summaryEn: "State Bank of India (SBI) invites online applications for 1,538 Junior Associate (Clerk) positions across India. Graduates in any discipline are eligible. Last date to apply online is August 27, 2026."
  },
  
];

// Filter SBI-related articles from articlesRegistry
const sbiArticles = articlesRegistry.filter(art => {
  const text = `${art.titleEn} ${art.titleMr} ${art.slug} ${art.category}`.toLowerCase();
  return text.includes("sbi") || text.includes("state bank");
});
---

<Layout
  title={`${title} | MahaSandhi.in`}
  description={description}
  canonicalURL={canonicalURL}
>
  <section class="py-2 sm:py-4 pb-16 not-prose px-2 sm:px-4 md:px-0">
    
    <!-- Hero Header Dashboard -->
    <div class="relative bg-bg-surface border border-border-card rounded-2xl sm:rounded-3xl p-4 sm:p-8 md:p-10 mb-6 sm:mb-10 overflow-hidden shadow-xs">
      <div class="absolute -right-16 -top-16 w-48 sm:w-56 h-48 sm:h-56 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-48 sm:w-56 h-48 sm:h-56 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative flex flex-col items-center text-center max-w-[850px] mx-auto">
        <span class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1 sm:py-1.5 rounded-full bg-sky-500/10 border border-sky-500/25 text-sky-600 dark:text-sky-400 text-[0.68rem] sm:text-xs font-bold uppercase tracking-wider mb-3 sm:mb-4 animate-pulse">
          <HiOutlineBuildingOffice className="text-xs sm:text-sm shrink-0" /> State Bank of India Careers Hub
        </span>
        
        <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight text-text-main m-0 leading-tight mb-3 sm:mb-4">
          SBI Recruitment & <span class="gradient-text">Advertisement Hub 2026</span>
        </h1>
        
        <p class="text-text-secondary text-xs sm:text-sm md:text-base leading-relaxed m-0 mb-6 sm:mb-8 max-w-[720px]">
          भारतीय स्टेट बँक (State Bank of India - SBI) अंतर्गत लिपिक (Junior Associate), प्रोबेशनरी ऑफिसर (PO), स्पेशलिस्ट ऑफिसर (SO), सर्कल बेस्ड ऑफिसर (CBO) आणि अप्रेंटिस पदांच्या अधिकृत जाहिराती, ऑनलाईन अर्ज दुवे, निकाल व प्रवेशपत्र अपडेट्स.
        </p>

        <!-- Metrics Dashboard Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 w-full border-t border-border-card dark:border-border-card/30 pt-4 sm:pt-6">
          <div class="text-center p-2 sm:p-2.5 bg-bg-base/40 rounded-xl sm:rounded-2xl border border-border-card/40">
            <span class="block text-lg sm:text-2xl md:text-3xl font-extrabold text-primary tracking-tight">1,538+</span>
            <span class="block text-[0.6rem] sm:text-xs text-text-muted uppercase font-semibold tracking-wider mt-0.5 sm:mt-1">Active Vacancies</span>
          </div>
          <div class="text-center p-2 sm:p-2.5 bg-bg-base/40 rounded-xl sm:rounded-2xl border border-border-card/40">
            <span class="block text-lg sm:text-2xl md:text-3xl font-extrabold text-emerald-500 tracking-tight">5 Streams</span>
            <span class="block text-[0.6rem] sm:text-xs text-text-muted uppercase font-semibold tracking-wider mt-0.5 sm:mt-1">Clerk, PO, SO, CBO</span>
          </div>
          <div class="text-center p-2 sm:p-2.5 bg-bg-base/40 rounded-xl sm:rounded-2xl border border-border-card/40">
            <span class="block text-lg sm:text-2xl md:text-3xl font-extrabold text-amber-500 tracking-tight">Degree</span>
            <span class="block text-[0.6rem] sm:text-xs text-text-muted uppercase font-semibold tracking-wider mt-0.5 sm:mt-1">Min Eligibility</span>
          </div>
          <div class="text-center p-2 sm:p-2.5 bg-bg-base/40 rounded-xl sm:rounded-2xl border border-border-card/40">
            <span class="block text-lg sm:text-2xl md:text-3xl font-extrabold text-sky-500 tracking-tight">IBPS Portal</span>
            <span class="block text-[0.6rem] sm:text-xs text-text-muted uppercase font-semibold tracking-wider mt-0.5 sm:mt-1">Online Apply</span>
          </div>
        </div>

        <!-- Direct Official Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-2.5 sm:gap-3 mt-6 sm:mt-8 w-full sm:w-auto">
          <a
            href="https://ibpsreg.ibps.in/sbijasrdjl26/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 sm:px-5 py-2.5 sm:py-3 bg-primary hover:bg-primary/90 text-white rounded-xl text-[0.7rem] sm:text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-xs shadow-primary/20 no-underline flex items-center justify-center gap-2 text-center"
          >
            <HiOutlineCursorArrowRays className="text-sm sm:text-base shrink-0" /> Direct Apply Portal (SBI Clerk)
          </a>
          <a
            href="https://sbi.co.in/web/careers"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 sm:px-5 py-2.5 sm:py-3 bg-sky-500/10 hover:bg-sky-500/20 text-sky-600 dark:text-sky-400 border border-sky-500/30 rounded-xl text-[0.7rem] sm:text-xs font-bold uppercase tracking-wider transition-all duration-300 no-underline flex items-center justify-center gap-2 text-center"
          >
            <HiOutlineDocumentText className="text-sm sm:text-base shrink-0" /> Official SBI Careers Portal
          </a>
        </div>
      </div>
    </div>

    <!-- Live Category Filter & Search Bar -->
    <div class="bg-bg-surface border border-border-card rounded-2xl p-3.5 sm:p-5 mb-6 sm:mb-8 shadow-xs">
      <div class="flex flex-col gap-3 sm:gap-4">
        
        <!-- Category Filter Tabs (Responsive 2-Column Grid on Mobile, Flex Row on Desktop) -->
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 sm:gap-2.5" id="sbi-category-tabs">
          <button data-cat="all" class="sbi-tab active col-span-2 sm:col-span-1 sm:w-auto px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl text-[0.68rem] sm:text-xs font-bold uppercase tracking-wider transition-all border cursor-pointer border-primary bg-primary text-white text-center justify-center flex items-center shadow-2xs">
            All SBI Exams
          </button>
          <button data-cat="clerk" class="sbi-tab col-span-1 sm:w-auto px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl text-[0.68rem] sm:text-xs font-bold uppercase tracking-wider transition-all border cursor-pointer border-border-card bg-bg-base/50 text-text-muted hover:border-primary/50 hover:text-text-main text-center justify-center flex items-center shadow-2xs">
            SBI Clerk (Junior Associate)
          </button>
          <button data-cat="po" class="sbi-tab col-span-1 sm:w-auto px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl text-[0.68rem] sm:text-xs font-bold uppercase tracking-wider transition-all border cursor-pointer border-border-card bg-bg-base/50 text-text-muted hover:border-primary/50 hover:text-text-main text-center justify-center flex items-center shadow-2xs">
            SBI PO
          </button>
          <button data-cat="cbo-so" class="sbi-tab col-span-1 sm:w-auto px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl text-[0.68rem] sm:text-xs font-bold uppercase tracking-wider transition-all border cursor-pointer border-border-card bg-bg-base/50 text-text-muted hover:border-primary/50 hover:text-text-main text-center justify-center flex items-center shadow-2xs">
            SBI CBO & SO
          </button>
          <button data-cat="apprentice" class="sbi-tab col-span-1 sm:w-auto px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl text-[0.68rem] sm:text-xs font-bold uppercase tracking-wider transition-all border cursor-pointer border-border-card bg-bg-base/50 text-text-muted hover:border-primary/50 hover:text-text-main text-center justify-center flex items-center shadow-2xs">
            SBI Apprentice
          </button>
        </div>

        <!-- Search Input Bar -->
        <div class="relative flex items-center bg-bg-base/60 dark:bg-black/20 border border-border-card rounded-xl px-3.5 sm:px-4 py-2.5 sm:py-3 focus-within:border-primary transition-all duration-300">
          <HiOutlineMagnifyingGlass className="text-text-muted text-base sm:text-lg mr-2.5 sm:mr-3 shrink-0" />
          <input 
            type="text" 
            placeholder="Search SBI recruitment post, clerk, PO, syllabus, qualification or details..." 
            id="sbi-search"
            class="bg-transparent border-none text-text-main font-sans text-xs sm:text-sm outline-none w-full placeholder-text-muted/65"
          />
        </div>

      </div>
    </div>

    <!-- Active SBI Recruitment Stream Cards List -->
    <div class="mb-10 sm:mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 mb-3 sm:mb-4">
        <h2 class="text-lg sm:text-xl md:text-2xl font-black text-text-main m-0 flex items-center gap-2">
          <HiOutlineBriefcase className="text-primary shrink-0" /> Active SBI Recruitment Advertisements
        </h2>
        <span class="text-[0.65rem] sm:text-xs text-text-muted font-semibold">Updated August 2026</span>
      </div>

      <div class="space-y-3.5 sm:space-y-4" id="sbi-cards-container">
        {sbiRecruitments.map((job) => (
          <div 
            data-id={job.id}
            data-cat={job.streamCategory}
            data-title={job.title.toLowerCase()}
            data-qual={job.qualification.toLowerCase()}
            class="sbi-job-card bg-bg-surface border border-border-card rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary hover:shadow-xs"
          >
            <!-- Card Header Row -->
            <div class="p-4 sm:p-5 flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-4 cursor-pointer select-none sbi-card-header">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2 mb-2 flex-wrap">
                  <span class="text-[0.55rem] sm:text-[0.6rem] bg-sky-500/10 text-sky-600 dark:text-sky-400 px-2 sm:px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-sky-500/20 whitespace-nowrap">
                    {job.organisation}
                  </span>

                  {job.status === "apply-now" && (
                    <span class="text-[0.55rem] sm:text-[0.6rem] bg-emerald-500/10 text-emerald-500 px-2 sm:px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-emerald-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full shadow-[0_0_6px] shadow-emerald-500 animate-pulse inline-block"></span>
                      Online Apply Active
                    </span>
                  )}

                  {job.status === "upcoming" && (
                    <span class="text-[0.55rem] sm:text-[0.6rem] bg-amber-500/10 text-amber-500 px-2 sm:px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-amber-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 bg-amber-500 rounded-full animate-pulse inline-block"></span>
                      Upcoming Notification
                    </span>
                  )}

                  {job.status === "active-updates" && (
                    <span class="text-[0.55rem] sm:text-[0.6rem] bg-blue-500/10 text-blue-500 px-2 sm:px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide border border-blue-500/20 flex items-center gap-1 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 bg-blue-500 rounded-full inline-block"></span>
                      Ongoing Updates
                    </span>
                  )}
                </div>

                <h3 class="text-base sm:text-lg md:text-xl text-text-main font-bold leading-snug sm:leading-tight mb-2 m-0 group-hover:text-primary transition-colors">
                  {job.title}
                </h3>
                
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[0.7rem] sm:text-xs text-text-muted">
                  <span class="flex items-center gap-1"><HiOutlineAcademicCap className="text-primary/70 shrink-0 text-xs sm:text-sm" /> {job.qualification}</span>
                  <span class="flex items-center gap-1"><HiOutlineCalendarDays className="text-rose-500 shrink-0 text-xs sm:text-sm" /> Last Date: <strong>{job.lastDate}</strong></span>
                </div>
              </div>

              <!-- Vacancies Badge & Collapsible Button -->
              <div class="flex items-center justify-between md:justify-end gap-2.5 sm:gap-3 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-border-card/30">
                <div class="bg-primary/5 border border-primary/20 rounded-xl px-3 sm:px-3.5 py-1.5 sm:py-2 text-center min-w-[90px] sm:min-w-[110px]">
                  <span class="block text-[0.5rem] sm:text-[0.55rem] text-text-muted uppercase tracking-wider font-semibold">Vacancies</span>
                  <span class="block text-xs sm:text-sm font-black text-primary mt-0.5">{job.vacancies}</span>
                </div>

                <!-- Chevron Toggle Button -->
                <button 
                  type="button"
                  aria-label="Toggle SBI Stream Details" 
                  class="w-8 sm:w-9 h-8 sm:h-9 flex items-center justify-center border border-border-card rounded-full text-text-muted hover:text-primary hover:border-primary transition-colors cursor-pointer sbi-chevron-btn shrink-0"
                >
                  <HiOutlineChevronDown className="text-base sm:text-lg transition-transform duration-300" />
                </button>
              </div>
            </div>

            <!-- Slide Drawer Container -->
            <div class="sbi-drawer max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out border-t border-border-card/0">
              <div class="p-4 sm:p-6 bg-bg-base/30 dark:bg-black/10 space-y-4 sm:space-y-6">
                
                <!-- Info Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
                  <div class="bg-bg-surface border border-border-card rounded-xl p-3.5 sm:p-4 flex gap-3">
                    <div class="w-8 sm:w-10 h-8 sm:h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                      <HiOutlineUser className="text-lg sm:text-xl" />
                    </div>
                    <div>
                      <span class="block text-[0.6rem] sm:text-[0.65rem] text-text-muted uppercase tracking-wider font-bold mb-0.5">Age Limit</span>
                      <p class="text-xs text-text-main m-0 leading-relaxed font-semibold">{job.ageLimit}</p>
                    </div>
                  </div>

                  <div class="bg-bg-surface border border-border-card rounded-xl p-3.5 sm:p-4 flex gap-3">
                    <div class="w-8 sm:w-10 h-8 sm:h-10 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
                      <HiOutlineBanknotes className="text-lg sm:text-xl" />
                    </div>
                    <div>
                      <span class="block text-[0.6rem] sm:text-[0.65rem] text-text-muted uppercase tracking-wider font-bold mb-0.5">Pay Scale / Salary</span>
                      <p class="text-xs text-text-main m-0 leading-relaxed font-semibold">{job.salary}</p>
                    </div>
                  </div>

                  <div class="bg-bg-surface border border-border-card rounded-xl p-3.5 sm:p-4 flex gap-3">
                    <div class="w-8 sm:w-10 h-8 sm:h-10 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
                      <HiOutlineCreditCard className="text-lg sm:text-xl" />
                    </div>
                    <div>
                      <span class="block text-[0.6rem] sm:text-[0.65rem] text-text-muted uppercase tracking-wider font-bold mb-0.5">Application Fee</span>
                      <p class="text-xs text-text-main m-0 leading-relaxed font-semibold">{job.appFee}</p>
                    </div>
                  </div>
                </div>

                <!-- Exam Pattern & Summary Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
                  <div class="bg-bg-surface border border-border-card rounded-xl p-3.5 sm:p-4">
                    <h4 class="text-[0.68rem] sm:text-xs uppercase tracking-wider font-extrabold text-primary flex items-center gap-1.5 mt-0 mb-2.5 sm:mb-3 border-none pb-0">
                      <HiOutlineDocumentText className="text-sm sm:text-base shrink-0" /> Exam Pattern & Selection Process
                    </h4>
                    <p class="text-xs text-text-secondary leading-relaxed m-0">{job.syllabus}</p>
                  </div>

                  <div class="bg-bg-surface border border-border-card rounded-xl p-3.5 sm:p-4">
                    <div class="flex items-center justify-between border-b border-border-card dark:border-border-card/30 pb-2 mb-2.5 sm:mb-3">
                      <span class="text-[0.68rem] sm:text-xs uppercase tracking-wider font-extrabold text-primary border-none pb-0 flex items-center gap-1.5">
                        📝 Overview
                      </span>
                      <div class="flex gap-1.5 sm:gap-2">
                        <button data-lang="mr" class="sbi-lang-switch active px-2 sm:px-2.5 py-0.5 rounded text-[0.6rem] sm:text-[0.65rem] font-bold uppercase tracking-wider cursor-pointer border border-primary/20 transition-all">मराठी</button>
                        <button data-lang="en" class="sbi-lang-switch px-2 sm:px-2.5 py-0.5 rounded text-[0.6rem] sm:text-[0.65rem] font-bold uppercase tracking-wider cursor-pointer border border-border-card text-text-muted hover:border-primary/50 transition-all">English</button>
                      </div>
                    </div>

                    <div class="summary-box">
                      <p class="mr-desc text-xs text-text-secondary leading-relaxed m-0 font-medium">{job.summaryMr}</p>
                      <p class="en-desc text-xs text-text-secondary leading-relaxed m-0 font-medium hidden">{job.summaryEn}</p>
                    </div>
                  </div>
                </div>

                <!-- Action Footer Buttons -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-2.5 sm:gap-3 border-t border-border-card/40 pt-3.5 sm:pt-4">
                  {job.detailLink !== "/sbi-recruitment" && (
                    <a 
                      href={job.detailLink}
                      class="px-4 py-2 sm:py-2 bg-primary/10 hover:bg-primary/20 text-primary border border-primary/20 hover:border-primary/40 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 no-underline flex items-center justify-center gap-1.5 text-center"
                    >
                      Read Full Article <HiOutlineArrowTopRightOnSquare className="text-sm shrink-0" />
                    </a>
                  )}

                  {job.status === "apply-now" && (
                    <a 
                      href={job.applyLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-5 py-2 sm:py-2 bg-primary hover:bg-primary/90 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 no-underline flex items-center justify-center gap-1.5 shadow-xs text-center"
                    >
                      <HiOutlineCursorArrowRays className="text-sm shrink-0" /> Apply Online Now
                    </a>
                  )}
                </div>

              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- No Match Container -->
      <div id="sbi-no-results" class="text-center py-12 sm:py-16 bg-bg-surface border border-border-card rounded-2xl hidden mt-4">
        <p class="text-text-muted text-xs sm:text-sm m-0">No SBI recruitment matches your selected filter or search query.</p>
      </div>
    </div>

    <!-- SBI Related Articles & Notifications Timeline -->
    <div class="mb-10 sm:mb-12">
      <div class="flex items-center justify-between mb-3 sm:mb-4">
        <h2 class="text-lg sm:text-xl md:text-2xl font-black text-text-main m-0 flex items-center gap-2">
          <HiOutlineNewspaper className="text-primary shrink-0" /> Latest SBI Articles & Official Updates
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4">
        {sbiArticles.map(art => (
          <div class="bg-bg-surface border border-border-card rounded-2xl p-4 sm:p-5 hover:border-primary transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[0.55rem] sm:text-[0.6rem] bg-primary/10 text-primary px-2 sm:px-2.5 py-0.5 rounded font-bold uppercase tracking-wider border border-primary/20">
                  {art.category || "SBI Update"}
                </span>
                <span class="text-[0.68rem] sm:text-xs text-text-muted font-medium flex items-center gap-1">
                  <HiOutlineClock className="text-xs text-primary/70" /> {art.date}
                </span>
              </div>
              <a href={art.slug} class="no-underline group">
