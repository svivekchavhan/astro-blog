<style>
  .sbi-tab.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.25);
  }
  
  .sbi-lang-switch.active {
    background-color: rgba(56, 189, 248, 0.15);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .sbi-drawer.expanded {
    max-height: 1200px;
    opacity: 1;
    border-color: var(--color-border-card);
  }
</style>

<script>
  function initSbiPillarPage() {
    const cards = document.querySelectorAll(".sbi-job-card") as NodeListOf<HTMLDivElement>;
    if (cards.length === 0) return;

    const tabsContainer = document.getElementById("sbi-category-tabs");
    const searchInput = document.getElementById("sbi-search") as HTMLInputElement;
    const noResults = document.getElementById("sbi-no-results");

    let activeCategory = "all";
    let searchQuery = "";

    function filterSbiJobs() {
      let count = 0;

      cards.forEach(card => {
        const cat = card.dataset.cat || "";
        const title = card.dataset.title || "";
        const qual = card.dataset.qual || "";

        const matchesCat = (activeCategory === "all" || cat === activeCategory);
        const matchesQuery = (
          title.includes(searchQuery) ||
          qual.includes(searchQuery) ||
          cat.includes(searchQuery)
        );

        if (matchesCat && matchesQuery) {
          card.classList.remove("hidden");
          count++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (noResults) {
        if (count === 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }
    }

    // Bind Category Tabs
    if (tabsContainer) {
      const tabs = tabsContainer.querySelectorAll(".sbi-tab");
      tabs.forEach(tab => {
        tab.addEventListener("click", () => {
          tabs.forEach(t => {
            t.classList.remove("active", "bg-primary", "text-white", "border-primary");
            t.classList.add("bg-bg-base/50", "text-text-muted", "border-border-card");
          });

          tab.classList.add("active", "bg-primary", "text-white", "border-primary");
          tab.classList.remove("bg-bg-base/50", "text-text-muted", "border-border-card");

          activeCategory = tab.getAttribute("data-cat") || "all";
          filterSbiJobs();
        });
      });
    }

    // Bind Search Input
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterSbiJobs();
      });
    }

    // Accordion Drawer & Language Switches
    cards.forEach(card => {
      const header = card.querySelector(".sbi-card-header");
      const drawer = card.querySelector(".sbi-drawer");
      const chevron = card.querySelector(".sbi-chevron-btn svg");

      if (header && drawer) {
        header.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (target.closest("a") || target.closest("button:not(.sbi-chevron-btn)")) {
            return;
          }

          const isExpanded = drawer.classList.contains("expanded");

          cards.forEach(c => {
            const d = c.querySelector(".sbi-drawer");
            const ch = c.querySelector(".sbi-chevron-btn svg");
            if (d && d !== drawer) {
              d.classList.remove("expanded");
              if (ch) (ch as HTMLElement).style.transform = "rotate(0deg)";
            }
          });

          if (isExpanded) {
            drawer.classList.remove("expanded");
            if (chevron) (chevron as HTMLElement).style.transform = "rotate(0deg)";
          } else {
            drawer.classList.add("expanded");
            if (chevron) (chevron as HTMLElement).style.transform = "rotate(180deg)";
          }
        });
      }

      // Bilingual toggle
      const mrBtn = card.querySelector('[data-lang="mr"]');
      const enBtn = card.querySelector('[data-lang="en"]');
      const mrDesc = card.querySelector(".mr-desc");
      const enDesc = card.querySelector(".en-desc");

      if (mrBtn && enBtn && mrDesc && enDesc) {
        mrBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          mrBtn.classList.add("active");
          enBtn.classList.remove("active");
          mrDesc.classList.remove("hidden");
          enDesc.classList.add("hidden");
        });

        enBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          enBtn.classList.add("active");
          mrBtn.classList.remove("active");
          enDesc.classList.remove("hidden");
          mrDesc.classList.add("hidden");
        });
      }
    });
  }

  document.addEventListener("astro:page-load", initSbiPillarPage);
</script>
