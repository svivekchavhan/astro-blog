---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import { 
  HiOutlineCalendarDays, 
  HiOutlineCursorArrowRays,
  HiOutlineArrowTopRightOnSquare,
  HiOutlineDocumentText,
  HiOutlineCurrencyRupee,
  HiOutlineMapPin,
  HiOutlineAcademicCap,
  HiOutlineBriefcase
} from "react-icons/hi2";

const title = "HPCL Bharti 2026: हिंदुस्तान पेट्रोलियम मध्ये 116 जागांसाठी भरती";
const description = "Hindustan Petroleum Corporation Limited (HPCL) Recruitment 2026: Apply Online for 116 Junior Executive, Senior Officer, and Manager Vacancies. Read eligibility criteria, pay scale, and dates.";
const canonicalURL = "https://mahasandhi.in/hpcl-recruitment-2026";
const date = "July 02, 2026";
const category = "Latest Job";
---

<Layout 
  title={title} 
  description={description}
  canonicalURL={canonicalURL}
  image="https://images.unsplash.com/photo-1513828742140-ccaa34f3fd07?auto=format&fit=crop&q=80&w=1200"
  article={true}
  customBreadcrumbs={[
    { name: "Current Recruitment", url: "/current-recruitment" },
    { name: "HPCL Recruitment" }
  ]}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
          >{category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a href="#marathi-version" class="text-primary font-bold text-sm hover:underline">↓ मराठी आवृत्ती (Marathi Version)</a>
      <span class="text-text-muted">|</span>
      <a href="#english-version" class="text-primary font-bold text-sm hover:underline">↓ English Version</a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">हिंदुस्तान पेट्रोलियम कॉर्पोरेशन लिमिटेड (HPCL) भरती २०२६</h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Introduction:</strong> हिंदुस्तान पेट्रोलियम कॉर्पोरेशन लिमिटेड (HPCL) ने ज्युनियर एक्झिक्युटिव, सिनियर ऑफिसर, असिस्टंट मॅनेजर, मॅनेजर आणि चीफ मॅनेजरसह विविध विभागांतील <strong>११६ रिक्त जागांसाठी</strong> mega भरतीची घोषणा केली आहे. या संदर्भातील पात्रता, वयोमर्यादा, पगार आणि अर्जाबद्दलची संपूर्ण माहिती खालीलप्रमाणे उपलब्ध करून देण्यात आली आहे.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineDocumentText className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">जाहिरात क्र. (Advt No.)</span>
              <span class="text-text-main font-semibold text-sm">HPCL/OPEN/HR/1/2026-27</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineMapPin className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">नोकरीचे ठिकाण (Job Location)</span>
              <span class="text-text-main font-semibold text-sm">संपूर्ण भारत (All India)</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineCurrencyRupee className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">अर्ज शुल्क (Application Fees)</span>
              <span class="text-text-main font-semibold text-sm">खुला/OBC/EWS: ₹११Values | SC/ST/PwD: फी नाही</span>
            </div>
          </div>
        </div>

        <!-- Post Details & Education Qualification Table -->
        <h2 id="details" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">पदांचे नाव आणि शैक्षणिक पात्रता (Post Details & Eligibility)</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main whitespace-nowrap">पद क्र.</th>
                <th class="p-3 border border-border-card font-bold text-text-main">पदाचे नाव (Post Name)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">जागा</th>
                <th class="p-3 border border-border-card font-bold text-text-main">शैक्षणिक पात्रता व अनुभव (Educational Qualifications)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">१</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">ज्युनियर एक्झिक्युटिव – Chemical</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">३७</td>
                <td class="p-3 border border-border-card text-text-muted">केमिकल इंजिनिअरिंग डिप्लोमा (Chemical Engineering Diploma)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">२</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">ज्युनियर एक्झिक्युटिव – फायर अॅण्ड सेफ्टी</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">१७</td>
                <td class="p-3 border border-border-card text-text-muted">(i) B.Sc पदवी (ii) फायर सेफ्टी डिप्लोमा (iii) अवजड वाहन चालक परवाना (HMV License)</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">३</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">सिनियर ऑफिसर - सेल्स (Retail / Lubes / Direct Sales / LPG)</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">५२</td>
                <td class="p-3 border border-border-card text-text-muted">(i) इंजिनिअरिंग पदवी (Mechanical/Electrical/Instrumentation/Civil/Chemical) (ii) MBA/PGDM (iii) ०२ वर्षे अनुभव</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">४ & ५</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">असिस्टंट मॅनेजर / मॅनेजर – प्रोजेक्ट्स</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">०५</td>
                <td class="p-3 border border-border-card text-text-muted">(i) सिव्हिल इंजिनिअरिंग पदवी (ii) असिस्टंट मॅनेजरसाठी ६ वर्षे आणि मॅनेजरसाठी ९ वर्षे अनुभव</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">६ & ७</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">चीफ मॅनेजर / डेप्युटी जनरल मॅनेजर – टेक्निकल सर्व्हिसेस (Specialty Chemicals)</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">०१</td>
                <td class="p-3 border border-border-card text-text-muted">(i) केमिकल इंजिनिअरिंग पदवी (ii) चीफ मॅनेजरसाठी १५ वर्षे आणि डेप्युटी जनरल मॅनेजरसाठी १८ वर्षे अनुभव</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">८, ९ & १०</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">सिनियर मॅनेजर / चीफ मॅनेजर / डेप्युटी जनरल मॅनेजर – इकॉनॉमिस्ट</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">०१</td>
                <td class="p-3 border border-border-card text-text-muted">(i) अर्थशास्त्र/उपयोजित अर्थशास्त्र/ऊर्जा नियोजन किंवा तत्सम विषयातील पदव्युत्तर पदवी (ii) संबंधित क्षेत्रात १२ ते १८ वर्षांचा अनुभव</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">११ & १२</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">डेप्युटी जनरल मॅनेजर / जनरल मॅनेजर – गॅस सोर्सिंग अॅण्ड मार्केटिंग</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">०२</td>
                <td class="p-3 border border-border-card text-text-muted">(i) कोणतीही इंजिनिअरिंग पदवी (ii) संबंधित पदांनुसार १८ ते २१ वर्षांचा अनुभव</td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium text-center">१३, १४ & १५</td>
                <td class="p-3 border border-border-card text-text-muted font-medium">डेप्युटी जनरल मॅनेजर / जनरल मॅनेजर / चीफ जनरल मॅनेजर – सेल्स & मार्केटिंग</td>
                <td class="p-3 border border-border-card text-text-muted font-bold text-center">०१</td>
                <td class="p-3 border border-border-card text-text-muted">(i) केमिकल इंजिनिअरिंग पदवी (ii) संबंधित पदांनुसार १८ ते २४ वर्षांचा अनुभव</td>
              </tr>
              <tr class="bg-primary/5">
                <td colspan="2" class="p-3 border border-border-card font-bold text-text-main text-right">एकूण पदे</td>
                <td class="p-3 border border-border-card font-bold text-primary text-center">११६</td>
                <td class="p-3 border border-border-card"></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Age Limit & Relxations -->
        <h2 id="age-limit" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">वयोमर्यादा (Age Limit)</h2>
        <div class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm">
          <p class="m-0 font-bold mb-2">वय मोजण्याचा दिनांक: २० जुलै २०२६ रोजी [SC/ST: ०५ वर्षे सूट, OBC: ०३ वर्षे सूट]</p>
          <ul class="list-disc pl-5 m-0 space-y-1.5 text-text-muted">
            <li><strong>पद क्र. १ & २:</strong> २५ वर्षांपर्यंत</li>
            <li><strong>पद क्र. ३:</strong> २९ वर्षांपर्यंत</li>
            <li><strong>पद क्र. ४:</strong> ३१ वर्षांपर्यंत</li>
            <li><strong>पद क्र. ५:</strong> ३४ वर्षांपर्यंत</li>
            <li><strong>पद क्र. ८:</strong> ४२ वर्षांपर्यंत</li>
            <li><strong>पद क्र. ६ & ९:</strong> ४५ वर्षांपर्यंत</li>
            <li><strong>पद क्र. ७, १०, ११ & १३:</strong> ४८ वर्षांपर्यंत</li>
            <li><strong>पद क्र. १२ &  १४:</strong> ५१ वर्षांपर्यंत</li>
            <li><strong>पद क्र. १५:</strong> ५४ वर्षांपर्यंत</li>
          </ul>
        </div>

        <!-- Important Dates & Links Table -->
        <h2 id="important-dates" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">{translateMarathi("महत्त्वाच्या तारखा आणि लिंक्स (Important Dates & Links)")}</h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="p-3 border border-border-card font-bold text-text-main">तपशील (Event)</th>
                <th class="p-3 border border-border-card font-bold text-text-main">तारीख / लिंक (Date / Action)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">ऑनलाइन अर्ज करण्याची शेवटची तारीख (Last Date)</td>
                <td class="p-3 border border-border-card text-rose-500 font-bold whitespace-nowrap">
                  <span class="flex items-center gap-1.5"><HiOutlineCalendarDays className="text-rose-500 text-lg shrink-0" /> २० जुलै २०२६ (दुपारी ०३:०० वाजेपर्यंत)</span>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">अधिकृत जाहिरात (Official Notification PDF)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://www.hindustanpetroleum.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-amber-500/30 w-full sm:w-auto">
                    <HiOutlineDocumentText className="text-base shrink-0" /> जाहिरात (PDF) डाउनलोड
                  </a>
                </td>
              </tr>
              <tr>
                <td class="p-3 border border-border-card text-text-muted font-medium">ऑनलाइन अर्ज लिंक (Apply Online)</td>
                <td class="p-3 border border-border-card">
                  <a href="https://www.hindustanpetroleum.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto">
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> अर्ज करा (Apply Now)
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section -->
        <h2 id="faq" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">वारंवार विचारले जाणारे प्रश्न (FAQ)</h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">प्रश्न १: HPCL भरती २०२६ साठी ऑनलाइन अर्ज करण्याची शेवटची तारीख काय आहे?</h3>
            <p class="text-text-muted text-xs m-0">उत्तर: अर्ज करण्याची अंतिम तारीख २० जुलै २०२६ रोजी दुपारी ०३:०० वाजेपर्यंत आहे.</p>
          </div>
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">प्रश्न २: अनुसूचित जाती (SC), अनुसूचित जमाती (ST) आणि दिव्यांग (PwD) उमेदवारांसाठी किती फी आहे?</h3>
            <p class="text-text-muted text-xs m-0">उत्तर: या प्रवर्गातील उमेदवारांना कोणतीही अर्ज फी लागू नाही. खुल्या, OBC आणि EWS प्रवर्गातील उमेदवारांसाठी अर्ज फी ₹१,१८०/- निश्चित केली आहे.</p>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="bg-primary/5 border border-primary/20 p-8 rounded-3xl text-center my-8">
          <h2 class="text-xl font-black text-text-main mb-4 border-none p-0 mt-0">ताज्या अपडेट्ससाठी जॉईन करा!</h2>
          <p class="text-text-muted mb-6 text-sm">सर्व भरती आणि शासकीय नोकरी अपडेट्स थेट मोबाईलवर मिळवण्यासाठी सामील व्हा.</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="https://chat.whatsapp.com" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm">
              WhatsApp Group
            </a>
            <a href="https://t.me" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold uppercase tracking-wider rounded-xl transition-colors shadow-sm">
              Telegram Channel
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- ================= LANGUAGE SEPARATOR ================= -->
    <div class="my-16 border-t-2 border-dashed border-border-card flex items-center justify-center relative">
      <span class="absolute bg-bg-base px-8 py-2 text-base sm:text-lg font-extrabold uppercase tracking-widest text-primary border border-border-card rounded-full shadow-md">
        English
      </span>
    </div>

    <!-- ================= ENGLISH VERSION ================= -->
    <div id="english-version" class="opacity-95">
      <div class="space-y-6 text-text-main leading-relaxed">
        
        <h2 id="main-keyword-en" class="text-2xl font-bold mt-2">HPCL Junior Executive, Senior Officer & Manager Recruitment 2026</h2>

        <!-- Key Information -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineDocumentText className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">Authority</span>
              <span class="text-text-main font-semibold text-sm">Hindustan Petroleum Corporation Ltd (HPCL)</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineMapPin className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">Job Location</span>
              <span class="text-text-main font-semibold text-sm">All India</span>
            </div>
          </div>
          <div class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3">
            <HiOutlineCurrencyRupee className="text-primary text-2xl shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-text-muted block uppercase font-bold tracking-wider">Application Fee</span>
              <span class="text-text-main font-semibold text-sm">General/OBC/EWS: ₹1180 | SC/ST/PwD: Exempted</span>
            </div>
          </div>
        </div>

        <!-- Vacancy Details Table -->
        <h2 id="en-details" class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3">Vacancy Distribution & Eligibility</h2>
        <div class="overflow-x-auto mt-3 mb-8">
