---
import Layout from "../layouts/Layout.astro";
import { translateMarathi } from "../utils/wordLibrary";
import { OFFICIAL_LINKS } from "../constants/links";
import {
  HiOutlineCalendarDays,
  HiOutlineCursorArrowRays,
  HiOutlineDocumentText,
  HiOutlineBuildingOffice,
  HiOutlineAcademicCap,
  HiOutlineCheckCircle,
  HiOutlineClock,
  HiOutlineMegaphone,
  HiOutlineCalculator,
} from "react-icons/hi2";

const title =
  "महाज्योति व वनार्टी मोफत स्पर्धा परीक्षा पूर्व प्रशिक्षण २०२६: चाळणी परीक्षा वेळापत्रक जाहीर (Mahajyoti & Vanarti Screening Test Timetable)";
const description =
  "Mahajyoti & VANARTI Free Coaching Screening Test Timetable 2026: महात्मा जोतिबा फुले संशोधन व प्रशिक्षण संस्था (महाज्योति) आणि वसंतराव नाईक संशोधन व प्रशिक्षण संस्था (वनार्टी), नागपूर द्वारे सन २०२६-२७ या आर्थिक वर्षात राबविण्यात येणाऱ्या MPSC Combined Group B & C, Army Soldier Recruitment, UPSC Civil Services, MPSC Rajyaseva, Maharashtra Engineering Services व Gowari Community Special Coaching चाळणी परीक्षांचे वेळापत्रक जाहीर. परीक्षा ०७, ०८ व ०९ ऑक्टोबर २०२६ रोजी होणार.";
const canonicalURL =
  "https://mahasandhi.in/mahajyoti-vanarti-screening-test-timetable-2026";
const date = "October 06, 2026";
const category = "Exam Alert";
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  article={true}
  customBreadcrumbs={[
    { name: "Naukri Updates", url: "/naukri-updates" },
    { name: "Mahajyoti & Vanarti Screening Test Timetable 2026" },
  ]}
>
  <article class="py-8">
    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="bg-rose-500/10 text-rose-600 dark:text-rose-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-rose-500/20"
        >
          {category}
        </span>
        <span class="text-text-muted text-sm">• {date}</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-text-main mb-6 leading-[1.25]"
      >
        {title}
      </h1>
      <p
        class="text-text-muted text-lg leading-relaxed border-l-4 border-primary pl-6 py-2 italic"
      >
        {description}
      </p>
    </div>

    <!-- Quick Language Navigation Links -->
    <div class="flex gap-4 mb-8">
      <a
        href="#marathi-version"
        class="text-primary font-bold text-sm hover:underline"
      >
        ↓ मराठी आवृत्ती (Marathi Version)
      </a>
      <span class="text-text-muted">|</span>
      <a
        href="#english-version"
        class="text-primary font-bold text-sm hover:underline"
      >
        ↓ English Version
      </a>
    </div>

    <!-- ================= MARATHI VERSION ================= -->
    <div id="marathi-version">
      <div class="space-y-6 text-text-main leading-relaxed">
        <h2 id="main-keyword-mr" class="text-2xl font-bold mt-2">
          महात्मा जोतिबा फुले संशोधन व प्रशिक्षण संस्था (महाज्योति) व वसंतराव नाईक संशोधन व प्रशिक्षण संस्था (वनार्टी), नागपूर - स्पर्धा परीक्षा चाळणी परीक्षा वेळापत्रक २०२६-२७
        </h2>

        <!-- Introduction -->
        <div class="mb-6">
          <p>
            <strong>Mahajyoti & VANARTI Free Coaching Screening Test Timetable 2026:</strong> इतर मागास बहुजन कल्याण विभाग, महाराष्ट्र राज्य अंतर्गत नागपूर येथे कार्यरत <strong>महात्मा जोतिबा फुले संशोधन व प्रशिक्षण संस्था (महाज्योति)</strong> आणि <strong>वसंतराव नाईक संशोधन व प्रशिक्षण संस्था (वनार्टी)</strong> यांच्यामार्फत सन २०२६-२७ या आर्थिक वर्षात राबविण्यात येणाऱ्या विविध स्पर्धा परीक्षा पूर्व प्रशिक्षण योजनांकरिता घेण्यात येणाऱ्या <strong>चाळणी परीक्षांचे (Screening Tests) अधिकृत वेळापत्रक</strong> जाहीर करण्यात आले आहे (जा.क्र. परीक्षांचा वेळापत्रक/1655/2026-27, दिनांक १५/०९/२०२६).
          </p>
          <p>
            या वेळापत्रकानुसार <strong>०७ ऑक्टोबर २०२६, ०८ ऑक्टोबर २०२६ आणि ०९ ऑक्टोबर २०२६</strong> या तीन दिवशी महाराष्ट्रातील विविध केंद्रांवर MPSC संयुक्त गट ब व क, लष्कराज्यातील सैनिक भरती, संघ लोकसेवा आयोग (UPSC), MPSC राज्यसेवा, महाराष्ट्र अभियांत्रिकी सेवा आणि भटक्या जमाती क व विशेष मागास प्रवर्गातील गोवारी समाजातील विद्यार्थ्यांसाठी विशेष पूर्व प्रशिक्षणाच्या चाळणी परीक्षा विविध सत्रांमध्ये आयोजित करण्यात आल्या आहेत.
          </p>
          <hr class="border-border-card my-6" />
        </div>

        <!-- Key Information Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineBuildingOffice
              className="text-primary text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
              >
                आयोजक संस्था
              </span>
              <span class="text-text-main font-semibold text-sm">
                महाज्योति (Mahajyoti) व वनार्टी (VANARTI), नागपूर
              </span>
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineCalendarDays
              className="text-rose-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
              >
                परीक्षेच्या तारखा
              </span>
              <span
                class="text-rose-600 dark:text-rose-400 font-extrabold text-sm"
              >
                ०७, ०८ व ०९ ऑक्टोबर २०२६
              </span>
            </div>
          </div>
          <div
            class="bg-bg-surface border border-border-card p-4 rounded-xl flex items-start gap-3"
          >
            <HiOutlineAcademicCap
              className="text-emerald-500 text-2xl shrink-0 mt-0.5"
            />
            <div>
              <span
                class="text-xs text-text-muted block uppercase font-bold tracking-wider"
              >
                प्रशिक्षण सत्र
              </span>
              <span class="text-text-main font-semibold text-sm">
                आर्थिक वर्ष २०२६-२७ मोफत पूर्व प्रशिक्षण
              </span>
            </div>
          </div>
        </div>

        <!-- Timetable Details Table -->
        <h2
          id="timetable-details-mr"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          चाळणी परीक्षांचे सविस्तर वेळापत्रक (Exam Schedule 07 to 09 October 2026)
        </h2>

        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center w-16"
                >
                  अ.क्र.
                </th>
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                >
                  प्रशिक्षणाचे नाव (Coaching Scheme Name)
                </th>
                <th
                  class="p-3 border border-border-card font-bold text-text-main text-center"
                >
                  दिनांक व परीक्षा वेळ (Date, Time Slot & Duration)
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-card/30">
              <tr class="bg-primary/5">
                <td class="p-3 border border-border-card text-center font-bold">
                  १
                </td>
                <td class="p-3 border border-border-card font-semibold text-text-main">
                  <strong>महाराष्ट्र लोकसेवा आयोग संयुक्त गट ब व क</strong>
                  <br />
                  <span class="text-xs text-text-muted font-normal">
                    (MPSC Combined Group B & Group C Coaching)
                  </span>
                </td>
                <td class="p-3 border border-border-card font-medium text-text-main">
                  <div class="space-y-1 text-xs sm:text-sm">
                    <p class="m-0">
                      • <strong>दि. ०७/१०/२०२६:</strong> सकाळी ०९.०० AM ते ११.०० AM (१२० मिनीटे)
                    </p>
                    <p class="m-0">
                      • <strong>दि. ०७/१०/२०२६:</strong> दुपारी १२.०० PM ते ०२.०० PM (१२० मिनीटे)
                    </p>
                    <p class="m-0">
                      • <strong>दि. ०७/१०/२०२६:</strong> दुपारी ०३.०० PM ते ०५.०० PM (१२० मिनीटे)
                    </p>
                    <p class="m-0">
                      • <strong>दि. ०८/१०/२०२६:</strong> सकाळी ०९.०० AM ते ११.०० AM (१२० मिनीटे)
                    </p>
                    <p class="m-0">
                      • <strong>दि. ०८/१०/२०२६:</strong> दुपारी १२.०० PM ते ०२.०० PM (१२० मिनीटे)
                    </p>
                  </div>
                </td>
              </tr>
              <tr class="bg-amber-500/5">
                <td class="p-3 border border-border-card text-center font-bold">
                  २
                </td>
                <td class="p-3 border border-border-card font-semibold text-text-main">
                  <strong>लष्कराज्यातील सैनिक भरती</strong>
                  <br />
                  <span class="text-xs text-text-muted font-normal">
                    (Army / Military Soldier Bharti Pre-Training)
                  </span>
                </td>
                <td class="p-3 border border-border-card font-medium text-text-main">
                  <p class="m-0 text-xs sm:text-sm">
                    • <strong>दि. ०८/१०/२०२६:</strong> दुपारी ०३.०० PM ते ०४.०० PM (६० मिनीटे)
                  </p>
                </td>
              </tr>
              <tr class="bg-emerald-500/5">
                <td class="p-3 border border-border-card text-center font-bold">
                  ३
                </td>
                <td class="p-3 border border-border-card font-semibold text-text-main">
                  <ol class="list-decimal pl-4 m-0 space-y-1 text-xs sm:text-sm">
                    <li><strong>संघ लोकसेवा आयोग प्रशिक्षण (UPSC)</strong></li>
                    <li><strong>महाराष्ट्र लोकसेवा आयोग (राज्यसेवा) प्रशिक्षण (MPSC Rajyaseva)</strong></li>
                    <li><strong>महाराष्ट्र अभियांत्रिकी सेवा प्रशिक्षण (Maharashtra Engineering Services)</strong></li>
                    <li><strong>भटक्या जमाती क आणि विशेष मागास प्रवर्गातील गोवारी समाजातील विद्यार्थ्यांकरिता संघ लोकसेवा आयोग व MPSC राज्यसेवा प्रशिक्षण</strong></li>
                  </ol>
                </td>
                <td class="p-3 border border-border-card font-medium text-text-main">
                  <div class="space-y-1 text-xs sm:text-sm">
                    <p class="m-0">
                      • <strong>दि. ०८/१०/२०२६:</strong> दुपारी ०३.०० PM ते ०५.०० PM (१२० मिनीटे)
                    </p>
                    <p class="m-0">
                      • <strong>दि. ०९/१०/२०२६:</strong> सकाळी ०९.०० AM ते ११.०० AM (१२० मिनीटे)
                    </p>
                    <p class="m-0">
                      • <strong>दि. ०९/१०/२०२६:</strong> दुपारी १२.०० PM ते ०२.०० PM (१२० मिनीटे)
                    </p>
                    <p class="m-0">
                      • <strong>दि. ०९/१०/२०२६:</strong> दुपारी ०३.०० PM ते ०५.०० PM (१२० मिनीटे)
                    </p>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Official Guidelines & Note -->
        <div
          class="bg-bg-surface border border-border-card p-5 rounded-2xl text-sm mb-6 space-y-3"
        >
          <p class="m-0 text-text-main font-bold flex items-center gap-2 text-base">
            <HiOutlineMegaphone className="text-rose-500 text-xl shrink-0" />
            <span>महत्त्वाच्या सूचना व परीक्षा मार्गदर्शन (Official Exam Guidelines):</span>
          </p>
          <ul class="list-disc pl-5 m-0 text-text-muted text-xs sm:text-sm space-y-1.5 leading-relaxed">
            <li>
              परीक्षेचे केंद्र आणि बैठक क्रमांक विद्यार्थ्यांच्या प्रवेशपत्रावर (Hall Ticket) नमूद केले जातील.
            </li>
            <li>
              परीक्षेच्या वेळेपूर्वी किमान ३० मिनिटे आधी परीक्षा केंद्रावर उपस्थित राहणे अनिवार्य आहे.
            </li>
            <li>
              परीक्षेच्या वेळी अधिकृत प्रवेशपत्र आणि मूळ फोटो ओळखपत्र (आधार कार्ड / मतदार ओळखपत्र / ड्रायव्हिंग लायसन्स) सोबत ठेवणे आवश्यक आहे.
            </li>
            <li>
              अधिकृत अपडेट्स आणि प्रवेशपत्र डाउनलोड करण्यासाठी संस्थांच्या संकेतस्थळाला नियमित भेट द्या.
            </li>
          </ul>
        </div>

        <!-- Official Links Table -->
        <h2
          id="important-links-mr"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          {
            translateMarathi(
              "महत्त्वाच्या लिंक्स (Official Circular & Portal Links)",
            )
          }
        </h2>
        <div class="overflow-x-auto mt-3 mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                >
                  तपशील (Event / Resource)
                </th>
                <th
                  class="p-3 border border-border-card font-bold text-text-main"
                >
                  दुवा / Action Link
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                >
                  महाज्योति व वनार्टी अधिकृत वेळापत्रक परिपत्रक (Official Notification PDF)
                </td>
                <td class="p-3 border border-border-card">
                  <a
                    href={OFFICIAL_LINKS.mahajyotiPortal}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-rose-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineDocumentText className="text-base shrink-0" /> अधिकृत परिपत्रक (Notice PDF)
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                >
                  महाज्योति अधिकृत संकेतस्थळ (Mahajyoti Portal)
                </td>
                <td class="p-3 border border-border-card">
                  <a
                    href={OFFICIAL_LINKS.mahajyotiPortal}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-primary/20 w-full sm:w-auto"
                  >
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> mahajyoti.org.in
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                >
                  वनार्टी अधिकृत संकेतस्थळ (VANARTI Portal)
                </td>
                <td class="p-3 border border-border-card">
                  <a
                    href={OFFICIAL_LINKS.vanartiPortal}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-emerald-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineCursorArrowRays className="text-base shrink-0" /> vanarti.org.in
                  </a>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 border border-border-card text-text-muted font-medium"
                >
                  MPSC व स्पर्धा परीक्षा वयोमर्यादा कॅल्क्युलेटर (MPSC Age Calculator)
                </td>
                <td class="p-3 border border-border-card">
                  <a
                    href="/mpsc-age-calculator-marathi"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-purple-500/10 hover:bg-purple-500/20 text-purple-600 dark:text-purple-400 text-xs font-bold uppercase tracking-wider rounded-lg transition-colors border border-purple-500/30 w-full sm:w-auto"
                  >
                    <HiOutlineCalculator className="text-base shrink-0" /> वय तपासा (Calculate Age)
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- FAQ Section Marathi -->
        <h2
          id="faq"
          class="text-xl md:text-2xl font-black text-primary mb-2 mt-8 border-l-4 border-primary pl-3"
        >
          वारंवार विचारले जाणारे प्रश्न (FAQ - Marathi)
        </h2>
        <div class="space-y-4 mt-3 mb-8">
          <div class="bg-bg-surface border border-border-card p-5 rounded-2xl">
            <h3 class="text-base font-bold text-text-main mb-2">
              प्रश्न १: महाज्योति व वनार्टी चाळणी परीक्षा कोणत्या तारखांना होणार आहे?
            </h3>
            <p class="text-text-muted text-xs sm:text-sm m-0">
